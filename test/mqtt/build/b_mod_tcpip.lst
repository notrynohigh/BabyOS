 930:../../bos/modules/b_mod_tcpip.c **** static int _bParseName(uint8_t *msg, uint8_t *compressed, char *buf, int16_t len)
 931:../../bos/modules/b_mod_tcpip.c **** {
 932:../../bos/modules/b_mod_tcpip.c ****     uint16_t slen; /* Length of current segment */
 933:../../bos/modules/b_mod_tcpip.c ****     uint8_t *cp;
 934:../../bos/modules/b_mod_tcpip.c ****     int      clen     = 0; /* Total length of compressed name */
 935:../../bos/modules/b_mod_tcpip.c ****     int      indirect = 0; /* Set if indirection encountered */
 936:../../bos/modules/b_mod_tcpip.c ****     int      nseg     = 0; /* Total number of segments in name */
 937:../../bos/modules/b_mod_tcpip.c **** 
 938:../../bos/modules/b_mod_tcpip.c ****     cp = compressed;
 939:../../bos/modules/b_mod_tcpip.c **** 
 940:../../bos/modules/b_mod_tcpip.c ****     for (;;)
 941:../../bos/modules/b_mod_tcpip.c ****     {
 942:../../bos/modules/b_mod_tcpip.c ****         slen = *cp++; /* Length of this segment */
 943:../../bos/modules/b_mod_tcpip.c **** 
 944:../../bos/modules/b_mod_tcpip.c ****         if (!indirect)
 945:../../bos/modules/b_mod_tcpip.c ****             clen++;
 946:../../bos/modules/b_mod_tcpip.c **** 
 947:../../bos/modules/b_mod_tcpip.c ****         if ((slen & 0xc0) == 0xc0)
