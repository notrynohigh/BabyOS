 834:../../bos/modules/b_mod_tcpip.c **** static int8_t bDnsCheckTimeout()
 835:../../bos/modules/b_mod_tcpip.c **** {
 836:../../bos/modules/b_mod_tcpip.c ****     if ((bHalGetSysTickPlus() - bDnsRunCtx.tick) >= MS2TICKS(DNS_WAIT_TIME))
 837:../../bos/modules/b_mod_tcpip.c ****     {
 838:../../bos/modules/b_mod_tcpip.c ****         bDnsRunCtx.tick = bHalGetSysTickPlus();
 839:../../bos/modules/b_mod_tcpip.c ****         if (bDnsRunCtx.retry >= MAX_DNS_RETRY)
 840:../../bos/modules/b_mod_tcpip.c ****         {
 841:../../bos/modules/b_mod_tcpip.c ****             bDnsRunCtx.retry = 0;
 842:../../bos/modules/b_mod_tcpip.c ****             return -1;  // timeout occurred
 843:../../bos/modules/b_mod_tcpip.c ****         }
 844:../../bos/modules/b_mod_tcpip.c ****         bDnsRunCtx.retry++;
 845:../../bos/modules/b_mod_tcpip.c ****         return 0;  // timer over, but no timeout
 846:../../bos/modules/b_mod_tcpip.c ****     }
