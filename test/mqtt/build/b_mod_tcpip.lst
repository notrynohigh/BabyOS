 692:../../bos/modules/b_mod_tcpip.c ****                 cur_valid_len += read_len;
 693:../../bos/modules/b_mod_tcpip.c ****             }
 694:../../bos/modules/b_mod_tcpip.c ****             else
 695:../../bos/modules/b_mod_tcpip.c ****             {
 696:../../bos/modules/b_mod_tcpip.c ****                 memcpy(pbuf + cur_valid_len, pdata, data_len);
 697:../../bos/modules/b_mod_tcpip.c ****                 cur_valid_len += data_len;
 698:../../bos/modules/b_mod_tcpip.c ****             }
 699:../../bos/modules/b_mod_tcpip.c ****             _bTransPcbDataShiftForward(phead, read_len);
 700:../../bos/modules/b_mod_tcpip.c ****         }
 701:../../bos/modules/b_mod_tcpip.c ****         else
 702:../../bos/modules/b_mod_tcpip.c ****         {
 703:../../bos/modules/b_mod_tcpip.c ****             break;
 704:../../bos/modules/b_mod_tcpip.c ****         }
 705:../../bos/modules/b_mod_tcpip.c ****     }
 706:../../bos/modules/b_mod_tcpip.c ****     return cur_valid_len;
 707:../../bos/modules/b_mod_tcpip.c **** }
