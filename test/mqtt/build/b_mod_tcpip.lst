 125:../../bos/utils/inc/b_util_list.h **** /*
 126:../../bos/utils/inc/b_util_list.h ****  * Delete a list entry by making the prev/next entries
 127:../../bos/utils/inc/b_util_list.h ****  * point to each other.
 128:../../bos/utils/inc/b_util_list.h ****  *
 129:../../bos/utils/inc/b_util_list.h ****  * This is only for internal list manipulation where we know
 130:../../bos/utils/inc/b_util_list.h ****  * the prev/next entries already!
 131:../../bos/utils/inc/b_util_list.h ****  */
 132:../../bos/utils/inc/b_util_list.h **** static __INLINE_DEF void __list_del(struct list_head *prev, struct list_head *next)
 133:../../bos/utils/inc/b_util_list.h **** {
 134:../../bos/utils/inc/b_util_list.h ****     next->prev = prev;
 135:../../bos/utils/inc/b_util_list.h ****     WRITE_ONCE(prev->next, next);
 136:../../bos/utils/inc/b_util_list.h **** }
 137:../../bos/utils/inc/b_util_list.h **** 
 138:../../bos/utils/inc/b_util_list.h **** static __INLINE_DEF void list_del(struct list_head *item)
 139:../../bos/utils/inc/b_util_list.h **** {
 140:../../bos/utils/inc/b_util_list.h ****     __list_del(item->prev, item->next);
 141:../../bos/utils/inc/b_util_list.h **** }
 142:../../bos/utils/inc/b_util_list.h **** 
 143:../../bos/utils/inc/b_util_list.h **** /**
 144:../../bos/utils/inc/b_util_list.h ****  * list_is_first -- tests whether @list is the first entry in list @head
 145:../../bos/utils/inc/b_util_list.h ****  * @list: the entry to test
GAS LISTING /tmp/ccJnc7OG.s 			page 147


 146:../../bos/utils/inc/b_util_list.h ****  * @head: the head of the list
 147:../../bos/utils/inc/b_util_list.h ****  */
 148:../../bos/utils/inc/b_util_list.h **** static __INLINE_DEF int list_is_first(const struct list_head *list, const struct list_head *head)
 149:../../bos/utils/inc/b_util_list.h **** {
 150:../../bos/utils/inc/b_util_list.h ****     return list->prev == head;
 151:../../bos/utils/inc/b_util_list.h **** }
 152:../../bos/utils/inc/b_util_list.h **** 
 153:../../bos/utils/inc/b_util_list.h **** /**
 154:../../bos/utils/inc/b_util_list.h ****  * list_is_last - tests whether @list is the last entry in list @head
 155:../../bos/utils/inc/b_util_list.h ****  * @list: the entry to test
 156:../../bos/utils/inc/b_util_list.h ****  * @head: the head of the list
 157:../../bos/utils/inc/b_util_list.h ****  */
 158:../../bos/utils/inc/b_util_list.h **** static __INLINE_DEF int list_is_last(const struct list_head *list, const struct list_head *head)
 159:../../bos/utils/inc/b_util_list.h **** {
 160:../../bos/utils/inc/b_util_list.h ****     return list->next == head;
 161:../../bos/utils/inc/b_util_list.h **** }
 162:../../bos/utils/inc/b_util_list.h **** 
 163:../../bos/utils/inc/b_util_list.h **** /**
 164:../../bos/utils/inc/b_util_list.h ****  * list_is_head - tests whether @list is the list @head
 165:../../bos/utils/inc/b_util_list.h ****  * @list: the entry to test
 166:../../bos/utils/inc/b_util_list.h ****  * @head: the head of the list
 167:../../bos/utils/inc/b_util_list.h ****  */
 168:../../bos/utils/inc/b_util_list.h **** static __INLINE_DEF int list_is_head(const struct list_head *list, const struct list_head *head)
 169:../../bos/utils/inc/b_util_list.h **** {
 170:../../bos/utils/inc/b_util_list.h ****     return list == head;
 171:../../bos/utils/inc/b_util_list.h **** }
 172:../../bos/utils/inc/b_util_list.h **** 
