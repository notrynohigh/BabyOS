 956:../../bos/modules/b_mod_tcpip.c **** 
 957:../../bos/modules/b_mod_tcpip.c ****         if (slen == 0) /* zero length == all done */
 958:../../bos/modules/b_mod_tcpip.c ****             break;
 959:../../bos/modules/b_mod_tcpip.c **** 
 960:../../bos/modules/b_mod_tcpip.c ****         len -= slen + 1;
GAS LISTING /tmp/ccJnc7OG.s 			page 18


 961:../../bos/modules/b_mod_tcpip.c **** 
 962:../../bos/modules/b_mod_tcpip.c ****         if (len < 0)
 963:../../bos/modules/b_mod_tcpip.c ****             return -1;
 964:../../bos/modules/b_mod_tcpip.c **** 
 965:../../bos/modules/b_mod_tcpip.c ****         if (!indirect)
 966:../../bos/modules/b_mod_tcpip.c ****             clen += slen;
 967:../../bos/modules/b_mod_tcpip.c **** 
 968:../../bos/modules/b_mod_tcpip.c ****         while (slen-- != 0)
 969:../../bos/modules/b_mod_tcpip.c ****             *buf++ = (char)*cp++;
 970:../../bos/modules/b_mod_tcpip.c ****         *buf++ = '.';
 971:../../bos/modules/b_mod_tcpip.c ****         nseg++;
 972:../../bos/modules/b_mod_tcpip.c ****     }
 973:../../bos/modules/b_mod_tcpip.c **** 
 974:../../bos/modules/b_mod_tcpip.c ****     if (nseg == 0)
 975:../../bos/modules/b_mod_tcpip.c ****     {
 976:../../bos/modules/b_mod_tcpip.c ****         /* Root name; represent as single dot */
 977:../../bos/modules/b_mod_tcpip.c ****         *buf++ = '.';
 978:../../bos/modules/b_mod_tcpip.c ****         len--;
 979:../../bos/modules/b_mod_tcpip.c ****     }
 980:../../bos/modules/b_mod_tcpip.c **** 
