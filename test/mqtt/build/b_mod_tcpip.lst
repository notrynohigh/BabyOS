 858:../../bos/modules/b_mod_tcpip.c **** 
 859:../../bos/modules/b_mod_tcpip.c **** /* copies uint16_t to the network buffer with network byte order. */
 860:../../bos/modules/b_mod_tcpip.c **** static uint8_t *put16(uint8_t *s, uint16_t i)
 861:../../bos/modules/b_mod_tcpip.c **** {
 862:../../bos/modules/b_mod_tcpip.c ****     *s++ = i >> 8;
 863:../../bos/modules/b_mod_tcpip.c ****     *s++ = i;
 864:../../bos/modules/b_mod_tcpip.c ****     return s;
 865:../../bos/modules/b_mod_tcpip.c **** }
 866:../../bos/modules/b_mod_tcpip.c **** 
 867:../../bos/modules/b_mod_tcpip.c **** static uint32_t get32(uint8_t *s)
 868:../../bos/modules/b_mod_tcpip.c **** {
 869:../../bos/modules/b_mod_tcpip.c ****     uint32_t i;
 870:../../bos/modules/b_mod_tcpip.c ****     i = (*s++) << 24;
 871:../../bos/modules/b_mod_tcpip.c ****     i = i + ((*s++) << 16);
 872:../../bos/modules/b_mod_tcpip.c ****     i = i + ((*s++) << 8);
 873:../../bos/modules/b_mod_tcpip.c ****     i = i + *s;
 874:../../bos/modules/b_mod_tcpip.c ****     return i;
 875:../../bos/modules/b_mod_tcpip.c **** }
