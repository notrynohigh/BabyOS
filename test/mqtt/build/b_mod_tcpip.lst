 907:../../bos/modules/b_mod_tcpip.c ****         else
 908:../../bos/modules/b_mod_tcpip.c ****             len = dlen; /* Last component */
 909:../../bos/modules/b_mod_tcpip.c **** 
 910:../../bos/modules/b_mod_tcpip.c ****         *cp++ = len; /* Write length of component */
