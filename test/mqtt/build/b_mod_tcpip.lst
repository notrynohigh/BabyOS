 982:../../bos/modules/b_mod_tcpip.c ****     len--;
 983:../../bos/modules/b_mod_tcpip.c **** 
 984:../../bos/modules/b_mod_tcpip.c ****     return clen; /* Length of compressed message */
 985:../../bos/modules/b_mod_tcpip.c **** }
