 588:../../bos/modules/b_mod_tcpip.c ****     else
 589:../../bos/modules/b_mod_tcpip.c ****     {
 590:../../bos/modules/b_mod_tcpip.c ****         pdata->pbuf = bMalloc(len + 1);
 591:../../bos/modules/b_mod_tcpip.c ****         if (pdata->pbuf == NULL)
 592:../../bos/modules/b_mod_tcpip.c ****         {
 593:../../bos/modules/b_mod_tcpip.c ****             bFree(pdata);
 594:../../bos/modules/b_mod_tcpip.c ****             return 0;
 595:../../bos/modules/b_mod_tcpip.c ****         }
 596:../../bos/modules/b_mod_tcpip.c ****         memset(pdata->pbuf, 0, len + 1);
 597:../../bos/modules/b_mod_tcpip.c ****         memcpy(pdata->pbuf, pbuf, len);
 598:../../bos/modules/b_mod_tcpip.c ****         pdata->release = bFree;
 599:../../bos/modules/b_mod_tcpip.c ****     }
 600:../../bos/modules/b_mod_tcpip.c ****     pdata->len = len;
 601:../../bos/modules/b_mod_tcpip.c ****     list_add_tail(&pdata->node, phead);
 602:../../bos/modules/b_mod_tcpip.c ****     b_log("[add data %d limit %d]\r\n", len, limit);
 603:../../bos/modules/b_mod_tcpip.c ****     return len;
