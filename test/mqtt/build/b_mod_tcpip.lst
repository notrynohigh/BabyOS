 850:../../bos/modules/b_mod_tcpip.c **** /* converts uint16_t from network buffer to a host byte order integer. */
 851:../../bos/modules/b_mod_tcpip.c **** static uint16_t get16(uint8_t *s)
 852:../../bos/modules/b_mod_tcpip.c **** {
 853:../../bos/modules/b_mod_tcpip.c ****     uint16_t i;
 854:../../bos/modules/b_mod_tcpip.c ****     i = *s++ << 8;
 855:../../bos/modules/b_mod_tcpip.c ****     i = i + *s;
