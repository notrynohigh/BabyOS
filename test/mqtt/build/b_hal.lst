  69:../../bos/hal/b_hal.c ****     uint32_t          base_value = 100000 * bUsDelayParam;
  70:../../bos/hal/b_hal.c ****     volatile uint32_t delay      = 0;
  71:../../bos/hal/b_hal.c ****     volatile uint32_t tick_s = 0, tick_e = 0;
