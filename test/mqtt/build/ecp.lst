 147:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /**
 148:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \brief           The ECP point structure, in Jacobian coordinates.
 149:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 150:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \note            All functions expect and return points satisfying
 151:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  the following condition: <code>Z == 0</code> or
 152:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  <code>Z == 1</code>. Other values of \p Z are
 153:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  used only by internal functions.
 154:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  The point is zero, or "at infinity", if <code>Z == 0</code>.
