 943:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;
 944:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
 945:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
 946:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /*
 947:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * Next two bytes are the namedcurve value
