2212:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      *
2213:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * Avoid the leak by randomizing coordinates before we normalize them.
2214:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      */
2215:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (f_rng != 0) {
