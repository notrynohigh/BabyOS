 142:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     uint16_t tls_id;                /*!< The TLS NamedCurve identifier. */
 143:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     uint16_t bit_size;              /*!< The curve size in bits. */
 144:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     const char *name;               /*!< A human-friendly name. */
 145:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** } mbedtls_ecp_curve_info;
