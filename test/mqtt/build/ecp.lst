1349:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
1350:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Normalize jacobian coordinates of an array of (pointers to) points,
1351:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * using Montgomery's trick to perform only one inversion mod P.
1352:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * (See for example Cohen's "A Course in Computational Algebraic Number
1353:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Theory", Algorithm 10.3.4.)
1354:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1355:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Warning: fails (returning an error) if one of the points is zero!
1356:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * This should never happen, see choice of w in ecp_mul_comb().
1357:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1358:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Cost: 1N(t) := 1I + (6t - 3)M + 1S
1359:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
1360:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static int ecp_normalize_jac_many(const mbedtls_ecp_group *grp,
1361:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                                   mbedtls_ecp_point *T[], size_t T_size)
1362:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
1363:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (T_size < 2) {
1364:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return ecp_normalize_jac(grp, *T);
1365:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1366:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1367:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_NORMALIZE_JAC_MANY_ALT)
1368:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (mbedtls_internal_ecp_grp_capable(grp)) {
1369:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return mbedtls_internal_ecp_normalize_jac_many(grp, T, T_size);
1370:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1371:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif
1372:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1373:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_NO_FALLBACK) && defined(MBEDTLS_ECP_NORMALIZE_JAC_MANY_ALT)
1374:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;
1375:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #else
1376:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
1377:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     size_t i;
1378:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi *c, t;
1379:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1380:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if ((c = mbedtls_calloc(T_size, sizeof(mbedtls_mpi))) == NULL) {
1381:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return MBEDTLS_ERR_ECP_ALLOC_FAILED;
1382:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1383:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1384:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi_init(&t);
1385:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1386:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mpi_init_many(c, T_size);
1387:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /*
1388:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * c[i] = Z_0 * ... * Z_i,   i = 0,..,n := T_size-1
1389:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      */
1390:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MOV(&c[0], &T[0]->Z);
1391:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     for (i = 1; i < T_size; i++) {
1392:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_MUL(&c[i], &c[i-1], &T[i]->Z);
1393:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1394:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
GAS LISTING /tmp/cc9fxdJq.s 			page 37


1395:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /*
1396:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * c[n] = 1 / (Z_0 * ... * Z_n) mod P
1397:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      */
1398:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_INV(&c[T_size-1], &c[T_size-1]);
1399:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1400:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     for (i = T_size - 1;; i--) {
1401:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* At the start of iteration i (note that i decrements), we have
1402:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * - c[j] = Z_0 * .... * Z_j        for j  < i,
1403:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * - c[j] = 1 / (Z_0 * .... * Z_j)  for j == i,
1404:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          *
1405:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * This is maintained via
1406:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * - c[i-1] <- c[i] * Z_i
1407:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          *
1408:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * We also derive 1/Z_i = c[i] * c[i-1] for i>0 and use that
1409:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * to do the actual normalization. For i==0, we already have
1410:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * c[0] = 1 / Z_0.
1411:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          */
1412:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1413:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if (i > 0) {
1414:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             /* Compute 1/Z_i and establish invariant for the next iteration. */
1415:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             MPI_ECP_MUL(&t,      &c[i], &c[i-1]);
1416:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             MPI_ECP_MUL(&c[i-1], &c[i], &T[i]->Z);
1417:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         } else {
1418:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             MPI_ECP_MOV(&t, &c[0]);
1419:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         }
1420:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1421:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* Now t holds 1 / Z_i; normalize as in ecp_normalize_jac() */
1422:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_MUL(&T[i]->Y, &T[i]->Y, &t);
1423:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_SQR(&t,       &t);
1424:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_MUL(&T[i]->X, &T[i]->X, &t);
1425:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_MUL(&T[i]->Y, &T[i]->Y, &t);
1426:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1427:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /*
1428:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * Post-precessing: reclaim some memory by shrinking coordinates
1429:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * - not storing Z (always 1)
1430:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * - shrinking other coordinates, but still keeping the same number of
1431:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          *   limbs as P, as otherwise it will too likely be regrown too fast.
1432:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          */
1433:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_shrink(&T[i]->X, grp->P.n));
1434:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_shrink(&T[i]->Y, grp->P.n));
1435:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1436:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_LSET(&T[i]->Z, 1);
1437:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1438:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if (i == 0) {
1439:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             break;
1440:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         }
1441:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1442:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
