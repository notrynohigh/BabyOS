 534:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  */
 535:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** mbedtls_ecp_curve_type mbedtls_ecp_get_type(const mbedtls_ecp_group *grp);
 536:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** 
 537:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /**
 538:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \brief           This function retrieves the information defined in
 539:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  mbedtls_ecp_curve_info() for all supported curves.
 540:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
