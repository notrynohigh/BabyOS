2515:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2516:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_ADD(&T[0], &P->X,   &P->Z);   /* Pp := PX + PZ                    */
2517:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SUB(&T[1], &P->X,   &P->Z);   /* Pm := PX - PZ                    */
2518:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_ADD(&T[2], &Q->X,   &Q->Z);   /* Qp := QX + XZ                    */
2519:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SUB(&T[3], &Q->X,   &Q->Z);   /* Qm := QX - QZ                    */
2520:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&T[3], &T[3],   &T[0]);   /* Qm * Pp                          */
2521:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&T[2], &T[2],   &T[1]);   /* Qp * Pm                          */
2522:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SQR(&T[0], &T[0]);            /* Pp^2                             */
2523:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SQR(&T[1], &T[1]);            /* Pm^2                             */
2524:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&R->X, &T[0],   &T[1]);   /* Pp^2 * Pm^2                      */
