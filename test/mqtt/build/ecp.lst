1649:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* {P,Q}->Z no longer used, so OK to write to Z even if there's aliasing. */
1650:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(Z,        &P->Z,    &tmp[0]);
