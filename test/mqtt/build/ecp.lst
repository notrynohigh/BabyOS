 165:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** #if !defined(MBEDTLS_ECP_ALT)
 166:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /*
 167:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * default Mbed TLS elliptic curve arithmetic implementation
 168:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 169:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * (in case MBEDTLS_ECP_ALT is defined then the developer has to provide an
 170:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * alternative implementation for the whole module and it will replace this
 171:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * one.)
 172:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  */
 173:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** 
 174:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /**
 175:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \brief           The ECP group structure.
 176:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 177:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * We consider two types of curve equations:
 178:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * <ul><li>Short Weierstrass: <code>y^2 = x^3 + A x + B mod P</code>
 179:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * (SEC1 + RFC-4492)</li>
 180:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * <li>Montgomery: <code>y^2 = x^3 + A x^2 + x mod P</code> (Curve25519,
 181:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * Curve448)</li></ul>
 182:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * In both cases, the generator (\p G) for a prime-order subgroup is fixed.
 183:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 184:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * For Short Weierstrass, this subgroup is the whole curve, and its
 185:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * cardinality is denoted by \p N. Our code requires that \p N is an
 186:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * odd prime as mbedtls_ecp_mul() requires an odd number, and
 187:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * mbedtls_ecdsa_sign() requires that it is prime for blinding purposes.
 188:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 189:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * The default implementation only initializes \p A without setting it to the
 190:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * authentic value for curves with <code>A = -3</code>(SECP256R1, etc), in which
 191:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * case you need to load \p A by yourself when using domain parameters directly,
 192:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * for example:
 193:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \code
 194:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * mbedtls_mpi_init(&A);
 195:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * mbedtls_ecp_group_init(&grp);
 196:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * CHECK_RETURN(mbedtls_ecp_group_load(&grp, grp_id));
 197:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * if (mbedtls_ecp_group_a_is_minus_3(&grp)) {
 198:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *     CHECK_RETURN(mbedtls_mpi_sub_int(&A, &grp.P, 3));
 199:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * } else {
 200:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *     CHECK_RETURN(mbedtls_mpi_copy(&A, &grp.A));
 201:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * }
 202:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 203:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * do_something_with_a(&A);
 204:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 205:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * cleanup:
 206:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * mbedtls_mpi_free(&A);
 207:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * mbedtls_ecp_group_free(&grp);
 208:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \endcode
 209:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 210:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * For Montgomery curves, we do not store \p A, but <code>(A + 2) / 4</code>,
 211:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * which is the quantity used in the formulas. Additionally, \p nbits is
 212:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * not the size of \p N but the required size for private keys.
 213:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 214:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * If \p modp is NULL, reduction modulo \p P is done using a generic algorithm.
 215:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * Otherwise, \p modp must point to a function that takes an \p mbedtls_mpi in the
 216:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * range of <code>0..2^(2*pbits)-1</code>, and transforms it in-place to an integer
 217:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * which is congruent mod \p P to the given MPI, and is close enough to \p pbits
 218:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * in size, so that it may be efficiently brought in the 0..P-1 range by a few
 219:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * additions or subtractions. Therefore, it is only an approximative modular
 220:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * reduction. It must return 0 on success and non-zero on failure.
GAS LISTING /tmp/cc9fxdJq.s 			page 62


 221:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 222:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \note        Alternative implementations of the ECP module must obey the
 223:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *              following constraints.
 224:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *              * Group IDs must be distinct: if two group structures have
 225:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                the same ID, then they must be identical.
 226:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *              * The fields \c id, \c P, \c A, \c B, \c G, \c N,
 227:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                \c pbits and \c nbits must have the same type and semantics
 228:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                as in the built-in implementation.
 229:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                They must be available for reading, but direct modification
 230:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                of these fields does not need to be supported.
 231:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                They do not need to be at the same offset in the structure.
 232:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  */
 233:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** typedef struct mbedtls_ecp_group {
 234:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     mbedtls_ecp_group_id id;    /*!< An internal group identifier. */
 235:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     mbedtls_mpi P;              /*!< The prime modulus of the base field. */
 236:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     mbedtls_mpi A;              /*!< For Short Weierstrass: \p A in the equation. Note that
 237:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****                                      \p A is not set to the authentic value in some cases.
 238:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****                                      Refer to detailed description of ::mbedtls_ecp_group if
 239:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****                                      using domain parameters in the structure.
 240:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****                                      For Montgomery curves: <code>(A + 2) / 4</code>. */
 241:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     mbedtls_mpi B;              /*!< For Short Weierstrass: \p B in the equation.
 242:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****                                      For Montgomery curves: unused. */
 243:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     mbedtls_ecp_point G;        /*!< The generator of the subgroup used. */
 244:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     mbedtls_mpi N;              /*!< The order of \p G. */
 245:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     size_t pbits;               /*!< The number of bits in \p P.*/
 246:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     size_t nbits;               /*!< For Short Weierstrass: The number of bits in \p P.
 247:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****                                      For Montgomery curves: the number of bits in the
 248:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****                                      private keys. */
 249:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     /* End of public fields */
 250:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** 
 251:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     unsigned int MBEDTLS_PRIVATE(h);             /*!< \internal 1 if the constants are static. */
 252:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     int(*MBEDTLS_PRIVATE(modp))(mbedtls_mpi *);  /*!< The function for fast pseudo-reduction
 253:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****                                                     mod \p P (see above).*/
 254:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     int(*MBEDTLS_PRIVATE(t_pre))(mbedtls_ecp_point *, void *);   /*!< Unused. */
 255:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     int(*MBEDTLS_PRIVATE(t_post))(mbedtls_ecp_point *, void *);  /*!< Unused. */
 256:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     void *MBEDTLS_PRIVATE(t_data);               /*!< Unused. */
 257:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     mbedtls_ecp_point *MBEDTLS_PRIVATE(T);       /*!< Pre-computed points for ecp_mul_comb(). */
 258:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****     size_t MBEDTLS_PRIVATE(T_size);              /*!< The number of dynamic allocated pre-computed 
 259:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** }
