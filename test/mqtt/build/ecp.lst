1284:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* check parity bit match or else invert Y */
1285:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* This quick inversion implementation is valid because Y != 0 for all
1286:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * Short Weierstrass curves supported by mbedtls, as each supported curve
1287:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * has an order that is a large prime, so each supported curve does not
1288:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * have any point of order 2, and a point with Y == 0 would be of order 2 */
1289:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (mbedtls_mpi_get_bit(Y, 0) != parity_bit) {
1290:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_sub_mpi(Y, &grp->P, Y));
1291:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
