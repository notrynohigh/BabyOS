  77:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /**
  78:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * Domain-parameter identifiers: curve, subgroup, and generator.
  79:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
  80:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \note Only curves over prime fields are supported.
