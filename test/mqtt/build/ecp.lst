1302:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
1303:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * For curves in short Weierstrass form, we do all the internal operations in
1304:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Jacobian coordinates.
1305:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1306:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * For multiplication, we'll use a comb method with countermeasures against
1307:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * SPA, hence timing attacks.
1308:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
1309:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1310:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
1311:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Normalize jacobian coordinates so that Z == 0 || Z == 1  (GECC 3.2.1)
1312:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Cost: 1N := 1I + 3M + 1S
1313:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
1314:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static int ecp_normalize_jac(const mbedtls_ecp_group *grp, mbedtls_ecp_point *pt)
1315:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
