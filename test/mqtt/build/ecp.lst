1317:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return 0;
1318:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1319:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1320:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_NORMALIZE_JAC_ALT)
1321:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (mbedtls_internal_ecp_grp_capable(grp)) {
1322:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return mbedtls_internal_ecp_normalize_jac(grp, pt);
1323:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1324:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif /* MBEDTLS_ECP_NORMALIZE_JAC_ALT */
1325:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1326:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_NO_FALLBACK) && defined(MBEDTLS_ECP_NORMALIZE_JAC_ALT)
1327:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;
1328:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #else
