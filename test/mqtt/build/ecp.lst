2527:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_ADD(&R->Z, &T[1],   &R->Z);   /* [ A * (Pp^2-Pm^2) ] + Pm^2       */
2528:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_ADD(&S->X, &T[3],   &T[2]);   /* Qm*Pp + Qp*Pm                    */
