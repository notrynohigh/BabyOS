1255:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
1256:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* w = y^2 = x^3 + ax + b
1257:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * y = sqrt(w) = w^((p+1)/4) mod p   (for prime p where p = 3 mod 4)
1258:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      *
1259:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * Note: this method for extracting square root does not validate that w
1260:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * was indeed a square so this function will return garbage in Y if X
1261:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * does not correspond to a point on the curve.
