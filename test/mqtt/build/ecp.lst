 971:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /**
 972:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \brief           This function performs multiplication of a point by
 973:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  an integer: \p R = \p m * \p P in a restartable way.
 974:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 975:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \see             mbedtls_ecp_mul()
 976:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 977:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \note            This function does the same as \c mbedtls_ecp_mul(), but
 978:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  it can return early and restart according to the limit set
 979:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  with \c mbedtls_ecp_set_max_ops() to reduce blocking.
 980:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 981:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \param grp       The ECP group to use.
 982:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  This must be initialized and have group parameters
 983:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  set, for example through mbedtls_ecp_group_load().
 984:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \param R         The point in which to store the result of the calculation.
 985:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  This must be initialized.
 986:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \param m         The integer by which to multiply. This must be initialized.
 987:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \param P         The point to multiply. This must be initialized.
 988:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \param f_rng     The RNG function. This must not be \c NULL.
 989:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \param p_rng     The RNG context to be passed to \p f_rng. This may be \c
 990:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  NULL if \p f_rng doesn't need a context.
 991:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \param rs_ctx    The restart context (NULL disables restart).
 992:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 993:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \return          \c 0 on success.
 994:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \return          #MBEDTLS_ERR_ECP_INVALID_KEY if \p m is not a valid private
 995:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  key, or \p P is not a valid public key.
 996:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \return          #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory-allocation failure.
 997:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \return          #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of
 998:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  operations was reached: see \c mbedtls_ecp_set_max_ops().
 999:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \return          Another negative error code on other kinds of failure.
1000:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  */
