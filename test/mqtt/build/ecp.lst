1674:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
1675:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Randomize jacobian coordinates:
1676:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * (X, Y, Z) -> (l^2 X, l^3 Y, l Z) for random l
1677:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * This is sort of the reverse operation of ecp_normalize_jac().
1678:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1679:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * This countermeasure was first suggested in [2].
GAS LISTING /tmp/cc9fxdJq.s 			page 42


1680:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
1681:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static int ecp_randomize_jac(const mbedtls_ecp_group *grp, mbedtls_ecp_point *pt,
1682:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                              int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)
1683:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
1684:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_RANDOMIZE_JAC_ALT)
1685:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (mbedtls_internal_ecp_grp_capable(grp)) {
1686:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return mbedtls_internal_ecp_randomize_jac(grp, pt, f_rng, p_rng);
1687:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1688:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif /* MBEDTLS_ECP_RANDOMIZE_JAC_ALT */
1689:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1690:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_NO_FALLBACK) && defined(MBEDTLS_ECP_RANDOMIZE_JAC_ALT)
1691:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;
1692:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #else
1693:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
1694:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi l;
1695:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1696:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi_init(&l);
1697:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1698:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* Generate l such that 1 < l < p */
1699:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_RAND(&l);
1700:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1701:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* Z' = l * Z */
1702:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&pt->Z,   &pt->Z,     &l);
1703:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1704:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* Y' = l * Y */
1705:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&pt->Y,   &pt->Y,     &l);
1706:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1707:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* X' = l^2 * X */
1708:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SQR(&l,       &l);
1709:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&pt->X,   &pt->X,     &l);
1710:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1711:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* Y'' = l^2 * Y' = l^3 * Y */
1712:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&pt->Y,   &pt->Y,     &l);
1713:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1714:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** cleanup:
1715:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi_free(&l);
1716:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1717:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (ret == MBEDTLS_ERR_MPI_NOT_ACCEPTABLE) {
1718:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         ret = MBEDTLS_ERR_ECP_RANDOM_FAILED;
1719:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1720:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return ret;
1721:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif /* !defined(MBEDTLS_ECP_NO_FALLBACK) || !defined(MBEDTLS_ECP_RANDOMIZE_JAC_ALT) */
1722:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** }
1723:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1724:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
1725:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Check and define parameters used by the comb method (see below for details)
1726:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
1727:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if MBEDTLS_ECP_WINDOW_SIZE < 2 || MBEDTLS_ECP_WINDOW_SIZE > 7
1728:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #error "MBEDTLS_ECP_WINDOW_SIZE out of bounds"
1729:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif
1730:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1731:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /* d = ceil( n / w ) */
1732:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #define COMB_MAX_D      (MBEDTLS_ECP_MAX_BITS + 1) / 2
1733:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1734:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /* number of precomputed points */
1735:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #define COMB_MAX_PRE    (1 << (MBEDTLS_ECP_WINDOW_SIZE - 1))
1736:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
GAS LISTING /tmp/cc9fxdJq.s 			page 43


1737:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
1738:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Compute the representation of m that will be used with our comb method.
1739:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1740:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * The basic comb method is described in GECC 3.44 for example. We use a
1741:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * modified version that provides resistance to SPA by avoiding zero
1742:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * digits in the representation as in [3]. We modify the method further by
1743:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * requiring that all K_i be odd, which has the small cost that our
1744:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * representation uses one more K_i, due to carries, but saves on the size of
1745:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * the precomputed table.
1746:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1747:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Summary of the comb method and its modifications:
1748:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1749:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - The goal is to compute m*P for some w*d-bit integer m.
1750:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1751:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - The basic comb method splits m into the w-bit integers
1752:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   x[0] .. x[d-1] where x[i] consists of the bits in m whose
1753:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   index has residue i modulo d, and computes m * P as
1754:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   S[x[0]] + 2 * S[x[1]] + .. + 2^(d-1) S[x[d-1]], where
1755:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   S[i_{w-1} .. i_0] := i_{w-1} 2^{(w-1)d} P + ... + i_1 2^d P + i_0 P.
1756:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1757:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - If it happens that, say, x[i+1]=0 (=> S[x[i+1]]=0), one can replace the sum by
1758:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *    .. + 2^{i-1} S[x[i-1]] - 2^i S[x[i]] + 2^{i+1} S[x[i]] + 2^{i+2} S[x[i+2]] ..,
1759:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   thereby successively converting it into a form where all summands
1760:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   are nonzero, at the cost of negative summands. This is the basic idea of [3].
1761:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1762:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - More generally, even if x[i+1] != 0, we can first transform the sum as
1763:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   .. - 2^i S[x[i]] + 2^{i+1} ( S[x[i]] + S[x[i+1]] ) + 2^{i+2} S[x[i+2]] ..,
1764:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   and then replace S[x[i]] + S[x[i+1]] = S[x[i] ^ x[i+1]] + 2 S[x[i] & x[i+1]].
1765:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   Performing and iterating this procedure for those x[i] that are even
1766:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   (keeping track of carry), we can transform the original sum into one of the form
1767:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   S[x'[0]] +- 2 S[x'[1]] +- .. +- 2^{d-1} S[x'[d-1]] + 2^d S[x'[d]]
1768:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   with all x'[i] odd. It is therefore only necessary to know S at odd indices,
1769:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   which is why we are only computing half of it in the first place in
1770:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   ecp_precompute_comb and accessing it with index abs(i) / 2 in ecp_select_comb.
1771:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1772:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - For the sake of compactness, only the seven low-order bits of x[i]
1773:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   are used to represent its absolute value (K_i in the paper), and the msb
1774:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   of x[i] encodes the sign (s_i in the paper): it is set if and only if
1775:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   if s_i == -1;
1776:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1777:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Calling conventions:
1778:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - x is an array of size d + 1
1779:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - w is the size, ie number of teeth, of the comb, and must be between
1780:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   2 and 7 (in practice, between 2 and MBEDTLS_ECP_WINDOW_SIZE)
1781:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - m is the MPI, expected to be odd and such that bitlength(m) <= w * d
1782:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   (the result will be incorrect if these assumptions are not satisfied)
1783:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
1784:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static void ecp_comb_recode_core(unsigned char x[], size_t d,
1785:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                                  unsigned char w, const mbedtls_mpi *m)
1786:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
1787:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     size_t i, j;
1788:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     unsigned char c, cc, adjust;
1789:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1790:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     memset(x, 0, d+1);
1791:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1792:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* First get the classical comb values (except for x_d = 0) */
1793:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     for (i = 0; i < d; i++) {
GAS LISTING /tmp/cc9fxdJq.s 			page 44


1794:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         for (j = 0; j < w; j++) {
1795:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             x[i] |= mbedtls_mpi_get_bit(m, i + d * j) << j;
1796:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         }
1797:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1798:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1799:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* Now make sure x_1 .. x_d are odd */
1800:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     c = 0;
1801:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     for (i = 1; i <= d; i++) {
1802:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* Add carry and update it */
1803:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         cc   = x[i] & c;
1804:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         x[i] = x[i] ^ c;
1805:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         c = cc;
1806:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1807:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* Adjust if needed, avoiding branches */
1808:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         adjust = 1 - (x[i] & 0x01);
1809:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         c   |= x[i] & (x[i-1] * adjust);
1810:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         x[i] = x[i] ^ (x[i-1] * adjust);
1811:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         x[i-1] |= adjust << 7;
1812:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1813:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** }
1814:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1815:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
1816:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Precompute points for the adapted comb method
1817:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1818:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Assumption: T must be able to hold 2^{w - 1} elements.
1819:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1820:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Operation: If i = i_{w-1} ... i_1 is the binary representation of i,
1821:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *            sets T[i] = i_{w-1} 2^{(w-1)d} P + ... + i_1 2^d P + P.
1822:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1823:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Cost: d(w-1) D + (2^{w-1} - 1) A + 1 N(w-1) + 1 N(2^{w-1} - 1)
1824:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1825:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Note: Even comb values (those where P would be omitted from the
1826:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *       sum defining T[i] above) are not needed in our adaption
1827:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *       the comb method. See ecp_comb_recode_core().
1828:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1829:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * This function currently works in four steps:
1830:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * (1) [dbl]      Computation of intermediate T[i] for 2-power values of i
1831:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * (2) [norm_dbl] Normalization of coordinates of these T[i]
1832:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * (3) [add]      Computation of all T[i]
1833:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * (4) [norm_add] Normalization of all T[i]
1834:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1835:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Step 1 can be interrupted but not the others; together with the final
1836:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * coordinate normalization they are the largest steps done at once, depending
1837:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * on the window size. Here are operation counts for P-256:
1838:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1839:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * step     (2)     (3)     (4)
1840:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * w = 5    142     165     208
1841:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * w = 4    136      77     160
1842:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * w = 3    130      33     136
1843:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * w = 2    124      11     124
1844:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1845:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * So if ECC operations are blocking for too long even with a low max_ops
1846:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * value, it's useful to set MBEDTLS_ECP_WINDOW_SIZE to a lower value in order
1847:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * to minimize maximum blocking time.
1848:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
1849:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static int ecp_precompute_comb(const mbedtls_ecp_group *grp,
1850:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                                mbedtls_ecp_point T[], const mbedtls_ecp_point *P,
GAS LISTING /tmp/cc9fxdJq.s 			page 45


1851:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                                unsigned char w, size_t d,
1852:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                                mbedtls_ecp_restart_ctx *rs_ctx)
1853:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
1854:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
1855:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     unsigned char i;
1856:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     size_t j = 0;
1857:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     const unsigned char T_size = 1U << (w - 1);
1858:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_ecp_point *cur, *TT[COMB_MAX_PRE - 1] = { NULL };
1859:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1860:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi tmp[4];
1861:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1862:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mpi_init_many(tmp, sizeof(tmp) / sizeof(mbedtls_mpi));
1863:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1864:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_RESTARTABLE)
1865:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (rs_ctx != NULL && rs_ctx->rsm != NULL) {
1866:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if (rs_ctx->rsm->state == ecp_rsm_pre_dbl) {
1867:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             goto dbl;
1868:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         }
1869:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if (rs_ctx->rsm->state == ecp_rsm_pre_norm_dbl) {
