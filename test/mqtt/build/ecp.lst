 931:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     const mbedtls_ecp_curve_info *curve_info;
 932:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /*
 933:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * We expect at least three bytes (see below)
