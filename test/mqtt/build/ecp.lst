2231:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
2232:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Pick window size based on curve size and whether we optimize for base point
2233:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
2234:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static unsigned char ecp_pick_window_size(const mbedtls_ecp_group *grp,
2235:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                                           unsigned char p_eq_g)
2236:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
2237:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     unsigned char w;
2238:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2239:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /*
2240:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * Minimize the number of multiplications, that is minimize
2241:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * 10 * d * w + 18 * 2^(w-1) + 11 * d + 7 * w, with d = ceil( nbits / w )
2242:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * (see costs of the various parts, with 1S = 1M)
2243:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      */
GAS LISTING /tmp/cc9fxdJq.s 			page 175


2244:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     w = grp->nbits >= 384 ? 5 : 4;
2245:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2246:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /*
2247:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * If P == G, pre-compute a bit more, since this may be re-used later.
2248:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * Just adding one avoids upping the cost of the first mul too much,
2249:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * and the memory cost too.
2250:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      */
2251:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (p_eq_g) {
2252:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         w++;
2253:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2254:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2255:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /*
2256:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * If static comb table may not be used (!p_eq_g) or static comb table does
2257:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * not exists, make sure w is within bounds.
2258:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * (The last test is useful only for very small curves in the test suite.)
2259:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      *
2260:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * The user reduces MBEDTLS_ECP_WINDOW_SIZE does not changes the size of
2261:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * static comb table, because the size of static comb table is fixed when
2262:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * it is generated.
2263:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      */
2264:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if (MBEDTLS_ECP_WINDOW_SIZE < 6)
2265:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if ((!p_eq_g || !ecp_group_is_static_comb_table(grp)) && w > MBEDTLS_ECP_WINDOW_SIZE) {
2266:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         w = MBEDTLS_ECP_WINDOW_SIZE;
2267:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2268:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif
2269:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (w >= grp->nbits) {
2270:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         w = 2;
2271:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2272:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2273:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return w;
2274:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** }
