2580:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     i = grp->nbits + 1; /* one past the (zero-based) required msb for private keys */
2581:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     while (i-- > 0) {
