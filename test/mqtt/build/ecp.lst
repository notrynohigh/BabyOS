1330:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi T;
1331:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi_init(&T);
1332:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1333:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_INV(&T,       &pt->Z);            /* T   <-          1 / Z   */
1334:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&pt->Y,   &pt->Y,     &T);    /* Y'  <- Y*T    = Y / Z   */
1335:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SQR(&T,       &T);                /* T   <- T^2    = 1 / Z^2 */
1336:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&pt->X,   &pt->X,     &T);    /* X   <- X  * T = X / Z^2 */
1337:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&pt->Y,   &pt->Y,     &T);    /* Y'' <- Y' * T = Y / Z^3 */
