 262:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /**
 263:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \name SECTION: Module settings
 264:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 265:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * The configuration options you can set for this module are in this section.
 266:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * Either change them in mbedtls_config.h, or define them using the compiler command line.
 267:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \{
 268:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  */
 269:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** 
 270:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** #if !defined(MBEDTLS_ECP_WINDOW_SIZE)
 271:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /*
 272:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * Maximum "window" size used for point multiplication.
 273:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * Default: a point where higher memory usage yields diminishing performance
 274:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *          returns.
 275:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * Minimum value: 2. Maximum value: 7.
 276:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 277:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * Result is an array of at most ( 1 << ( MBEDTLS_ECP_WINDOW_SIZE - 1 ) )
GAS LISTING /tmp/cc9fxdJq.s 			page 63


 278:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * points used for point multiplication. This value is directly tied to EC
 279:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * peak memory usage, so decreasing it by one should roughly cut memory usage
 280:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * by two (if large curves are in use).
 281:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 282:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * Reduction in size may reduce speed, but larger curves are impacted first.
 283:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * Sample performances (in ECDHE handshakes/s, with FIXED_POINT_OPTIM = 1):
 284:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *      w-size:     6       5       4       3       2
 285:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *      521       145     141     135     120      97
 286:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *      384       214     209     198     177     146
 287:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *      256       320     320     303     262     226
 288:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *      224       475     475     453     398     342
 289:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *      192       640     640     633     587     476
 290:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  */
 291:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** #define MBEDTLS_ECP_WINDOW_SIZE    4   /**< The maximum window size used. */
 292:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** #endif /* MBEDTLS_ECP_WINDOW_SIZE */
 293:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** 
 294:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** #if !defined(MBEDTLS_ECP_FIXED_POINT_OPTIM)
 295:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /*
 296:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * Trade code size for speed on fixed-point multiplication.
 297:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 298:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * This speeds up repeated multiplication of the generator (that is, the
 299:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * multiplication in ECDSA signatures, and half of the multiplications in
 300:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * ECDSA verification and ECDHE) by a factor roughly 3 to 4.
 301:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 302:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * For each n-bit Short Weierstrass curve that is enabled, this adds 4n bytes
 303:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * of code size if n < 384 and 8n otherwise.
 304:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 305:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * Change this value to 0 to reduce code size.
 306:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  */
 307:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** #define MBEDTLS_ECP_FIXED_POINT_OPTIM  1   /**< Enable fixed-point speed-up. */
 308:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** #endif /* MBEDTLS_ECP_FIXED_POINT_OPTIM */
 309:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** 
 310:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /** \} name SECTION: Module settings */
 311:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** 
 312:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** #else  /* MBEDTLS_ECP_ALT */
 313:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** #include "ecp_alt.h"
 314:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** #endif /* MBEDTLS_ECP_ALT */
 315:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** 
 316:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /**
 317:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * The maximum size of the groups, that is, of \c N and \c P.
