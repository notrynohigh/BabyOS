1472:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
1473:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Point doubling R = 2 P, Jacobian coordinates
1474:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1475:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Based on http://www.hyperelliptic.org/EFD/g1p/auto-shortw-jacobian.html#doubling-dbl-1998-cmo-2 
1476:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1477:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * We follow the variable naming fairly closely. The formula variations that trade a MUL for a SQR
1478:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * (plus a few ADDs) aren't useful as our bignum implementation doesn't distinguish squaring.
1479:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1480:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Standard optimizations are applied when curve parameter A is one of { 0, -3 }.
1481:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1482:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Cost: 1D := 3M + 4S          (A ==  0)
1483:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *             4M + 4S          (A == -3)
1484:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *             3M + 6S + 1a     otherwise
1485:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
1486:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static int ecp_double_jac(const mbedtls_ecp_group *grp, mbedtls_ecp_point *R,
1487:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                           const mbedtls_ecp_point *P,
1488:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                           mbedtls_mpi tmp[4])
1489:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
1490:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_SELF_TEST)
1491:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     dbl_count++;
1492:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif
1493:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1494:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_DOUBLE_JAC_ALT)
1495:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (mbedtls_internal_ecp_grp_capable(grp)) {
1496:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return mbedtls_internal_ecp_double_jac(grp, R, P);
1497:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1498:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif /* MBEDTLS_ECP_DOUBLE_JAC_ALT */
1499:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1500:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_NO_FALLBACK) && defined(MBEDTLS_ECP_DOUBLE_JAC_ALT)
1501:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;
1502:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #else
1503:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
1504:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1505:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* Special case for A = -3 */
1506:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (mbedtls_ecp_group_a_is_minus_3(grp)) {
1507:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* tmp[0] <- M = 3(X + Z^2)(X - Z^2) */
1508:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_SQR(&tmp[1],  &P->Z);
GAS LISTING /tmp/cc9fxdJq.s 			page 39


1509:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_ADD(&tmp[2],  &P->X,  &tmp[1]);
1510:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_SUB(&tmp[3],  &P->X,  &tmp[1]);
1511:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_MUL(&tmp[1],  &tmp[2],     &tmp[3]);
1512:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_MUL_INT(&tmp[0],  &tmp[1],     3);
1513:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     } else {
1514:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* tmp[0] <- M = 3.X^2 + A.Z^4 */
1515:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_SQR(&tmp[1],  &P->X);
1516:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MPI_ECP_MUL_INT(&tmp[0],  &tmp[1],  3);
1517:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1518:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* Optimize away for "koblitz" curves with A = 0 */
1519:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if (MPI_ECP_CMP_INT(&grp->A, 0) != 0) {
1520:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             /* M += A.Z^4 */
1521:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             MPI_ECP_SQR(&tmp[1],  &P->Z);
1522:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             MPI_ECP_SQR(&tmp[2],  &tmp[1]);
1523:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             MPI_ECP_MUL(&tmp[1],  &tmp[2],     &grp->A);
1524:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             MPI_ECP_ADD(&tmp[0],  &tmp[0],     &tmp[1]);
1525:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         }
1526:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1527:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1528:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* tmp[1] <- S = 4.X.Y^2 */
1529:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SQR(&tmp[2],  &P->Y);
1530:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SHIFT_L(&tmp[2],  1);
1531:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&tmp[1],  &P->X, &tmp[2]);
1532:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SHIFT_L(&tmp[1],  1);
1533:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1534:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* tmp[3] <- U = 8.Y^4 */
1535:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SQR(&tmp[3],  &tmp[2]);
1536:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SHIFT_L(&tmp[3],  1);
1537:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1538:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* tmp[2] <- T = M^2 - 2.S */
1539:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SQR(&tmp[2],  &tmp[0]);
1540:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SUB(&tmp[2],  &tmp[2], &tmp[1]);
1541:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SUB(&tmp[2],  &tmp[2], &tmp[1]);
1542:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1543:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* tmp[1] <- S = M(S - T) - U */
1544:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SUB(&tmp[1],  &tmp[1],     &tmp[2]);
1545:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&tmp[1],  &tmp[1],     &tmp[0]);
1546:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SUB(&tmp[1],  &tmp[1],     &tmp[3]);
1547:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1548:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* tmp[3] <- U = 2.Y.Z */
1549:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&tmp[3],  &P->Y,  &P->Z);
1550:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SHIFT_L(&tmp[3],  1);
1551:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1552:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* Store results */
1553:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MOV(&R->X, &tmp[2]);
1554:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MOV(&R->Y, &tmp[1]);
1555:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MOV(&R->Z, &tmp[3]);
1556:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1557:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** cleanup:
1558:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1559:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return ret;
1560:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif /* !defined(MBEDTLS_ECP_NO_FALLBACK) || !defined(MBEDTLS_ECP_DOUBLE_JAC_ALT) */
1561:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** }
