2037:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
2038:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Core multiplication algorithm for the (modified) comb method.
2039:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * This part is actually common with the basic comb method (GECC 3.44)
2040:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
2041:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Cost: d A + d D + 1 R
2042:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
2043:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static int ecp_mul_comb_core(const mbedtls_ecp_group *grp, mbedtls_ecp_point *R,
2044:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                              const mbedtls_ecp_point T[], unsigned char T_size,
2045:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                              const unsigned char x[], size_t d,
2046:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                              int (*f_rng)(void *, unsigned char *, size_t),
2047:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                              void *p_rng,
2048:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                              mbedtls_ecp_restart_ctx *rs_ctx)
2049:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
2050:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
2051:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_ecp_point Txi;
2052:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi tmp[4];
2053:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     size_t i;
2054:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2055:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_ecp_point_init(&Txi);
2056:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mpi_init_many(tmp, sizeof(tmp) / sizeof(mbedtls_mpi));
2057:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2058:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if !defined(MBEDTLS_ECP_RESTARTABLE)
2059:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     (void) rs_ctx;
2060:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif
2061:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2062:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_RESTARTABLE)
2063:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (rs_ctx != NULL && rs_ctx->rsm != NULL &&
2064:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         rs_ctx->rsm->state != ecp_rsm_comb_core) {
2065:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         rs_ctx->rsm->i = 0;
2066:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         rs_ctx->rsm->state = ecp_rsm_comb_core;
2067:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2068:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2069:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* new 'if' instead of nested for the sake of the 'else' branch */
2070:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (rs_ctx != NULL && rs_ctx->rsm != NULL && rs_ctx->rsm->i != 0) {
2071:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* restore current index (R already pointing to rs_ctx->rsm->R) */
2072:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         i = rs_ctx->rsm->i;
GAS LISTING /tmp/cc9fxdJq.s 			page 172


2073:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     } else
2074:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif
2075:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     {
2076:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* Start with a non-zero point and randomize its coordinates */
2077:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         i = d;
2078:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MBEDTLS_MPI_CHK(ecp_select_comb(grp, R, T, T_size, x[i]));
2079:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if (f_rng != 0) {
2080:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             MBEDTLS_MPI_CHK(ecp_randomize_jac(grp, R, f_rng, p_rng));
2081:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         }
2082:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2083:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2084:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     while (i != 0) {
2085:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MBEDTLS_ECP_BUDGET(MBEDTLS_ECP_OPS_DBL + MBEDTLS_ECP_OPS_ADD);
2086:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         --i;
2087:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2088:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MBEDTLS_MPI_CHK(ecp_double_jac(grp, R, R, tmp));
2089:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MBEDTLS_MPI_CHK(ecp_select_comb(grp, &Txi, T, T_size, x[i]));
2090:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MBEDTLS_MPI_CHK(ecp_add_mixed(grp, R, R, &Txi, tmp));
2091:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2092:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2093:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** cleanup:
2094:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2095:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_ecp_point_free(&Txi);
2096:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mpi_free_many(tmp, sizeof(tmp) / sizeof(mbedtls_mpi));
2097:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2098:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_RESTARTABLE)
2099:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (rs_ctx != NULL && rs_ctx->rsm != NULL &&
2100:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         ret == MBEDTLS_ERR_ECP_IN_PROGRESS) {
2101:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         rs_ctx->rsm->i = i;
2102:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* no need to save R, already pointing to rs_ctx->rsm->R */
2103:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2104:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif
2105:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2106:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return ret;
2107:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** }
2108:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2109:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
2110:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Recode the scalar to get constant-time comb multiplication
2111:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
2112:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * As the actual scalar recoding needs an odd scalar as a starting point,
2113:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * this wrapper ensures that by replacing m by N - m if necessary, and
2114:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * informs the caller that the result of multiplication will be negated.
2115:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
2116:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * This works because we only support large prime order for Short Weierstrass
2117:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * curves, so N is always odd hence either m or N - m is.
2118:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
2119:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * See ecp_comb_recode_core() for background.
