1453:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
1454:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Conditional point inversion: Q -> -Q = (Q.X, -Q.Y, Q.Z) without leak.
1455:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * "inv" must be 0 (don't invert) or 1 (invert) or the result will be invalid
1456:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
1457:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static int ecp_safe_invert_jac(const mbedtls_ecp_group *grp,
1458:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                                mbedtls_ecp_point *Q,
1459:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                                unsigned char inv)
1460:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
1461:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
1462:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi tmp;
1463:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi_init(&tmp);
1464:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1465:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_COND_NEG(&Q->Y, inv);
