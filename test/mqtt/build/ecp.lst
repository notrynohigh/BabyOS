2507:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return mbedtls_internal_ecp_double_add_mxz(grp, R, S, P, Q, d);
2508:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2509:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif /* MBEDTLS_ECP_DOUBLE_ADD_MXZ_ALT */
2510:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2511:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_NO_FALLBACK) && defined(MBEDTLS_ECP_DOUBLE_ADD_MXZ_ALT)
2512:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;
2513:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #else
