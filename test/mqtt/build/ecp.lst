GAS LISTING /tmp/cc9fxdJq.s 			page 34


1224:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
1225:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static int ecp_sw_rhs(const mbedtls_ecp_group *grp,
1226:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                       mbedtls_mpi *rhs,
1227:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                       const mbedtls_mpi *X)
