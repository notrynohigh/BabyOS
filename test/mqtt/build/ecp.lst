2496:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
2497:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Cost: 5M + 4S
2498:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
2499:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static int ecp_double_add_mxz(const mbedtls_ecp_group *grp,
2500:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                               mbedtls_ecp_point *R, mbedtls_ecp_point *S,
2501:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                               const mbedtls_ecp_point *P, const mbedtls_ecp_point *Q,
2502:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                               const mbedtls_mpi *d,
2503:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                               mbedtls_mpi T[4])
2504:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
2505:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_DOUBLE_ADD_MXZ_ALT)
