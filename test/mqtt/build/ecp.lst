2411:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
2412:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * For Montgomery curves, we do all the internal arithmetic in projective
2413:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * coordinates. Import/export of points uses only the x coordinates, which is
2414:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * internally represented as X / Z.
2415:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
2416:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * For scalar multiplication, we'll use a Montgomery ladder.
2417:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
2418:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2419:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
2420:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Normalize Montgomery x/z coordinates: X = X/Z, Z = 1
2421:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Cost: 1M + 1I
2422:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
2423:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static int ecp_normalize_mxz(const mbedtls_ecp_group *grp, mbedtls_ecp_point *P)
2424:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
2425:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_NORMALIZE_MXZ_ALT)
2426:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (mbedtls_internal_ecp_grp_capable(grp)) {
2427:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return mbedtls_internal_ecp_normalize_mxz(grp, P);
2428:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2429:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif /* MBEDTLS_ECP_NORMALIZE_MXZ_ALT */
2430:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2431:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_NO_FALLBACK) && defined(MBEDTLS_ECP_NORMALIZE_MXZ_ALT)
2432:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;
2433:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #else
2434:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
2435:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_INV(&P->Z, &P->Z);
2436:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&P->X, &P->X, &P->Z);
2437:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_LSET(&P->Z, 1);
2438:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
