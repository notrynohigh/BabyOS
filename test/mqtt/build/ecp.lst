1635:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SUB(&tmp[0], &tmp[0], &P->X);
1636:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SUB(&tmp[1], &tmp[1], &P->Y);
1637:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1638:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* Special cases (2) and (3) */
1639:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (MPI_ECP_CMP_INT(&tmp[0], 0) == 0) {
1640:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if (MPI_ECP_CMP_INT(&tmp[1], 0) == 0) {
1641:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             ret = ecp_double_jac(grp, R, P, tmp);
1642:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             goto cleanup;
1643:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         } else {
1644:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             ret = mbedtls_ecp_set_zero(R);
1645:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             goto cleanup;
1646:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         }
1647:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
