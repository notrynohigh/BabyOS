  82:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \warning This library does not support validation of arbitrary domain
  83:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * parameters. Therefore, only standardized domain parameters from trusted
  84:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * sources should be used. See mbedtls_ecp_group_load().
  85:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  */
  86:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /* Note: when adding a new curve:
  87:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * - Add it at the end of this enum, otherwise you'll break the ABI by
  88:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *   changing the numerical value for existing curves.
  89:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * - Increment MBEDTLS_ECP_DP_MAX below if needed.
  90:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * - Update the calculation of MBEDTLS_ECP_MAX_BITS below.
  91:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * - Add the corresponding MBEDTLS_ECP_DP_xxx_ENABLED macro definition to
  92:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *   mbedtls_config.h.
  93:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * - List the curve as a dependency of MBEDTLS_ECP_C and
  94:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *   MBEDTLS_ECDSA_C if supported in check_config.h.
  95:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * - Add the curve to the appropriate curve type macro
  96:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *   MBEDTLS_ECP_yyy_ENABLED above.
  97:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * - Add the necessary definitions to ecp_curves.c.
  98:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * - Add the curve to the ecp_supported_curves array in ecp.c.
