 456:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** 
 457:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** #if defined(MBEDTLS_ECP_RESTARTABLE)
 458:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /**
 459:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \brief           Set the maximum number of basic operations done in a row.
 460:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 461:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  If more operations are needed to complete a computation,
 462:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  #MBEDTLS_ERR_ECP_IN_PROGRESS will be returned by the
 463:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  function performing the computation. It is then the
 464:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  caller's responsibility to either call again with the same
 465:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  parameters until it returns 0 or an error code; or to free
 466:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  the restart context if the operation is to be aborted.
 467:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 468:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  It is strictly required that all input parameters and the
 469:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  restart context be the same on successive calls for the
 470:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  same operation, but output parameters need not be the
 471:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  same; they must not be used until the function finally
 472:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  returns 0.
 473:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 474:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  This only applies to functions whose documentation
 475:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  mentions they may return #MBEDTLS_ERR_ECP_IN_PROGRESS (or
 476:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS for functions in the
 477:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  SSL module). For functions that accept a "restart context"
 478:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  argument, passing NULL disables restart and makes the
 479:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  function equivalent to the function with the same name
 480:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  with \c _restartable removed. For functions in the ECDH
 481:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  module, restart is disabled unless the function accepts
 482:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  an "ECDH context" argument and
 483:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  mbedtls_ecdh_enable_restart() was previously called on
 484:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  that context. For function in the SSL module, restart is
 485:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  only enabled for specific sides and key exchanges
 486:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  (currently only for clients and ECDHE-ECDSA).
 487:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 488:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \warning         Using the PSA interruptible interfaces with keys in local
 489:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  storage and no accelerator driver will also call this
 490:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  function to set the values specified via those interfaces,
 491:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  overwriting values previously set. Care should be taken if
 492:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  mixing these two interfaces.
 493:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 494:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \param max_ops   Maximum number of basic operations done in a row.
 495:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  Default: 0 (unlimited).
 496:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  Lower (non-zero) values mean ECC functions will block for
 497:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  a lesser maximum amount of time.
 498:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 499:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \note            A "basic operation" is defined as a rough equivalent of a
 500:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  multiplication in GF(p) for the NIST P-256 curve.
 501:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  As an indication, with default settings, a scalar
 502:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  multiplication (full run of \c mbedtls_ecp_mul()) is:
 503:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  - about 3300 basic operations for P-256
 504:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  - about 9400 basic operations for P-384
 505:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
GAS LISTING /tmp/cc9fxdJq.s 			page 67


 506:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \note            Very low values are not always respected: sometimes
 507:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  functions need to block for a minimum number of
 508:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  operations, and will do so even if max_ops is set to a
 509:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  lower value.  That minimum depends on the curve size, and
 510:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  can be made lower by decreasing the value of
 511:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  \c MBEDTLS_ECP_WINDOW_SIZE.  As an indication, here is the
 512:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  lowest effective value for various curves and values of
 513:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  that parameter (w for short):
 514:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                          w=6     w=5     w=4     w=3     w=2
 515:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  P-256   208     208     160     136     124
 516:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  P-384   682     416     320     272     248
 517:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  P-521  1364     832     640     544     496
 518:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 519:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \note            This setting is currently ignored by Curve25519.
 520:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  */
 521:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** void mbedtls_ecp_set_max_ops(unsigned max_ops);
 522:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** 
 523:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /**
 524:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \brief           Check if restart is enabled (max_ops != 0)
 525:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 526:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \return          \c 0 if \c max_ops == 0 (restart disabled)
 527:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \return          \c 1 otherwise (restart enabled)
 528:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  */
 529:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** int mbedtls_ecp_restart_is_enabled(void);
 530:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** #endif /* MBEDTLS_ECP_RESTARTABLE */
