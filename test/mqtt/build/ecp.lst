  34:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /**
  35:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * \brief Function level alternative implementation.
  36:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
  37:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * The MBEDTLS_ECP_INTERNAL_ALT macro enables alternative implementations to
  38:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * replace certain functions in this module. The alternative implementations are
  39:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * typically hardware accelerators and need to activate the hardware before the
  40:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * computation starts and deactivate it after it finishes. The
  41:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * mbedtls_internal_ecp_init() and mbedtls_internal_ecp_free() functions serve
  42:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * this purpose.
  43:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
  44:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * To preserve the correct functionality the following conditions must hold:
  45:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
  46:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - The alternative implementation must be activated by
  47:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   mbedtls_internal_ecp_init() before any of the replaceable functions is
  48:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   called.
GAS LISTING /tmp/cc9fxdJq.s 			page 2


  49:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - mbedtls_internal_ecp_free() must \b only be called when the alternative
  50:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   implementation is activated.
  51:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - mbedtls_internal_ecp_init() must \b not be called when the alternative
  52:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   implementation is activated.
  53:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - Public functions must not return while the alternative implementation is
  54:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   activated.
  55:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - Replaceable functions are guarded by \c MBEDTLS_ECP_XXX_ALT macros and
  56:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   before calling them an \code if( mbedtls_internal_ecp_grp_capable( grp ) )
  57:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   \endcode ensures that the alternative implementation supports the current
  58:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   group.
  59:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
  60:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_INTERNAL_ALT)
  61:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif
