2444:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
2445:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Randomize projective x/z coordinates:
2446:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * (X, Z) -> (l X, l Z) for random l
2447:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * This is sort of the reverse operation of ecp_normalize_mxz().
2448:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
2449:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * This countermeasure was first suggested in [2].
2450:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Cost: 2M
2451:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
2452:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static int ecp_randomize_mxz(const mbedtls_ecp_group *grp, mbedtls_ecp_point *P,
2453:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                              int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)
2454:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
2455:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_RANDOMIZE_MXZ_ALT)
2456:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (mbedtls_internal_ecp_grp_capable(grp)) {
2457:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return mbedtls_internal_ecp_randomize_mxz(grp, P, f_rng, p_rng);
2458:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2459:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif /* MBEDTLS_ECP_RANDOMIZE_MXZ_ALT */
2460:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2461:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_NO_FALLBACK) && defined(MBEDTLS_ECP_RANDOMIZE_MXZ_ALT)
2462:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;
2463:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #else
2464:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
2465:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi l;
2466:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi_init(&l);
2467:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2468:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* Generate l such that 1 < l < p */
2469:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_RAND(&l);
2470:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2471:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&P->X, &P->X, &l);
2472:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&P->Z, &P->Z, &l);
2473:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2474:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** cleanup:
2475:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi_free(&l);
2476:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2477:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (ret == MBEDTLS_ERR_MPI_NOT_ACCEPTABLE) {
2478:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         ret = MBEDTLS_ERR_ECP_RANDOM_FAILED;
2479:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2480:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return ret;
2481:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif /* !defined(MBEDTLS_ECP_NO_FALLBACK) || !defined(MBEDTLS_ECP_RANDOMIZE_MXZ_ALT) */
2482:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** }
2483:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2484:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
2485:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Double-and-add: R = 2P, S = P + Q, with d = X(P - Q),
2486:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * for Montgomery curves in x/z coordinates.
2487:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
2488:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * http://www.hyperelliptic.org/EFD/g1p/auto-code/montgom/xz/ladder/mladd-1987-m.op3
2489:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * with
2490:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * d =  X1
2491:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * P = (X2, Z2)
2492:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Q = (X3, Z3)
2493:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * R = (X4, Z4)
2494:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * S = (X5, Z5)
2495:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * and eliminating temporary variables tO, ..., t4.
