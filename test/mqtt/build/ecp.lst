 938:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /**
 939:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \brief           This function performs a scalar multiplication of a point
 940:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  by an integer: \p R = \p m * \p P.
 941:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 942:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  It is not thread-safe to use same group in multiple threads.
 943:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
 944:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \note            To prevent timing attacks, this function
 945:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  executes the exact same sequence of base-field
 946:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  operations for any valid \p m. It avoids any if-branch or
 947:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  array index depending on the value of \p m. It also uses
 948:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *                  \p f_rng to randomize some intermediate results.
 949:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  *
