 243:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
 244:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Check if we can do the next step
 245:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
 246:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** int mbedtls_ecp_check_budget(const mbedtls_ecp_group *grp,
 247:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                              mbedtls_ecp_restart_ctx *rs_ctx,
 248:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                              unsigned ops)
 249:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
 250:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (rs_ctx != NULL && ecp_max_ops != 0) {
 251:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* scale depending on curve size: the chosen reference is 256-bit,
 252:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * and multiplication is quadratic. Round to the closest integer. */
 253:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if (grp->pbits >= 512) {
 254:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             ops *= 4;
 255:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         } else if (grp->pbits >= 384) {
 256:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             ops *= 2;
 257:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         }
 258:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
 259:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* Avoid infinite loops: always allow first step.
 260:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * Because of that, however, it's not generally true
 261:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * that ops_done <= ecp_max_ops, so the check
 262:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****          * ops_done > ecp_max_ops below is mandatory. */
 263:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if ((rs_ctx->ops_done != 0) &&
 264:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             (rs_ctx->ops_done > ecp_max_ops ||
 265:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****              ops > ecp_max_ops - rs_ctx->ops_done)) {
 266:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             return MBEDTLS_ERR_ECP_IN_PROGRESS;
 267:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         }
 268:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
 269:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* update running count */
 270:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         rs_ctx->ops_done += ops;
 271:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
 272:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
 273:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return 0;
 274:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** }
 275:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
 276:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /* Call this when entering a function that needs its own sub-context */
GAS LISTING /tmp/cc9fxdJq.s 			page 6


 277:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #define ECP_RS_ENTER(SUB)   do {                                      \
 278:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* reset ops count for this call if top-level */                    \
 279:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if (rs_ctx != NULL && rs_ctx->depth++ == 0)                        \
 280:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         rs_ctx->ops_done = 0;                                           \
 281:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                                                                         \
 282:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* set up our own sub-context if needed */                          \
 283:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if (mbedtls_ecp_restart_is_enabled() &&                             \
 284:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             rs_ctx != NULL && rs_ctx->SUB == NULL)                         \
 285:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         {                                                                   \
 286:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             rs_ctx->SUB = mbedtls_calloc(1, sizeof(*rs_ctx->SUB));      \
 287:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             if (rs_ctx->SUB == NULL)                                       \
 288:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             return MBEDTLS_ERR_ECP_ALLOC_FAILED;                     \
 289:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                                                                       \
 290:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             ecp_restart_## SUB ##_init(rs_ctx->SUB);                      \
 291:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         }                                                                   \
 292:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** } while (0)
 293:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
 294:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /* Call this when leaving a function that needs its own sub-context */
 295:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #define ECP_RS_LEAVE(SUB)   do {                                      \
 296:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         /* clear our sub-context when not in progress (done or error) */    \
 297:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if (rs_ctx != NULL && rs_ctx->SUB != NULL &&                        \
 298:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             ret != MBEDTLS_ERR_ECP_IN_PROGRESS)                            \
 299:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         {                                                                   \
 300:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             ecp_restart_## SUB ##_free(rs_ctx->SUB);                      \
 301:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             mbedtls_free(rs_ctx->SUB);                                    \
 302:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****             rs_ctx->SUB = NULL;                                             \
 303:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         }                                                                   \
 304:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                                                                         \
 305:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         if (rs_ctx != NULL)                                                \
 306:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         rs_ctx->depth--;                                                \
 307:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** } while (0)
 308:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
 309:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #else /* MBEDTLS_ECP_RESTARTABLE */
 310:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
 311:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #define ECP_RS_ENTER(sub)     (void) rs_ctx;
 312:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #define ECP_RS_LEAVE(sub)     (void) rs_ctx;
 313:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
 314:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif /* MBEDTLS_ECP_RESTARTABLE */
 315:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
 316:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_C)
 317:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static void mpi_init_many(mbedtls_mpi *arr, size_t size)
 318:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
 319:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     while (size--) {
 320:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         mbedtls_mpi_init(arr++);
