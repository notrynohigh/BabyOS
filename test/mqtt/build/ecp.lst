2217:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2218:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2219:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MBEDTLS_MPI_CHK(ecp_normalize_jac(grp, RR));
2220:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
2221:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_RESTARTABLE)
2222:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (rs_ctx != NULL && rs_ctx->rsm != NULL) {
2223:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         MBEDTLS_MPI_CHK(mbedtls_ecp_copy(R, RR));
2224:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
2225:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif
