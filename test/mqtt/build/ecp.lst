1281:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* sqrt(w) = w^((p+1)/4) mod p   (for prime p where p = 3 mod 4) */
1282:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_exp_mod(Y, Y /*y^2*/, &exp, &grp->P, NULL));
