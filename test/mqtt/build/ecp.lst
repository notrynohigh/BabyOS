 359:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h **** /**
 360:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ecp.h ****  * \brief           Internal restart context for multiplication
