1563:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** /*
1564:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Addition: R = P + Q, mixed affine-Jacobian coordinates (GECC 3.22)
1565:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
GAS LISTING /tmp/cc9fxdJq.s 			page 40


1566:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * The coordinates of Q must be normalized (= affine),
1567:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * but those of P don't need to. R is not normalized.
1568:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1569:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * P,Q,R may alias, but only at the level of EC points: they must be either
1570:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * equal as pointers, or disjoint (including the coordinate data buffers).
1571:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Fine-grained aliasing at the level of coordinates is not supported.
1572:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1573:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Special cases: (1) P or Q is zero, (2) R is zero, (3) P == Q.
1574:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * None of these cases can happen as intermediate step in ecp_mul_comb():
1575:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - at each step, P, Q and R are multiples of the base point, the factor
1576:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   being less than its order, so none of them is zero;
1577:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * - Q is an odd multiple of the base point, P an even multiple,
1578:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *   due to the choice of precomputed points in the modified comb method.
1579:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * So branches for these cases do not leak secret information.
1580:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  *
1581:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  * Cost: 1A := 8M + 3S
1582:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****  */
1583:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** static int ecp_add_mixed(const mbedtls_ecp_group *grp, mbedtls_ecp_point *R,
1584:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                          const mbedtls_ecp_point *P, const mbedtls_ecp_point *Q,
1585:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****                          mbedtls_mpi tmp[4])
1586:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** {
1587:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_SELF_TEST)
1588:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     add_count++;
1589:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif
1590:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1591:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_ADD_MIXED_ALT)
1592:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (mbedtls_internal_ecp_grp_capable(grp)) {
1593:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return mbedtls_internal_ecp_add_mixed(grp, R, P, Q);
1594:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1595:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #endif /* MBEDTLS_ECP_ADD_MIXED_ALT */
1596:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1597:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #if defined(MBEDTLS_ECP_NO_FALLBACK) && defined(MBEDTLS_ECP_ADD_MIXED_ALT)
1598:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;
1599:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** #else
1600:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
1601:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1602:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* NOTE: Aliasing between input and output is allowed, so one has to make
1603:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      *       sure that at the point X,Y,Z are written, {P,Q}->{X,Y,Z} are no
1604:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      *       longer read from. */
1605:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi * const X = &R->X;
1606:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi * const Y = &R->Y;
1607:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     mbedtls_mpi * const Z = &R->Z;
1608:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1609:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (!MPI_ECP_VALID(&Q->Z)) {
1610:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;
1611:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1612:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1613:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /*
1614:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * Trivial cases: P == 0 or Q == 0 (case 1)
1615:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      */
1616:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (MPI_ECP_CMP_INT(&P->Z, 0) == 0) {
1617:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return mbedtls_ecp_copy(R, Q);
1618:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1619:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1620:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (MPI_ECP_CMP_INT(&Q->Z, 0) == 0) {
1621:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return mbedtls_ecp_copy(R, P);
1622:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
GAS LISTING /tmp/cc9fxdJq.s 			page 41


1623:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1624:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /*
1625:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * Make sure Q coordinates are normalized
1626:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      */
1627:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     if (MPI_ECP_CMP_INT(&Q->Z, 1) != 0) {
1628:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****         return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;
1629:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     }
1630:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c **** 
1631:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_SQR(&tmp[0], &P->Z);
1632:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&tmp[1], &tmp[0], &P->Z);
1633:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MPI_ECP_MUL(&tmp[0], &tmp[0], &Q->X);
