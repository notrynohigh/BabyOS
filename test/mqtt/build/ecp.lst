2955:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     /* Reduce X mod P so that we only need to check values less than P.
2956:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****      * We know X < 2^256 so we can proceed by subtraction. */
2957:../../bos/thirdparty/mbedtls/bos_mbedtls/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&XmP, X));
