 509:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c **** 
 510:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c **** /* Return a "good" nonce length for CTR_DRBG. The chosen nonce length
 511:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****  * is sufficient to achieve the maximum security strength given the key
 512:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****  * size and entropy length. If there is enough entropy in the initial
 513:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****  * call to the entropy function to serve as both the entropy input and
 514:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****  * the nonce, don't make a second call to get a nonce. */
 515:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c **** static size_t good_nonce_len(size_t entropy_len)
 516:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c **** {
 517:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****     if (entropy_len >= MBEDTLS_CTR_DRBG_KEYSIZE * 3 / 2) {
 518:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****         return 0;
 519:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****     } else {
 520:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****         return (entropy_len + 1) / 2;
 521:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****     }
