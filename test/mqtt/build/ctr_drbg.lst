  28:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** /*
  29:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * __ARM_FEATURE_UNALIGNED is defined where appropriate by armcc, gcc 7, clang 9
  30:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * (and later versions) for Arm v7 and later; all x86 platforms should have
  31:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * efficient unaligned access.
  32:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  33:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * https://learn.microsoft.com/en-us/cpp/build/arm64-windows-abi-conventions?view=msvc-170#alignmen
  34:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * specifies that on Windows-on-Arm64, unaligned access is safe (except for uncached
  35:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * device memory).
  36:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  */
  37:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** #define MBEDTLS_EFFICIENT_UNALIGNED_ACCESS
