 192:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****     /*
 193:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****      * Construct IV (16 bytes) and S in buffer
 194:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****      * IV = Counter (in 32-bits) padded to 16 with zeroes
 195:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****      * S = Length input string (in 32-bits) || Length of output (in 32-bits) ||
 196:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****      *     data || 0x80
 197:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****      *     (Total is padded to a multiple of 16-bytes with zeroes)
 198:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****      */
 199:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****     p = buf + MBEDTLS_CTR_DRBG_BLOCKSIZE;
 200:../../bos/thirdparty/mbedtls/bos_mbedtls/ctr_drbg.c ****     MBEDTLS_PUT_UINT32_BE(data_len, p, 0);
