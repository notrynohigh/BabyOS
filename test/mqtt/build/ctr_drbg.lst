  40:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** #if defined(__IAR_SYSTEMS_ICC__) && \
  41:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****     (defined(MBEDTLS_ARCH_IS_ARM64) || defined(MBEDTLS_ARCH_IS_ARM32) \
  42:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****     || defined(__ICCRX__) || defined(__ICCRL78__) || defined(__ICCRISCV__))
