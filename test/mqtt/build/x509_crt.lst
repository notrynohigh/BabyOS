2436:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Check if an end-entity certificate is locally trusted
2437:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2438:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Currently we require such certificates to be self-signed (actually only
2439:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * check for self-issued as self-signatures are not checked)
2440:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  */
2441:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c **** static int x509_crt_check_ee_locally_trusted(
2442:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     mbedtls_x509_crt *crt,
