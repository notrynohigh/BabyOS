2209:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c **** /*
2210:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Find a suitable parent for child in candidates, or return NULL.
2211:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2212:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Here suitable is defined as:
2213:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  1. subject name matches child's issuer
2214:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  2. if necessary, the CA bit is set and key usage allows signing certs
2215:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  3. for trusted roots, the signature is correct
2216:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *     (for intermediates, the signature is checked and the result reported)
2217:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  4. pathlen constraints are satisfied
2218:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2219:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * If there's a suitable candidate which is also time-valid, return the first
2220:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * such. Otherwise, return the first suitable candidate (or NULL if there is
2221:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * none).
2222:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2223:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * The rationale for this rule is that someone could have a list of trusted
2224:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * roots with two versions on the same root with different validity periods.
2225:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * (At least one user reported having such a list and wanted it to just work.)
2226:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * The reason we don't just require time-validity is that generally there is
2227:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * only one version, and if it's expired we want the flags to state that
2228:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * rather than NOT_TRUSTED, as would be the case if we required it here.
2229:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2230:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * The rationale for rule 3 (signature for trusted roots) is that users might
2231:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * have two versions of the same CA with different keys in their list, and the
2232:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * way we select the correct one is by checking the signature (as we don't
2233:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * rely on key identifier extensions). (This is one way users might choose to
2234:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * handle key rollover, another relies on self-issued certs, see [SIRO].)
2235:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2236:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Arguments:
2237:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [in] child: certificate for which we're looking for a parent
2238:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [in] candidates: chained list of potential parents
2239:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [out] r_parent: parent found (or NULL)
2240:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [out] r_signature_is_good: 1 if child signature by parent is valid, or 0
2241:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [in] top: 1 if candidates consists of trusted roots, ie we're at the top
2242:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *         of the chain, 0 otherwise
2243:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [in] path_cnt: number of intermediates seen so far
2244:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [in] self_cnt: number of self-signed intermediates seen so far
2245:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *         (will never be greater than path_cnt)
2246:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [in-out] rs_ctx: context for restarting operations
2247:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2248:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Return value:
2249:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - 0 on success
2250:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - MBEDTLS_ERR_ECP_IN_PROGRESS otherwise
2251:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  */
2252:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c **** static int x509_crt_find_parent_in(
2253:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     mbedtls_x509_crt *child,
2254:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     mbedtls_x509_crt *candidates,
GAS LISTING /tmp/ccqNaP2E.s 			page 52


