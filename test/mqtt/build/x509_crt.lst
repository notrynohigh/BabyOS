2444:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c **** {
2445:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     mbedtls_x509_crt *cur;
2446:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c **** 
2447:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     /* must be self-issued */
