2464:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c **** /*
2465:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Build and verify a certificate chain
2466:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2467:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Given a peer-provided list of certificates EE, C1, ..., Cn and
2468:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * a list of trusted certs R1, ... Rp, try to build and verify a chain
2469:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *      EE, Ci1, ... Ciq [, Rj]
2470:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * such that every cert in the chain is a child of the next one,
2471:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * jumping to a trusted root as early as possible.
2472:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2473:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Verify that chain and return it with flags for all issues found.
2474:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2475:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Special cases:
2476:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * - EE == Rj -> return a one-element list containing it
2477:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * - EE, Ci1, ..., Ciq cannot be continued with a trusted root
2478:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *   -> return that chain with NOT_TRUSTED set on Ciq
2479:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2480:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Tests for (aspects of) this function should include at least:
2481:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * - trusted EE
2482:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * - EE -> trusted root
GAS LISTING /tmp/ccqNaP2E.s 			page 56


2483:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * - EE -> intermediate CA -> trusted root
2484:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * - if relevant: EE untrusted
2485:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * - if relevant: EE -> intermediate, untrusted
2486:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * with the aspect under test checked at each relevant level (EE, int, root).
2487:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * For some aspects longer chains are required, but usually length 2 is
2488:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * enough (but length 1 is not in general).
2489:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2490:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Arguments:
2491:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [in] crt: the cert list EE, C1, ..., Cn
2492:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [in] trust_ca: the trusted list R1, ..., Rp
2493:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [in] ca_crl, profile: as in verify_with_profile()
2494:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [out] ver_chain: the built and verified chain
2495:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *      Only valid when return value is 0, may contain garbage otherwise!
2496:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *      Restart note: need not be the same when calling again to resume.
2497:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - [in-out] rs_ctx: context for restarting operations
2498:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *
2499:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  * Return value:
2500:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - non-zero if the chain could not be fully built and examined
2501:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *  - 0 is the chain was successfully built and examined,
2502:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  *      even if it was found to be invalid
2503:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****  */
2504:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c **** static int x509_crt_verify_chain(
2505:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     mbedtls_x509_crt *crt,
2506:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     mbedtls_x509_crt *trust_ca,
2507:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     mbedtls_x509_crl *ca_crl,
2508:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     mbedtls_x509_crt_ca_cb_t f_ca_cb,
2509:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     void *p_ca_cb,
2510:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     const mbedtls_x509_crt_profile *profile,
2511:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     mbedtls_x509_crt_verify_chain *ver_chain,
2512:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     mbedtls_x509_crt_restart_ctx *rs_ctx)
2513:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c **** {
2514:../../bos/thirdparty/mbedtls/bos_mbedtls/x509_crt.c ****     /* Don't initialize any of those variables here, so that the compiler can
