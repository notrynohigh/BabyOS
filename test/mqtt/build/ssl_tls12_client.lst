1515:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /**
1516:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * Get the first defined opaque PSK by order of precedence:
1517:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * 1. handshake PSK set by \c mbedtls_ssl_set_hs_psk_opaque() in the PSK
1518:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *    callback
1519:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * 2. static PSK configured by \c mbedtls_ssl_conf_psk_opaque()
1520:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * Return an opaque PSK
1521:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
1522:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** static inline mbedtls_svc_key_id_t mbedtls_ssl_get_opaque_psk(
1523:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     const mbedtls_ssl_context *ssl)
1524:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** {
