2539:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *  Since we only support a single certificate on clients, let's just
2540:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *  ignore all the information that's supposed to help us pick a
2541:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *  certificate.
2542:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *
2543:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *  We could check that our certificate matches the request, and bail out
2544:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *  if it doesn't, but it's simpler to just send the certificate anyway,
2545:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *  and give the server the opportunity to decide if it should terminate
2546:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *  the connection when it doesn't like our certificate.
2547:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *
2548:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *  Same goes for the hash in TLS 1.2's signature_algorithms: at this
2549:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *  point we only have one hash available (see comments in
2550:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *  write_certificate_verify), so let's just use what we have.
2551:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *
2552:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *  However, we still minimally parse the message to check it is at least
2553:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *  superficially sane.
2554:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      */
2555:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****     buf = ssl->in_msg;
2556:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c **** 
2557:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****     /* certificate_types */
2558:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****     if (ssl->in_hslen <= mbedtls_ssl_hs_hdr_len(ssl)) {
2559:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         MBEDTLS_SSL_DEBUG_MSG(1, ("bad certificate request message"));
2560:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,
2561:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****                                        MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR);
2562:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         return MBEDTLS_ERR_SSL_DECODE_ERROR;
2563:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****     }
2564:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****     cert_type_len = buf[mbedtls_ssl_hs_hdr_len(ssl)];
2565:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****     n = cert_type_len;
2566:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c **** 
