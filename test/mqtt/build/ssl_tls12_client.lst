 566:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     do {                                                                        \
 567:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****         if (mbedtls_ssl_chk_buf_ptr((cur), (end), (need)) != 0)        \
 568:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****         {                                                                       \
 569:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****             MBEDTLS_SSL_DEBUG_MSG(1,                                           \
 570:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                                   ("missing input data in %s", __func__));  \
