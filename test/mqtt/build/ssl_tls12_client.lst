2572:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      * Both reach at most the index:
2573:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      *    ...hdr_len + 2 + n,
2574:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      * therefore the buffer length at this point must be greater than that
2575:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      * regardless of the actual code path.
2576:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      */
2577:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****     if (ssl->in_hslen <= mbedtls_ssl_hs_hdr_len(ssl) + 2 + n) {
2578:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         MBEDTLS_SSL_DEBUG_MSG(1, ("bad certificate request message"));
2579:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,
