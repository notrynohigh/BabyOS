2587:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****     /*
2588:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****      * The furthest access in buf is in the loop few lines below:
