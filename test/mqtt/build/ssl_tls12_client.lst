 533:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /**
 534:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \brief        This macro checks if the remaining size in a buffer is
 535:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               greater or equal than a needed space. If it is not the case,
 536:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               it returns an SSL_BUFFER_TOO_SMALL error.
 537:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 538:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \param cur    Pointer to the current position in the buffer.
 539:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \param end    Pointer to one past the end of the buffer.
 540:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \param need   Needed space in bytes.
 541:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 542:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
 543:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #define MBEDTLS_SSL_CHK_BUF_PTR(cur, end, need)                        \
 544:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     do {                                                                 \
 545:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****         if (mbedtls_ssl_chk_buf_ptr((cur), (end), (need)) != 0) \
 546:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****         {                                                                \
 547:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****             return MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL;                  \
 548:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****         }                                                                \
 549:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     } while (0)
 550:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
 551:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /**
 552:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \brief        This macro checks if the remaining length in an input buffer is
 553:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               greater or equal than a needed length. If it is not the case, it
 554:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               returns #MBEDTLS_ERR_SSL_DECODE_ERROR error and pends a
 555:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               #MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR alert message.
 556:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 557:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               This is a function-like macro. It is guaranteed to evaluate each
 558:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               argument exactly once.
 559:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 560:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \param cur    Pointer to the current position in the buffer.
 561:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \param end    Pointer to one past the end of the buffer.
 562:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \param need   Needed length in bytes.
 563:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 564:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
GAS LISTING /tmp/ccQOFOgI.s 			page 142


