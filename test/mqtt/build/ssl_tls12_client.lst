2976:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****             handshake->xxdh_psa_privkey = MBEDTLS_SVC_KEY_ID_INIT;
2977:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****             return PSA_TO_MBEDTLS_ERR(status);
2978:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         }
2979:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c **** 
