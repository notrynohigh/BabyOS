1122:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     size_t ivlen;                       /*!<  IV length               */
1123:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     size_t fixed_ivlen;                 /*!<  Fixed part of IV (AEAD) */
1124:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     size_t maclen;                      /*!<  MAC(CBC) len            */
1125:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     size_t taglen;                      /*!<  TAG(AEAD) len           */
