2943:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         /* The master secret is obtained from the shared ECDH secret by
2944:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****          * applying the TLS 1.2 PRF with a specific salt and label. While
2945:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****          * the PSA Crypto API encourages combining key agreement schemes
2946:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****          * such as ECDH with fixed KDFs such as TLS 1.2 PRF, it does not
2947:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****          * yet support the provisioning of salt + label to the KDF.
2948:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****          * For the time being, we therefore need to split the computation
2949:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****          * of the ECDH secret and the application of the TLS 1.2 PRF. */
2950:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         key_attributes = psa_key_attributes_init();
2951:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         psa_set_key_usage_flags(&key_attributes, PSA_KEY_USAGE_DERIVE);
2952:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         psa_set_key_algorithm(&key_attributes, PSA_ALG_ECDH);
