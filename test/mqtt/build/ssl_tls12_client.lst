2960:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****             return PSA_TO_MBEDTLS_ERR(status);
2961:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         }
2962:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c **** 
2963:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         /* Export the public part of the ECDH private key from PSA.
2964:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****          * The export format is an ECPoint structure as expected by TLS,
2965:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****          * but we just need to add a length byte before that. */
2966:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         unsigned char *own_pubkey = p + 1;
