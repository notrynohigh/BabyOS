3323:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****     } else {
3324:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         md_alg = MBEDTLS_MD_SHA256;
3325:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         ssl->out_msg[4] = MBEDTLS_SSL_HASH_SHA256;
3326:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****     }
3327:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****     ssl->out_msg[5] = mbedtls_ssl_sig_from_pk(mbedtls_ssl_own_key(ssl));
