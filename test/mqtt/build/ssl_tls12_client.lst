 586:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /* cipher.h exports the maximum IV, key and block length from
 587:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * all ciphers enabled in the config, regardless of whether those
 588:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * ciphers are actually usable in SSL/TLS. Notably, XTS is enabled
 589:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * in the default configuration and uses 64 Byte keys, but it is
 590:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * not used for record protection in SSL/TLS.
 591:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 592:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * In order to prevent unnecessary inflation of key structures,
 593:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * we introduce SSL-specific variants of the max-{key,block,IV}
 594:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * macros here which are meant to only take those ciphers into
 595:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * account which can be negotiated in SSL/TLS.
 596:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 597:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * Since the current definitions of MBEDTLS_MAX_{KEY|BLOCK|IV}_LENGTH
 598:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * in cipher.h are rough overapproximations of the real maxima, here
 599:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * we content ourselves with replicating those overapproximations
 600:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * for the maximum block and IV length, and excluding XTS from the
 601:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * computation of the maximum key length. */
 602:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #define MBEDTLS_SSL_MAX_BLOCK_LENGTH 16
 603:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #define MBEDTLS_SSL_MAX_IV_LENGTH    16
 604:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #define MBEDTLS_SSL_MAX_KEY_LENGTH   32
 605:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
 606:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /**
 607:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \brief   The data structure holding the cryptographic material (key and IV)
 608:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *          used for record protection in TLS 1.3.
 609:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
 610:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** struct mbedtls_ssl_key_set {
 611:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     /*! The key for client->server records. */
 612:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     unsigned char client_write_key[MBEDTLS_SSL_MAX_KEY_LENGTH];
 613:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     /*! The key for server->client records. */
 614:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     unsigned char server_write_key[MBEDTLS_SSL_MAX_KEY_LENGTH];
 615:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     /*! The IV  for client->server records. */
 616:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     unsigned char client_write_iv[MBEDTLS_SSL_MAX_IV_LENGTH];
 617:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     /*! The IV  for server->client records. */
 618:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     unsigned char server_write_iv[MBEDTLS_SSL_MAX_IV_LENGTH];
 619:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
 620:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     size_t key_len; /*!< The length of client_write_key and
 621:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                      *   server_write_key, in Bytes. */
GAS LISTING /tmp/ccQOFOgI.s 			page 143


 622:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     size_t iv_len;  /*!< The length of client_write_iv and
 623:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                      *   server_write_iv, in Bytes. */
 624:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** };
 625:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** typedef struct mbedtls_ssl_key_set mbedtls_ssl_key_set;
