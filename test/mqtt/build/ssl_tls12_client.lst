2968:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         size_t own_pubkey_max_len = (size_t) (end - own_pubkey);
2969:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         size_t own_pubkey_len = 0;
2970:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c **** 
2971:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         status = psa_export_public_key(handshake->xxdh_psa_privkey,
2972:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****                                        own_pubkey, own_pubkey_max_len,
2973:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****                                        &own_pubkey_len);
2974:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls12_client.c ****         if (status != PSA_SUCCESS) {
