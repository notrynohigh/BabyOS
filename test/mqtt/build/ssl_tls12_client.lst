1527:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     }
1528:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
1529:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     if (!mbedtls_svc_key_id_is_null(ssl->conf->psk_opaque)) {
