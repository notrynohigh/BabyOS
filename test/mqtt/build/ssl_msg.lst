 778:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ctx      Context for the receive callback (typically a file
 779:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 descriptor)
 780:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param buf      Buffer to write the received data to
 781:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param len      Length of the receive buffer
 782:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
 783:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \returns        If data has been received, the positive number of bytes received.
 784:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \returns        \c 0 if the connection has been closed.
 785:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \returns        If performing non-blocking I/O, \c MBEDTLS_ERR_SSL_WANT_READ
 786:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 must be returned when the operation would block.
