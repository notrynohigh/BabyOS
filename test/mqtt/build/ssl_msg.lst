2650:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2651:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note            On client, use \c mbedtls_ssl_conf_session_tickets().
2652:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2653:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf      SSL configuration context
