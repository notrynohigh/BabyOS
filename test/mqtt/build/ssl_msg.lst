3026:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set client's transport-level identification info.
3027:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Server only. DTLS only.)
3028:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3029:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This is usually the IP address (and port), but could be
3030:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 anything identify the client depending on the underlying
3031:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 network stack. Used for HelloVerifyRequest with DTLS.
3032:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This is *not* used to route the actual packets.
3033:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3034:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl      SSL context
3035:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param info     Transport-level info identifying the client (eg IP + port)
