2664:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2665:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief Get the creation time of a session ticket.
2666:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2667:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note See the documentation of \c ticket_creation_time for information about
2668:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *       the intended usage of this function.
2669:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2670:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param session  SSL session
2671:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ticket_creation_time  On exit, holds the ticket creation time in
2672:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                              milliseconds.
2673:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2674:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         0 on success,
2675:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 MBEDTLS_ERR_SSL_BAD_INPUT_DATA if an input is not valid.
