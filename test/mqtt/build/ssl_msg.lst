2190:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****                 MBEDTLS_SSL_DEBUG_MSG(2, ("next record in same datagram, offset: %"
2191:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****                                           MBEDTLS_PRINTF_SIZET,
2192:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****                                           ssl->next_record_offset));
