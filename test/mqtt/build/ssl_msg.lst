1086:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
1087:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief           Callback type: resume external operation.
1088:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1089:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  This callback is called during an SSL handshake to resume
1090:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  an external operation started by the
1091:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  ::mbedtls_ssl_async_sign_t or
1092:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  ::mbedtls_ssl_async_decrypt_t callback.
1093:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1094:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  This function typically checks the status of a pending
1095:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  request or causes the request queue to make progress, and
1096:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  does not wait for the operation to complete. This allows
1097:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  the handshake step to be non-blocking.
1098:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1099:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  This function may call mbedtls_ssl_get_async_operation_data()
1100:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  to retrieve an operation context set by the start callback.
1101:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  It may call mbedtls_ssl_set_async_operation_data() to modify
1102:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  this context.
1103:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1104:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  Note that when this function returns a status other than
GAS LISTING /tmp/ccmtdssg.s 			page 271


1105:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS, it must free any
1106:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  resources associated with the operation.
1107:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1108:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl             The SSL connection instance. It should not be
1109:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        modified other than via
1110:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        mbedtls_ssl_set_async_operation_data().
1111:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param output          Buffer containing the output (signature or decrypted
1112:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        data) on success.
1113:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param output_len      On success, number of bytes written to \p output.
1114:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param output_size     Size of the \p output buffer in bytes.
1115:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1116:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return          0 if output of the operation is available in the
