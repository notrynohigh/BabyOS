4609:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** static int ssl_consume_current_message(mbedtls_ssl_context *ssl)
4610:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** {
4611:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /*
4612:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * Consume last content-layer message and potentially
4613:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * update in_msglen which keeps track of the contents'
4614:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * consumption state.
4615:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
4616:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * (1) Handshake messages:
4617:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *     Remove last handshake message, move content
4618:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *     and adapt in_msglen.
4619:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
4620:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * (2) Alert messages:
4621:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *     Consume whole record content, in_msglen = 0.
4622:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
4623:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * (3) Change cipher spec:
4624:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *     Consume whole record content, in_msglen = 0.
4625:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
4626:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * (4) Application data:
4627:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *     Don't do anything - the record layer provides
4628:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *     the application data as a stream transport
4629:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *     and consumes through mbedtls_ssl_read only.
GAS LISTING /tmp/ccmtdssg.s 			page 179


4630:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
4631:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      */
4632:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
4633:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /* Case (1): Handshake messages */
4634:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     if (ssl->in_hslen != 0) {
4635:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         /* Hard assertion to be sure that no application data
4636:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          * is in flight, as corrupting ssl->in_msglen during
4637:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          * ssl->in_offt != NULL is fatal. */
4638:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         if (ssl->in_offt != NULL) {
4639:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****             MBEDTLS_SSL_DEBUG_MSG(1, ("should never happen"));
4640:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****             return MBEDTLS_ERR_SSL_INTERNAL_ERROR;
4641:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         }
4642:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
4643:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         /*
4644:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          * Get next Handshake message in the current record
4645:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          */
4646:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
4647:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         /* Notes:
4648:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          * (1) in_hslen is not necessarily the size of the
4649:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     current handshake content: If DTLS handshake
4650:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     fragmentation is used, that's the fragment
4651:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     size instead. Using the total handshake message
4652:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     size here is faulty and should be changed at
4653:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     some point.
4654:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          * (2) While it doesn't seem to cause problems, one
4655:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     has to be very careful not to assume that in_hslen
4656:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     is always <= in_msglen in a sensible communication.
4657:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     Again, it's wrong for DTLS handshake fragmentation.
4658:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     The following check is therefore mandatory, and
4659:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     should not be treated as a silently corrected assertion.
4660:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     Additionally, ssl->in_hslen might be arbitrarily out of
4661:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     bounds after handling a DTLS message with an unexpected
4662:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          *     sequence number, see mbedtls_ssl_prepare_handshake_record.
4663:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          */
4664:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         if (ssl->in_hslen < ssl->in_msglen) {
4665:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****             ssl->in_msglen -= ssl->in_hslen;
4666:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****             memmove(ssl->in_msg, ssl->in_msg + ssl->in_hslen,
4667:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****                     ssl->in_msglen);
4668:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
4669:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****             MBEDTLS_SSL_DEBUG_BUF(4, "remaining content in record",
4670:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****                                   ssl->in_msg, ssl->in_msglen);
4671:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         } else {
4672:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****             ssl->in_msglen = 0;
4673:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         }
4674:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
4675:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         ssl->in_hslen   = 0;
4676:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     }
4677:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /* Case (4): Application data */
4678:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     else if (ssl->in_offt != NULL) {
4679:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         return 0;
4680:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     }
4681:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /* Everything else (CCS & Alerts) */
