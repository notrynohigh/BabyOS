3859:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3860:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the allowed groups in order of preference.
3861:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3862:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 On server: This only affects the choice of key agreement mechanism
3863:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3864:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 On client: this affects the list of groups offered for any
3865:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 use. The server can override our preference order.
3866:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3867:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Both sides: limits the set of groups accepted for use in
3868:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 key sharing.
3869:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3870:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This function replaces the deprecated mbedtls_ssl_conf_curves(),
3871:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 which only allows ECP curves to be configured.
3872:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3873:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           The most recent invocation of either mbedtls_ssl_conf_curves()
3874:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 or mbedtls_ssl_conf_groups() nullifies all previous invocations
3875:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 of both.
3876:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3877:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This list should be ordered by decreasing preference
3878:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (preferred group first).
3879:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3880:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           When this function is not called, a default list is used,
3881:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 consisting of all supported curves at 255 bits and above,
3882:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 and all supported finite fields at 2048 bits and above.
3883:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 The order favors groups with the lowest resource usage.
3884:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3885:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           New minor versions of Mbed TLS will not remove items
3886:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 from the default list unless serious security concerns require it.
3887:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 New minor versions of Mbed TLS may change the order in
3888:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 keeping with the general principle of favoring the lowest
3889:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 resource usage.
3890:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3891:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
3892:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param groups   List of allowed groups ordered by preference, terminated by 0.
3893:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Must contain valid IANA NamedGroup IDs (provided via either an integer
3894:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 or using MBEDTLS_TLS1_3_NAMED_GROUP_XXX macros).
3895:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3896:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_groups(mbedtls_ssl_config *conf,
3897:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              const uint16_t *groups);
