 488:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
 489:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /* Implement the final paragraph of RFC 6347 section 4.1.1.1
 490:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * in the following way: after the initial transmission and a first
 491:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * retransmission, back off to a temporary estimated MTU of 508 bytes.
 492:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * This value is guaranteed to be deliverable (if not guaranteed to be
 493:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * delivered) of any compliant IPv4 (and IPv6) network, and should work
 494:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * on most non-IP stacks too. */
 495:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     if (ssl->handshake->retransmit_timeout != ssl->conf->hs_timeout_min) {
 496:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         ssl->handshake->mtu = 508;
 497:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         MBEDTLS_SSL_DEBUG_MSG(2, ("mtu autoreduction to %d bytes", ssl->handshake->mtu));
 498:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     }
 499:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
 500:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     new_timeout = 2 * ssl->handshake->retransmit_timeout;
