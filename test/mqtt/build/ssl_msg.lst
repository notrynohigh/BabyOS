3701:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This should only be called inside the PSK callback,
3702:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 i.e. the function passed to \c mbedtls_ssl_conf_psk_cb().
3703:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3704:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           An opaque PSK set by this function takes precedence over an
3705:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 opaque PSK configured by \c mbedtls_ssl_conf_psk_opaque().
3706:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3707:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl      The SSL context to configure a PSK for.
