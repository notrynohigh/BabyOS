2589:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2590:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief           Callback type: generate and write session ticket
2591:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2592:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note            This describes what a callback implementation should do.
2593:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  This callback should generate an encrypted and
2594:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  authenticated ticket for the session and write it to the
2595:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  output buffer. Here, ticket means the opaque ticket part
2596:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  of the NewSessionTicket structure of RFC 5077.
2597:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2598:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param p_ticket  Context for the callback
2599:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param session   SSL session to be written in the ticket
2600:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param start     Start of the output buffer
2601:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param end       End of the output buffer
2602:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param tlen      On exit, holds the length written
2603:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param lifetime  On exit, holds the lifetime of the ticket in seconds
2604:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2605:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return          0 if successful, or
2606:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  a specific MBEDTLS_ERR_XXX code.
2607:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2608:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** typedef int mbedtls_ssl_ticket_write_t(void *p_ticket,
2609:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                        const mbedtls_ssl_session *session,
2610:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                        unsigned char *start,
2611:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                        const unsigned char *end,
2612:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                        size_t *tlen,
2613:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                        uint32_t *lifetime);
2614:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
2615:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2616:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief           Callback type: parse and load session ticket
2617:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2618:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note            This describes what a callback implementation should do.
2619:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  This callback should parse a session ticket as generated
2620:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  by the corresponding mbedtls_ssl_ticket_write_t function,
2621:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  and, if the ticket is authentic and valid, load the
2622:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  session.
2623:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2624:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note            The implementation is allowed to modify the first len
2625:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  bytes of the input buffer, eg to use it as a temporary
2626:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  area for the decrypted ticket contents.
2627:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2628:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param p_ticket  Context for the callback
2629:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param session   SSL session to be loaded
2630:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param buf       Start of the buffer containing the ticket
2631:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param len       Length of the ticket.
2632:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2633:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return          0 if successful, or
2634:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  MBEDTLS_ERR_SSL_INVALID_MAC if not authentic, or
2635:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  MBEDTLS_ERR_SSL_SESSION_TICKET_EXPIRED if expired, or
2636:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  any other non-zero code for other failures.
2637:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2638:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** typedef int mbedtls_ssl_ticket_parse_t(void *p_ticket,
2639:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                        mbedtls_ssl_session *session,
2640:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                        unsigned char *buf,
2641:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                        size_t len);
