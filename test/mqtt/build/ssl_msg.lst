2051:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2052:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the certificate verification mode
2053:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Default: NONE on server, REQUIRED on client
2054:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2055:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
2056:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param authmode can be:
2057:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2058:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  MBEDTLS_SSL_VERIFY_NONE:      peer certificate is not checked
2059:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        (default on server)
2060:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        (insecure on client)
2061:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2062:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  MBEDTLS_SSL_VERIFY_OPTIONAL:  peer certificate is checked, however the
2063:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        handshake continues even if verification failed;
2064:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        mbedtls_ssl_get_verify_result() can be called after the
2065:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        handshake is complete.
2066:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2067:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  MBEDTLS_SSL_VERIFY_REQUIRED:  peer *must* present a valid certificate,
2068:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        handshake is aborted if verification failed.
2069:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        (default on client)
2070:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2071:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note On client, MBEDTLS_SSL_VERIFY_REQUIRED is the recommended mode.
2072:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * With MBEDTLS_SSL_VERIFY_OPTIONAL, the user needs to call mbedtls_ssl_get_verify_result() at
2073:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * the right time(s), which may not be obvious, while REQUIRED always perform
GAS LISTING /tmp/ccmtdssg.s 			page 288


2074:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * the verification as soon as possible. For example, REQUIRED was protecting
2075:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * against the "triple handshake" attack even before it was found.
2076:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2077:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_authmode(mbedtls_ssl_config *conf, int authmode);
2078:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
2079:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_SSL_EARLY_DATA)
2080:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2081:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief    Set the early data mode
2082:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *           Default: disabled on server and client
2083:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2084:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf   The SSL configuration to use.
2085:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param early_data_enabled can be:
2086:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2087:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  MBEDTLS_SSL_EARLY_DATA_DISABLED:
2088:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  Early data functionality is disabled. This is the default on client and
2089:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  server.
2090:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2091:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  MBEDTLS_SSL_EARLY_DATA_ENABLED:
2092:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  Early data functionality is enabled and may be negotiated in the handshake.
2093:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  Application using early data functionality needs to be aware that the
2094:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  security properties for early data (also refered to as 0-RTT data) are
2095:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  weaker than those for other kinds of TLS data. See the documentation of
2096:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  mbedtls_ssl_write_early_data() and mbedtls_ssl_read_early_data() for more
2097:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  information.
2098:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  When early data functionality is enabled on server and only in that case,
2099:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  the call to one of the APIs that trigger or resume an handshake sequence,
2100:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  namely mbedtls_ssl_handshake(), mbedtls_ssl_handshake_step(),
2101:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  mbedtls_ssl_read() or mbedtls_ssl_write() may return with the error code
2102:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA indicating that some early data have
2103:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  been received. To read the early data, call mbedtls_ssl_read_early_data()
2104:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *  before calling the original function again.
2105:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2106:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_early_data(mbedtls_ssl_config *conf,
2107:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                  int early_data_enabled);
2108:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
2109:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_SSL_SRV_C)
2110:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2111:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief Set the maximum amount of 0-RTT data in bytes
2112:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        Default:  #MBEDTLS_SSL_MAX_EARLY_DATA_SIZE
2113:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2114:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        This function sets the value of the max_early_data_size
2115:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        field of the early data indication extension included in
2116:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        the NewSessionTicket messages that the server may send.
2117:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2118:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        The value defines the maximum amount of 0-RTT data
2119:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        in bytes that a client will be allowed to send when using
2120:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        one of the tickets defined by the NewSessionTicket messages.
2121:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2122:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note When resuming a session using a ticket, if the server receives more
2123:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *       early data than allowed for the ticket, it terminates the connection.
2124:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *       The maximum amount of 0-RTT data should thus be large enough
2125:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *       to allow a minimum of early data to be exchanged.
2126:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2127:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param[in] conf                  The SSL configuration to use.
2128:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param[in] max_early_data_size   The maximum amount of 0-RTT data.
2129:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2130:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning This interface DOES NOT influence/limit the amount of early data
GAS LISTING /tmp/ccmtdssg.s 			page 289


2131:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *          that can be received through previously created and issued tickets,
2132:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *          which clients may have stored.
2133:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2134:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_max_early_data_size(
2135:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****     mbedtls_ssl_config *conf, uint32_t max_early_data_size);
2136:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_SRV_C */
2137:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
2138:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_EARLY_DATA */
