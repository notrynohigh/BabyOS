4476:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****     defined(MBEDTLS_SSL_SRV_C) && \
4477:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****     defined(MBEDTLS_SSL_PROTO_TLS1_3)
4478:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4479:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief   Number of NewSessionTicket messages for the server to send
4480:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *          after handshake completion.
4481:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4482:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note    The default value is
4483:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *          \c MBEDTLS_SSL_TLS1_3_DEFAULT_NEW_SESSION_TICKETS.
4484:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4485:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note    In case of a session resumption, this setting only partially apply.
4486:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *          At most one ticket is sent in that case to just renew the pool of
4487:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *          tickets of the client. The rationale is to avoid the number of
4488:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *          tickets on the server to become rapidly out of control when the
4489:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *          server has the same configuration for all its connection instances.
4490:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4491:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf    SSL configuration
4492:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param num_tickets    Number of NewSessionTicket.
4493:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4494:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
4495:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_new_session_tickets(mbedtls_ssl_config *conf,
4496:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                           uint16_t num_tickets);
4497:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_SESSION_TICKETS &&
4498:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****           MBEDTLS_SSL_SRV_C &&
4499:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****           MBEDTLS_SSL_PROTO_TLS1_3*/
4500:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
4501:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_SSL_RENEGOTIATION)
4502:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4503:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Enable / Disable renegotiation support for connection when
4504:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 initiated by peer
4505:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Default: MBEDTLS_SSL_RENEGOTIATION_DISABLED)
4506:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4507:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning        It is recommended to always disable renegotiation unless you
4508:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 know you need it and you know what you're doing. In the
4509:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 past, there have been several issues associated with
4510:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 renegotiation or a poor understanding of its properties.
4511:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4512:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Server-side, enabling renegotiation also makes the server
4513:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 susceptible to a resource DoS by a malicious client.
4514:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4515:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf    SSL configuration
4516:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param renegotiation     Enable or disable (MBEDTLS_SSL_RENEGOTIATION_ENABLED or
4517:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                                             MBEDTLS_SSL_RENEGOTIATION_DISABLED)
4518:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
4519:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_renegotiation(mbedtls_ssl_config *conf, int renegotiation);
4520:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_RENEGOTIATION */
4521:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
4522:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4523:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Prevent or allow legacy renegotiation.
4524:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Default: MBEDTLS_SSL_LEGACY_NO_RENEGOTIATION)
GAS LISTING /tmp/ccmtdssg.s 			page 331


4525:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4526:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 MBEDTLS_SSL_LEGACY_NO_RENEGOTIATION allows connections to
4527:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 be established even if the peer does not support
4528:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 secure renegotiation, but does not allow renegotiation
4529:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to take place if not secure.
4530:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Interoperable and secure option)
4531:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4532:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 MBEDTLS_SSL_LEGACY_ALLOW_RENEGOTIATION allows renegotiations
4533:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 with non-upgraded peers. Allowing legacy renegotiation
4534:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 makes the connection vulnerable to specific man in the
4535:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 middle attacks. (See RFC 5746)
4536:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Most interoperable and least secure option)
4537:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4538:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 MBEDTLS_SSL_LEGACY_BREAK_HANDSHAKE breaks off connections
4539:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 if peer does not support secure renegotiation. Results
4540:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 in interoperability issues with non-upgraded peers
4541:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 that do not support renegotiation altogether.
4542:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Most secure option, interoperability issues)
4543:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4544:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
4545:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param allow_legacy  Prevent or allow (SSL_NO_LEGACY_RENEGOTIATION,
4546:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                                        SSL_ALLOW_LEGACY_RENEGOTIATION or
4547:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                                        MBEDTLS_SSL_LEGACY_BREAK_HANDSHAKE)
4548:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
4549:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_legacy_renegotiation(mbedtls_ssl_config *conf, int allow_legacy);
4550:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
4551:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_SSL_RENEGOTIATION)
4552:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4553:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Enforce renegotiation requests.
4554:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Default: enforced, max_records = 16)
4555:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4556:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 When we request a renegotiation, the peer can comply or
4557:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 ignore the request. This function allows us to decide
4558:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 whether to enforce our renegotiation requests by closing
4559:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the connection if the peer doesn't comply.
4560:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4561:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 However, records could already be in transit from the peer
4562:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 when the request is emitted. In order to increase
4563:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 reliability, we can accept a number of records before the
4564:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 expected handshake records.
4565:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4566:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 The optimal value is highly dependent on the specific usage
4567:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 scenario.
4568:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4569:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           With DTLS and server-initiated renegotiation, the
4570:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 HelloRequest is retransmitted every time mbedtls_ssl_read() times
4571:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 out or receives Application Data, until:
4572:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 - max_records records have beens seen, if it is >= 0, or
4573:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 - the number of retransmits that would happen during an
4574:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 actual handshake has been reached.
4575:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Please remember the request might be lost a few times
4576:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 if you consider setting max_records to a really low value.
4577:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4578:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning        On client, the grace period can only happen during
4579:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 mbedtls_ssl_read(), as opposed to mbedtls_ssl_write() and mbedtls_ssl_renegotiat
4580:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 which always behave as if max_record was 0. The reason is,
4581:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 if we receive application data from the server, we need a
GAS LISTING /tmp/ccmtdssg.s 			page 332


4582:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 place to write it, which only happens during mbedtls_ssl_read().
4583:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4584:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
4585:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param max_records Use MBEDTLS_SSL_RENEGOTIATION_NOT_ENFORCED if you don't want to
4586:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 enforce renegotiation, or a non-negative value to enforce
4587:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 it but allow for a grace period of max_records records.
4588:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
4589:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_renegotiation_enforced(mbedtls_ssl_config *conf, int max_records);
4590:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
4591:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4592:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set record counter threshold for periodic renegotiation.
4593:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Default: 2^48 - 1)
4594:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4595:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Renegotiation is automatically triggered when a record
4596:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 counter (outgoing or incoming) crosses the defined
4597:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 threshold. The default value is meant to prevent the
4598:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 connection from being closed when the counter is about to
4599:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 reached its maximal value (it is not allowed to wrap).
4600:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4601:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Lower values can be used to enforce policies such as "keys
4602:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 must be refreshed every N packets with cipher X".
4603:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4604:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 The renegotiation period can be disabled by setting
4605:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 conf->disable_renegotiation to
4606:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 MBEDTLS_SSL_RENEGOTIATION_DISABLED.
4607:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4608:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           When the configured transport is
4609:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 MBEDTLS_SSL_TRANSPORT_DATAGRAM the maximum renegotiation
4610:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 period is 2^48 - 1, and for MBEDTLS_SSL_TRANSPORT_STREAM,
4611:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the maximum renegotiation period is 2^64 - 1.
4612:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4613:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
4614:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param period   The threshold value: a big-endian 64-bit number.
4615:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
4616:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_renegotiation_period(mbedtls_ssl_config *conf,
4617:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                            const unsigned char period[8]);
4618:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_RENEGOTIATION */
4619:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
4620:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4621:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Check if there is data already read from the
4622:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 underlying transport but not yet processed.
4623:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4624:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl      SSL context
4625:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4626:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         0 if nothing's pending, 1 otherwise.
4627:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4628:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This is different in purpose and behaviour from
4629:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_ssl_get_bytes_avail in that it considers
4630:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 any kind of unprocessed data, not only unread
4631:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 application data. If \c mbedtls_ssl_get_bytes
4632:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 returns a non-zero value, this function will
4633:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 also signal pending data, but the converse does
4634:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 not hold. For example, in DTLS there might be
4635:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 further records waiting to be processed from
4636:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the current underlying transport's datagram.
4637:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4638:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           If this function returns 1 (data pending), this
GAS LISTING /tmp/ccmtdssg.s 			page 333


4639:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 does not imply that a subsequent call to
4640:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_ssl_read will provide any data;
4641:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 e.g., the unprocessed data might turn out
4642:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to be an alert or a handshake message.
4643:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4644:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This function is useful in the following situation:
4645:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If the SSL/TLS module successfully returns from an
4646:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 operation - e.g. a handshake or an application record
4647:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 read - and you're awaiting incoming data next, you
4648:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 must not immediately idle on the underlying transport
4649:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to have data ready, but you need to check the value
4650:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 of this function first. The reason is that the desired
4651:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 data might already be read but not yet processed.
4652:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If, in contrast, a previous call to the SSL/TLS module
4653:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 returned MBEDTLS_ERR_SSL_WANT_READ, it is not necessary
4654:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to call this function, as the latter error code entails
4655:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 that all internal data has been processed.
4656:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4657:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
4658:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_check_pending(const mbedtls_ssl_context *ssl);
