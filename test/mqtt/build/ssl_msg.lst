4380:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4381:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief           Enable or disable Extended Master Secret negotiation.
4382:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  (Default: MBEDTLS_SSL_EXTENDED_MS_ENABLED)
4383:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4384:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note            This should always be enabled, it is a security fix to the
4385:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  protocol, and should not cause any interoperability issue
4386:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  (used only if the peer supports it too).
4387:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4388:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf      SSL configuration
