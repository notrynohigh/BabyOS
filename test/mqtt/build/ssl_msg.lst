2191:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Return the SSL configuration structure associated
2192:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 with the given SSL context.
2193:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2194:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           The pointer returned by this function is guaranteed to
2195:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 remain valid until the context is freed.
2196:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2197:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl      The SSL context to query.
2198:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         Pointer to the SSL configuration associated with \p ssl.
2199:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2200:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** static inline const mbedtls_ssl_config *mbedtls_ssl_context_get_config(
2201:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****     const mbedtls_ssl_context *ssl)
2202:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** {
