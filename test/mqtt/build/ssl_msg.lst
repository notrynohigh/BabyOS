5332:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     if (ssl->conf->transport == MBEDTLS_SSL_TRANSPORT_DATAGRAM) {
5333:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         /* This sets the header pointers to match records
5334:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****          * without CID. When we receive a record containing
