3051:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3052:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Enable or disable anti-replay protection for DTLS.
3053:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (DTLS only, no effect on TLS.)
3054:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Default: enabled.
3055:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3056:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
3057:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param mode     MBEDTLS_SSL_ANTI_REPLAY_ENABLED or MBEDTLS_SSL_ANTI_REPLAY_DISABLED.
3058:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3059:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning        Disabling this is a security risk unless the application
3060:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 protocol handles duplicated packets in a safe way. You
3061:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 should not disable this without careful consideration.
3062:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 However, if your application already detects duplicated
3063:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 packets and needs information about them to adjust its
3064:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 transmission strategy, then you'll want to disable this.
3065:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3066:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_dtls_anti_replay(mbedtls_ssl_config *conf, char mode);
3067:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_DTLS_ANTI_REPLAY */
3068:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3069:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3070:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set a limit on the number of records with a bad MAC
3071:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 before terminating the connection.
3072:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (DTLS only, no effect on TLS.)
3073:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Default: 0 (disabled).
3074:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3075:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
3076:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param limit    Limit, or 0 to disable.
3077:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3078:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           If the limit is N, then the connection is terminated when
3079:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the Nth non-authentic record is seen.
3080:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3081:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Records with an invalid header are not counted, only the
3082:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 ones going through the authentication-decryption phase.
3083:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3084:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This is a security trade-off related to the fact that it's
3085:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 often relatively easy for an active attacker to inject UDP
3086:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 datagrams. On one hand, setting a low limit here makes it
3087:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 easier for such an attacker to forcibly terminated a
3088:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 connection. On the other hand, a high limit or no limit
3089:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 might make us waste resources checking authentication on
3090:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 many bogus packets.
3091:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3092:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_dtls_badmac_limit(mbedtls_ssl_config *conf, unsigned limit);
3093:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3094:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_SSL_PROTO_DTLS)
3095:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3096:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3097:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Allow or disallow packing of multiple handshake records
3098:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 within a single datagram.
3099:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
GAS LISTING /tmp/ccmtdssg.s 			page 306


3100:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl           The SSL context to configure.
3101:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param allow_packing This determines whether datagram packing may
3102:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      be used or not. A value of \c 0 means that every
3103:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      record will be sent in a separate datagram; a
3104:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      value of \c 1 means that, if space permits,
3105:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      multiple handshake messages (including CCS) belonging to
3106:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      a single flight may be packed within a single datagram.
3107:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3108:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This is enabled by default and should only be disabled
3109:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 for test purposes, or if datagram packing causes
3110:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 interoperability issues with peers that don't support it.
3111:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3112:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Allowing datagram packing reduces the network load since
3113:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 there's less overhead if multiple messages share the same
3114:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 datagram. Also, it increases the handshake efficiency
3115:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 since messages belonging to a single datagram will not
3116:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 be reordered in transit, and so future message buffering
3117:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 or flight retransmission (if no buffering is used) as
3118:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 means to deal with reordering are needed less frequently.
3119:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3120:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Application records are not affected by this option and
3121:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 are currently always sent in separate datagrams.
3122:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3123:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3124:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_set_datagram_packing(mbedtls_ssl_context *ssl,
3125:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                       unsigned allow_packing);
3126:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3127:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3128:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set retransmit timeout values for the DTLS handshake.
3129:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (DTLS only, no effect on TLS.)
3130:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3131:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
3132:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param min      Initial timeout value in milliseconds.
3133:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Default: 1000 (1 second).
3134:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param max      Maximum timeout value in milliseconds.
3135:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Default: 60000 (60 seconds).
3136:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3137:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Default values are from RFC 6347 section 4.2.4.1.
3138:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3139:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           The 'min' value should typically be slightly above the
3140:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 expected round-trip time to your peer, plus whatever time
3141:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 it takes for the peer to process the message. For example,
3142:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 if your RTT is about 600ms and you peer needs up to 1s to
3143:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 do the cryptographic operations in the handshake, then you
3144:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 should set 'min' slightly above 1600. Lower values of 'min'
3145:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 might cause spurious resends which waste network resources,
3146:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 while larger value of 'min' will increase overall latency
3147:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 on unreliable network links.
3148:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3149:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           The more unreliable your network connection is, the larger
3150:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 your max / min ratio needs to be in order to achieve
3151:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 reliable handshakes.
3152:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3153:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Messages are retransmitted up to log2(ceil(max/min)) times.
3154:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 For example, if min = 1s and max = 5s, the retransmit plan
3155:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 goes: send ... 1s -> resend ... 2s -> resend ... 4s ->
3156:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 resend ... 5s -> give up and return a timeout error.
GAS LISTING /tmp/ccmtdssg.s 			page 307


3157:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3158:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_handshake_timeout(mbedtls_ssl_config *conf, uint32_t min, uint32_t max);
3159:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_PROTO_DTLS */
3160:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3161:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_SSL_SRV_C)
3162:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3163:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the session cache callbacks (server-side only)
3164:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If not set, no session resuming is done (except if session
3165:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 tickets are enabled too).
3166:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3167:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 The session cache has the responsibility to check for stale
3168:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 entries based on timeout. See RFC 5246 for recommendations.
3169:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3170:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Warning: session.peer_cert is cleared by the SSL/TLS layer on
3171:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 connection shutdown, so do not cache the pointer! Either set
3172:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 it to NULL or make a full copy of the certificate.
3173:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3174:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 The get callback is called once during the initial handshake
3175:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to enable session resuming. The get function has the
3176:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 following parameters: (void *parameter, mbedtls_ssl_session *session)
3177:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If a valid entry is found, it should fill the master of
3178:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the session object with the cached values and return 0,
3179:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 return 1 otherwise. Optionally peer_cert can be set as well
3180:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 if it is properly present in cache entry.
3181:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3182:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 The set callback is called once during the initial handshake
3183:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to enable session resuming after the entire handshake has
3184:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 been finished. The set function has the following parameters:
3185:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (void *parameter, const mbedtls_ssl_session *session). The function
3186:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 should create a cache entry for future retrieval based on
3187:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the data in the session structure and should keep in mind
3188:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 that the mbedtls_ssl_session object presented (and all its referenced
3189:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 data) is cleared by the SSL/TLS layer when the connection is
3190:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 terminated. It is recommended to add metadata to determine if
3191:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 an entry is still valid in the future. Return 0 if
3192:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 successfully cached, return 1 otherwise.
3193:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3194:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf           SSL configuration
3195:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param p_cache        parameter (context) for both callbacks
3196:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_get_cache    session get callback
3197:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_set_cache    session set callback
3198:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3199:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_session_cache(mbedtls_ssl_config *conf,
3200:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                     void *p_cache,
3201:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                     mbedtls_ssl_cache_get_t *f_get_cache,
3202:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                     mbedtls_ssl_cache_set_t *f_set_cache);
3203:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_SRV_C */
3204:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3205:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_SSL_CLI_C)
3206:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3207:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Load a session for session resumption.
3208:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3209:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Sessions loaded through this call will be considered
3210:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 for session resumption in the next handshake.
3211:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3212:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Even if this call succeeds, it is not guaranteed that
3213:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the next handshake will indeed be shortened through the
GAS LISTING /tmp/ccmtdssg.s 			page 308


3214:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 use of session resumption: The server is always free
3215:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to reject any attempt for resumption and fall back to
3216:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 a full handshake.
3217:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3218:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This function can handle a variety of mechanisms for session
3219:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 resumption: For TLS 1.2, both session ID-based resumption and
3220:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 ticket-based resumption will be considered. For TLS 1.3,
3221:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 once implemented, sessions equate to tickets, and loading
3222:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 one or more sessions via this call will lead to their
3223:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 corresponding tickets being advertised as resumption PSKs
3224:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 by the client.
3225:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3226:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Calling this function multiple times will only be useful
3227:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 once TLS 1.3 is supported. For TLS 1.2 connections, this
3228:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 function should be called at most once.
3229:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3230:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl      The SSL context representing the connection which should
3231:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 be attempted to be setup using session resumption. This
3232:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 must be initialized via mbedtls_ssl_init() and bound to
3233:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 an SSL configuration via mbedtls_ssl_setup(), but
3234:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the handshake must not yet have been started.
3235:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param session  The session to be considered for session resumption.
3236:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This must be a session previously exported via
3237:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 mbedtls_ssl_get_session(), and potentially serialized and
3238:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 deserialized through mbedtls_ssl_session_save() and
3239:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 mbedtls_ssl_session_load() in the meantime.
3240:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3241:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         \c 0 if successful.
3242:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         \c MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE if the session
3243:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 could not be loaded because of an implementation limitation.
3244:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This error is non-fatal, and has no observable effect on
3245:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the SSL context or the session that was attempted to be loaded.
3246:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         Another negative error code on other kinds of failure.
3247:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3248:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \sa             mbedtls_ssl_get_session()
3249:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \sa             mbedtls_ssl_session_load()
3250:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3251:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_set_session(mbedtls_ssl_context *ssl, const mbedtls_ssl_session *session);
3252:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_CLI_C */
3253:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3254:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3255:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Load serialized session data into a session structure.
3256:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 On client, this can be used for loading saved sessions
3257:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 before resuming them with mbedtls_ssl_set_session().
3258:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 On server, this can be used for alternative implementations
3259:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 of session cache or session tickets.
3260:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3261:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning        If a peer certificate chain is associated with the session,
3262:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the serialized state will only contain the peer's
3263:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 end-entity certificate and the result of the chain
3264:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 verification (unless verification was disabled), but not
3265:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the rest of the chain.
3266:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3267:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \see            mbedtls_ssl_session_save()
3268:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \see            mbedtls_ssl_set_session()
3269:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3270:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param session  The session structure to be populated. It must have been
GAS LISTING /tmp/ccmtdssg.s 			page 309


3271:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 initialised with mbedtls_ssl_session_init() but not
3272:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 populated yet.
3273:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param buf      The buffer holding the serialized session data. It must be a
3274:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 readable buffer of at least \p len bytes.
3275:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param len      The size of the serialized data in bytes.
3276:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3277:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         \c 0 if successful.
3278:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         #MBEDTLS_ERR_SSL_ALLOC_FAILED if memory allocation failed.
3279:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         #MBEDTLS_ERR_SSL_BAD_INPUT_DATA if input data is invalid.
3280:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         #MBEDTLS_ERR_SSL_VERSION_MISMATCH if the serialized data
3281:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 was generated in a different version or configuration of
3282:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Mbed TLS.
3283:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         Another negative value for other kinds of errors (for
3284:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 example, unsupported features in the embedded certificate).
3285:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3286:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_session_load(mbedtls_ssl_session *session,
3287:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              const unsigned char *buf,
3288:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              size_t len);
3289:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3290:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3291:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Save session structure as serialized data in a buffer.
3292:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 On client, this can be used for saving session data,
3293:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 potentially in non-volatile storage, for resuming later.
3294:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 On server, this can be used for alternative implementations
3295:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 of session cache or session tickets.
3296:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3297:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \see            mbedtls_ssl_session_load()
3298:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3299:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param session  The session structure to be saved.
3300:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param buf      The buffer to write the serialized data to. It must be a
3301:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 writeable buffer of at least \p buf_len bytes, or may be \c
3302:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 NULL if \p buf_len is \c 0.
3303:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param buf_len  The number of bytes available for writing in \p buf.
3304:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param olen     The size in bytes of the data that has been or would have
3305:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 been written. It must point to a valid \c size_t.
3306:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3307:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           \p olen is updated to the correct value regardless of
3308:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 whether \p buf_len was large enough. This makes it possible
3309:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to determine the necessary size by calling this function
3310:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 with \p buf set to \c NULL and \p buf_len to \c 0.
3311:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3312:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         \c 0 if successful.
3313:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         #MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL if \p buf is too small.
3314:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3315:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_session_save(const mbedtls_ssl_session *session,
3316:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              unsigned char *buf,
3317:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              size_t buf_len,
3318:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              size_t *olen);
3319:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3320:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3321:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief               Set the list of allowed ciphersuites and the preference
3322:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      order. First in the list has the highest preference.
3323:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3324:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      For TLS 1.2, the notion of ciphersuite determines both
3325:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      the key exchange mechanism and the suite of symmetric
3326:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      algorithms to be used during and after the handshake.
3327:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
GAS LISTING /tmp/ccmtdssg.s 			page 310


3328:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      For TLS 1.3 (in development), the notion of ciphersuite
3329:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      only determines the suite of symmetric algorithms to be
3330:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      used during and after the handshake, while key exchange
3331:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      mechanisms are configured separately.
3332:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3333:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      In Mbed TLS, ciphersuites for both TLS 1.2 and TLS 1.3
3334:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      are configured via this function. For users of TLS 1.3,
3335:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      there will be separate API for the configuration of key
3336:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      exchange mechanisms.
3337:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3338:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      The list of ciphersuites passed to this function may
3339:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      contain a mixture of TLS 1.2 and TLS 1.3 ciphersuite
3340:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      identifiers. This is useful if negotiation of TLS 1.3
3341:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      should be attempted, but a fallback to TLS 1.2 would
3342:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      be tolerated.
3343:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3344:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note                By default, the server chooses its preferred
3345:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      ciphersuite among those that the client supports. If
3346:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      mbedtls_ssl_conf_preference_order() is called to prefer
3347:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      the client's preferences, the server instead chooses
3348:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      the client's preferred ciphersuite among those that
3349:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      the server supports.
3350:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3351:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning             The ciphersuites array \p ciphersuites is not copied.
3352:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      It must remain valid for the lifetime of the SSL
3353:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      configuration \p conf.
3354:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3355:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf          The SSL configuration to modify.
3356:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ciphersuites  A 0-terminated list of IANA identifiers of supported
3357:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      ciphersuites, accessible through \c MBEDTLS_TLS_XXX
3358:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      and \c MBEDTLS_TLS1_3_XXX macros defined in
3359:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      ssl_ciphersuites.h.
3360:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3361:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_ciphersuites(mbedtls_ssl_config *conf,
3362:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                    const int *ciphersuites);
3363:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3364:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_SSL_PROTO_TLS1_3)
3365:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3366:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief Set the supported key exchange modes for TLS 1.3 connections.
3367:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3368:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        In contrast to TLS 1.2, the ciphersuite concept in TLS 1.3 does not
3369:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        include the choice of key exchange mechanism. It is therefore not
3370:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        covered by the API mbedtls_ssl_conf_ciphersuites(). See the
3371:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        documentation of mbedtls_ssl_conf_ciphersuites() for more
3372:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        information on the ciphersuite concept in TLS 1.2 and TLS 1.3.
3373:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3374:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        The present function is specific to TLS 1.3 and allows users to
3375:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        configure the set of supported key exchange mechanisms in TLS 1.3.
3376:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3377:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf       The SSL configuration the change should apply to.
3378:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param kex_modes  A bitwise combination of one or more of the following:
3379:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                   - MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK
3380:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     This flag enables pure-PSK key exchanges.
3381:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                   - MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL
3382:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     This flag enables combined PSK-ephemeral key exchanges.
3383:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                   - MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL
3384:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     This flag enables pure-ephemeral key exchanges.
GAS LISTING /tmp/ccmtdssg.s 			page 311


3385:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                   For convenience, the following pre-defined macros are
3386:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                   available for combinations of the above:
3387:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                   - MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_ALL
3388:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     Includes all of pure-PSK, PSK-ephemeral and pure-ephemeral.
3389:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                   - MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ALL
3390:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     Includes both pure-PSK and combined PSK-ephemeral
3391:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     key exchanges, but excludes pure-ephemeral key exchanges.
3392:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                   - MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ALL
3393:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     Includes both pure-ephemeral and combined PSK-ephemeral
3394:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     key exchanges.
3395:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3396:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note  If a PSK-based key exchange mode shall be supported, applications
3397:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        must also use the APIs mbedtls_ssl_conf_psk() or
3398:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        mbedtls_ssl_conf_psk_cb() or mbedtls_ssl_conf_psk_opaque()
3399:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        to configure the PSKs to be used.
3400:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3401:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note  If a pure-ephemeral key exchange mode shall be supported,
3402:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        server-side applications must also provide a certificate via
3403:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *        mbedtls_ssl_conf_own_cert().
3404:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3405:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3406:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3407:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_tls13_key_exchange_modes(mbedtls_ssl_config *conf,
3408:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                                const int kex_modes);
3409:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_PROTO_TLS1_3 */
3410:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3411:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)
3412:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #define MBEDTLS_SSL_UNEXPECTED_CID_IGNORE 0
3413:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #define MBEDTLS_SSL_UNEXPECTED_CID_FAIL   1
3414:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3415:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief               Specify the length of Connection IDs for incoming
3416:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      encrypted DTLS records, as well as the behaviour
3417:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      on unexpected CIDs.
3418:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3419:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      By default, the CID length is set to \c 0,
3420:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      and unexpected CIDs are silently ignored.
3421:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3422:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf          The SSL configuration to modify.
3423:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param len           The length in Bytes of the CID fields in encrypted
3424:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      DTLS records using the CID mechanism. This must
3425:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      not be larger than #MBEDTLS_SSL_CID_OUT_LEN_MAX.
3426:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ignore_other_cids This determines the stack's behaviour when
3427:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          receiving a record with an unexpected CID.
3428:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          Possible values are:
3429:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          - #MBEDTLS_SSL_UNEXPECTED_CID_IGNORE
3430:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                            In this case, the record is silently ignored.
3431:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          - #MBEDTLS_SSL_UNEXPECTED_CID_FAIL
3432:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                            In this case, the stack fails with the specific
3433:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                            error code #MBEDTLS_ERR_SSL_UNEXPECTED_CID.
3434:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3435:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note                The CID specification allows implementations to either
3436:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      use a common length for all incoming connection IDs or
3437:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      allow variable-length incoming IDs. Mbed TLS currently
3438:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      requires a common length for all connections sharing the
3439:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      same SSL configuration; this allows simpler parsing of
3440:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      record headers.
3441:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
GAS LISTING /tmp/ccmtdssg.s 			page 312


3442:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return              \c 0 on success.
3443:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return              #MBEDTLS_ERR_SSL_BAD_INPUT_DATA if \p len
3444:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      is too large.
3445:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3446:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_conf_cid(mbedtls_ssl_config *conf, size_t len,
3447:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                          int ignore_other_cids);
3448:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID */
3449:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3450:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_X509_CRT_PARSE_C)
3451:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3452:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the X.509 security profile used for verification
3453:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3454:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           The restrictions are enforced for all certificates in the
3455:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 chain. However, signatures in the handshake are not covered
3456:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 by this setting but by \b mbedtls_ssl_conf_sig_hashes().
3457:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3458:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
3459:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param profile  Profile to use
3460:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3461:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_cert_profile(mbedtls_ssl_config *conf,
3462:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                    const mbedtls_x509_crt_profile *profile);
3463:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3464:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3465:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the data required to verify peer certificate
3466:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3467:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           See \c mbedtls_x509_crt_verify() for notes regarding the
3468:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 parameters ca_chain (maps to trust_ca for that function)
3469:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 and ca_crl.
3470:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3471:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
3472:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ca_chain trusted CA chain (meaning all fully trusted top-level CAs)
3473:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ca_crl   trusted CA CRLs
3474:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3475:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_ca_chain(mbedtls_ssl_config *conf,
3476:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                mbedtls_x509_crt *ca_chain,
3477:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                mbedtls_x509_crl *ca_crl);
3478:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3479:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_KEY_EXCHANGE_CERT_REQ_ALLOWED_ENABLED)
3480:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3481:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set DN hints sent to client in CertificateRequest message
3482:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3483:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           If not set, subject distinguished names (DNs) are taken
3484:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 from \c mbedtls_ssl_conf_ca_chain()
3485:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 or \c mbedtls_ssl_set_hs_ca_chain())
3486:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3487:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
3488:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param crt      crt chain whose subject DNs are issuer DNs of client certs
3489:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 from which the client should select client peer certificate.
3490:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3491:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** static inline
3492:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_dn_hints(mbedtls_ssl_config *conf,
3493:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                const mbedtls_x509_crt *crt)
3494:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** {
3495:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****     conf->MBEDTLS_PRIVATE(dn_hints) = crt;
3496:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** }
3497:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_KEY_EXCHANGE_CERT_REQ_ALLOWED_ENABLED */
