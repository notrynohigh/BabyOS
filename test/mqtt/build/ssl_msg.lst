5310:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
5311:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** /* Once ssl->in_hdr as the address of the beginning of the
5312:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  * next incoming record is set, deduce the other pointers.
5313:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *
5314:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  * Note: For TLS, we save the implicit record sequence number
5315:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *       (entering MAC computation) in the 8 bytes before ssl->in_hdr,
5316:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *       and the caller has to make sure there's space for this.
5317:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  */
5318:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
5319:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** void mbedtls_ssl_update_in_pointers(mbedtls_ssl_context *ssl)
5320:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** {
5321:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /* This function sets the pointers to match the case
