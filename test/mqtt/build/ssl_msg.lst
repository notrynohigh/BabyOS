3499:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK)
3500:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3501:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the trusted certificate callback.
3502:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3503:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This API allows to register the set of trusted certificates
3504:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 through a callback, instead of a linked list as configured
3505:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 by mbedtls_ssl_conf_ca_chain().
3506:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3507:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This is useful for example in contexts where a large number
3508:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 of CAs are used, and the inefficiency of maintaining them
3509:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 in a linked list cannot be tolerated. It is also useful when
3510:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the set of trusted CAs needs to be modified frequently.
3511:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3512:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 See the documentation of `mbedtls_x509_crt_ca_cb_t` for
3513:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 more information.
3514:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3515:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     The SSL configuration to register the callback with.
3516:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_ca_cb  The trusted certificate callback to use when verifying
3517:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 certificate chains.
3518:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param p_ca_cb  The context to be passed to \p f_ca_cb (for example,
3519:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 a reference to a trusted CA database).
3520:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3521:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This API is incompatible with mbedtls_ssl_conf_ca_chain():
3522:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Any call to this function overwrites the values set through
3523:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 earlier calls to mbedtls_ssl_conf_ca_chain() or
3524:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 mbedtls_ssl_conf_ca_cb().
3525:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3526:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This API is incompatible with CA indication in
3527:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 CertificateRequest messages: A server-side SSL context which
3528:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 is bound to an SSL configuration that uses a CA callback
3529:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 configured via mbedtls_ssl_conf_ca_cb(), and which requires
3530:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 client authentication, will send an empty CA list in the
3531:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 corresponding CertificateRequest message.
3532:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3533:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This API is incompatible with mbedtls_ssl_set_hs_ca_chain():
3534:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If an SSL context is bound to an SSL configuration which uses
3535:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 CA callbacks configured via mbedtls_ssl_conf_ca_cb(), then
3536:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 calls to mbedtls_ssl_set_hs_ca_chain() have no effect.
3537:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3538:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           The use of this API disables the use of restartable ECC
3539:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 during X.509 CRT signature verification (but doesn't affect
3540:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 other uses).
3541:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3542:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning        This API is incompatible with the use of CRLs. Any call to
3543:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 mbedtls_ssl_conf_ca_cb() unsets CRLs configured through
3544:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 earlier calls to mbedtls_ssl_conf_ca_chain().
3545:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3546:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning        In multi-threaded environments, the callback \p f_ca_cb
3547:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 must be thread-safe, and it is the user's responsibility
3548:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to guarantee this (for example through a mutex
3549:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 contained in the callback context pointed to by \p p_ca_cb).
3550:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3551:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_ca_cb(mbedtls_ssl_config *conf,
3552:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                             mbedtls_x509_crt_ca_cb_t f_ca_cb,
3553:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                             void *p_ca_cb);
3554:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK */
3555:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
GAS LISTING /tmp/ccmtdssg.s 			page 314


3556:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3557:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set own certificate chain and private key
3558:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3559:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           own_cert should contain in order from the bottom up your
3560:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 certificate chain. The top certificate (self-signed)
3561:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 can be omitted.
3562:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3563:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           On server, this function can be called multiple times to
3564:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 provision more than one cert/key pair (eg one ECDSA, one
3565:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 RSA with SHA-256, one RSA with SHA-1). An adequate
3566:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 certificate will be selected according to the client's
3567:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 advertised capabilities. In case multiple certificates are
3568:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 adequate, preference is given to the one set by the first
3569:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 call to this function, then second, etc.
3570:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3571:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           On client, only the first call has any effect. That is,
3572:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 only one client certificate can be provisioned. The
3573:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 server's preferences in its CertificateRequest message will
3574:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 be ignored and our only cert will be sent regardless of
3575:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 whether it matches those preferences - the server can then
3576:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 decide what it wants to do with it.
3577:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3578:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           The provided \p pk_key needs to match the public key in the
3579:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 first certificate in \p own_cert, or all handshakes using
3580:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 that certificate will fail. It is your responsibility
3581:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to ensure that; this function will not perform any check.
3582:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 You may use mbedtls_pk_check_pair() in order to perform
3583:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 this check yourself, but be aware that this function can
3584:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 be computationally expensive on some key types.
3585:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3586:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
3587:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param own_cert own public certificate chain
3588:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param pk_key   own private key
3589:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3590:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         0 on success or MBEDTLS_ERR_SSL_ALLOC_FAILED
3591:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3592:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_conf_own_cert(mbedtls_ssl_config *conf,
3593:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                               mbedtls_x509_crt *own_cert,
3594:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                               mbedtls_pk_context *pk_key);
3595:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_X509_CRT_PARSE_C */
3596:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3597:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_SSL_HANDSHAKE_WITH_PSK_ENABLED)
3598:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3599:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Configure pre-shared keys (PSKs) and their
3600:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 identities to be used in PSK-based ciphersuites.
3601:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3602:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Only one PSK can be registered, through either
3603:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 mbedtls_ssl_conf_psk() or mbedtls_ssl_conf_psk_opaque().
3604:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If you attempt to register more than one PSK, this function
3605:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 fails, though this may change in future versions, which
3606:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 may add support for multiple PSKs.
3607:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3608:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This is mainly useful for clients. Servers will usually
3609:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 want to use \c mbedtls_ssl_conf_psk_cb() instead.
3610:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3611:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           A PSK set by \c mbedtls_ssl_set_hs_psk() in the PSK callback
3612:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 takes precedence over a PSK configured by this function.
GAS LISTING /tmp/ccmtdssg.s 			page 315


3613:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3614:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     The SSL configuration to register the PSK with.
3615:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param psk      The pointer to the pre-shared key to use.
3616:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param psk_len  The length of the pre-shared key in bytes.
3617:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param psk_identity      The pointer to the pre-shared key identity.
3618:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param psk_identity_len  The length of the pre-shared key identity
3619:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          in bytes.
3620:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3621:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           The PSK and its identity are copied internally and
3622:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 hence need not be preserved by the caller for the lifetime
3623:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 of the SSL configuration.
3624:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3625:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         \c 0 if successful.
3626:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         #MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE if no more PSKs
3627:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 can be configured. In this case, the old PSK(s) remain intact.
3628:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         Another negative error code on other kinds of failure.
3629:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3630:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_conf_psk(mbedtls_ssl_config *conf,
3631:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                          const unsigned char *psk, size_t psk_len,
3632:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                          const unsigned char *psk_identity, size_t psk_identity_len);
3633:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
3634:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_USE_PSA_CRYPTO)
3635:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3636:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Configure one or more opaque pre-shared keys (PSKs) and
3637:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 their identities to be used in PSK-based ciphersuites.
3638:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3639:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Only one PSK can be registered, through either
3640:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 mbedtls_ssl_conf_psk() or mbedtls_ssl_conf_psk_opaque().
3641:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If you attempt to register more than one PSK, this function
3642:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 fails, though this may change in future versions, which
3643:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 may add support for multiple PSKs.
3644:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3645:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This is mainly useful for clients. Servers will usually
3646:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 want to use \c mbedtls_ssl_conf_psk_cb() instead.
3647:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3648:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           An opaque PSK set by \c mbedtls_ssl_set_hs_psk_opaque() in
3649:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the PSK callback takes precedence over an opaque PSK
3650:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 configured by this function.
3651:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3652:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     The SSL configuration to register the PSK with.
3653:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param psk      The identifier of the key slot holding the PSK.
3654:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Until \p conf is destroyed or this function is successfully
3655:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 called again, the key slot \p psk must be populated with a
3656:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 key of type PSA_ALG_CATEGORY_KEY_DERIVATION whose policy
3657:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 allows its use for the key derivation algorithm applied
