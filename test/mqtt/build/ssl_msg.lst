 154:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     PSA_CHK(psa_hash_abort(&operation));
 155:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
 156:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /* Calculate okey */
 157:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     for (i = 0; i < mac_key_length; i++) {
 158:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         key_buf[i] = (unsigned char) ((key_buf[i] ^ 0x36) ^ 0x5C);
 159:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     }
 160:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     for (; i < block_size; ++i) {
