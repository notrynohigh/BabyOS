5829:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /* Loop as long as no application data record is available */
5830:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     while (ssl->in_offt == NULL) {
