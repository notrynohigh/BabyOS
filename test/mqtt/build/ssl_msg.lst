 967:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
 968:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /* The following two code paths implement the (D)TLSInnerPlaintext
 969:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * structure present in TLS 1.3 and DTLS 1.2 + CID.
 970:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 971:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * See ssl_build_inner_plaintext() for more information.
 972:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 973:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * Note that this changes `rec->data_len`, and hence
 974:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * `post_avail` needs to be recalculated afterwards.
 975:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 976:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * Note also that the two code paths cannot occur simultaneously
 977:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * since they apply to different versions of the protocol. There
 978:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * is hence no risk of double-addition of the inner plaintext.
 979:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      */
 980:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** #if defined(MBEDTLS_SSL_PROTO_TLS1_3)
 981:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     if (transform->tls_version == MBEDTLS_SSL_VERSION_TLS1_3) {
 982:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         size_t padding =
 983:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****             ssl_compute_padding_length(rec->data_len,
 984:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****                                        MBEDTLS_SSL_CID_TLS1_3_PADDING_GRANULARITY);
 985:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         if (ssl_build_inner_plaintext(data,
 986:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****                                       &rec->data_len,
 987:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****                                       post_avail,
 988:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****                                       rec->type,
 989:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****                                       padding) != 0) {
 990:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****             return MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL;
GAS LISTING /tmp/ccmtdssg.s 			page 44


 991:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         }
 992:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
 993:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         rec->type = MBEDTLS_SSL_MSG_APPLICATION_DATA;
 994:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     }
 995:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** #endif /* MBEDTLS_SSL_PROTO_TLS1_3 */
 996:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
 997:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** #if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)
