1278:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****     /*! When a ticket is created by a TLS server as part of an established TLS
1279:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  session, the ticket creation time may need to be saved for the ticket
1280:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  module to be able to check the ticket age when the ticket is used.
1281:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  That's the purpose of this field.
1282:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  Before creating a new ticket, an Mbed TLS server set this field with
1283:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  its current time in milliseconds. This time may then be saved in the
1284:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  session ticket data by the session ticket writing function and
1285:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  recovered by the ticket parsing function later when the ticket is used.
1286:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  The ticket module may then use this time to compute the ticket age and
1287:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  determine if it has expired or not.
1288:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  The Mbed TLS implementations of the session ticket writing and parsing
1289:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  functions save and retrieve the ticket creation time as part of the
1290:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  session ticket data. The session ticket parsing function relies on
1291:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  the mbedtls_ssl_session_get_ticket_creation_time() API to get the
1292:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *  ticket creation time from the session ticket data.
1293:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      */
1294:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****     mbedtls_ms_time_t MBEDTLS_PRIVATE(ticket_creation_time);
