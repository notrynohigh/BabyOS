1020:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
1021:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief           Callback type: start external decryption operation.
1022:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1023:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  This callback is called during an SSL handshake to start
1024:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  an RSA decryption operation using an
1025:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  external processor. The parameter \p cert contains
1026:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  the public key; it is up to the callback function to
1027:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  determine how to access the associated private key.
1028:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1029:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  This function typically sends or enqueues a request, and
1030:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  does not wait for the operation to complete. This allows
1031:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  the handshake step to be non-blocking.
1032:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1033:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  The parameters \p ssl and \p cert are guaranteed to remain
1034:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  valid throughout the handshake. On the other hand, this
1035:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  function must save the contents of \p input if the value
1036:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  is needed for later processing, because the \p input buffer
1037:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  is no longer valid after this function returns.
1038:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1039:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  This function may call mbedtls_ssl_set_async_operation_data()
1040:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  to store an operation context for later retrieval
1041:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  by the resume or cancel callback.
1042:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1043:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning         RSA decryption as used in TLS is subject to a potential
1044:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  timing side channel attack first discovered by Bleichenbacher
1045:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  in 1998. This attack can be remotely exploitable
1046:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  in practice. To avoid this attack, you must ensure that
1047:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  if the callback performs an RSA decryption, the time it
GAS LISTING /tmp/ccmtdssg.s 			page 270


1048:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  takes to execute and return the result does not depend
1049:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  on whether the RSA decryption succeeded or reported
1050:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  invalid padding.
1051:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1052:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl             The SSL connection instance. It should not be
1053:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        modified other than via
1054:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        mbedtls_ssl_set_async_operation_data().
1055:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param cert            Certificate containing the public key.
1056:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        In simple cases, this is one of the pointers passed to
1057:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        mbedtls_ssl_conf_own_cert() when configuring the SSL
1058:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        connection. However, if other callbacks are used, this
1059:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        property may not hold. For example, if an SNI callback
1060:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        is registered with mbedtls_ssl_conf_sni(), then
1061:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        this callback determines what certificate is used.
1062:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param input           Buffer containing the input ciphertext. This buffer
1063:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        is no longer valid when the function returns.
1064:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param input_len       Size of the \p input buffer in bytes.
1065:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
1066:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return          0 if the operation was started successfully and the SSL
1067:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  stack should call the resume callback immediately.
1068:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return          #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS if the operation
1069:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  was started successfully and the SSL stack should return
1070:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  immediately without calling the resume callback yet.
1071:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return          #MBEDTLS_ERR_SSL_HW_ACCEL_FALLTHROUGH if the external
1072:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  processor does not support this key. The SSL stack will
1073:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  use the private key object instead.
1074:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return          Any other error indicates a fatal failure and is
1075:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  propagated up the call chain. The callback should
1076:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  use \c MBEDTLS_ERR_PK_xxx error codes, and <b>must not</b>
1077:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  use \c MBEDTLS_ERR_SSL_xxx error codes except as
1078:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  directed in the documentation of this callback.
1079:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
