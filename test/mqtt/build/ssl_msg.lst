 194:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /*
 195:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * This function breaks the HMAC abstraction and uses the md_clone()
