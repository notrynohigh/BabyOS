4828:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4829:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Export a session in order to resume it later.
4830:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4831:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl      The SSL context representing the connection for which to
4832:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to export a session structure for later resumption.
4833:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param session  The target structure in which to store the exported session.
4834:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This must have been initialized with mbedtls_ssl_session_init()
4835:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 but otherwise be unused.
4836:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4837:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This function can handle a variety of mechanisms for session
4838:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 resumption: For TLS 1.2, both session ID-based resumption and
4839:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 ticket-based resumption will be considered. For TLS 1.3,
4840:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 once implemented, sessions equate to tickets, and calling
4841:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 this function multiple times will export the available
4842:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 tickets one a time until no further tickets are available,
4843:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 in which case MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE will
4844:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 be returned.
4845:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4846:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Calling this function multiple times will only be useful
4847:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 once TLS 1.3 is supported. For TLS 1.2 connections, this
4848:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 function should be called at most once.
4849:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4850:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         \c 0 if successful. In this case, \p session can be used for
4851:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 session resumption by passing it to mbedtls_ssl_set_session(),
4852:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 and serialized for storage via mbedtls_ssl_session_save().
4853:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         #MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE if no further session
4854:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 is available for export.
4855:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This error is a non-fatal, and has no observable effect on
4856:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the SSL context or the destination session.
4857:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         Another negative error code on other kinds of failure.
4858:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4859:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \sa             mbedtls_ssl_set_session()
4860:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \sa             mbedtls_ssl_session_save()
4861:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
4862:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_get_session(const mbedtls_ssl_context *ssl,
4863:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                             mbedtls_ssl_session *session);
4864:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_CLI_C */
