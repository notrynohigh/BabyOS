2245:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
2246:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
2247:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2248:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief             Configure the use of the Connection ID (CID)
2249:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    extension in the next handshake.
2250:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2251:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    Reference: RFC 9146 (or draft-ietf-tls-dtls-connection-id-05
2252:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    https://tools.ietf.org/html/draft-ietf-tls-dtls-connection-id-05
2253:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    for legacy version)
2254:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2255:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    The DTLS CID extension allows the reliable association of
2256:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    DTLS records to DTLS connections across changes in the
2257:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    underlying transport (changed IP and Port metadata) by
2258:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    adding explicit connection identifiers (CIDs) to the
2259:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    headers of encrypted DTLS records. The desired CIDs are
2260:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    configured by the application layer and are exchanged in
2261:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    new `ClientHello` / `ServerHello` extensions during the
2262:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    handshake, where each side indicates the CID it wants the
2263:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    peer to use when writing encrypted messages. The CIDs are
2264:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    put to use once records get encrypted: the stack discards
2265:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    any incoming records that don't include the configured CID
2266:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    in their header, and adds the peer's requested CID to the
2267:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    headers of outgoing messages.
2268:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2269:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    This API enables or disables the use of the CID extension
2270:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    in the next handshake and sets the value of the CID to
2271:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    be used for incoming messages.
2272:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2273:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl         The SSL context to configure. This must be initialized.
2274:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param enable      This value determines whether the CID extension should
2275:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    be used or not. Possible values are:
2276:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    - MBEDTLS_SSL_CID_ENABLED to enable the use of the CID.
2277:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    - MBEDTLS_SSL_CID_DISABLED (default) to disable the use
2278:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      of the CID.
2279:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param own_cid     The address of the readable buffer holding the CID we want
2280:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    the peer to use when sending encrypted messages to us.
2281:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    This may be \c NULL if \p own_cid_len is \c 0.
2282:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    This parameter is unused if \p enable is set to
2283:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    MBEDTLS_SSL_CID_DISABLED.
2284:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param own_cid_len The length of \p own_cid.
2285:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    This parameter is unused if \p enable is set to
2286:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    MBEDTLS_SSL_CID_DISABLED.
2287:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2288:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note              The value of \p own_cid_len must match the value of the
2289:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    \c len parameter passed to mbedtls_ssl_conf_cid()
2290:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    when configuring the ::mbedtls_ssl_config that \p ssl
2291:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    is bound to.
2292:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2293:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note              This CID configuration applies to subsequent handshakes
2294:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    performed on the SSL context \p ssl, but does not trigger
2295:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    one. You still have to call `mbedtls_ssl_handshake()`
2296:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    (for the initial handshake) or `mbedtls_ssl_renegotiate()`
2297:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    (for a renegotiation handshake) explicitly after a
2298:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    successful call to this function to run the handshake.
2299:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2300:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note              This call cannot guarantee that the use of the CID
2301:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    will be successfully negotiated in the next handshake,
GAS LISTING /tmp/ccmtdssg.s 			page 292


2302:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    because the peer might not support it. Specifically:
2303:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    - On the Client, enabling the use of the CID through
2304:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      this call implies that the `ClientHello` in the next
2305:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      handshake will include the CID extension, thereby
2306:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      offering the use of the CID to the server. Only if
2307:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      the `ServerHello` contains the CID extension, too,
2308:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      the CID extension will actually be put to use.
2309:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    - On the Server, enabling the use of the CID through
2310:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      this call implies that the server will look for
2311:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      the CID extension in a `ClientHello` from the client,
2312:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      and, if present, reply with a CID extension in its
2313:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                      `ServerHello`.
2314:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2315:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note              To check whether the use of the CID was negotiated
2316:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    after the subsequent handshake has completed, please
2317:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    use the API mbedtls_ssl_get_peer_cid().
2318:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2319:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning           If the use of the CID extension is enabled in this call
2320:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    and the subsequent handshake negotiates its use, Mbed TLS
2321:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    will silently drop every packet whose CID does not match
2322:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    the CID configured in \p own_cid. It is the responsibility
2323:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    of the user to adapt the underlying transport to take care
2324:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    of CID-based demultiplexing before handing datagrams to
2325:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    Mbed TLS.
2326:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2327:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return            \c 0 on success. In this case, the CID configuration
2328:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    applies to the next handshake.
2329:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return            A negative error code on failure.
2330:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2331:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_set_cid(mbedtls_ssl_context *ssl,
2332:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                         int enable,
2333:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                         unsigned char const *own_cid,
2334:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                         size_t own_cid_len);
