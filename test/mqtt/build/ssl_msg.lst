4794:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4795:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Return the peer certificate from the current connection.
4796:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4797:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param  ssl     The SSL context to use. This must be initialized and setup.
4798:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4799:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         The current peer certificate, if available.
4800:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 The returned certificate is owned by the SSL context and
4801:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 is valid only until the next call to the SSL API.
4802:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         \c NULL if no peer certificate is available. This might
4803:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 be because the chosen ciphersuite doesn't use CRTs
4804:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (PSK-based ciphersuites, for example), or because
4805:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 #MBEDTLS_SSL_KEEP_PEER_CERTIFICATE has been disabled,
4806:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 allowing the stack to free the peer's CRT to save memory.
4807:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4808:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           For one-time inspection of the peer's certificate during
4809:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the handshake, consider registering an X.509 CRT verification
GAS LISTING /tmp/ccmtdssg.s 			page 336


4810:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 callback through mbedtls_ssl_conf_verify() instead of calling
4811:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 this function. Using mbedtls_ssl_conf_verify() also comes at
4812:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the benefit of allowing you to influence the verification
4813:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 process, for example by masking expected and tolerated
4814:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 verification failures.
4815:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4816:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning        You must not use the pointer returned by this function
4817:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 after any further call to the SSL API, including
4818:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 mbedtls_ssl_read() and mbedtls_ssl_write(); this is
4819:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 because the pointer might change during renegotiation,
4820:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 which happens transparently to the user.
4821:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If you want to use the certificate across API calls,
4822:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 you must make a copy.
4823:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
