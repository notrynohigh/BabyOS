3901:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3902:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the allowed hashes for signatures during the handshake.
3903:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3904:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This only affects which hashes are offered and can be used
3905:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 for signatures during the handshake. Hashes for message
3906:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 authentication and the TLS PRF are controlled by the
3907:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 ciphersuite, see \c mbedtls_ssl_conf_ciphersuites(). Hashes
3908:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 used for certificate signature are controlled by the
3909:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 verification profile, see \c mbedtls_ssl_conf_cert_profile().
3910:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3911:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \deprecated     Superseded by mbedtls_ssl_conf_sig_algs().
3912:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3913:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This list should be ordered by decreasing preference
3914:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (preferred hash first).
3915:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3916:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           By default, all supported hashes whose length is at least
3917:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 256 bits are allowed. This is the same set as the default
3918:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 for certificate verification
3919:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (#mbedtls_x509_crt_profile_default).
3920:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 The preference order is currently unspecified and may
3921:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 change in future versions.
3922:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3923:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           New minor versions of Mbed TLS may extend this list,
3924:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 for example if new curves are added to the library.
3925:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 New minor versions of Mbed TLS will not remove items
3926:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 from this list unless serious security concerns require it.
3927:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3928:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
3929:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param hashes   Ordered list of allowed signature hashes,
3930:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 terminated by \c MBEDTLS_MD_NONE.
3931:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3932:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void MBEDTLS_DEPRECATED mbedtls_ssl_conf_sig_hashes(mbedtls_ssl_config *conf,
3933:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                                     const int *hashes);
