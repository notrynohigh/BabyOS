 145:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         mbedtls_ct_memcpy_if(mbedtls_ct_uint_eq(offset, data_len_secret),
 146:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****                              output, aux_out, NULL, hash_size);
 147:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
 148:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         if (offset < max_data_len) {
 149:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****             PSA_CHK(psa_hash_update(&operation, data + offset, 1));
 150:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         }
 151:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     }
