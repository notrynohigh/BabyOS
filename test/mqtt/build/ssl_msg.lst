 502:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /* Avoid arithmetic overflow and range overflow */
 503:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     if (new_timeout < ssl->handshake->retransmit_timeout ||
 504:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         new_timeout > ssl->conf->hs_timeout_max) {
GAS LISTING /tmp/ccmtdssg.s 			page 10


 505:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         new_timeout = ssl->conf->hs_timeout_max;
