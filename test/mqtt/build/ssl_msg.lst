5799:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /*
5800:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * Check if renegotiation is necessary and/or handshake is
5801:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * in process. If yes, perform/continue, and fall through
5802:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * if an unexpected packet is received while the client
5803:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * is waiting for the ServerHello.
