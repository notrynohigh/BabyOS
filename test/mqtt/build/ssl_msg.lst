2480:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2481:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the timeout period for mbedtls_ssl_read()
2482:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Default: no timeout.)
2483:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2484:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration context
2485:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param timeout  Timeout value in milliseconds.
2486:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Use 0 for no timeout (default).
2487:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2488:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           With blocking I/O, this will only work if a non-NULL
2489:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c f_recv_timeout was set with \c mbedtls_ssl_set_bio().
2490:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 With non-blocking I/O, this will only work if timer
2491:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 callbacks were set with \c mbedtls_ssl_set_timer_cb().
2492:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2493:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           With non-blocking I/O, you may also skip this function
2494:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 altogether and handle timeouts at the application layer.
2495:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2496:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_read_timeout(mbedtls_ssl_config *conf, uint32_t timeout);
