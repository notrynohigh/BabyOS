4261:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                         - mki size and value( if size is > 0 ).
4262:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
