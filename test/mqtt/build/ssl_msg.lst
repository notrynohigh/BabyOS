4408:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH)
4409:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4410:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the maximum fragment length to emit and/or negotiate.
GAS LISTING /tmp/ccmtdssg.s 			page 329


4411:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Typical: the smaller of #MBEDTLS_SSL_IN_CONTENT_LEN and
4412:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 #MBEDTLS_SSL_OUT_CONTENT_LEN, usually `2^14` bytes)
4413:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Server: set maximum fragment length to emit,
4414:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 usually negotiated by the client during handshake)
4415:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Client: set maximum fragment length to emit *and*
4416:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 negotiate with the server during handshake)
4417:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Default: #MBEDTLS_SSL_MAX_FRAG_LEN_NONE)
4418:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4419:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           On the client side, the maximum fragment length extension
4420:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 *will not* be used, unless the maximum fragment length has
4421:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 been set via this function to a value different than
4422:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 #MBEDTLS_SSL_MAX_FRAG_LEN_NONE.
4423:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4424:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           With TLS, this currently only affects ApplicationData (sent
4425:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 with \c mbedtls_ssl_read()), not handshake messages.
4426:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 With DTLS, this affects both ApplicationData and handshake.
4427:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4428:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This sets the maximum length for a record's payload,
4429:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 excluding record overhead that will be added to it, see
4430:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_ssl_get_record_expansion().
4431:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4432:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           For DTLS, it is also possible to set a limit for the total
4433:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 size of datagrams passed to the transport layer, including
4434:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 record overhead, see \c mbedtls_ssl_set_mtu().
4435:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4436:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
4437:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param mfl_code Code for maximum fragment length (allowed values:
4438:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 MBEDTLS_SSL_MAX_FRAG_LEN_512,  MBEDTLS_SSL_MAX_FRAG_LEN_1024,
4439:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 MBEDTLS_SSL_MAX_FRAG_LEN_2048, MBEDTLS_SSL_MAX_FRAG_LEN_4096)
4440:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4441:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         0 if successful or MBEDTLS_ERR_SSL_BAD_INPUT_DATA
4442:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
4443:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_conf_max_frag_len(mbedtls_ssl_config *conf, unsigned char mfl_code);
4444:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_MAX_FRAGMENT_LENGTH */
4445:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
4446:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_SSL_SRV_C)
4447:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4448:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Pick the ciphersuites order according to the second parameter
4449:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 in the SSL Server module (MBEDTLS_SSL_SRV_C).
4450:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Default, if never called: MBEDTLS_SSL_SRV_CIPHERSUITE_ORDER_SERVER)
4451:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4452:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
4453:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param order    Server or client (MBEDTLS_SSL_SRV_CIPHERSUITE_ORDER_SERVER
4454:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                                or MBEDTLS_SSL_SRV_CIPHERSUITE_ORDER_CLIENT)
4455:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
4456:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_preference_order(mbedtls_ssl_config *conf, int order);
4457:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_SRV_C */
