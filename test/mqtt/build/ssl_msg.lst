 749:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *                length_of_DTLSInnerPlaintext
 750:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 751:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * Section 5.3 of draft-ietf-tls-dtls-connection-id-05 (for legacy CID use)
 752:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * defines the additional data calculation as follows:
 753:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 754:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *     additional_data = seq_num +
 755:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *                tls12_cid +
 756:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *                DTLSCipherText.version +
 757:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *                cid +
 758:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *                cid_length +
 759:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *                length_of_DTLSInnerPlaintext
