2206:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2207:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the underlying BIO callbacks for write, read and
2208:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 read-with-timeout.
2209:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2210:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl      SSL context
2211:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param p_bio    parameter (context) shared by BIO callbacks
2212:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_send   write callback
2213:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_recv   read callback
2214:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_recv_timeout blocking read callback with timeout.
2215:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2216:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           One of f_recv or f_recv_timeout can be NULL, in which case
2217:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the other is used. If both are non-NULL, f_recv_timeout is
2218:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 used and f_recv is ignored (as if it were NULL).
2219:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2220:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           The two most common use cases are:
2221:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 - non-blocking I/O, f_recv != NULL, f_recv_timeout == NULL
2222:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 - blocking I/O, f_recv == NULL, f_recv_timeout != NULL
2223:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2224:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           For DTLS, you need to provide either a non-NULL
2225:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 f_recv_timeout callback, or a f_recv that doesn't block.
2226:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2227:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           See the documentations of \c mbedtls_ssl_send_t,
2228:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_ssl_recv_t and \c mbedtls_ssl_recv_timeout_t for
2229:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the conventions those callbacks must follow.
2230:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2231:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           On some platforms, net_sockets.c provides
2232:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_net_send(), \c mbedtls_net_recv() and
2233:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_net_recv_timeout() that are suitable to be used
2234:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 here.
2235:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2236:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_set_bio(mbedtls_ssl_context *ssl,
2237:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                          void *p_bio,
2238:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                          mbedtls_ssl_send_t *f_send,
2239:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                          mbedtls_ssl_recv_t *f_recv,
2240:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                          mbedtls_ssl_recv_timeout_t *f_recv_timeout);
