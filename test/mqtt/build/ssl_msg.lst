 384:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /*
 385:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * Maximum fragment length in bytes,
 386:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * determines the size of each of the two internal I/O buffers.
 387:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
 388:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * Note: the RFC defines the default size of SSL / TLS messages. If you
 389:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * change the value here, other clients / servers may not be able to
 390:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * communicate with you anymore. Only change this value if you control
 391:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * both sides of the connection and have it reduced at both sides, or
 392:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * if you're using the Max Fragment Length extension and you know all your
