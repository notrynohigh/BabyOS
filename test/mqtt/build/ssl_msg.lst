 807:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param timeout  Maximum number of milliseconds to wait for data
 808:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 0 means no timeout (potentially waiting forever)
 809:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
