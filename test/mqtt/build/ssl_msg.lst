5819:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
5820:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     if (ssl->state != MBEDTLS_SSL_HANDSHAKE_OVER) {
5821:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         ret = mbedtls_ssl_handshake(ssl);
5822:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         if (ret != MBEDTLS_ERR_SSL_WAITING_SERVER_HELLO_RENEGO &&
