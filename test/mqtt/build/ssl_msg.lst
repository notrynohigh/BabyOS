2498:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2499:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Check whether a buffer contains a valid and authentic record
2500:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 that has not been seen before. (DTLS only).
2501:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2502:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This function does not change the user-visible state
2503:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 of the SSL context. Its sole purpose is to provide
2504:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 an indication of the legitimacy of an incoming record.
2505:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2506:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This can be useful e.g. in distributed server environments
2507:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 using the DTLS Connection ID feature, in which connections
2508:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 might need to be passed between service instances on a change
2509:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 of peer address, but where such disruptive operations should
2510:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 only happen after the validity of incoming records has been
2511:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 confirmed.
2512:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2513:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl      The SSL context to use.
2514:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param buf      The address of the buffer holding the record to be checked.
2515:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This must be a read/write buffer of length \p buflen Bytes.
2516:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param buflen   The length of \p buf in Bytes.
2517:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2518:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This routine only checks whether the provided buffer begins
2519:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 with a valid and authentic record that has not been seen
2520:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 before, but does not check potential data following the
2521:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 initial record. In particular, it is possible to pass DTLS
2522:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 datagrams containing multiple records, in which case only
2523:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the first record is checked.
2524:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2525:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This function modifies the input buffer \p buf. If you need
2526:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to preserve the original record, you have to maintain a copy.
2527:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2528:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         \c 0 if the record is valid and authentic and has not been
2529:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 seen before.
GAS LISTING /tmp/ccmtdssg.s 			page 296


2530:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         MBEDTLS_ERR_SSL_INVALID_MAC if the check completed
2531:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 successfully but the record was found to be not authentic.
2532:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         MBEDTLS_ERR_SSL_INVALID_RECORD if the check completed
2533:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 successfully but the record was found to be invalid for
2534:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 a reason different from authenticity checking.
2535:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         MBEDTLS_ERR_SSL_UNEXPECTED_RECORD if the check completed
2536:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 successfully but the record was found to be unexpected
2537:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 in the state of the SSL context, including replayed records.
2538:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         Another negative error code on different kinds of failure.
2539:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 In this case, the SSL context becomes unusable and needs
2540:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to be freed or reset before reuse.
2541:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2542:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_check_record(mbedtls_ssl_context const *ssl,
2543:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              unsigned char *buf,
2544:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              size_t buflen);
