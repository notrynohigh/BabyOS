 835:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           If using an event-driven style of programming, an event must
 836:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 be generated when the final delay is passed. The event must
 837:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 cause a call to \c mbedtls_ssl_handshake() with the proper
 838:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 SSL context to be scheduled. Care must be taken to ensure
 839:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 that at most one such call happens at a time.
 840:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
 841:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Only one timer at a time must be running. Calling this
 842:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 function while a timer is running must cancel it. Cancelled
 843:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 timers must not generate any event.
 844:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
