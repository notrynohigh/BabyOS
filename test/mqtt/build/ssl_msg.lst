  64:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** /** \def ARRAY_LENGTH
  65:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * Return the number of elements of a static or stack array.
  66:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  *
  67:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * \param array         A value of array (not pointer) type.
  68:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  *
  69:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * \return The number of elements of the array.
  70:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  */
  71:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** /* A correct implementation of ARRAY_LENGTH, but which silently gives
  72:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * a nonsensical result if called with a pointer rather than an array. */
  73:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #define ARRAY_LENGTH_UNSAFE(array)            \
  74:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****     (sizeof(array) / sizeof(*(array)))
  75:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** 
  76:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #if defined(__GNUC__)
  77:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** /* Test if arg and &(arg)[0] have the same type. This is true if arg is
  78:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * an array but not if it's a pointer. */
  79:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #define IS_ARRAY_NOT_POINTER(arg)                                     \
  80:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****     (!__builtin_types_compatible_p(__typeof__(arg),                \
  81:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****                                    __typeof__(&(arg)[0])))
  82:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** /* A compile-time constant with the value 0. If `const_expr` is not a
  83:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * compile-time constant with a nonzero value, cause a compile-time error. */
  84:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #define STATIC_ASSERT_EXPR(const_expr)                                \
  85:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****     (0 && sizeof(struct { unsigned int STATIC_ASSERT : 1 - 2 * !(const_expr); }))
  86:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** 
  87:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** /* Return the scalar value `value` (possibly promoted). This is a compile-time
  88:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * constant if `value` is. `condition` must be a compile-time constant.
  89:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * If `condition` is false, arrange to cause a compile-time error. */
  90:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #define STATIC_ASSERT_THEN_RETURN(condition, value)   \
  91:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****     (STATIC_ASSERT_EXPR(condition) ? 0 : (value))
  92:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** 
  93:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #define ARRAY_LENGTH(array)                                           \
  94:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****     (STATIC_ASSERT_THEN_RETURN(IS_ARRAY_NOT_POINTER(array),         \
  95:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****                                ARRAY_LENGTH_UNSAFE(array)))
  96:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** 
  97:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #else
  98:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** /* If we aren't sure the compiler supports our non-standard tricks,
  99:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * fall back to the unsafe implementation. */
 100:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #define ARRAY_LENGTH(array) ARRAY_LENGTH_UNSAFE(array)
 101:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #endif
