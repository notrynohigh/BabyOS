2336:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2337:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief              Get information about our request for usage of the CID
2338:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     extension in the current connection.
2339:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2340:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl          The SSL context to query.
2341:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param enabled      The address at which to store whether the CID extension
2342:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     is requested to be used or not. If the CID is
2343:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     requested, `*enabled` is set to
2344:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     MBEDTLS_SSL_CID_ENABLED; otherwise, it is set to
2345:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     MBEDTLS_SSL_CID_DISABLED.
2346:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param own_cid      The address of the buffer in which to store our own
2347:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     CID (if the CID extension is requested). This may be
2348:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     \c NULL in case the value of our CID isn't needed. If
2349:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     it is not \c NULL, \p own_cid_len must not be \c NULL.
2350:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param own_cid_len  The address at which to store the size of our own CID
2351:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     (if the CID extension is requested). This is also the
2352:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     number of Bytes in \p own_cid that have been written.
2353:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     This may be \c NULL in case the length of our own CID
2354:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     isn't needed. If it is \c NULL, \p own_cid must be
2355:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     \c NULL, too.
2356:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2357:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *\note                If we are requesting an empty CID this function sets
2358:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     `*enabled` to #MBEDTLS_SSL_CID_DISABLED (the rationale
GAS LISTING /tmp/ccmtdssg.s 			page 293


2359:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     for this is that the resulting outcome is the
2360:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     same as if the CID extensions wasn't requested).
2361:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2362:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return            \c 0 on success.
2363:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return            A negative error code on failure.
2364:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2365:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_get_own_cid(mbedtls_ssl_context *ssl,
2366:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                             int *enabled,
2367:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                             unsigned char own_cid[MBEDTLS_SSL_CID_OUT_LEN_MAX],
2368:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                             size_t *own_cid_len);
2369:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
2370:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2371:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief              Get information about the use of the CID extension
2372:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     in the current connection.
2373:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2374:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl          The SSL context to query.
2375:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param enabled      The address at which to store whether the CID extension
2376:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     is currently in use or not. If the CID is in use,
2377:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     `*enabled` is set to MBEDTLS_SSL_CID_ENABLED;
2378:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     otherwise, it is set to MBEDTLS_SSL_CID_DISABLED.
2379:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param peer_cid     The address of the buffer in which to store the CID
2380:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     chosen by the peer (if the CID extension is used).
2381:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     This may be \c NULL in case the value of peer CID
2382:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     isn't needed. If it is not \c NULL, \p peer_cid_len
2383:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     must not be \c NULL.
2384:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param peer_cid_len The address at which to store the size of the CID
2385:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     chosen by the peer (if the CID extension is used).
2386:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     This is also the number of Bytes in \p peer_cid that
2387:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     have been written.
2388:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     This may be \c NULL in case the length of the peer CID
2389:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     isn't needed. If it is \c NULL, \p peer_cid must be
2390:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     \c NULL, too.
2391:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2392:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note               This applies to the state of the CID negotiated in
2393:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     the last complete handshake. If a handshake is in
2394:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     progress, this function will attempt to complete
2395:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     the handshake first.
2396:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2397:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note               If CID extensions have been exchanged but both client
2398:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     and server chose to use an empty CID, this function
2399:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     sets `*enabled` to #MBEDTLS_SSL_CID_DISABLED
2400:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     (the rationale for this is that the resulting
2401:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     communication is the same as if the CID extensions
2402:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                     hadn't been used).
2403:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2404:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return            \c 0 on success.
2405:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return            A negative error code on failure.
2406:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2407:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** int mbedtls_ssl_get_peer_cid(mbedtls_ssl_context *ssl,
2408:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              int *enabled,
2409:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              unsigned char peer_cid[MBEDTLS_SSL_CID_OUT_LEN_MAX],
2410:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              size_t *peer_cid_len);
2411:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
2412:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID */
2413:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
2414:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2415:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the Maximum Transport Unit (MTU).
GAS LISTING /tmp/ccmtdssg.s 			page 294


2416:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Special value: 0 means unset (no limit).
2417:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This represents the maximum size of a datagram payload
2418:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 handled by the transport layer (usually UDP) as determined
2419:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 by the network link and stack. In practice, this controls
2420:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the maximum size datagram the DTLS layer will pass to the
2421:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c f_send() callback set using \c mbedtls_ssl_set_bio().
2422:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2423:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           The limit on datagram size is converted to a limit on
2424:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 record payload by subtracting the current overhead of
2425:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 encapsulation and encryption/authentication if any.
2426:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2427:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This can be called at any point during the connection, for
2428:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 example when a Path Maximum Transfer Unit (PMTU)
2429:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 estimate becomes available from other sources,
2430:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 such as lower (or higher) protocol layers.
2431:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2432:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This setting only controls the size of the packets we send,
2433:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 and does not restrict the size of the datagrams we're
2434:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 willing to receive. Client-side, you can request the
2435:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 server to use smaller records with \c
2436:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 mbedtls_ssl_conf_max_frag_len().
2437:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2438:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           If both a MTU and a maximum fragment length have been
2439:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 configured (or negotiated with the peer), the resulting
2440:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 lower limit on record payload (see first note) is used.
2441:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2442:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This can only be used to decrease the maximum size
2443:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 of datagrams (hence records, see first note) sent. It
2444:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 cannot be used to increase the maximum size of records over
2445:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the limit set by #MBEDTLS_SSL_OUT_CONTENT_LEN.
2446:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2447:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Values lower than the current record layer expansion will
2448:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 result in an error when trying to send data.
2449:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2450:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl      SSL context
2451:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param mtu      Value of the path MTU in bytes
2452:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2453:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_set_mtu(mbedtls_ssl_context *ssl, uint16_t mtu);
2454:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_PROTO_DTLS */
2455:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
2456:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_X509_CRT_PARSE_C)
2457:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2458:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set a connection-specific verification callback (optional).
2459:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2460:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If set, the provided verify callback is called for each
2461:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 certificate in the peer's CRT chain, including the trusted
2462:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 root. For more information, please see the documentation of
2463:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_x509_crt_verify().
2464:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2465:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This call is analogous to mbedtls_ssl_conf_verify() but
2466:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 binds the verification callback and context to an SSL context
2467:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 as opposed to an SSL configuration.
2468:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If mbedtls_ssl_conf_verify() and mbedtls_ssl_set_verify()
2469:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 are both used, mbedtls_ssl_set_verify() takes precedence.
2470:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2471:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl      The SSL context to use.
2472:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_vrfy   The verification callback to use during CRT verification.
GAS LISTING /tmp/ccmtdssg.s 			page 295


2473:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param p_vrfy   The opaque context to be passed to the callback.
2474:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2475:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_set_verify(mbedtls_ssl_context *ssl,
2476:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                             int (*f_vrfy)(void *, mbedtls_x509_crt *, int, uint32_t *),
2477:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                             void *p_vrfy);
2478:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_X509_CRT_PARSE_C */
