3723:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3724:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the PSK callback (server-side only).
3725:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3726:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If set, the PSK callback is called for each
GAS LISTING /tmp/ccmtdssg.s 			page 317


3727:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 handshake where a PSK-based ciphersuite was negotiated.
3728:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 The caller provides the identity received and wants to
3729:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 receive the actual PSK data and length.
3730:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3731:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 The callback has the following parameters:
3732:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 - \c void*: The opaque pointer \p p_psk.
3733:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 - \c mbedtls_ssl_context*: The SSL context to which
3734:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                                            the operation applies.
3735:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 - \c const unsigned char*: The PSK identity
3736:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                                            selected by the client.
3737:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 - \c size_t: The length of the PSK identity
3738:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                              selected by the client.
3739:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3740:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If a valid PSK identity is found, the callback should use
3741:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_ssl_set_hs_psk() or
3742:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_ssl_set_hs_psk_opaque()
3743:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 on the SSL context to set the correct PSK and return \c 0.
3744:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Any other return value will result in a denied PSK identity.
3745:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3746:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           A dynamic PSK (i.e. set by the PSK callback) takes
3747:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 precedence over a static PSK (i.e. set by
3748:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_ssl_conf_psk() or
3749:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_ssl_conf_psk_opaque()).
3750:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 This means that if you set a PSK callback using this
3751:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 function, you don't need to set a PSK using
3752:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_ssl_conf_psk() or
3753:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_ssl_conf_psk_opaque()).
3754:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3755:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     The SSL configuration to register the callback with.
3756:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_psk    The callback for selecting and setting the PSK based
3757:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 in the PSK identity chosen by the client.
3758:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param p_psk    A pointer to an opaque structure to be passed to
3759:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the callback, for example a PSK store.
3760:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3761:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_psk_cb(mbedtls_ssl_config *conf,
3762:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              int (*f_psk)(void *, mbedtls_ssl_context *, const unsigned char *,
3763:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                           size_t),
3764:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              void *p_psk);
