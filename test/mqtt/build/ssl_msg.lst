1695:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****     /**
1696:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      * Maximum TLS version to be negotiated, then negotiated TLS version.
1697:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *
1698:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      * It is initialized as the configured maximum TLS version to be
1699:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      * negotiated by mbedtls_ssl_setup().
1700:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *
1701:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      * When renegotiating or resuming a session, it is overwritten in the
1702:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      * ClientHello writing preparation stage with the previously negotiated
1703:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      * TLS version.
1704:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      *
1705:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****      * On client side, it is updated to the TLS version selected by the server
