4866:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
GAS LISTING /tmp/ccmtdssg.s 			page 337


4867:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Perform the SSL handshake
4868:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4869:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl      SSL context
4870:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4871:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         \c 0 if successful.
4872:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         #MBEDTLS_ERR_SSL_WANT_READ or #MBEDTLS_ERR_SSL_WANT_WRITE
4873:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 if the handshake is incomplete and waiting for data to
4874:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 be available for reading from or writing to the underlying
4875:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 transport - in this case you must call this function again
4876:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 when the underlying transport is ready for the operation.
4877:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS if an asynchronous
4878:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 operation is in progress (see
4879:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 mbedtls_ssl_conf_async_private_cb()) - in this case you
4880:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 must call this function again when the operation is ready.
4881:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS if a cryptographic
4882:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 operation is in progress (see mbedtls_ecp_set_max_ops()) -
4883:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 in this case you must call this function again to complete
4884:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the handshake when you're done attending other tasks.
4885:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         #MBEDTLS_ERR_SSL_HELLO_VERIFY_REQUIRED if DTLS is in use
4886:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 and the client did not demonstrate reachability yet - in
4887:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 this case you must stop using the context (see below).
4888:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         #MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA if early data, as
4889:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 defined in RFC 8446 (TLS 1.3 specification), has been
4890:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 received as part of the handshake. This is server specific
4891:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 and may occur only if the early data feature has been
4892:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 enabled on server (see mbedtls_ssl_conf_early_data()
4893:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 documentation). You must call mbedtls_ssl_read_early_data()
4894:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 to read the early data before resuming the handshake.
4895:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         Another SSL error code - in this case you must stop using
4896:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the context (see below).
4897:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4898:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning        If this function returns something other than
4899:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c 0,
4900:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 #MBEDTLS_ERR_SSL_WANT_READ,
4901:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 #MBEDTLS_ERR_SSL_WANT_WRITE,
4902:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS or
4903:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS or
4904:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 #MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA,
4905:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 you must stop using the SSL context for reading or writing,
4906:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 and either free it or call \c mbedtls_ssl_session_reset()
4907:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 on it before re-using it for a new connection; the current
4908:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 connection must be closed.
4909:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4910:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           If DTLS is in use, then you may choose to handle
4911:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 #MBEDTLS_ERR_SSL_HELLO_VERIFY_REQUIRED specially for logging
4912:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 purposes, as it is an expected return value rather than an
4913:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 actual error, but you still need to reset/free the context.
4914:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4915:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Remarks regarding event-driven DTLS:
4916:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If the function returns #MBEDTLS_ERR_SSL_WANT_READ, no datagram
4917:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 from the underlying transport layer is currently being processed,
4918:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 and it is safe to idle until the timer or the underlying transport
4919:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 signal a new event. This is not true for a successful handshake,
4920:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 in which case the datagram of the underlying transport that is
4921:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 currently being processed might or might not contain further
4922:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 DTLS records.
4923:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
GAS LISTING /tmp/ccmtdssg.s 			page 338


4924:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           If the context is configured to allow TLS 1.3, or if
4925:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto
4926:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 subsystem must have been initialized by calling
4927:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 psa_crypto_init() before calling this function.
4928:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
