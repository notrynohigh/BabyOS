 862:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** /* Compute IV := ( fixed_iv || 0 ) XOR ( 0 || dynamic_IV )
 863:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *
 864:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  * Concretely, this occurs in two variants:
 865:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *
 866:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  * a) Fixed and dynamic IV lengths add up to total IV length, giving
 867:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *       IV = fixed_iv || dynamic_iv
 868:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *
 869:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *    This variant is used in TLS 1.2 when used with GCM or CCM.
 870:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *
 871:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  * b) Fixed IV lengths matches total IV length, giving
 872:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *       IV = fixed_iv XOR ( 0 || dynamic_iv )
 873:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *
 874:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *    This variant occurs in TLS 1.3 and for TLS 1.2 when using ChaChaPoly.
 875:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****  *
