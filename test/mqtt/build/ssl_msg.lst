4460:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****     defined(MBEDTLS_SSL_CLI_C)
4461:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4462:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Enable / Disable session tickets (client only).
4463:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (Default: MBEDTLS_SSL_SESSION_TICKETS_ENABLED.)
4464:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4465:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           On server, use \c mbedtls_ssl_conf_session_tickets_cb().
4466:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4467:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
GAS LISTING /tmp/ccmtdssg.s 			page 330


4468:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param use_tickets   Enable or disable (MBEDTLS_SSL_SESSION_TICKETS_ENABLED or
