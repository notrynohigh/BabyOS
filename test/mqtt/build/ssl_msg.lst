5355:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
5356:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /* This will be adjusted at record decryption time. */
5357:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     ssl->in_msg = ssl->in_iv;
5358:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** }
