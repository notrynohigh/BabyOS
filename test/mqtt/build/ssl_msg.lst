2992:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2993:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief           Register callbacks for DTLS cookies
2994:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  (Server only. DTLS only.)
2995:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2996:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  Default: dummy callbacks that fail, in order to force you to
2997:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  register working callbacks (and initialize their context).
2998:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2999:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  To disable HelloVerifyRequest, register NULL callbacks.
3000:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3001:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \warning         Disabling hello verification allows your server to be used
3002:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  for amplification in DoS attacks against other hosts.
3003:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  Only disable if you known this can't happen in your
3004:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  particular environment.
3005:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3006:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note            See comments on \c mbedtls_ssl_handshake() about handling
3007:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  the MBEDTLS_ERR_SSL_HELLO_VERIFY_REQUIRED that is expected
3008:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  on the first handshake attempt when this is enabled.
3009:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3010:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note            This is also necessary to handle client reconnection from
3011:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  the same port as described in RFC 6347 section 4.2.8 (only
3012:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  the variant with cookies is supported currently). See
3013:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  comments on \c mbedtls_ssl_read() for details.
3014:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3015:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf              SSL configuration
3016:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_cookie_write    Cookie write callback
3017:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_cookie_check    Cookie check callback
3018:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param p_cookie          Context for both callbacks
3019:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
