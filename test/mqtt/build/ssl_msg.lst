2882:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_async_sign      Callback to start a signature operation. See
2883:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          the description of ::mbedtls_ssl_async_sign_t
2884:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          for more information. This may be \c NULL if the
2885:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          external processor does not support any signature
2886:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          operation; in this case the private key object
2887:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          associated with the certificate will be used.
2888:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_async_decrypt   Callback to start a decryption operation. See
2889:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          the description of ::mbedtls_ssl_async_decrypt_t
2890:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          for more information. This may be \c NULL if the
2891:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          external processor does not support any decryption
2892:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          operation; in this case the private key object
2893:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          associated with the certificate will be used.
2894:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_async_resume    Callback to resume an asynchronous operation. See
2895:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          the description of ::mbedtls_ssl_async_resume_t
2896:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          for more information. This may not be \c NULL unless
2897:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          \p f_async_sign and \p f_async_decrypt are both
2898:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          \c NULL.
2899:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_async_cancel    Callback to cancel an asynchronous operation. See
2900:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          the description of ::mbedtls_ssl_async_cancel_t
2901:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          for more information. This may be \c NULL if
2902:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          no cleanup is needed.
2903:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param config_data       A pointer to configuration data which can be
2904:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          retrieved with
2905:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          mbedtls_ssl_conf_get_async_config_data(). The
2906:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                          library stores this value without dereferencing it.
2907:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2908:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_async_private_cb(mbedtls_ssl_config *conf,
2909:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                        mbedtls_ssl_async_sign_t *f_async_sign,
