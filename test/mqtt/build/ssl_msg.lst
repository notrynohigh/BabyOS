4470:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
4471:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_session_tickets(mbedtls_ssl_config *conf, int use_tickets);
4472:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_SSL_SESSION_TICKETS &&
