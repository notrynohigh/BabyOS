2547:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the timer callbacks (Mandatory for DTLS.)
2548:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2549:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl      SSL context
2550:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param p_timer  parameter (context) shared by timer callbacks
2551:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_set_timer   set timer callback
2552:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_get_timer   get timer callback. Must return:
2553:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2554:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           See the documentation of \c mbedtls_ssl_set_timer_t and
2555:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_ssl_get_timer_t for the conventions this pair of
2556:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 callbacks must follow.
2557:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2558:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           On some platforms, timing.c provides
2559:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_timing_set_delay() and
2560:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_timing_get_delay() that are suitable for using
2561:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 here, except if using an event-driven style.
2562:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2563:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           See also the "DTLS tutorial" article in our knowledge base.
2564:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 https://mbed-tls.readthedocs.io/en/latest/kb/how-to/dtls-tutorial
2565:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2566:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_set_timer_cb(mbedtls_ssl_context *ssl,
2567:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                               void *p_timer,
2568:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                               mbedtls_ssl_set_timer_t *f_set_timer,
2569:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                               mbedtls_ssl_get_timer_t *f_get_timer);
