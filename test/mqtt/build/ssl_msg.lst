5755:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /* Zeroising the plaintext buffer to erase unused application data
5756:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****        from the memory. */
5757:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     mbedtls_platform_zeroize(ssl->in_offt, n);
