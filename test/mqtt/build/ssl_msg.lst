3038:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           An internal copy is made, so the info buffer can be reused.
3039:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3040:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return         0 on success,
3041:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 MBEDTLS_ERR_SSL_BAD_INPUT_DATA if used on client,
3042:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 MBEDTLS_ERR_SSL_ALLOC_FAILED if out of memory.
