3813:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
3814:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the allowed curves in order of preference.
3815:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3816:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 On server: this only affects selection of the ECDHE curve;
3817:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 the curves used for ECDH and ECDSA are determined by the
3818:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 list of available certificates instead.
3819:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3820:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 On client: this affects the list of curves offered for any
3821:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 use. The server can override our preference order.
3822:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3823:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Both sides: limits the set of curves accepted for use in
3824:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 ECDHE and in the peer's end-entity certificate.
3825:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3826:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \deprecated     Superseded by mbedtls_ssl_conf_groups().
3827:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3828:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This has no influence on which curves are allowed inside the
3829:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 certificate chains, see \c mbedtls_ssl_conf_cert_profile()
3830:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 for that. For the end-entity certificate however, the key
3831:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 will be accepted only if it is allowed both by this list
3832:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 and by the cert profile.
3833:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3834:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This list should be ordered by decreasing preference
3835:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (preferred curve first).
3836:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3837:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           The default list is the same set of curves that
3838:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 #mbedtls_x509_crt_profile_default allows, plus
3839:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 ECDHE-only curves selected according to the same criteria.
3840:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 The order favors curves with the lowest resource usage.
GAS LISTING /tmp/ccmtdssg.s 			page 319


3841:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3842:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           New minor versions of Mbed TLS may extend this list,
3843:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 for example if new curves are added to the library.
3844:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 New minor versions of Mbed TLS will not remove items
3845:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 from this list unless serious security concerns require it.
3846:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 New minor versions of Mbed TLS may change the order in
3847:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 keeping with the general principle of favoring the lowest
3848:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 resource usage.
3849:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
3850:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
3851:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param curves   Ordered list of allowed curves,
3852:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 terminated by MBEDTLS_ECP_DP_NONE.
3853:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
3854:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void MBEDTLS_DEPRECATED mbedtls_ssl_conf_curves(mbedtls_ssl_config *conf,
3855:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                                 const mbedtls_ecp_group_id *curves);
