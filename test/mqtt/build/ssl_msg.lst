 910:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return                \c 0 on success
 911:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \return                A non-zero return value on failure.
 912:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
 913:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
