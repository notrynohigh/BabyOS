5342:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         ssl->in_len = ssl->in_ctr + MBEDTLS_SSL_SEQUENCE_NUMBER_LEN;
5343:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** #endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID */
5344:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****         ssl->in_iv  = ssl->in_len + 2;
