2645:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief           Configure SSL session ticket callbacks (server only).
2646:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  (Default: none.)
2647:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2648:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note            On server, session tickets are enabled by providing
