1536:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /**
1537:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * Get the first defined PSK by order of precedence:
1538:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * 1. handshake PSK set by \c mbedtls_ssl_set_hs_psk() in the PSK callback
1539:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * 2. static PSK configured by \c mbedtls_ssl_conf_psk()
1540:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * Return a code and update the pair (PSK, PSK length) passed to this function
1541:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
1542:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** static inline int mbedtls_ssl_get_psk(const mbedtls_ssl_context *ssl,
1543:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                                       const unsigned char **psk, size_t *psk_len)
1544:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** {
1545:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     if (ssl->handshake->psk != NULL && ssl->handshake->psk_len > 0) {
1546:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****         *psk = ssl->handshake->psk;
1547:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****         *psk_len = ssl->handshake->psk_len;
1548:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     } else if (ssl->conf->psk != NULL && ssl->conf->psk_len > 0) {
1549:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****         *psk = ssl->conf->psk;
1550:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****         *psk_len = ssl->conf->psk_len;
1551:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     } else {
1552:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****         *psk = NULL;
1553:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****         *psk_len = 0;
1554:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****         return MBEDTLS_ERR_SSL_PRIVATE_KEY_REQUIRED;
1555:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     }
1556:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
1557:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     return 0;
1558:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** }
