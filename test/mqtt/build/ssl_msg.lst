 942:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #if defined(MBEDTLS_X509_CRT_PARSE_C)
 943:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
 944:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief           Callback type: start external signature operation.
 945:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
 946:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  This callback is called during an SSL handshake to start
 947:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  a signature decryption operation using an
 948:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  external processor. The parameter \p cert contains
 949:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  the public key; it is up to the callback function to
 950:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  determine how to access the associated private key.
 951:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
 952:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  This function typically sends or enqueues a request, and
 953:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  does not wait for the operation to complete. This allows
 954:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  the handshake step to be non-blocking.
 955:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
 956:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  The parameters \p ssl and \p cert are guaranteed to remain
 957:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  valid throughout the handshake. On the other hand, this
 958:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  function must save the contents of \p hash if the value
 959:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  is needed for later processing, because the \p hash buffer
 960:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  is no longer valid after this function returns.
 961:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
 962:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  This function may call mbedtls_ssl_set_async_operation_data()
 963:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  to store an operation context for later retrieval
 964:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  by the resume or cancel callback.
 965:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
 966:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note            For RSA signatures, this function must produce output
 967:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  that is consistent with PKCS#1 v1.5 in the same way as
 968:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  mbedtls_rsa_pkcs1_sign(). Before the private key operation,
 969:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  apply the padding steps described in RFC 8017, section 9.2
 970:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  "EMSA-PKCS1-v1_5" as follows.
 971:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  - If \p md_alg is #MBEDTLS_MD_NONE, apply the PKCS#1 v1.5
 972:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    encoding, treating \p hash as the DigestInfo to be
 973:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    padded. In other words, apply EMSA-PKCS1-v1_5 starting
 974:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    from step 3, with `T = hash` and `tLen = hash_len`.
 975:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  - If `md_alg != MBEDTLS_MD_NONE`, apply the PKCS#1 v1.5
 976:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    encoding, treating \p hash as the hash to be encoded and
 977:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    padded. In other words, apply EMSA-PKCS1-v1_5 starting
 978:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    from step 2, with `digestAlgorithm` obtained by calling
 979:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                    mbedtls_oid_get_oid_by_md() on \p md_alg.
 980:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
 981:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note            For ECDSA signatures, the output format is the DER encoding
 982:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  `Ecdsa-Sig-Value` defined in
 983:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                  [RFC 4492 section 5.4](https://tools.ietf.org/html/rfc4492#section-5.4).
 984:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
 985:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param ssl             The SSL connection instance. It should not be
 986:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        modified other than via
 987:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        mbedtls_ssl_set_async_operation_data().
 988:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param cert            Certificate containing the public key.
 989:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                        In simple cases, this is one of the pointers passed to
