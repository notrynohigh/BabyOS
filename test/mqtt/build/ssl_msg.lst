4308:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
4309:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the minimum accepted SSL/TLS protocol version
4310:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4311:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           By default, all supported versions are accepted.
4312:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Future versions of the library may disable older
4313:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 protocol versions by default if they become deprecated.
4314:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4315:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           The following versions are supported (if enabled at
4316:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 compile time):
4317:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 - (D)TLS 1.2: \p major = #MBEDTLS_SSL_MAJOR_VERSION_3,
4318:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                   \p minor = #MBEDTLS_SSL_MINOR_VERSION_3
4319:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 - TLS 1.3: \p major = #MBEDTLS_SSL_MAJOR_VERSION_3,
4320:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                   \p minor = #MBEDTLS_SSL_MINOR_VERSION_4
4321:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4322:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 Note that the numbers in the constant names are the
4323:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 TLS internal protocol numbers, and the minor versions
4324:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 differ by one from the human-readable versions!
4325:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4326:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           Input outside of the SSL_MAX_XXXXX_VERSION and
4327:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 SSL_MIN_XXXXX_VERSION range is ignored.
4328:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4329:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           After the handshake, you can call
4330:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 mbedtls_ssl_get_version_number() to see what version was
4331:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 negotiated.
4332:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4333:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           This function is deprecated and has been replaced by
4334:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_ssl_conf_min_tls_version().
4335:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
4336:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     SSL configuration
4337:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param major    Major version number (#MBEDTLS_SSL_MAJOR_VERSION_3)
4338:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param minor    Minor version number
4339:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 (#MBEDTLS_SSL_MINOR_VERSION_3 for (D)TLS 1.2,
4340:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 #MBEDTLS_SSL_MINOR_VERSION_4 for TLS 1.3)
4341:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
4342:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void MBEDTLS_DEPRECATED mbedtls_ssl_conf_min_version(mbedtls_ssl_config *conf, int major,
4343:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                                                      int minor);
4344:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_DEPRECATED_REMOVED */
4345:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
