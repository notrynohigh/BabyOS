 673:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     /* Several types of ciphers have been defined for use with TLS and DTLS,
 674:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * and the MAC calculations for those ciphers differ slightly. Further
 675:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * variants were added when the CID functionality was added with RFC 9146.
GAS LISTING /tmp/ccmtdssg.s 			page 13


 676:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * This implementations also considers the use of a legacy version of the
 677:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * CID specification published in draft-ietf-tls-dtls-connection-id-05,
 678:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * which is used in deployments.
 679:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 680:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * We will distinguish between the non-CID and the CID cases below.
 681:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 682:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * --- Non-CID cases ---
 683:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 684:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * Quoting RFC 5246 (TLS 1.2):
 685:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 686:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *    additional_data = seq_num + TLSCompressed.type +
 687:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *                      TLSCompressed.version + TLSCompressed.length;
 688:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 689:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * For TLS 1.3, the record sequence number is dropped from the AAD
 690:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * and encoded within the nonce of the AEAD operation instead.
 691:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * Moreover, the additional data involves the length of the TLS
 692:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * ciphertext, not the TLS plaintext as in earlier versions.
 693:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * Quoting RFC 8446 (TLS 1.3):
 694:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 695:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *      additional_data = TLSCiphertext.opaque_type ||
 696:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *                        TLSCiphertext.legacy_record_version ||
 697:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *                        TLSCiphertext.length
 698:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 699:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * We pass the tag length to this function in order to compute the
 700:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * ciphertext length from the inner plaintext length rec->data_len via
 701:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 702:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *     TLSCiphertext.length = TLSInnerPlaintext.length + taglen.
 703:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 704:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * --- CID cases ---
 705:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 706:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * RFC 9146 uses a common pattern when constructing the data
 707:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * passed into a MAC / AEAD cipher.
 708:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 709:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * Data concatenation for MACs used with block ciphers with
 710:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * Encrypt-then-MAC Processing (with CID):
 711:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 712:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *  data = seq_num_placeholder +
 713:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *         tls12_cid +
 714:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *         cid_length +
 715:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *         tls12_cid +
 716:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *         DTLSCiphertext.version +
 717:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *         epoch +
 718:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *         sequence_number +
 719:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *         cid +
 720:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *         DTLSCiphertext.length +
 721:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *         IV +
 722:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *         ENC(content + padding + padding_length)
 723:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 724:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      * Data concatenation for MACs used with block ciphers (with CID):
 725:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *
 726:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *  data =  seq_num_placeholder +
 727:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *          tls12_cid +
 728:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****      *          cid_length +
