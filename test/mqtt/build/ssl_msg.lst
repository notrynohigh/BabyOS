5746:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     mbedtls_ssl_context *ssl, unsigned char *buf, size_t len)
5747:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** {
5748:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c ****     size_t n = (len < ssl->in_msglen) ? len : ssl->in_msglen;
5749:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_msg.c **** 
