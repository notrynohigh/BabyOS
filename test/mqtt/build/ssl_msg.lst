 356:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /*
 357:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * Whether early data record should be discarded or not and how.
 358:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
 359:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * The client has indicated early data and the server has rejected them.
 360:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * The server has then to skip past early data by either:
 361:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * - attempting to deprotect received records using the handshake traffic
 362:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *   key, discarding records which fail deprotection (up to the configured
 363:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *   max_early_data_size). Once a record is deprotected successfully,
GAS LISTING /tmp/ccmtdssg.s 			page 258


 364:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *   it is treated as the start of the client's second flight and the
 365:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *   server proceeds as with an ordinary 1-RTT handshake.
 366:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * - skipping all records with an external content type of
 367:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *   "application_data" (indicating that they are encrypted), up to the
 368:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *   configured max_early_data_size. This is the expected behavior if the
 369:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *   server has sent an HelloRetryRequest message. The server ignores
 370:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *   application data message before 2nd ClientHello.
 371:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
