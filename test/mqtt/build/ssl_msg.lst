2141:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** /**
2142:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \brief          Set the verification callback (Optional).
2143:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2144:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 If set, the provided verify callback is called for each
2145:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 certificate in the peer's CRT chain, including the trusted
2146:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 root. For more information, please see the documentation of
2147:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 \c mbedtls_x509_crt_verify().
2148:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2149:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \note           For per context callbacks and contexts, please use
2150:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *                 mbedtls_ssl_set_verify() instead.
2151:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  *
2152:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param conf     The SSL configuration to use.
2153:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param f_vrfy   The verification callback to use during CRT verification.
2154:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  * \param p_vrfy   The opaque context to be passed to the callback.
2155:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****  */
2156:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** void mbedtls_ssl_conf_verify(mbedtls_ssl_config *conf,
2157:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              int (*f_vrfy)(void *, mbedtls_x509_crt *, int, uint32_t *),
2158:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h ****                              void *p_vrfy);
2159:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** #endif /* MBEDTLS_X509_CRT_PARSE_C */
2160:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/ssl.h **** 
