 606:../../bos/services/b_srv_mqtt.c ****     pack_id |= pack->pack[index + 1];
 607:../../bos/services/b_srv_mqtt.c ****     b_log("suback:%d\r\n", pack_id);
 608:../../bos/services/b_srv_mqtt.c **** 
 609:../../bos/services/b_srv_mqtt.c ****     bMqttSubscribeNode_t *pnode = NULL;
 610:../../bos/services/b_srv_mqtt.c ****     struct list_head     *pos   = NULL;
 611:../../bos/services/b_srv_mqtt.c ****     list_for_each(pos, &bMqttSubscribeListHead)
 612:../../bos/services/b_srv_mqtt.c ****     {
 613:../../bos/services/b_srv_mqtt.c ****         pnode = list_entry(pos, bMqttSubscribeNode_t, node);
 614:../../bos/services/b_srv_mqtt.c ****         if (pnode->pack_id == pack_id)
 615:../../bos/services/b_srv_mqtt.c ****         {
 616:../../bos/services/b_srv_mqtt.c ****             pnode->state = 1;
 617:../../bos/services/b_srv_mqtt.c ****             return 0;
 618:../../bos/services/b_srv_mqtt.c ****         }
 619:../../bos/services/b_srv_mqtt.c ****     }
 620:../../bos/services/b_srv_mqtt.c ****     return -1;
 621:../../bos/services/b_srv_mqtt.c **** }
