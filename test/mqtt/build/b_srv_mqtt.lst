 608:../../bos/services/b_srv_mqtt.c **** static int _bMqttSubscribeAckHandle(bMqttPack_t *pack)
 609:../../bos/services/b_srv_mqtt.c **** {
 610:../../bos/services/b_srv_mqtt.c ****     int      index   = 1;
 611:../../bos/services/b_srv_mqtt.c ****     uint16_t pack_id = 0;
 612:../../bos/services/b_srv_mqtt.c ****     // 跳过所有返回码字节 (QoS 0-2 对应不同的字节数)
 613:../../bos/services/b_srv_mqtt.c ****     while (index < pack->pack_len && pack->pack[index] & 0x80)
 614:../../bos/services/b_srv_mqtt.c ****     {
 615:../../bos/services/b_srv_mqtt.c ****         index += 1;
 616:../../bos/services/b_srv_mqtt.c ****     }
 617:../../bos/services/b_srv_mqtt.c ****     if (index + 1 >= pack->pack_len)
 618:../../bos/services/b_srv_mqtt.c ****     {
 619:../../bos/services/b_srv_mqtt.c ****         b_log_e("MQTT suback packet too short\r\n");
 620:../../bos/services/b_srv_mqtt.c ****         return -1;
 621:../../bos/services/b_srv_mqtt.c ****     }
 622:../../bos/services/b_srv_mqtt.c ****     index += 1;  // 跳过第一个返回码
 623:../../bos/services/b_srv_mqtt.c ****     pack_id |= pack->pack[index];
 624:../../bos/services/b_srv_mqtt.c ****     pack_id <<= 8;
 625:../../bos/services/b_srv_mqtt.c ****     pack_id |= pack->pack[index + 1];
 626:../../bos/services/b_srv_mqtt.c ****     b_log("suback:%d\r\n", pack_id);
 627:../../bos/services/b_srv_mqtt.c **** 
 628:../../bos/services/b_srv_mqtt.c ****     bMqttSubscribeNode_t *pnode = NULL;
 629:../../bos/services/b_srv_mqtt.c ****     struct list_head     *pos   = NULL;
 630:../../bos/services/b_srv_mqtt.c ****     list_for_each(pos, &bMqttSubscribeListHead)
 631:../../bos/services/b_srv_mqtt.c ****     {
 632:../../bos/services/b_srv_mqtt.c ****         pnode = list_entry(pos, bMqttSubscribeNode_t, node);
 633:../../bos/services/b_srv_mqtt.c ****         if (pnode->pack_id == pack_id)
 634:../../bos/services/b_srv_mqtt.c ****         {
 635:../../bos/services/b_srv_mqtt.c ****             pnode->state = 1;
 636:../../bos/services/b_srv_mqtt.c ****             return 0;
 637:../../bos/services/b_srv_mqtt.c ****         }
 638:../../bos/services/b_srv_mqtt.c ****     }
 639:../../bos/services/b_srv_mqtt.c ****     return -1;
 640:../../bos/services/b_srv_mqtt.c **** }
