 382:../../bos/services/b_srv_mqtt.c ****         int rc = MQTTPACKET_READ_ERROR;
 383:../../bos/services/b_srv_mqtt.c ****         if (++len > MAX_NO_OF_REMAINING_LENGTH_BYTES)
 384:../../bos/services/b_srv_mqtt.c ****         {
