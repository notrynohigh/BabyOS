  84:../../bos/utils/inc/b_util_list.h **** /*
  85:../../bos/utils/inc/b_util_list.h ****  * Insert a new entry between two known consecutive entries.
  86:../../bos/utils/inc/b_util_list.h ****  *
  87:../../bos/utils/inc/b_util_list.h ****  * This is only for internal list manipulation where we know
  88:../../bos/utils/inc/b_util_list.h ****  * the prev/next entries already!
  89:../../bos/utils/inc/b_util_list.h ****  */
  90:../../bos/utils/inc/b_util_list.h **** static __INLINE_DEF void __list_add(struct list_head *newItem, struct list_head *prev,
  91:../../bos/utils/inc/b_util_list.h ****                                     struct list_head *next)
  92:../../bos/utils/inc/b_util_list.h **** {
  93:../../bos/utils/inc/b_util_list.h ****     next->prev    = newItem;
  94:../../bos/utils/inc/b_util_list.h ****     newItem->next = next;
  95:../../bos/utils/inc/b_util_list.h ****     newItem->prev = prev;
  96:../../bos/utils/inc/b_util_list.h ****     WRITE_ONCE(prev->next, newItem);
  97:../../bos/utils/inc/b_util_list.h **** }
  98:../../bos/utils/inc/b_util_list.h **** 
  99:../../bos/utils/inc/b_util_list.h **** /**
 100:../../bos/utils/inc/b_util_list.h ****  * list_add - add a new entry
 101:../../bos/utils/inc/b_util_list.h ****  * @new: new entry to be added
 102:../../bos/utils/inc/b_util_list.h ****  * @head: list head to add it after
 103:../../bos/utils/inc/b_util_list.h ****  *
 104:../../bos/utils/inc/b_util_list.h ****  * Insert a new entry after the specified head.
 105:../../bos/utils/inc/b_util_list.h ****  * This is good for implementing stacks.
 106:../../bos/utils/inc/b_util_list.h ****  */
 107:../../bos/utils/inc/b_util_list.h **** static __INLINE_DEF void list_add(struct list_head *newItem, struct list_head *head)
 108:../../bos/utils/inc/b_util_list.h **** {
 109:../../bos/utils/inc/b_util_list.h ****     __list_add(newItem, head, head->next);
 110:../../bos/utils/inc/b_util_list.h **** }
 111:../../bos/utils/inc/b_util_list.h **** 
 112:../../bos/utils/inc/b_util_list.h **** /**
 113:../../bos/utils/inc/b_util_list.h ****  * list_add_tail - add a new entry
 114:../../bos/utils/inc/b_util_list.h ****  * @new: new entry to be added
 115:../../bos/utils/inc/b_util_list.h ****  * @head: list head to add it before
 116:../../bos/utils/inc/b_util_list.h ****  *
 117:../../bos/utils/inc/b_util_list.h ****  * Insert a new entry before the specified head.
 118:../../bos/utils/inc/b_util_list.h ****  * This is useful for implementing queues.
 119:../../bos/utils/inc/b_util_list.h ****  */
 120:../../bos/utils/inc/b_util_list.h **** static __INLINE_DEF void list_add_tail(struct list_head *newItem, struct list_head *head)
GAS LISTING /tmp/cc84Tnkj.s 			page 52


 121:../../bos/utils/inc/b_util_list.h **** {
