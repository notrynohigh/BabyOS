  71:../../bos/utils/inc/b_util_list.h **** /**
  72:../../bos/utils/inc/b_util_list.h ****  * list_entry - get the struct for this entry
  73:../../bos/utils/inc/b_util_list.h ****  * @ptr: the &struct list_head pointer.
  74:../../bos/utils/inc/b_util_list.h ****  * @type: the type of the struct this is embedded in.
