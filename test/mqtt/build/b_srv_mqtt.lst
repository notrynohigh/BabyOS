 125:../../bos/utils/inc/b_util_list.h **** /*
 126:../../bos/utils/inc/b_util_list.h ****  * Delete a list entry by making the prev/next entries
 127:../../bos/utils/inc/b_util_list.h ****  * point to each other.
 128:../../bos/utils/inc/b_util_list.h ****  *
 129:../../bos/utils/inc/b_util_list.h ****  * This is only for internal list manipulation where we know
