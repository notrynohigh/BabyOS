 589:../../bos/services/b_srv_mqtt.c **** static int _bMqttSubscribeAckHandle(bMqttPack_t *pack)
 590:../../bos/services/b_srv_mqtt.c **** {
 591:../../bos/services/b_srv_mqtt.c ****     int      index   = 1;
 592:../../bos/services/b_srv_mqtt.c ****     uint16_t pack_id = 0;
 593:../../bos/services/b_srv_mqtt.c ****     // 跳过所有返回码字节 (QoS 0-2 对应不同的字节数)
 594:../../bos/services/b_srv_mqtt.c ****     while (index < pack->pack_len && pack->pack[index] & 0x80)
 595:../../bos/services/b_srv_mqtt.c ****     {
 596:../../bos/services/b_srv_mqtt.c ****         index += 1;
 597:../../bos/services/b_srv_mqtt.c ****     }
 598:../../bos/services/b_srv_mqtt.c ****     if (index + 1 >= pack->pack_len)
 599:../../bos/services/b_srv_mqtt.c ****     {
 600:../../bos/services/b_srv_mqtt.c ****         b_log_e("MQTT suback packet too short\r\n");
 601:../../bos/services/b_srv_mqtt.c ****         return -1;
 602:../../bos/services/b_srv_mqtt.c ****     }
 603:../../bos/services/b_srv_mqtt.c ****     index += 1;  // 跳过第一个返回码
 604:../../bos/services/b_srv_mqtt.c ****     pack_id |= pack->pack[index];
 605:../../bos/services/b_srv_mqtt.c ****     pack_id <<= 8;
