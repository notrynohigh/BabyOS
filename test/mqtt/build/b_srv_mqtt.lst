 191:../../bos/services/b_srv_mqtt.c **** static int _bMqttParseUrl(const char *url, char **host, uint16_t *port, uint8_t *is_mqtts)
 192:../../bos/services/b_srv_mqtt.c **** {
 193:../../bos/services/b_srv_mqtt.c ****     // Check if the URL starts with "mqtt://" or "mqtts://"
 194:../../bos/services/b_srv_mqtt.c ****     const char *prefix_mqtt    = "mqtt://";
 195:../../bos/services/b_srv_mqtt.c ****     const char *prefix_mqtts   = "mqtts://";
 196:../../bos/services/b_srv_mqtt.c ****     const char *hostname_start = NULL;
 197:../../bos/services/b_srv_mqtt.c ****     int         tmp_port       = -1;
 198:../../bos/services/b_srv_mqtt.c ****     uint8_t     tmp_is_mqtts   = 0;
 199:../../bos/services/b_srv_mqtt.c ****     if (strncmp(url, prefix_mqtt, strlen(prefix_mqtt)) == 0)
 200:../../bos/services/b_srv_mqtt.c ****     {
 201:../../bos/services/b_srv_mqtt.c ****         tmp_is_mqtts   = 0;
 202:../../bos/services/b_srv_mqtt.c ****         hostname_start = url + strlen(prefix_mqtt);
 203:../../bos/services/b_srv_mqtt.c ****     }
GAS LISTING /tmp/ccsEtjz0.s 			page 5


 204:../../bos/services/b_srv_mqtt.c ****     else if (strncmp(url, prefix_mqtts, strlen(prefix_mqtts)) == 0)
 205:../../bos/services/b_srv_mqtt.c ****     {
 206:../../bos/services/b_srv_mqtt.c ****         tmp_is_mqtts   = 1;
 207:../../bos/services/b_srv_mqtt.c ****         hostname_start = url + strlen(prefix_mqtts);
 208:../../bos/services/b_srv_mqtt.c ****     }
 209:../../bos/services/b_srv_mqtt.c ****     else
 210:../../bos/services/b_srv_mqtt.c ****     {
 211:../../bos/services/b_srv_mqtt.c ****         return -1;  // Invalid URL scheme
 212:../../bos/services/b_srv_mqtt.c ****     }
 213:../../bos/services/b_srv_mqtt.c **** 
 214:../../bos/services/b_srv_mqtt.c ****     // Find the position of the colon (:) and slash (/) after the hostname
 215:../../bos/services/b_srv_mqtt.c ****     const char *colon_pos = strchr(hostname_start, ':');
 216:../../bos/services/b_srv_mqtt.c ****     const char *slash_pos = strchr(hostname_start, '/');
 217:../../bos/services/b_srv_mqtt.c **** 
 218:../../bos/services/b_srv_mqtt.c ****     // Extract the hostname
 219:../../bos/services/b_srv_mqtt.c ****     uint32_t hostname_len = 0;
 220:../../bos/services/b_srv_mqtt.c ****     if (colon_pos != NULL)
 221:../../bos/services/b_srv_mqtt.c ****     {
 222:../../bos/services/b_srv_mqtt.c ****         hostname_len = colon_pos - hostname_start;
 223:../../bos/services/b_srv_mqtt.c ****     }
 224:../../bos/services/b_srv_mqtt.c ****     else if (slash_pos != NULL)
 225:../../bos/services/b_srv_mqtt.c ****     {
 226:../../bos/services/b_srv_mqtt.c ****         hostname_len = slash_pos - hostname_start;
 227:../../bos/services/b_srv_mqtt.c ****     }
 228:../../bos/services/b_srv_mqtt.c ****     else
 229:../../bos/services/b_srv_mqtt.c ****     {
 230:../../bos/services/b_srv_mqtt.c ****         hostname_len = strlen(hostname_start);
 231:../../bos/services/b_srv_mqtt.c ****     }
 232:../../bos/services/b_srv_mqtt.c **** 
 233:../../bos/services/b_srv_mqtt.c ****     if (hostname_len > strlen(hostname_start))
 234:../../bos/services/b_srv_mqtt.c ****     {
 235:../../bos/services/b_srv_mqtt.c ****         return -1;
 236:../../bos/services/b_srv_mqtt.c ****     }
 237:../../bos/services/b_srv_mqtt.c **** 
 238:../../bos/services/b_srv_mqtt.c ****     char *phostname = _bMqttMalloc(hostname_len + 1);
 239:../../bos/services/b_srv_mqtt.c ****     if (phostname == NULL)
 240:../../bos/services/b_srv_mqtt.c ****     {
 241:../../bos/services/b_srv_mqtt.c ****         return -1;
 242:../../bos/services/b_srv_mqtt.c ****     }
 243:../../bos/services/b_srv_mqtt.c **** 
 244:../../bos/services/b_srv_mqtt.c ****     strncpy(phostname, hostname_start, hostname_len);
 245:../../bos/services/b_srv_mqtt.c ****     phostname[hostname_len] = '\0';
 246:../../bos/services/b_srv_mqtt.c **** 
 247:../../bos/services/b_srv_mqtt.c ****     // Extract the port if specified
 248:../../bos/services/b_srv_mqtt.c ****     if (colon_pos != NULL)
 249:../../bos/services/b_srv_mqtt.c ****     {
 250:../../bos/services/b_srv_mqtt.c ****         const char *port_start  = colon_pos + 1;
 251:../../bos/services/b_srv_mqtt.c ****         char        port_str[6] = {0};  // Port number is at most 5 digits
 252:../../bos/services/b_srv_mqtt.c ****         uint32_t    port_len    = 0;
 253:../../bos/services/b_srv_mqtt.c **** 
 254:../../bos/services/b_srv_mqtt.c ****         if (slash_pos != NULL)
 255:../../bos/services/b_srv_mqtt.c ****         {
 256:../../bos/services/b_srv_mqtt.c ****             port_len = slash_pos - port_start;
 257:../../bos/services/b_srv_mqtt.c ****         }
 258:../../bos/services/b_srv_mqtt.c ****         else
 259:../../bos/services/b_srv_mqtt.c ****         {
 260:../../bos/services/b_srv_mqtt.c ****             port_len = strlen(port_start);
GAS LISTING /tmp/ccsEtjz0.s 			page 6


 261:../../bos/services/b_srv_mqtt.c ****         }
 262:../../bos/services/b_srv_mqtt.c **** 
 263:../../bos/services/b_srv_mqtt.c ****         if (port_len >= sizeof(port_str))
 264:../../bos/services/b_srv_mqtt.c ****         {
