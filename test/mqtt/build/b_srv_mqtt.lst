  84:../../bos/utils/inc/b_util_list.h **** /*
  85:../../bos/utils/inc/b_util_list.h ****  * Insert a new entry between two known consecutive entries.
  86:../../bos/utils/inc/b_util_list.h ****  *
  87:../../bos/utils/inc/b_util_list.h ****  * This is only for internal list manipulation where we know
  88:../../bos/utils/inc/b_util_list.h ****  * the prev/next entries already!
  89:../../bos/utils/inc/b_util_list.h ****  */
  90:../../bos/utils/inc/b_util_list.h **** static __INLINE_DEF void __list_add(struct list_head *newItem, struct list_head *prev,
  91:../../bos/utils/inc/b_util_list.h ****                                     struct list_head *next)
  92:../../bos/utils/inc/b_util_list.h **** {
  93:../../bos/utils/inc/b_util_list.h ****     next->prev    = newItem;
  94:../../bos/utils/inc/b_util_list.h ****     newItem->next = next;
  95:../../bos/utils/inc/b_util_list.h ****     newItem->prev = prev;
  96:../../bos/utils/inc/b_util_list.h ****     WRITE_ONCE(prev->next, newItem);
  97:../../bos/utils/inc/b_util_list.h **** }
  98:../../bos/utils/inc/b_util_list.h **** 
  99:../../bos/utils/inc/b_util_list.h **** /**
