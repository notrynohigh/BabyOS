 266:../../bos/services/b_srv_mqtt.c ****             return -1;  // Port number too long
 267:../../bos/services/b_srv_mqtt.c ****         }
 268:../../bos/services/b_srv_mqtt.c **** 
 269:../../bos/services/b_srv_mqtt.c ****         strncpy(port_str, port_start, port_len);
 270:../../bos/services/b_srv_mqtt.c ****         tmp_port = atoi(port_str);
 271:../../bos/services/b_srv_mqtt.c ****     }
 272:../../bos/services/b_srv_mqtt.c **** 
 273:../../bos/services/b_srv_mqtt.c ****     // If port is not specified, set default ports
 274:../../bos/services/b_srv_mqtt.c ****     if (tmp_port == -1)
