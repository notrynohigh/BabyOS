 371:../../bos/services/b_srv_mqtt.c **** static int _bMqttDecodePacket(bMqttSrvInstance_t *pinstance, int *value)
 372:../../bos/services/b_srv_mqtt.c **** {
 373:../../bos/services/b_srv_mqtt.c ****     unsigned char i;
 374:../../bos/services/b_srv_mqtt.c ****     int           multiplier                       = 1;
 375:../../bos/services/b_srv_mqtt.c ****     int           len                              = 0;
 376:../../bos/services/b_srv_mqtt.c ****     const int     MAX_NO_OF_REMAINING_LENGTH_BYTES = 4;
 377:../../bos/services/b_srv_mqtt.c **** 
GAS LISTING /tmp/cc84Tnkj.s 			page 9


 378:../../bos/services/b_srv_mqtt.c ****     *value = 0;
 379:../../bos/services/b_srv_mqtt.c ****     do
 380:../../bos/services/b_srv_mqtt.c ****     {
 381:../../bos/services/b_srv_mqtt.c ****         int rc = MQTTPACKET_READ_ERROR;
 382:../../bos/services/b_srv_mqtt.c ****         if (++len > MAX_NO_OF_REMAINING_LENGTH_BYTES)
 383:../../bos/services/b_srv_mqtt.c ****         {
 384:../../bos/services/b_srv_mqtt.c ****             rc  = MQTTPACKET_READ_ERROR; /* bad data */
 385:../../bos/services/b_srv_mqtt.c ****             len = 0;
 386:../../bos/services/b_srv_mqtt.c ****             b_log_e("MQTT read remaining length error\r\n");
 387:../../bos/services/b_srv_mqtt.c ****             goto exit;
 388:../../bos/services/b_srv_mqtt.c ****         }
 389:../../bos/services/b_srv_mqtt.c ****         rc = _bMqttRead(pinstance, &i, 1);
 390:../../bos/services/b_srv_mqtt.c ****         if (rc != 1)
 391:../../bos/services/b_srv_mqtt.c ****         {
 392:../../bos/services/b_srv_mqtt.c ****             len = 0;
 393:../../bos/services/b_srv_mqtt.c ****             b_log_e("bMqttRead failed\r\n");
 394:../../bos/services/b_srv_mqtt.c ****             goto exit;
 395:../../bos/services/b_srv_mqtt.c ****         }
 396:../../bos/services/b_srv_mqtt.c ****         *value += (i & 127) * multiplier;
 397:../../bos/services/b_srv_mqtt.c ****         multiplier *= 128;
 398:../../bos/services/b_srv_mqtt.c ****     } while ((i & 128) != 0);
 399:../../bos/services/b_srv_mqtt.c **** exit:
 400:../../bos/services/b_srv_mqtt.c ****     return len;
 401:../../bos/services/b_srv_mqtt.c **** }
