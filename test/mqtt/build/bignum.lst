 205:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /*
 206:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * Enlarge to the specified number of limbs
 207:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  */
 208:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** int mbedtls_mpi_grow(mbedtls_mpi *X, size_t nblimbs)
 209:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** {
 210:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi_uint *p;
 211:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 212:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (nblimbs > MBEDTLS_MPI_MAX_LIMBS) {
 213:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         return MBEDTLS_ERR_MPI_ALLOC_FAILED;
 214:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
 215:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 216:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (X->n < nblimbs) {
 217:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         if ((p = (mbedtls_mpi_uint *) mbedtls_calloc(nblimbs, ciL)) == NULL) {
 218:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             return MBEDTLS_ERR_MPI_ALLOC_FAILED;
