1330:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /*
1331:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * Algorithm D, Section 4.3.1 - The Art of Computer Programming
1332:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *   Vol. 2 - Seminumerical Algorithms, Knuth
1333:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      */
1334:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1335:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /*
1336:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * Normalize the divisor, d, and dividend, u0, u1
1337:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      */
1338:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     s = mbedtls_mpi_core_clz(d);
1339:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     d = d << s;
