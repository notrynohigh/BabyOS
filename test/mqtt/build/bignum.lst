1309:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             *r = ~(mbedtls_mpi_uint) 0u;
1310:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         }
1311:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1312:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         return ~(mbedtls_mpi_uint) 0u;
1313:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1314:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1315:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** #if defined(MBEDTLS_HAVE_UDBL)
1316:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     dividend  = (mbedtls_t_udbl) u1 << biL;
1317:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     dividend |= (mbedtls_t_udbl) u0;
1318:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     quotient = dividend / d;
1319:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (quotient > ((mbedtls_t_udbl) 1 << biL) - 1) {
