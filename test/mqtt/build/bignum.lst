 239:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** int mbedtls_mpi_shrink(mbedtls_mpi *X, size_t nblimbs)
 240:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** {
 241:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi_uint *p;
 242:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     size_t i;
 243:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 244:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (nblimbs > MBEDTLS_MPI_MAX_LIMBS) {
 245:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         return MBEDTLS_ERR_MPI_ALLOC_FAILED;
 246:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
 247:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 248:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /* Actually resize up if there are currently fewer than nblimbs limbs. */
 249:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (X->n <= nblimbs) {
