1066:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     for (n = B->n; n > 0; n--) {
1067:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         if (B->p[n - 1] != 0) {
1068:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             break;
1069:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         }
1070:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1071:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (n > A->n) {
1072:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         /* B >= (2^ciL)^n > A */
1073:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         ret = MBEDTLS_ERR_MPI_NEGATIVE_VALUE;
