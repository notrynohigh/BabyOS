 251:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
 252:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /* After this point, then X->n > nblimbs and in particular X->n > 0. */
 253:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 254:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     for (i = X->n - 1; i > 0; i--) {
 255:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         if (X->p[i] != 0) {
 256:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             break;
 257:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         }
 258:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
