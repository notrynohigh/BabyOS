1389:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /*
1390:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * Division by mbedtls_mpi: A = Q * B + R  (HAC 14.20)
1391:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  */
1392:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** int mbedtls_mpi_div_mpi(mbedtls_mpi *Q, mbedtls_mpi *R, const mbedtls_mpi *A,
1393:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                         const mbedtls_mpi *B)
1394:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** {
1395:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
1396:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     size_t i, n, t, k;
1397:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi X, Y, Z, T1, T2;
1398:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi_uint TP2[3];
1399:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1400:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (mbedtls_mpi_cmp_int(B, 0) == 0) {
1401:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         return MBEDTLS_ERR_MPI_DIVISION_BY_ZERO;
1402:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
