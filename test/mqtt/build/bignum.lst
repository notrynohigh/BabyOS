2243:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                  * First, check small factors for X and Y
2244:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                  * before doing Miller-Rabin on any of them
2245:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                  */
2246:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                 if ((ret = mpi_check_small_factors(X)) == 0 &&
2247:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                     (ret = mpi_check_small_factors(&Y)) == 0 &&
2248:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                     (ret = mpi_miller_rabin(X, rounds, f_rng, p_rng))
2249:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                     == 0 &&
