1185:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1186:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     return mbedtls_mpi_sub_mpi(X, A, &B);
1187:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** }
1188:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1189:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /*
1190:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * Baseline multiplication: X = A * B  (HAC 14.12)
1191:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  */
1192:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** int mbedtls_mpi_mul_mpi(mbedtls_mpi *X, const mbedtls_mpi *A, const mbedtls_mpi *B)
1193:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** {
1194:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
1195:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     size_t i, j;
1196:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi TA, TB;
1197:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     int result_is_zero = 0;
1198:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1199:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi_init(&TA);
1200:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi_init(&TB);
1201:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1202:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (X == A) {
1203:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&TA, A)); A = &TA;
1204:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1205:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (X == B) {
1206:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&TB, B)); B = &TB;
1207:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1208:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1209:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     for (i = A->n; i > 0; i--) {
1210:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         if (A->p[i - 1] != 0) {
1211:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             break;
1212:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         }
1213:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1214:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (i == 0) {
1215:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         result_is_zero = 1;
1216:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1217:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1218:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     for (j = B->n; j > 0; j--) {
1219:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         if (B->p[j - 1] != 0) {
1220:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             break;
1221:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         }
1222:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1223:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (j == 0) {
1224:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         result_is_zero = 1;
1225:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1226:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1227:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_grow(X, i + j));
1228:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_lset(X, 0));
1229:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1230:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi_core_mul(X->p, A->p, i, B->p, j);
1231:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1232:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /* If the result is 0, we don't shortcut the operation, which reduces
1233:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * but does not eliminate side channels leaking the zero-ness. We do
1234:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * need to take care to set the sign bit properly since the library does
1235:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * not fully support an MPI object with a value of 0 and s == -1. */
1236:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (result_is_zero) {
GAS LISTING /tmp/ccGAqckk.s 			page 145


1237:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         X->s = 1;
1238:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     } else {
1239:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         X->s = A->s * B->s;
1240:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1241:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1242:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** cleanup:
1243:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1244:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi_free(&TB); mbedtls_mpi_free(&TA);
1245:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1246:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     return ret;
1247:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** }
1248:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1249:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /*
1250:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * Baseline multiplication: X = A * b
1251:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  */
1252:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** int mbedtls_mpi_mul_int(mbedtls_mpi *X, const mbedtls_mpi *A, mbedtls_mpi_uint b)
1253:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** {
1254:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     size_t n = A->n;
1255:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     while (n > 0 && A->p[n - 1] == 0) {
1256:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         --n;
1257:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1258:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1259:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /* The general method below doesn't work if b==0. */
1260:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (b == 0 || n == 0) {
1261:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         return mbedtls_mpi_lset(X, 0);
1262:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1263:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1264:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /* Calculate A*b as A + A*(b-1) to take advantage of mbedtls_mpi_core_mla */
1265:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
1266:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /* In general, A * b requires 1 limb more than b. If
1267:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * A->p[n - 1] * b / b == A->p[n - 1], then A * b fits in the same
1268:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * number of limbs as A and the call to grow() is not required since
1269:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * copy() will take care of the growth if needed. However, experimentally,
1270:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * making the call to grow() unconditional causes slightly fewer
1271:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * calls to calloc() in ECP code, presumably because it reuses the
1272:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * same mpi for a while and this way the mpi is more likely to directly
1273:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * grow to its final size.
1274:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *
1275:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * Note that calculating A*b as 0 + A*b doesn't work as-is because
1276:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * A,X can be the same. */
1277:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_grow(X, n + 1));
1278:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_copy(X, A));
1279:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi_core_mla(X->p, X->n, A->p, n, b - 1);
1280:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1281:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** cleanup:
1282:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     return ret;
1283:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** }
1284:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1285:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /*
1286:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * Unsigned integer divide - double mbedtls_mpi_uint dividend, u1/u0, and
1287:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * mbedtls_mpi_uint divisor, d
1288:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  */
1289:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** static mbedtls_mpi_uint mbedtls_int_div_int(mbedtls_mpi_uint u1,
1290:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                                             mbedtls_mpi_uint u0,
1291:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                                             mbedtls_mpi_uint d,
1292:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                                             mbedtls_mpi_uint *r)
1293:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** {
GAS LISTING /tmp/ccGAqckk.s 			page 146


1294:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** #if defined(MBEDTLS_HAVE_UDBL)
1295:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_t_udbl dividend, quotient;
1296:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** #else
1297:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     const mbedtls_mpi_uint radix = (mbedtls_mpi_uint) 1 << biH;
1298:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     const mbedtls_mpi_uint uint_halfword_mask = ((mbedtls_mpi_uint) 1 << biH) - 1;
1299:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi_uint d0, d1, q0, q1, rAX, r0, quotient;
1300:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi_uint u0_msw, u0_lsw;
1301:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     size_t s;
1302:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** #endif
1303:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1304:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /*
1305:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * Check for overflow
1306:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      */
1307:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (0 == d || u1 >= d) {
