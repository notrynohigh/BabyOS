 282:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /* Resize X to have exactly n limbs and set it to 0. */
 283:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** static int mbedtls_mpi_resize_clear(mbedtls_mpi *X, size_t limbs)
