1108:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /* Common function for signed addition and subtraction.
1109:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * Calculate A + B * flip_B where flip_B is 1 or -1.
1110:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  */
1111:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** static int add_sub_mpi(mbedtls_mpi *X,
1112:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                        const mbedtls_mpi *A, const mbedtls_mpi *B,
1113:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                        int flip_B)
1114:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** {
1115:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     int ret, s;
1116:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1117:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     s = A->s;
1118:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (A->s * B->s * flip_B < 0) {
1119:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         int cmp = mbedtls_mpi_cmp_abs(A, B);
1120:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         if (cmp >= 0) {
1121:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             MBEDTLS_MPI_CHK(mbedtls_mpi_sub_abs(X, A, B));
1122:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             /* If |A| = |B|, the result is 0 and we must set the sign bit
GAS LISTING /tmp/ccGAqckk.s 			page 143


1123:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****              * to +1 regardless of which of A or B was negative. Otherwise,
1124:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****              * since |A| > |B|, the sign is the sign of A. */
1125:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             X->s = cmp == 0 ? 1 : s;
1126:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         } else {
1127:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             MBEDTLS_MPI_CHK(mbedtls_mpi_sub_abs(X, B, A));
1128:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             /* Since |A| < |B|, the sign is the opposite of A. */
1129:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             X->s = -s;
1130:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         }
1131:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     } else {
1132:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_add_abs(X, A, B));
1133:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         X->s = s;
1134:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1135:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1136:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** cleanup:
1137:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
