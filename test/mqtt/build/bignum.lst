 264:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 265:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if ((p = (mbedtls_mpi_uint *) mbedtls_calloc(i, ciL)) == NULL) {
 266:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         return MBEDTLS_ERR_MPI_ALLOC_FAILED;
 267:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
 268:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 269:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (X->p != NULL) {
 270:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         memcpy(p, X->p, i * ciL);
 271:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         mbedtls_mpi_zeroize_and_free(X->p, X->n);
 272:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
 273:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 274:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /* i fits in n because we ensure that MBEDTLS_MPI_MAX_LIMBS
 275:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * fits, and we've checked that i <= nblimbs <= MBEDTLS_MPI_MAX_LIMBS. */
 276:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     X->n = (unsigned short) i;
 277:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     X->p = p;
