1723:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /*
1724:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * Greatest common divisor: G = gcd(A, B)  (HAC 14.54)
1725:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  */
1726:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** int mbedtls_mpi_gcd(mbedtls_mpi *G, const mbedtls_mpi *A, const mbedtls_mpi *B)
1727:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** {
1728:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
1729:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     size_t lz, lzt;
1730:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi TA, TB;
1731:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1732:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi_init(&TA); mbedtls_mpi_init(&TB);
1733:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1734:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&TA, A));
1735:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&TB, B));
1736:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1737:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     lz = mbedtls_mpi_lsb(&TA);
1738:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     lzt = mbedtls_mpi_lsb(&TB);
1739:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1740:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /* The loop below gives the correct result when A==0 but not when B==0.
1741:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * So have a special case for B==0. Leverage the fact that we just
1742:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * calculated the lsb and lsb(B)==0 iff B is odd or 0 to make the test
1743:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * slightly more efficient than cmp_int(). */
1744:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (lzt == 0 && mbedtls_mpi_get_bit(&TB, 0) == 0) {
1745:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         ret = mbedtls_mpi_copy(G, A);
1746:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         goto cleanup;
1747:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1748:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1749:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (lzt < lz) {
GAS LISTING /tmp/ccGAqckk.s 			page 154


1750:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         lz = lzt;
1751:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1752:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1753:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     TA.s = TB.s = 1;
1754:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1755:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /* We mostly follow the procedure described in HAC 14.54, but with some
1756:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * minor differences:
1757:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * - Sequences of multiplications or divisions by 2 are grouped into a
1758:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *   single shift operation.
1759:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * - The procedure in HAC assumes that 0 < TB <= TA.
1760:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *     - The condition TB <= TA is not actually necessary for correctness.
1761:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *       TA and TB have symmetric roles except for the loop termination
1762:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *       condition, and the shifts at the beginning of the loop body
1763:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *       remove any significance from the ordering of TA vs TB before
1764:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *       the shifts.
1765:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *     - If TA = 0, the loop goes through 0 iterations and the result is
1766:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *       correctly TB.
1767:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *     - The case TB = 0 was short-circuited above.
1768:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *
1769:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * For the correctness proof below, decompose the original values of
1770:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * A and B as
1771:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *   A = sa * 2^a * A' with A'=0 or A' odd, and sa = +-1
1772:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *   B = sb * 2^b * B' with B'=0 or B' odd, and sb = +-1
1773:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * Then gcd(A, B) = 2^{min(a,b)} * gcd(A',B'),
1774:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * and gcd(A',B') is odd or 0.
1775:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *
1776:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * At the beginning, we have TA = |A| and TB = |B| so gcd(A,B) = gcd(TA,TB).
1777:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * The code maintains the following invariant:
1778:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *     gcd(A,B) = 2^k * gcd(TA,TB) for some k   (I)
1779:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      */
1780:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1781:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /* Proof that the loop terminates:
1782:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * At each iteration, either the right-shift by 1 is made on a nonzero
1783:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * value and the nonnegative integer bitlen(TA) + bitlen(TB) decreases
1784:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * by at least 1, or the right-shift by 1 is made on zero and then
1785:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * TA becomes 0 which ends the loop (TB cannot be 0 if it is right-shifted
1786:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * since in that case TB is calculated from TB-TA with the condition TB>TA).
1787:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      */
1788:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     while (mbedtls_mpi_cmp_int(&TA, 0) != 0) {
1789:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         /* Divisions by 2 preserve the invariant (I). */
1790:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&TA, mbedtls_mpi_lsb(&TA)));
1791:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&TB, mbedtls_mpi_lsb(&TB)));
1792:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1793:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         /* Set either TA or TB to |TA-TB|/2. Since TA and TB are both odd,
1794:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****          * TA-TB is even so the division by 2 has an integer result.
1795:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****          * Invariant (I) is preserved since any odd divisor of both TA and TB
1796:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****          * also divides |TA-TB|/2, and any odd divisor of both TA and |TA-TB|/2
1797:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****          * also divides TB, and any odd divisor of both TB and |TA-TB|/2 also
1798:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****          * divides TA.
1799:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****          */
1800:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         if (mbedtls_mpi_cmp_mpi(&TA, &TB) >= 0) {
1801:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             MBEDTLS_MPI_CHK(mbedtls_mpi_sub_abs(&TA, &TA, &TB));
1802:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&TA, 1));
1803:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         } else {
1804:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             MBEDTLS_MPI_CHK(mbedtls_mpi_sub_abs(&TB, &TB, &TA));
1805:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&TB, 1));
1806:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         }
GAS LISTING /tmp/ccGAqckk.s 			page 155


1807:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         /* Note that one of TA or TB is still odd. */
1808:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1809:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1810:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /* By invariant (I), gcd(A,B) = 2^k * gcd(TA,TB) for some k.
1811:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * At the loop exit, TA = 0, so gcd(TA,TB) = TB.
1812:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * - If there was at least one loop iteration, then one of TA or TB is odd,
1813:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *   and TA = 0, so TB is odd and gcd(TA,TB) = gcd(A',B'). In this case,
1814:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *   lz = min(a,b) so gcd(A,B) = 2^lz * TB.
1815:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * - If there was no loop iteration, then A was 0, and gcd(A,B) = B.
1816:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      *   In this case, lz = 0 and B = TB so gcd(A,B) = B = 2^lz * TB as well.
1817:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      */
1818:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
