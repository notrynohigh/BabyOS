1341:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     u1 = u1 << s;
1342:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     u1 |= (u0 >> (biL - s)) & (-(mbedtls_mpi_sint) s >> (biL - 1));
1343:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     u0 =  u0 << s;
1344:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1345:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     d1 = d >> biH;
1346:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     d0 = d & uint_halfword_mask;
1347:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1348:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     u0_msw = u0 >> biH;
1349:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     u0_lsw = u0 & uint_halfword_mask;
1350:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
GAS LISTING /tmp/ccGAqckk.s 			page 147


1351:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /*
1352:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * Find the first quotient and remainder
1353:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      */
1354:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     q1 = u1 / d1;
1355:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     r0 = u1 - d1 * q1;
1356:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1357:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     while (q1 >= radix || (q1 * d0 > radix * r0 + u0_msw)) {
1358:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         q1 -= 1;
1359:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         r0 += d1;
1360:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1361:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         if (r0 >= radix) {
1362:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             break;
1363:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         }
1364:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1365:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1366:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     rAX = (u1 * radix) + (u0_msw - q1 * d);
1367:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     q0 = rAX / d1;
1368:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     r0 = rAX - q0 * d1;
1369:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1370:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     while (q0 >= radix || (q0 * d0 > radix * r0 + u0_lsw)) {
1371:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         q0 -= 1;
1372:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         r0 += d1;
1373:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1374:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         if (r0 >= radix) {
1375:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             break;
