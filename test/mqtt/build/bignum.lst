1377:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1378:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1379:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (r != NULL) {
1380:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         *r = (rAX * radix + u0_lsw - q0 * d) >> s;
1381:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
1382:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1383:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     quotient = q1 * radix + q0;
1384:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
1385:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     return quotient;
1386:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** #endif
1387:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** }
