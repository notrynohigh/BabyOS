  42:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /*
  43:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * Conditionally select an MPI sign in constant time.
  44:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * (MPI sign is the field s in mbedtls_mpi. It is unsigned short and only 1 and -1 are valid
  45:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * values.)
  46:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  */
  47:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** static inline signed short mbedtls_ct_mpi_sign_if(mbedtls_ct_condition_t cond,
  48:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                                                   signed short sign1, signed short sign2)
  49:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** {
GAS LISTING /tmp/ccGAqckk.s 			page 2


  50:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     return (signed short) mbedtls_ct_uint_if(cond, sign1 + 1, sign2 + 1) - 1;
  51:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** }
  52:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
  53:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /*
  54:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * Compare signed values in constant time
  55:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  */
  56:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** int mbedtls_mpi_lt_mpi_ct(const mbedtls_mpi *X,
  57:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                           const mbedtls_mpi *Y,
  58:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                           unsigned *ret)
  59:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** {
  60:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_ct_condition_t different_sign, X_is_negative, Y_is_negative, result;
  61:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
  62:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (X->n != Y->n) {
  63:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;
  64:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
  65:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
  66:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /*
  67:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * Set N_is_negative to MBEDTLS_CT_FALSE if N >= 0, MBEDTLS_CT_TRUE if N < 0.
  68:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * We know that N->s == 1 if N >= 0 and N->s == -1 if N < 0.
  69:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      */
  70:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     X_is_negative = mbedtls_ct_bool((X->s & 2) >> 1);
  71:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     Y_is_negative = mbedtls_ct_bool((Y->s & 2) >> 1);
  72:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
  73:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /*
  74:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * If the signs are different, then the positive operand is the bigger.
  75:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * That is if X is negative (X_is_negative == 1), then X < Y is true and it
  76:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * is false if X is positive (X_is_negative == 0).
  77:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      */
  78:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     different_sign = mbedtls_ct_bool_ne(X_is_negative, Y_is_negative); // true if different sign
  79:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     result = mbedtls_ct_bool_and(different_sign, X_is_negative);
  80:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
  81:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /*
  82:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * Assuming signs are the same, compare X and Y. We switch the comparison
  83:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * order if they are negative so that we get the right result, regardles of
  84:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * sign.
  85:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      */
  86:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
  87:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /* This array is used to conditionally swap the pointers in const time */
  88:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     void * const p[2] = { X->p, Y->p };
  89:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     size_t i = mbedtls_ct_size_if_else_0(X_is_negative, 1);
  90:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_ct_condition_t lt = mbedtls_mpi_core_lt_ct(p[i], p[i ^ 1], X->n);
  91:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
  92:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     /*
  93:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * Store in result iff the signs are the same (i.e., iff different_sign == false). If
  94:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      * the signs differ, result has already been set, so we don't change it.
  95:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****      */
  96:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     result = mbedtls_ct_bool_or(result,
  97:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                                 mbedtls_ct_bool_and(mbedtls_ct_bool_not(different_sign), lt));
  98:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
  99:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     *ret = mbedtls_ct_uint_if_else_0(result, 1);
 100:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 101:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     return 0;
 102:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** }
 103:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 104:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /*
 105:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * Conditionally assign X = Y, without leaking information
 106:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * about whether the assignment was made or not.
GAS LISTING /tmp/ccGAqckk.s 			page 3


 107:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * (Leaking information about the respective sizes of X and Y is ok however.)
 108:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  */
 109:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** #if defined(_MSC_VER) && defined(MBEDTLS_PLATFORM_IS_WINDOWS_ON_ARM64) && \
 110:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     (_MSC_FULL_VER < 193131103)
 111:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /*
 112:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * MSVC miscompiles this function if it's inlined prior to Visual Studio 2022 version 17.1. See:
 113:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * https://developercommunity.visualstudio.com/t/c-compiler-miscompiles-part-of-mbedtls-library-on/
 114:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  */
 115:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** __declspec(noinline)
 116:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** #endif
 117:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** int mbedtls_mpi_safe_cond_assign(mbedtls_mpi *X,
 118:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                                  const mbedtls_mpi *Y,
 119:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                                  unsigned char assign)
 120:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** {
 121:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     int ret = 0;
 122:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 123:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_grow(X, Y->n));
 124:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 125:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     {
 126:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         mbedtls_ct_condition_t do_assign = mbedtls_ct_bool(assign);
 127:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 128:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         X->s = mbedtls_ct_mpi_sign_if(do_assign, Y->s, X->s);
 129:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 130:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         mbedtls_mpi_core_cond_assign(X->p, Y->p, Y->n, do_assign);
 131:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 132:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         mbedtls_ct_condition_t do_not_assign = mbedtls_ct_bool_not(do_assign);
 133:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         for (size_t i = Y->n; i < X->n; i++) {
 134:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****             X->p[i] = mbedtls_ct_mpi_uint_if_else_0(do_not_assign, X->p[i]);
 135:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         }
 136:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
 137:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 138:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** cleanup:
 139:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     return ret;
 140:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** }
 141:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 142:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** /*
 143:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * Conditionally swap X and Y, without leaking information
 144:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * about whether the swap was made or not.
 145:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * Here it is not ok to simply swap the pointers, which would lead to
 146:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  * different memory access patterns when X and Y are used afterwards.
 147:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****  */
 148:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** int mbedtls_mpi_safe_cond_swap(mbedtls_mpi *X,
 149:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                                mbedtls_mpi *Y,
 150:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****                                unsigned char swap)
 151:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** {
 152:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     int ret = 0;
 153:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     int s;
 154:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 155:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     if (X == Y) {
 156:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****         return 0;
 157:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     }
 158:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 159:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_ct_condition_t do_swap = mbedtls_ct_bool(swap);
 160:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 161:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_grow(X, Y->n));
 162:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_grow(Y, X->n));
 163:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
GAS LISTING /tmp/ccGAqckk.s 			page 4


 164:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     s = X->s;
 165:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     X->s = mbedtls_ct_mpi_sign_if(do_swap, Y->s, X->s);
 166:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     Y->s = mbedtls_ct_mpi_sign_if(do_swap, s, Y->s);
 167:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 168:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     mbedtls_mpi_core_cond_swap(X->p, Y->p, X->n, do_swap);
 169:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** 
 170:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** cleanup:
 171:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c ****     return ret;
 172:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum.c **** }
