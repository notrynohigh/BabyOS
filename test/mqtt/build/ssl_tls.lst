1134:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     mbedtls_svc_key_id_t psa_mac_dec;           /*!<  MAC (decryption)        */
1135:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     psa_algorithm_t psa_mac_alg;                /*!<  psa MAC algorithm       */
1136:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #else
1137:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     mbedtls_md_context_t md_ctx_enc;            /*!<  MAC (encryption)        */
1138:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     mbedtls_md_context_t md_ctx_dec;            /*!<  MAC (decryption)        */
1139:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #endif /* MBEDTLS_USE_PSA_CRYPTO */
1140:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
