 666:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     /** Minimum TLS version to be negotiated.
 667:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      *
 668:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * It is set up in the ClientHello writing preparation stage and used
 669:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * throughout the ClientHello writing. Not relevant anymore as soon as
 670:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * the protocol version has been negotiated thus as soon as the
 671:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * ServerHello is received.
 672:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * For a fresh handshake not linked to any previous handshake, it is
 673:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * equal to the configured minimum minor version to be negotiated. When
 674:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * renegotiating or resuming a session, it is equal to the previously
 675:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * negotiated minor version.
 676:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      *
 677:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * There is no maximum TLS version field in this handshake context.
 678:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * From the start of the handshake, we need to define a current protocol
 679:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * version for the record layer which we define as the maximum TLS
 680:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * version to be negotiated. The `tls_version` field of the SSL context is
 681:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * used to store this maximum value until it contains the actual
 682:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      * negotiated value.
 683:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****      */
 684:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     mbedtls_ssl_protocol_version min_tls_version;
 685:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #endif
