2167:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
2168:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     MBEDTLS_SSL_EARLY_DATA_STATE_NO_IND_SENT,
2169:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
2170:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /*
2171:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * The client has sent an early data indication extension in its first
2172:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * ClientHello, it has not received the response (ServerHello or
2173:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * HelloRetryRequest) from the server yet. The transform to protect early data
2174:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * is not set either as for middlebox compatibility a dummy CCS may have to be
2175:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * sent in clear. Early data cannot be sent to the server yet.
2176:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
2177:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     MBEDTLS_SSL_EARLY_DATA_STATE_IND_SENT,
2178:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
2179:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /*
2180:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * The client has sent an early data indication extension in its first
2181:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * ClientHello, it has not received the response (ServerHello or
2182:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * HelloRetryRequest) from the server yet. The transform to protect early data
2183:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * has been set and early data can be written now.
2184:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
2185:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     MBEDTLS_SSL_EARLY_DATA_STATE_CAN_WRITE,
2186:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
2187:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /*
2188:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * The client has indicated the use of early data and the server has accepted
2189:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * it.
2190:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
2191:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     MBEDTLS_SSL_EARLY_DATA_STATE_ACCEPTED,
2192:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
2193:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /*
2194:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * The client has indicated the use of early data but the server has rejected
2195:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * it.
2196:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
2197:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     MBEDTLS_SSL_EARLY_DATA_STATE_REJECTED,
2198:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
2199:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /*
2200:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * The client has sent an early data indication extension in its first
2201:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * ClientHello, the server has accepted them and the client has received the
2202:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * server Finished message. It cannot send early data to the server anymore.
2203:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
