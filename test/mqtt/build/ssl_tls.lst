4996:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c **** /*
4997:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * Serialize a full SSL context
4998:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
4999:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * The format of the serialized data is:
5000:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * (in the presentation language of TLS, RFC 8446 section 3)
5001:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
5002:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  // header
5003:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  opaque mbedtls_version[3];   // major, minor, patch
5004:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  opaque context_format[5];    // version-specific field determining
5005:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *                               // the format of the remaining
5006:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *                               // serialized data.
5007:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  Note: When updating the format, remember to keep these
GAS LISTING /tmp/ccqtSeIp.s 			page 89


5008:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *        version+format bytes. (We may make their size part of the API.)
5009:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
5010:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  // session sub-structure
5011:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  opaque session<1..2^32-1>;  // see mbedtls_ssl_session_save()
5012:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  // transform sub-structure
5013:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  uint8 random[64];           // ServerHello.random+ClientHello.random
5014:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  uint8 in_cid<0..2^8-1>      // Connection ID: expected incoming value
5015:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  uint8 out_cid<0..2^8-1>     // Connection ID: outgoing value to use
5016:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  // fields from ssl_context
5017:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  uint32 badmac_seen;         // DTLS: number of records with failing MAC
5018:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  uint64 in_window_top;       // DTLS: last validated record seq_num
5019:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  uint64 in_window;           // DTLS: bitmask for replay protection
5020:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  uint8 disable_datagram_packing; // DTLS: only one record per datagram
5021:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  uint64 cur_out_ctr;         // Record layer: outgoing sequence number
5022:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  uint16 mtu;                 // DTLS: path mtu (max outgoing fragment size)
5023:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  uint8 alpn_chosen<0..2^8-1> // ALPN: negotiated application protocol
5024:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
5025:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * Note that many fields of the ssl_context or sub-structures are not
5026:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * serialized, as they fall in one of the following categories:
5027:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
5028:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  1. forced value (eg in_left must be 0)
5029:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  2. pointer to dynamically-allocated memory (eg session, transform)
5030:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  3. value can be re-derived from other data (eg session keys from MS)
5031:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  4. value was temporary (eg content of input buffer)
5032:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *  5. value will be provided by the user again (eg I/O callbacks and context)
5033:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  */
5034:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c **** int mbedtls_ssl_context_save(mbedtls_ssl_context *ssl,
5035:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****                              unsigned char *buf,
5036:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****                              size_t buf_len,
5037:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****                              size_t *olen)
5038:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c **** {
5039:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     unsigned char *p = buf;
5040:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     size_t used = 0;
5041:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     size_t session_len;
5042:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     int ret = 0;
5043:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c **** 
5044:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     /*
5045:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****      * Enforce usage restrictions, see "return BAD_INPUT_DATA" in
5046:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****      * this function's documentation.
5047:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****      *
5048:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****      * These are due to assumptions/limitations in the implementation. Some of
5049:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****      * them are likely to stay (no handshake in progress) some might go away
5050:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****      * (only DTLS) but are currently used to simplify the implementation.
5051:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****      */
5052:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     /* The initial handshake must be over */
5053:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     if (mbedtls_ssl_is_handshake_over(ssl) == 0) {
5054:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****         MBEDTLS_SSL_DEBUG_MSG(1, ("Initial handshake isn't over"));
5055:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****         return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
5056:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     }
5057:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     if (ssl->handshake != NULL) {
5058:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****         MBEDTLS_SSL_DEBUG_MSG(1, ("Handshake isn't completed"));
5059:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****         return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
5060:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     }
5061:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     /* Double-check that sub-structures are indeed ready */
5062:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     if (ssl->transform == NULL || ssl->session == NULL) {
5063:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****         MBEDTLS_SSL_DEBUG_MSG(1, ("Serialised structures aren't ready"));
5064:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****         return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
GAS LISTING /tmp/ccqtSeIp.s 			page 90


5065:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     }
5066:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     /* There must be no pending incoming or outgoing data */
5067:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     if (mbedtls_ssl_check_pending(ssl) != 0) {
5068:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****         MBEDTLS_SSL_DEBUG_MSG(1, ("There is pending incoming data"));
5069:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****         return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
5070:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     }
5071:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     if (ssl->out_left != 0) {
5072:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****         MBEDTLS_SSL_DEBUG_MSG(1, ("There is pending outgoing data"));
5073:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****         return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
5074:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     }
5075:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     /* Protocol must be DTLS, not TLS */
5076:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     if (ssl->conf->transport != MBEDTLS_SSL_TRANSPORT_DATAGRAM) {
5077:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****         MBEDTLS_SSL_DEBUG_MSG(1, ("Only DTLS is supported"));
5078:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****         return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
