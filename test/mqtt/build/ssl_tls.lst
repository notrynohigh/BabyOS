 200:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c **** #if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH)
 201:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c **** /*
 202:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * Convert max_fragment_length codes to length.
 203:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * RFC 6066 says:
 204:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *    enum{
 205:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *        2^9(1), 2^10(2), 2^11(3), 2^12(4), (255)
 206:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *    } MaxFragmentLength;
 207:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * and we add 0 -> extension unused
 208:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  */
 209:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c **** static unsigned int ssl_mfl_code_to_length(int mfl)
 210:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c **** {
 211:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****     switch (mfl) {
