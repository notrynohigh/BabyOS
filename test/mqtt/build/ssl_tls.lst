   6:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** /*
   7:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *  Copyright The Mbed TLS Contributors
   8:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later
