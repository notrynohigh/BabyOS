9544:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * Function for writing a signature algorithm extension.
9545:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
9546:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * The `extension_data` field of signature algorithm contains  a `SignatureSchemeList`
9547:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * value (TLS 1.3 RFC8446):
9548:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *      enum {
9549:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *         ....
9550:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *        ecdsa_secp256r1_sha256( 0x0403 ),
9551:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *        ecdsa_secp384r1_sha384( 0x0503 ),
9552:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *        ecdsa_secp521r1_sha512( 0x0603 ),
9553:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *         ....
9554:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *      } SignatureScheme;
9555:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
9556:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *      struct {
9557:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *         SignatureScheme supported_signature_algorithms<2..2^16-2>;
9558:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *      } SignatureSchemeList;
9559:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
9560:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * The `extension_data` field of signature algorithm contains a `SignatureAndHashAlgorithm`
9561:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * value (TLS 1.2 RFC5246):
9562:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *      enum {
9563:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *          none(0), md5(1), sha1(2), sha224(3), sha256(4), sha384(5),
9564:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *          sha512(6), (255)
9565:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *      } HashAlgorithm;
9566:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
9567:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *      enum { anonymous(0), rsa(1), dsa(2), ecdsa(3), (255) }
9568:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *        SignatureAlgorithm;
9569:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
9570:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *      struct {
9571:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *          HashAlgorithm hash;
9572:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *          SignatureAlgorithm signature;
9573:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *      } SignatureAndHashAlgorithm;
9574:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
9575:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *      SignatureAndHashAlgorithm
9576:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *        supported_signature_algorithms<2..2^16-2>;
9577:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
9578:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * The TLS 1.3 signature algorithm extension was defined to be a compatible
9579:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * generalization of the TLS 1.2 signature algorithm extension.
9580:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * `SignatureAndHashAlgorithm` field of TLS 1.2 can be represented by
9581:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  * `SignatureScheme` field of TLS 1.3
9582:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  *
9583:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_tls.c ****  */
