 199:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c **** /*
 200:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c ****  * Derive a suitable integer for group grp from a buffer of length len
 201:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c ****  * SEC1 4.1.3 step 5 aka SEC1 4.1.4 step 3
 202:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c ****  */
 203:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c **** static int derive_mpi(const mbedtls_ecp_group *grp, mbedtls_mpi *x,
 204:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c ****                       const unsigned char *buf, size_t blen)
 205:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c **** {
 206:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
 207:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c ****     size_t n_size = (grp->nbits + 7) / 8;
 208:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c ****     size_t use_size = blen > n_size ? n_size : blen;
 209:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c **** 
 210:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(x, buf, use_size));
 211:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c ****     if (use_size * 8 > grp->nbits) {
 212:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(x, use_size * 8 - grp->nbits));
 213:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c ****     }
 214:../../bos/thirdparty/mbedtls/bos_mbedtls/ecdsa.c **** 
