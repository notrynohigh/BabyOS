  48:../../bos/thirdparty/mbedtls/bos_mbedtls/pem.c ****                       size_t iv_len)
  49:../../bos/thirdparty/mbedtls/bos_mbedtls/pem.c **** {
  50:../../bos/thirdparty/mbedtls/bos_mbedtls/pem.c ****     size_t i, j, k;
  51:../../bos/thirdparty/mbedtls/bos_mbedtls/pem.c **** 
  52:../../bos/thirdparty/mbedtls/bos_mbedtls/pem.c ****     memset(iv, 0, iv_len);
  53:../../bos/thirdparty/mbedtls/bos_mbedtls/pem.c **** 
  54:../../bos/thirdparty/mbedtls/bos_mbedtls/pem.c ****     for (i = 0; i < iv_len * 2; i++, s++) {
  55:../../bos/thirdparty/mbedtls/bos_mbedtls/pem.c ****         if (*s >= '0' && *s <= '9') {
  56:../../bos/thirdparty/mbedtls/bos_mbedtls/pem.c ****             j = *s - '0';
  57:../../bos/thirdparty/mbedtls/bos_mbedtls/pem.c ****         } else
  58:../../bos/thirdparty/mbedtls/bos_mbedtls/pem.c ****         if (*s >= 'A' && *s <= 'F') {
