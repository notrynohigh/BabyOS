 124:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h **** /**
GAS LISTING /tmp/cc6I7rsZ.s 			page 20


 125:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * \brief Combines a high-level and low-level error code together.
 126:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *
 127:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *        This function can be called directly however it is usually
 128:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *        called via the #MBEDTLS_ERROR_ADD macro.
 129:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *
 130:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *        While a value of zero is not a negative error code, it is still an
 131:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *        error code (that denotes success) and can be combined with both a
 132:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *        negative error code or another value of zero.
 133:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *
 134:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * \note  When invasive testing is enabled via #MBEDTLS_TEST_HOOKS, also try to
 135:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *        call \link mbedtls_test_hook_error_add \endlink.
 136:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *
 137:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * \param high      high-level error code. See error.h for more details.
 138:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * \param low       low-level error code. See error.h for more details.
 139:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * \param file      file where this error code addition occurred.
 140:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * \param line      line where this error code addition occurred.
 141:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  */
 142:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h **** static inline int mbedtls_error_add(int high, int low,
 357              		.loc 3 142 19 view .LVU108
