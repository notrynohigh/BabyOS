  90:../../bos/utils/inc/b_util_list.h **** static __INLINE_DEF void __list_add(struct list_head *newItem, struct list_head *prev,
  91:../../bos/utils/inc/b_util_list.h ****                                     struct list_head *next)
  92:../../bos/utils/inc/b_util_list.h **** {
  93:../../bos/utils/inc/b_util_list.h ****     next->prev    = newItem;
  94:../../bos/utils/inc/b_util_list.h ****     newItem->next = next;
  95:../../bos/utils/inc/b_util_list.h ****     newItem->prev = prev;
  96:../../bos/utils/inc/b_util_list.h ****     WRITE_ONCE(prev->next, newItem);
