 190:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     }
 191:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c **** 
 192:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     /* Check length, subtract one for actual bit string length */
 193:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     if (bs->len < 1) {
 194:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         return MBEDTLS_ERR_ASN1_OUT_OF_DATA;
 195:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     }
 196:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     bs->len -= 1;
 197:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c **** 
 198:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     /* Get number of unused bits, ensure unused bits <= 7 */
 199:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     bs->unused_bits = **p;
 200:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     if (bs->unused_bits > 7) {
 201:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         return MBEDTLS_ERR_ASN1_INVALID_LENGTH;
 202:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     }
 203:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     (*p)++;
 204:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c **** 
 205:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     /* Get actual bitstring */
 206:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     bs->p = *p;
 207:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     *p += bs->len;
 208:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c **** 
 209:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     if (*p != end) {
 210:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         return MBEDTLS_ERR_ASN1_LENGTH_MISMATCH;
 211:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     }
