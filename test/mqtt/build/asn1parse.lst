 184:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c **** {
 185:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
 186:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c **** 
 187:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     /* Certificate type is a single byte bitstring */
 188:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     if ((ret = mbedtls_asn1_get_tag(p, end, &bs->len, MBEDTLS_ASN1_BIT_STRING)) != 0) {
