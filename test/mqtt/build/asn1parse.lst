 111:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c **** 
 112:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     /*
 113:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****      * len==0 is malformed (0 must be represented as 020100 for INTEGER,
 114:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****      * or 0A0100 for ENUMERATED tags
 115:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****      */
 116:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     if (len == 0) {
 117:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         return MBEDTLS_ERR_ASN1_INVALID_LENGTH;
 118:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     }
 119:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     /* This is a cryptography library. Reject negative integers. */
 120:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     if ((**p & 0x80) != 0) {
 121:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         return MBEDTLS_ERR_ASN1_INVALID_LENGTH;
 122:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     }
 123:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c **** 
 124:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     /* Skip leading zeros. */
 125:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     while (len > 0 && **p == 0) {
 126:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         ++(*p);
 127:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         --len;
 128:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     }
 129:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c **** 
 130:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     /* Reject integers that don't fit in an int. This code assumes that
 131:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****      * the int type has no padding bit. */
 132:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     if (len > sizeof(int)) {
 133:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         return MBEDTLS_ERR_ASN1_INVALID_LENGTH;
 134:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     }
 135:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     if (len == sizeof(int) && (**p & 0x80) != 0) {
 136:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         return MBEDTLS_ERR_ASN1_INVALID_LENGTH;
 137:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     }
 138:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c **** 
 139:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     *val = 0;
 140:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     while (len-- > 0) {
 141:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         *val = (*val << 8) | **p;
 142:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         (*p)++;
 143:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     }
 144:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c **** 
