  37:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         *len = *(*p)++;
  38:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****     } else {
  39:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         int n = (**p) & 0x7F;
  40:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         if (n == 0 || n > 4) {
