  45:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         }
  46:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         *len = 0;
  47:../../bos/thirdparty/mbedtls/bos_mbedtls/asn1parse.c ****         (*p)++;
