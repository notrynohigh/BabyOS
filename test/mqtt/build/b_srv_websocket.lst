 433:../../bos/services/b_srv_websocket.c ****         frame->payload_len = ((uint16_t)data[2] << 8) | data[3];
 434:../../bos/services/b_srv_websocket.c ****         frame->header_len = 4;
 435:../../bos/services/b_srv_websocket.c ****     }
 436:../../bos/services/b_srv_websocket.c ****     else if (payload_len_byte == 127)
 437:../../bos/services/b_srv_websocket.c ****     {
 438:../../bos/services/b_srv_websocket.c ****         if (len < 10)
 439:../../bos/services/b_srv_websocket.c ****         {
 440:../../bos/services/b_srv_websocket.c ****             return -1;
 441:../../bos/services/b_srv_websocket.c ****         }
 442:../../bos/services/b_srv_websocket.c ****         // Read 8-byte extended length (we only support up to 4GB for now)
 443:../../bos/services/b_srv_websocket.c ****         frame->payload_len = 0;
 444:../../bos/services/b_srv_websocket.c ****         for (int i = 0; i < 8; i++)
 445:../../bos/services/b_srv_websocket.c ****         {
 446:../../bos/services/b_srv_websocket.c ****             frame->payload_len = (frame->payload_len << 8) | data[2 + i];
 447:../../bos/services/b_srv_websocket.c ****         }
