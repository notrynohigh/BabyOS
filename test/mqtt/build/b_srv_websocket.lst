 449:../../bos/services/b_srv_websocket.c ****     }
 450:../../bos/services/b_srv_websocket.c **** 
 451:../../bos/services/b_srv_websocket.c ****     // Masking key (if masked)
 452:../../bos/services/b_srv_websocket.c ****     if (frame->masked)
 453:../../bos/services/b_srv_websocket.c ****     {
 454:../../bos/services/b_srv_websocket.c ****         if ((int)frame->header_len + 4 > len)
 455:../../bos/services/b_srv_websocket.c ****         {
 456:../../bos/services/b_srv_websocket.c ****             return -1;
 457:../../bos/services/b_srv_websocket.c ****         }
 458:../../bos/services/b_srv_websocket.c ****         memcpy(frame->mask_key, data + frame->header_len, 4);
 459:../../bos/services/b_srv_websocket.c ****         frame->header_len += 4;
 460:../../bos/services/b_srv_websocket.c ****     }
 461:../../bos/services/b_srv_websocket.c **** 
 462:../../bos/services/b_srv_websocket.c ****     // Check if we have the complete frame
 463:../../bos/services/b_srv_websocket.c ****     if ((int)frame->header_len + (int)frame->payload_len > len)
 464:../../bos/services/b_srv_websocket.c ****     {
