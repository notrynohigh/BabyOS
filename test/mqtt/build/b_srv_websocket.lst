 411:../../bos/services/b_srv_websocket.c **** 
 412:../../bos/services/b_srv_websocket.c ****     // Byte 0: FIN + opcode
 413:../../bos/services/b_srv_websocket.c ****     frame->fin = (data[0] & 0x80) != 0;
