 467:../../bos/services/b_srv_websocket.c **** 
 468:../../bos/services/b_srv_websocket.c ****     // Get pointer to payload data
 469:../../bos/services/b_srv_websocket.c ****     frame->payload = (uint8_t *)(data + frame->header_len);
 470:../../bos/services/b_srv_websocket.c **** 
