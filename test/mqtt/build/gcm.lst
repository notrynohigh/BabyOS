  30:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** /** Helper to define a function as static except when building invasive tests.
  31:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  *
  32:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * If a function is only used inside its own source file and should be
  33:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * declared `static` to allow the compiler to optimize for code size,
  34:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * but that function has unit tests, define it with
  35:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * ```
  36:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * MBEDTLS_STATIC_TESTABLE int mbedtls_foo(...) { ... }
  37:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * ```
  38:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * and declare it in a header in the `library/` directory with
  39:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * ```
  40:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * #if defined(MBEDTLS_TEST_HOOKS)
  41:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * int mbedtls_foo(...);
  42:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * #endif
  43:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * ```
  44:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  */
  45:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #if defined(MBEDTLS_TEST_HOOKS)
  46:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #define MBEDTLS_STATIC_TESTABLE
  47:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #else
  48:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #define MBEDTLS_STATIC_TESTABLE static
  49:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #endif
  50:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** 
