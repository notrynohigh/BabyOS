  91:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****     (STATIC_ASSERT_EXPR(condition) ? 0 : (value))
  92:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** 
  93:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #define ARRAY_LENGTH(array)                                           \
  94:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****     (STATIC_ASSERT_THEN_RETURN(IS_ARRAY_NOT_POINTER(array),         \
  95:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****                                ARRAY_LENGTH_UNSAFE(array)))
  96:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** 
  97:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** #else
  98:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** /* If we aren't sure the compiler supports our non-standard tricks,
