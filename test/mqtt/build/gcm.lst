  86:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** 
  87:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h **** /* Return the scalar value `value` (possibly promoted). This is a compile-time
  88:../../bos/thirdparty/mbedtls/bos_mbedtls/common.h ****  * constant if `value` is. `condition` must be a compile-time constant.
