 450:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** /**
 451:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  * mbedtls_gcm_context::buf contains the partial state of the computation of
 452:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  * the authentication tag.
 453:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  * mbedtls_gcm_context::add_len and mbedtls_gcm_context::len indicate
 454:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  * different stages of the computation:
 455:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  *     * len == 0 && add_len == 0:      initial state
 456:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  *     * len == 0 && add_len % 16 != 0: the first `add_len % 16` bytes have
 457:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  *                                      a partial block of AD that has been
 458:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  *                                      xored in but not yet multiplied in.
 459:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  *     * len == 0 && add_len % 16 == 0: the authentication tag is correct if
 460:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  *                                      the data ends now.
 461:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  *     * len % 16 != 0:                 the first `len % 16` bytes have
 462:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  *                                      a partial block of ciphertext that has
 463:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  *                                      been xored in but not yet multiplied in.
 464:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  *     * len > 0 && len % 16 == 0:      the authentication tag is correct if
 465:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  *                                      the data ends now.
 466:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  */
