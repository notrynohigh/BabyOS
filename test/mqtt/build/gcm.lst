  80:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** static inline void gcm_gen_table_rightshift(uint64_t dst[2], const uint64_t src[2])
  81:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** {
  82:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     uint8_t *u8Dst = (uint8_t *) dst;
  83:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     uint8_t *u8Src = (uint8_t *) src;
  84:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
  85:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     MBEDTLS_PUT_UINT64_BE(MBEDTLS_GET_UINT64_BE(&src[1], 0) >> 1, &dst[1], 0);
  86:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     u8Dst[8] |= (u8Src[7] & 0x01) << 7;
  87:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     MBEDTLS_PUT_UINT64_BE(MBEDTLS_GET_UINT64_BE(&src[0], 0) >> 1, &dst[0], 0);
  88:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     u8Dst[0] ^= (u8Src[15] & 0x01) ? 0xE1 : 0;
  89:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** }
