  91:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** /*
  92:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  * Precompute small multiples of H, that is set
  93:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  *      HH[i] || HL[i] = H times i,
  94:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  * where i is seen as a field element as in [MGV], ie high-order bits
  95:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  * correspond to low powers of P. The result is stored in the same way, that
  96:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  * is the high-order bit of HH corresponds to P^0 and the low-order bit of HL
  97:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  * corresponds to P^127.
  98:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****  */
  99:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** static int gcm_gen_table(mbedtls_gcm_context *ctx)
 100:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** {
 101:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     int ret, i, j;
 102:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     uint64_t u64h[2] = { 0 };
 103:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     uint8_t *h = (uint8_t *) u64h;
 104:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
 105:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** #if defined(MBEDTLS_BLOCK_CIPHER_C)
GAS LISTING /tmp/ccHFal0G.s 			page 3


 106:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     ret = mbedtls_block_cipher_encrypt(&ctx->block_cipher_ctx, h, h);
 107:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** #else
 108:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     size_t olen = 0;
 109:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     ret = mbedtls_cipher_update(&ctx->cipher_ctx, h, 16, h, &olen);
 110:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** #endif
 111:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     if (ret != 0) {
 112:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****         return ret;
 113:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     }
 114:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
 115:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     gcm_set_acceleration(ctx);
 116:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
 117:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     /* MBEDTLS_GCM_HTABLE_SIZE/2 = 1000 corresponds to 1 in GF(2^128) */
 118:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     ctx->H[MBEDTLS_GCM_HTABLE_SIZE/2][0] = u64h[0];
 119:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     ctx->H[MBEDTLS_GCM_HTABLE_SIZE/2][1] = u64h[1];
 120:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
 121:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     switch (ctx->acceleration) {
 122:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** #if defined(MBEDTLS_AESNI_HAVE_CODE)
 123:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****         case MBEDTLS_GCM_ACC_AESNI:
 124:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****             return 0;
 125:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** #endif
 126:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
 127:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** #if defined(MBEDTLS_AESCE_HAVE_CODE)
 128:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****         case MBEDTLS_GCM_ACC_AESCE:
 129:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****             return 0;
 130:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** #endif
 131:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
 132:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****         default:
 133:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****             /* 0 corresponds to 0 in GF(2^128) */
 134:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****             ctx->H[0][0] = 0;
 135:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****             ctx->H[0][1] = 0;
 136:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
 137:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****             for (i = MBEDTLS_GCM_HTABLE_SIZE/4; i > 0; i >>= 1) {
 138:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****                 gcm_gen_table_rightshift(ctx->H[i], ctx->H[i*2]);
 139:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****             }
 140:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
 141:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** #if !defined(MBEDTLS_GCM_LARGE_TABLE)
 142:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****             /* pack elements of H as 64-bits ints, big-endian */
 143:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****             for (i = MBEDTLS_GCM_HTABLE_SIZE/2; i > 0; i >>= 1) {
 144:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****                 MBEDTLS_PUT_UINT64_BE(ctx->H[i][0], &ctx->H[i][0], 0);
 145:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****                 MBEDTLS_PUT_UINT64_BE(ctx->H[i][1], &ctx->H[i][1], 0);
 146:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****             }
 147:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** #endif
 148:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
 149:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****             for (i = 2; i < MBEDTLS_GCM_HTABLE_SIZE; i <<= 1) {
 150:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****                 for (j = 1; j < i; j++) {
 151:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****                     mbedtls_xor_no_simd((unsigned char *) ctx->H[i+j],
 152:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****                                         (unsigned char *) ctx->H[i],
 153:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****                                         (unsigned char *) ctx->H[j],
 154:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****                                         16);
 155:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****                 }
 156:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****             }
 157:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     }
 158:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
 159:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     return 0;
 160:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** }
