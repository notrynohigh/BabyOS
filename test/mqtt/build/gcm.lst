 473:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
 474:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     /* AD is limited to 2^64 bits, ie 2^61 bytes
GAS LISTING /tmp/ccHFal0G.s 			page 31


 475:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****      * Also check for possible overflow */
 476:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** #if SIZE_MAX > 0xFFFFFFFFFFFFFFFFULL
 477:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     if (add_len > 0xFFFFFFFFFFFFFFFFULL) {
 478:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****         return MBEDTLS_ERR_GCM_BAD_INPUT;
 479:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     }
 480:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** #endif
 481:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     new_add_len = ctx->add_len + (uint64_t) add_len;
 482:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     if (new_add_len < ctx->add_len || new_add_len >> 61 != 0) {
 483:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****         return MBEDTLS_ERR_GCM_BAD_INPUT;
 484:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     }
 485:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c **** 
 486:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     offset = ctx->add_len % 16;
 487:../../bos/thirdparty/mbedtls/bos_mbedtls/gcm.c ****     p = add;
