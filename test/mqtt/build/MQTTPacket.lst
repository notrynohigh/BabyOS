 318:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** /**
 319:../../bos/thirdparty/mqtt-pack/MQTTPacket.c ****  * Decodes the message length according to the MQTT algorithm, non-blocking
 320:../../bos/thirdparty/mqtt-pack/MQTTPacket.c ****  * @param trp pointer to a transport structure holding what is needed to solve getting data from it
 321:../../bos/thirdparty/mqtt-pack/MQTTPacket.c ****  * @param value the decoded length returned
 322:../../bos/thirdparty/mqtt-pack/MQTTPacket.c ****  * @return integer the number of bytes read from the socket, 0 for call again, or -1 on error
 323:../../bos/thirdparty/mqtt-pack/MQTTPacket.c ****  */
 324:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** static int MQTTPacket_decodenb(MQTTTransport *trp)
 325:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** {
 326:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 	unsigned char c;
 327:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 	int rc = MQTTPACKET_READ_ERROR;
 328:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 
 329:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 	FUNC_ENTRY;
 330:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 	if(trp->len == 0){		/* initialize on first call */
 331:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 		trp->multiplier = 1;
 332:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 		trp->rem_len = 0;
 333:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 	}
 334:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 	do {
 335:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 		int frc;
 336:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 		if (trp->len >= MAX_NO_OF_REMAINING_LENGTH_BYTES)
 337:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 			goto exit;
 338:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 		if ((frc=(*trp->getfn)(trp->sck, &c, 1)) == -1)
 339:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 			goto exit;
 340:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 		if (frc == 0){
 341:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 			rc = 0;
 342:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 			goto exit;
 343:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 		}
 344:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 		++(trp->len);
 345:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 		trp->rem_len += (c & 127) * trp->multiplier;
 346:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 		trp->multiplier *= 128;
 347:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 	} while ((c & 128) != 0);
 348:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 	rc = trp->len;
 349:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** exit:
 350:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 	FUNC_EXIT_RC(rc);
 351:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** 	return rc;
 352:../../bos/thirdparty/mqtt-pack/MQTTPacket.c **** }
