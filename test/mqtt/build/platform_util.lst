  57:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c **** /*
  58:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * Where possible, we try to detect the presence of a platform-provided
  59:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * secure memset, such as explicit_bzero(), that is safe against being optimized
  60:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * out, and use that.
  61:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  *
  62:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * For other platforms, we provide an implementation that aims not to be
  63:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * optimized out by the compiler.
  64:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  *
  65:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * This implementation for mbedtls_platform_zeroize() was inspired from Colin
  66:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * Percival's blog article at:
  67:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  *
  68:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * http://www.daemonology.net/blog/2014-09-04-how-to-zero-a-buffer.html
  69:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  *
  70:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * It uses a volatile function pointer to the standard memset(). Because the
  71:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * pointer is volatile the compiler expects it to change at
  72:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * any time and will not optimize out the call that could potentially perform
  73:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * other operations on the input buffer instead of just setting it to 0.
  74:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * Nevertheless, as pointed out by davidtgoldblatt on Hacker News
  75:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * (refer to http://www.daemonology.net/blog/2014-09-05-erratum.html for
  76:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * details), optimizations of the following form are still possible:
  77:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  *
  78:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * if (memset_func != memset)
  79:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  *     memset_func(buf, 0, len);
  80:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  *
  81:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * Note that it is extremely difficult to guarantee that
  82:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * the memset() call will not be optimized out by aggressive compilers
  83:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * in a portable way. For this reason, Mbed TLS also provides the configuration
  84:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * option MBEDTLS_PLATFORM_ZEROIZE_ALT, which allows users to configure
  85:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * mbedtls_platform_zeroize() to use a suitable implementation for their
  86:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  * platform and needs.
  87:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****  */
  88:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c **** #if !defined(MBEDTLS_PLATFORM_HAS_EXPLICIT_BZERO) && !(defined(__STDC_LIB_EXT1__) && \
  89:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****     !defined(__IAR_SYSTEMS_ICC__)) \
  90:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c ****     && !defined(_WIN32)
  91:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c **** static void *(*const volatile memset_func)(void *, int, size_t) = memset;
  92:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c **** #endif
  93:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c **** 
  94:../../bos/thirdparty/mbedtls/bos_mbedtls/platform_util.c **** void mbedtls_platform_zeroize(void *buf, size_t len)
