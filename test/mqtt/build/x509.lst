  16:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h **** 
  17:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h **** /**
  18:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * Error code layout.
  19:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *
  20:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * Currently we try to keep all error codes within the negative space of 16
  21:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * bits signed integers to support all platforms (-0x0001 - -0x7FFF). In
  22:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * addition we'd like to give two layers of information on the error if
  23:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * possible.
  24:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *
  25:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * For that purpose the error codes are segmented in the following manner:
  26:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *
  27:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * 16 bit error code bit-segmentation
  28:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *
  29:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * 1 bit  - Unused (sign bit)
  30:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * 3 bits - High level module ID
GAS LISTING /tmp/ccfDDSBu.s 			page 5


  31:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * 5 bits - Module-dependent error code
  32:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * 7 bits - Low level module errors
  33:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *
  34:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * For historical reasons, low-level error codes are divided in even and odd,
  35:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * even codes were assigned first, and -1 is reserved for other errors.
  36:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *
  37:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * Low-level module errors (0x0002-0x007E, 0x0001-0x007F)
  38:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  *
  39:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * Module   Nr  Codes assigned
  40:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * ERROR     2  0x006E          0x0001
  41:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * MPI       7  0x0002-0x0010
  42:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * GCM       3  0x0012-0x0016   0x0013-0x0013
  43:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * THREADING 3  0x001A-0x001E
  44:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * AES       5  0x0020-0x0022   0x0021-0x0025
  45:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * CAMELLIA  3  0x0024-0x0026   0x0027-0x0027
  46:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * BASE64    2  0x002A-0x002C
  47:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * OID       1  0x002E-0x002E   0x000B-0x000B
  48:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * PADLOCK   1  0x0030-0x0030
  49:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * DES       2  0x0032-0x0032   0x0033-0x0033
  50:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * CTR_DBRG  4  0x0034-0x003A
  51:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * ENTROPY   3  0x003C-0x0040   0x003D-0x003F
  52:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/error.h ****  * NET      13  0x0042-0x0052   0x0043-0x0049
