 473:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *
 474:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *  RDNSequence ::= SEQUENCE OF RelativeDistinguishedName
 475:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *
 476:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *  RelativeDistinguishedName ::=
 477:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *    SET OF AttributeTypeAndValue
 478:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *
 479:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *  AttributeTypeAndValue ::= SEQUENCE {
 480:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *    type     AttributeType,
 481:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *    value    AttributeValue }
 482:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *
 483:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *  AttributeType ::= OBJECT IDENTIFIER
 484:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *
 485:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *  AttributeValue ::= ANY DEFINED BY AttributeType
 486:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *
 487:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  * The data structure is optimized for the common case where each RDN has only
 488:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  * one element, which is represented as a list of AttributeTypeAndValue.
 489:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  * For the general case we still use a flat list, but we mark elements of the
 490:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  * same set so that they are "merged" together in the functions that consume
 491:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  * this list, eg mbedtls_x509_dn_gets().
 492:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  *
 493:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  * On success, this function may allocate a linked list starting at cur->next
 494:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  * that must later be free'd by the caller using mbedtls_free(). In error
 495:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  * cases, this function frees all allocated memory internally and the caller
 496:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  * has no freeing responsibilities.
 497:../../bos/thirdparty/mbedtls/bos_mbedtls/x509.c ****  */
