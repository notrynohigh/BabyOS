 202:../../bos/services/b_srv_tcpip.c **** PT_THREAD(_bNtpTaskFunc)(struct pt *pt, void *arg)
 203:../../bos/services/b_srv_tcpip.c **** {
 204:../../bos/services/b_srv_tcpip.c ****     static uint8_t ntp_server_index = 0;
 205:../../bos/services/b_srv_tcpip.c ****     bNtpPacket_t   packet;
 206:../../bos/services/b_srv_tcpip.c ****     uint16_t       rlen      = 0;
 207:../../bos/services/b_srv_tcpip.c ****     uint64_t       ntp_time  = 0;
 208:../../bos/services/b_srv_tcpip.c ****     uint32_t       wait_time = 0;
 209:../../bos/services/b_srv_tcpip.c ****     wait_time                = 10;
 210:../../bos/services/b_srv_tcpip.c ****     PT_BEGIN(pt);
 211:../../bos/services/b_srv_tcpip.c ****     while (1)
 212:../../bos/services/b_srv_tcpip.c ****     {
 213:../../bos/services/b_srv_tcpip.c ****         if (SOCKFD_IS_INVALID(bNtpPcb.sockfd))
 214:../../bos/services/b_srv_tcpip.c ****         {
 215:../../bos/services/b_srv_tcpip.c ****             bNtpPcb.sockfd = bSocket(B_TRANS_CONN_UDP, _bNtpConnCallback, NULL);
 216:../../bos/services/b_srv_tcpip.c ****             if (SOCKFD_IS_INVALID(bNtpPcb.sockfd))
 217:../../bos/services/b_srv_tcpip.c ****             {
 218:../../bos/services/b_srv_tcpip.c ****                 bTaskRestart(pt);
GAS LISTING /tmp/ccirJrnR.s 			page 5


 219:../../bos/services/b_srv_tcpip.c ****             }
 220:../../bos/services/b_srv_tcpip.c ****             b_log("ntp sockfd: %x %d\r\n", bNtpPcb.sockfd, ntp_server_index);
 221:../../bos/services/b_srv_tcpip.c ****         }
 222:../../bos/services/b_srv_tcpip.c ****         else
 223:../../bos/services/b_srv_tcpip.c ****         {
 224:../../bos/services/b_srv_tcpip.c ****             if (bSocketIsConnected(bNtpPcb.sockfd))
 225:../../bos/services/b_srv_tcpip.c ****             {
 226:../../bos/services/b_srv_tcpip.c ****                 if (bSockIsWriteable(bNtpPcb.sockfd))
 227:../../bos/services/b_srv_tcpip.c ****                 {
 228:../../bos/services/b_srv_tcpip.c ****                     memset(&packet, 0, sizeof(bNtpPacket_t));
 229:../../bos/services/b_srv_tcpip.c ****                     packet.li_vn_mode = 0x1b;
 230:../../bos/services/b_srv_tcpip.c ****                     bSend(bNtpPcb.sockfd, (uint8_t *)&packet, sizeof(bNtpPacket_t), NULL);
 231:../../bos/services/b_srv_tcpip.c ****                     PT_WAIT_UNTIL(pt, bSockIsReadable(bNtpPcb.sockfd) == 1, B_NTP_TIMEOUT_S * 1000)
 232:../../bos/services/b_srv_tcpip.c ****                     if (PT_WAIT_IS_TIMEOUT(pt))
 233:../../bos/services/b_srv_tcpip.c ****                     {
 234:../../bos/services/b_srv_tcpip.c ****                         b_log_e("ntp recv timeout...\r\n");
 235:../../bos/services/b_srv_tcpip.c ****                     }
 236:../../bos/services/b_srv_tcpip.c ****                     else
 237:../../bos/services/b_srv_tcpip.c ****                     {
 238:../../bos/services/b_srv_tcpip.c ****                         bRecv(bNtpPcb.sockfd, (uint8_t *)&packet, sizeof(bNtpPacket_t), &rlen);
 239:../../bos/services/b_srv_tcpip.c ****                         b_log("ntp recv len: %d == %d\r\n", rlen, sizeof(bNtpPacket_t));
 240:../../bos/services/b_srv_tcpip.c ****                         if (rlen == sizeof(bNtpPacket_t))
 241:../../bos/services/b_srv_tcpip.c ****                         {
 242:../../bos/services/b_srv_tcpip.c ****                             if (packet.recv_time.seconds <= packet.trans_time.seconds &&
 243:../../bos/services/b_srv_tcpip.c ****                                 (packet.trans_time.seconds - packet.recv_time.seconds) <= 1)
 244:../../bos/services/b_srv_tcpip.c ****                             {
 245:../../bos/services/b_srv_tcpip.c ****                                 ntp_time =
 246:../../bos/services/b_srv_tcpip.c ****                                     B_SWAP_32(packet.trans_time.seconds) - B_NTP_TIMESTAMP_DELTA;
 247:../../bos/services/b_srv_tcpip.c ****                                 bUTC_SetTime(ntp_time);
 248:../../bos/services/b_srv_tcpip.c ****                                 wait_time = bNtpPcb.interval_s;
 249:../../bos/services/b_srv_tcpip.c ****                             }
 250:../../bos/services/b_srv_tcpip.c ****                         }
 251:../../bos/services/b_srv_tcpip.c ****                     }
 252:../../bos/services/b_srv_tcpip.c ****                 }
 253:../../bos/services/b_srv_tcpip.c ****                 PT_WAIT_UNTIL_FOREVER(pt, bShutdown(bNtpPcb.sockfd) >= 0);
 254:../../bos/services/b_srv_tcpip.c ****                 bNtpPcb.sockfd = -1;
 255:../../bos/services/b_srv_tcpip.c ****                 b_log_e("shutdown..\r\n");
 256:../../bos/services/b_srv_tcpip.c ****                 bTaskDelayMs(pt, wait_time * 1000);
 257:../../bos/services/b_srv_tcpip.c ****             }
 258:../../bos/services/b_srv_tcpip.c ****             else
 259:../../bos/services/b_srv_tcpip.c ****             {
 260:../../bos/services/b_srv_tcpip.c ****                 bConnect(bNtpPcb.sockfd, (char *)bNtpServer[ntp_server_index], 123);
 261:../../bos/services/b_srv_tcpip.c ****                 PT_WAIT_UNTIL(pt, bSocketIsConnected(bNtpPcb.sockfd) == 1, B_NTP_TIMEOUT_S * 1000);
 262:../../bos/services/b_srv_tcpip.c ****                 if (pt->retval == PT_RETVAL_TIMEOUT)
 263:../../bos/services/b_srv_tcpip.c ****                 {
 264:../../bos/services/b_srv_tcpip.c ****                     b_log_e("ntp connect fail...\r\n");
 265:../../bos/services/b_srv_tcpip.c ****                     PT_WAIT_UNTIL_FOREVER(pt, bShutdown(bNtpPcb.sockfd) >= 0);
 266:../../bos/services/b_srv_tcpip.c ****                     b_log_e("shutdown..\r\n");
 267:../../bos/services/b_srv_tcpip.c ****                     ntp_server_index = (ntp_server_index + 1) % B_NTP_SERVER_NUM;
 268:../../bos/services/b_srv_tcpip.c ****                     bNtpPcb.sockfd   = -1;
 269:../../bos/services/b_srv_tcpip.c ****                     bTaskDelayMs(pt, wait_time * 1000);
 270:../../bos/services/b_srv_tcpip.c ****                 }
 271:../../bos/services/b_srv_tcpip.c ****             }
 272:../../bos/services/b_srv_tcpip.c ****         }
 273:../../bos/services/b_srv_tcpip.c ****         bTaskYield(pt);
 274:../../bos/services/b_srv_tcpip.c ****     }
 275:../../bos/services/b_srv_tcpip.c ****     PT_END(pt);
