 280:../../bos/services/b_srv_tcpip.c **** static int _bHttpParseUrl(const char *url, char *host, char *path, uint16_t *port, uint8_t *ishttps
 281:../../bos/services/b_srv_tcpip.c **** {
 282:../../bos/services/b_srv_tcpip.c ****     // 检查是否是HTTPS
 283:../../bos/services/b_srv_tcpip.c ****     if (strncmp(url, "https://", 8) == 0)
 284:../../bos/services/b_srv_tcpip.c ****     {
 285:../../bos/services/b_srv_tcpip.c ****         *ishttps = 1;
 286:../../bos/services/b_srv_tcpip.c ****     }
