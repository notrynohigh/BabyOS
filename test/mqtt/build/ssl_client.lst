1190:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /*
1191:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * Internal representation of record frames
1192:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1193:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * Instances come in two flavors:
1194:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * (1) Encrypted
1195:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *     These always have data_offset = 0
1196:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * (2) Unencrypted
1197:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *     These have data_offset set to the amount of
1198:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *     pre-expansion during record protection. Concretely,
1199:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *     this is the length of the fixed part of the explicit IV
1200:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *     used for encryption, or 0 if no explicit IV is used
1201:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *     (e.g. for stream ciphers).
1202:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1203:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * The reason for the data_offset in the unencrypted case
1204:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * is to allow for in-place conversion of an unencrypted to
1205:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * an encrypted record. If the offset wasn't included, the
1206:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * encrypted content would need to be shifted afterwards to
1207:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * make space for the fixed IV.
1208:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1209:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
1210:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #if MBEDTLS_SSL_CID_OUT_LEN_MAX > MBEDTLS_SSL_CID_IN_LEN_MAX
1211:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #define MBEDTLS_SSL_CID_LEN_MAX MBEDTLS_SSL_CID_OUT_LEN_MAX
1212:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #else
1213:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #define MBEDTLS_SSL_CID_LEN_MAX MBEDTLS_SSL_CID_IN_LEN_MAX
1214:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #endif
1215:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
1216:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** typedef struct {
1217:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     uint8_t ctr[MBEDTLS_SSL_SEQUENCE_NUMBER_LEN];  /* In TLS:  The implicit record sequence number.
1218:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                                                     * In DTLS: The 2-byte epoch followed by
1219:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                                                     *          the 6-byte sequence number.
1220:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                                                     * This is stored as a raw big endian byte array
1221:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                                                     * as opposed to a uint64_t because we rarely
1222:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                                                     * need to perform arithmetic on this, but do
1223:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                                                     * need it as a Byte array for the purpose of
1224:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                                                     * MAC computations.                            
1225:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     uint8_t type;           /* The record content type.                      */
1226:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     uint8_t ver[2];         /* SSL/TLS version as present on the wire.
1227:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                              * Convert to internal presentation of versions
1228:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                              * using mbedtls_ssl_read_version() and
GAS LISTING /tmp/ccAjNtFj.s 			page 78


1229:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                              * mbedtls_ssl_write_version().
1230:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                              * Keep wire-format for MAC computations.        */
1231:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
1232:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     unsigned char *buf;     /* Memory buffer enclosing the record content    */
1233:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     size_t buf_len;         /* Buffer length                                 */
1234:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     size_t data_offset;     /* Offset of record content                      */
1235:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****     size_t data_len;        /* Length of record content                      */
1236:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
1237:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)
