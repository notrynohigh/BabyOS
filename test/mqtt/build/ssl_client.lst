GAS LISTING /tmp/ccAjNtFj.s 			page 49


  66:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * For all versions, this issue happens iff unaligned access is not supported.
  67:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  68:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * For gcc 4.x, this implementation will generate byte-by-byte loads even if unaligned access is
  69:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * supported, which is correct but not optimal.
  70:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  71:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * For performance (and code size, in some cases), we want to avoid the branch and just generate
  72:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * some inline load/store instructions since the access is small and constant-size.
  73:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  74:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * The manual states:
  75:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * "The packed attribute specifies that a variable or structure field should have the smallest
  76:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *  possible alignment—one byte for a variable"
  77:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * https://gcc.gnu.org/onlinedocs/gcc-4.5.4/gcc/Variable-Attributes.html
  78:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  79:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * Previous implementations used __attribute__((__aligned__(1)), but had issues with a gcc bug:
  80:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * https://gcc.gnu.org/bugzilla/show_bug.cgi?id=94662
  81:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  82:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * Tested with several versions of GCC from 4.5.0 up to 13.2.0
  83:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * We don't enable for older than 4.5.0 as this has not been tested.
  84:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  */
  85:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  #define UINT_UNALIGNED_STRUCT
  86:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** typedef struct {
