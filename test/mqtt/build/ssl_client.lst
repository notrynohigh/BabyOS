  56:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      * struct {
  57:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      *     NameType name_type;
  58:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      *     select (name_type) {
  59:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      *         case host_name: HostName;
  60:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      *     } name;
  61:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      * } ServerName;
  62:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      *
  63:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      * enum {
  64:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      *     host_name(0), (255)
  65:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      * } NameType;
  66:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      *
  67:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      * opaque HostName<1..2^16-1>;
  68:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      *
  69:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****      * struct {
