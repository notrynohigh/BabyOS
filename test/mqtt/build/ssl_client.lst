 110:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
 111:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /* In messages containing extension requests, we should ignore unrecognized
 112:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * extensions. In messages containing extension responses, unrecognized
 113:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * extensions should result in handshake abortion. Messages containing
 114:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * extension requests include ClientHello, CertificateRequest and
 115:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * NewSessionTicket. Messages containing extension responses include
 116:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * ServerHello, HelloRetryRequest, EncryptedExtensions and Certificate.
 117:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 118:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * RFC 8446 section 4.1.3
 119:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 120:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * The ServerHello MUST only include extensions which are required to establish
 121:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * the cryptographic context and negotiate the protocol version.
 122:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 123:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * RFC 8446 section 4.2
 124:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 125:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * If an implementation receives an extension which it recognizes and which is
 126:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * not specified for the message in which it appears, it MUST abort the handshake
 127:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * with an "illegal_parameter" alert.
 128:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
 129:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
 130:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /* Extensions that are not recognized by TLS 1.3 */
