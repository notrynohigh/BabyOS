 175:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c **** /*
 176:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  * Function for writing a supported groups (TLS 1.3) or supported elliptic
 177:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  * curves (TLS 1.2) extension.
 178:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *
 179:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  * The "extension_data" field of a supported groups extension contains a
 180:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  * "NamedGroupList" value (TLS 1.3 RFC8446):
 181:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *      enum {
 182:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *          secp256r1(0x0017), secp384r1(0x0018), secp521r1(0x0019),
 183:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *          x25519(0x001D), x448(0x001E),
 184:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *          ffdhe2048(0x0100), ffdhe3072(0x0101), ffdhe4096(0x0102),
 185:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *          ffdhe6144(0x0103), ffdhe8192(0x0104),
 186:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *          ffdhe_private_use(0x01FC..0x01FF),
 187:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *          ecdhe_private_use(0xFE00..0xFEFF),
 188:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *          (0xFFFF)
 189:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *      } NamedGroup;
 190:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *      struct {
 191:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *          NamedGroup named_group_list<2..2^16-1>;
 192:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *      } NamedGroupList;
 193:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *
 194:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  * The "extension_data" field of a supported elliptic curves extension contains
 195:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  * a "NamedCurveList" value (TLS 1.2 RFC 8422):
 196:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  * enum {
 197:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *      deprecated(1..22),
 198:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *      secp256r1 (23), secp384r1 (24), secp521r1 (25),
 199:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *      x25519(29), x448(30),
 200:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *      reserved (0xFE00..0xFEFF),
 201:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *      deprecated(0xFF01..0xFF02),
 202:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *      (0xFFFF)
GAS LISTING /tmp/ccAjNtFj.s 			page 7


 203:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  *  } NamedCurve;
 204:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_client.c ****  * struct {
