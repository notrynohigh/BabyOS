 533:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /**
 534:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \brief        This macro checks if the remaining size in a buffer is
 535:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               greater or equal than a needed space. If it is not the case,
 536:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               it returns an SSL_BUFFER_TOO_SMALL error.
 537:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 538:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \param cur    Pointer to the current position in the buffer.
 539:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \param end    Pointer to one past the end of the buffer.
 540:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \param need   Needed space in bytes.
 541:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 542:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
 543:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** #define MBEDTLS_SSL_CHK_BUF_PTR(cur, end, need)                        \
