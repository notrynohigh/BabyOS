 551:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /**
 552:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \brief        This macro checks if the remaining length in an input buffer is
 553:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               greater or equal than a needed length. If it is not the case, it
 554:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               returns #MBEDTLS_ERR_SSL_DECODE_ERROR error and pends a
 555:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               #MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR alert message.
 556:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
 557:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               This is a function-like macro. It is guaranteed to evaluate each
 558:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *               argument exactly once.
 559:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
