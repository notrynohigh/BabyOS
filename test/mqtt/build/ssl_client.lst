1358:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** 
1359:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** /**
1360:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \brief       Update record layer
1361:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1362:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              This function roughly separates the implementation
1363:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              of the logic of (D)TLS from the implementation
1364:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              of the secure transport.
1365:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
GAS LISTING /tmp/ccAjNtFj.s 			page 84


1366:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \param  ssl              The SSL context to use.
1367:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \param  update_hs_digest This indicates if the handshake digest
1368:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                          should be automatically updated in case
1369:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                          a handshake message is found.
1370:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1371:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \return      0 or non-zero error code.
1372:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1373:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \note        A clarification on what is called 'record layer' here
1374:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              is in order, as many sensible definitions are possible:
1375:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1376:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              The record layer takes as input an untrusted underlying
1377:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              transport (stream or datagram) and transforms it into
1378:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              a serially multiplexed, secure transport, which
1379:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              conceptually provides the following:
1380:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1381:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              (1) Three datagram based, content-agnostic transports
1382:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                  for handshake, alert and CCS messages.
1383:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              (2) One stream- or datagram-based transport
1384:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                  for application data.
1385:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              (3) Functionality for changing the underlying transform
1386:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                  securing the contents.
1387:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1388:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              The interface to this functionality is given as follows:
1389:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1390:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              a Updating
1391:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                [Currently implemented by mbedtls_ssl_read_record]
1392:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1393:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                Check if and on which of the four 'ports' data is pending:
1394:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                Nothing, a controlling datagram of type (1), or application
1395:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                data (2). In any case data is present, internal buffers
1396:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                provide access to the data for the user to process it.
1397:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                Consumption of type (1) datagrams is done automatically
1398:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                on the next update, invalidating that the internal buffers
1399:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                for previous datagrams, while consumption of application
1400:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                data (2) is user-controlled.
1401:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1402:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              b Reading of application data
1403:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                [Currently manual adaption of ssl->in_offt pointer]
1404:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1405:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                As mentioned in the last paragraph, consumption of data
1406:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                is different from the automatic consumption of control
1407:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                datagrams (1) because application data is treated as a stream.
1408:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1409:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              c Tracking availability of application data
1410:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                [Currently manually through decreasing ssl->in_msglen]
1411:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1412:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                For efficiency and to retain datagram semantics for
1413:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                application data in case of DTLS, the record layer
1414:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                provides functionality for checking how much application
1415:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *                data is still available in the internal buffer.
1416:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1417:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              d Changing the transformation securing the communication.
1418:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1419:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              Given an opaque implementation of the record layer in the
1420:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              above sense, it should be possible to implement the logic
1421:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              of (D)TLS on top of it without the need to know anything
1422:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              about the record layer's internals. This is done e.g.
GAS LISTING /tmp/ccAjNtFj.s 			page 85


1423:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              in all the handshake handling functions, and in the
1424:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              application data reading function mbedtls_ssl_read.
1425:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1426:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  * \note        The above tries to give a conceptual picture of the
1427:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              record layer, but the current implementation deviates
1428:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              from it in some places. For example, our implementation of
1429:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              the update functionality through mbedtls_ssl_read_record
1430:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              discards datagrams depending on the current state, which
1431:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              wouldn't fall under the record layer's responsibility
1432:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *              following the above definition.
1433:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  *
1434:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****  */
1435:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** MBEDTLS_CHECK_RETURN_CRITICAL
1436:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h **** int mbedtls_ssl_read_record(mbedtls_ssl_context *ssl,
1437:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_misc.h ****                             unsigned update_hs_digest);
