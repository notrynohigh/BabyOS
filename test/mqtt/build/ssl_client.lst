  54:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** typedef uint64_t __packed mbedtls_uint64_unaligned_t;
  55:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** #elif defined(MBEDTLS_COMPILER_IS_GCC) && (MBEDTLS_GCC_VERSION >= 40504) && \
