  45:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****     static const TYPE_T *oid_ ## NAME ## _from_asn1(                   \
  46:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****         const mbedtls_asn1_buf *oid)     \
  47:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****     {                                                                   \
  48:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****         const TYPE_T *p = (LIST);                                       \
  49:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****         const mbedtls_oid_descriptor_t *cur =                           \
  50:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****             (const mbedtls_oid_descriptor_t *) p;                       \
  51:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****         if (p == NULL || oid == NULL) return NULL;                  \
  52:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****         while (cur->asn1 != NULL) {                                    \
  53:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****             if (cur->asn1_len == oid->len &&                            \
  54:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****                 memcmp(cur->asn1, oid->p, oid->len) == 0) {          \
  55:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****                 return p;                                            \
  56:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****             }                                                           \
  57:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****             p++;                                                        \
  58:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****             cur = (const mbedtls_oid_descriptor_t *) p;                 \
  59:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****         }                                                               \
  60:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****         return NULL;                                                 \
  61:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****     }
