1013:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****         value >>= 7;
1014:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****         num_bytes++;
1015:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****     } while (value != 0);
