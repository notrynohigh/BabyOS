1008:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c **** static size_t oid_subidentifier_num_bytes(unsigned int value)
1009:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c **** {
1010:../../bos/thirdparty/mbedtls/bos_mbedtls/oid.c ****     size_t num_bytes = 0;
