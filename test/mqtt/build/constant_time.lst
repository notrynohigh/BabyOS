  46:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** /* IAR recommend this technique for accessing unaligned data in
  47:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * https://www.iar.com/knowledge/support/technical-notes/compiler/accessing-unaligned-data
  48:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * This results in a single load / store instruction (if unaligned access is supported).
  49:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * According to that document, this is only supported on certain architectures.
  50:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  */
  51:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****     #define UINT_UNALIGNED
  52:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** typedef uint16_t __packed mbedtls_uint16_unaligned_t;
  53:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** typedef uint32_t __packed mbedtls_uint32_unaligned_t;
  54:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** typedef uint64_t __packed mbedtls_uint64_unaligned_t;
  55:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** #elif defined(MBEDTLS_COMPILER_IS_GCC) && (MBEDTLS_GCC_VERSION >= 40504) && \
  56:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****     ((MBEDTLS_GCC_VERSION < 60300) || (!defined(MBEDTLS_EFFICIENT_UNALIGNED_ACCESS)))
  57:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** /*
  58:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * gcc may generate a branch to memcpy for calls like `memcpy(dest, src, 4)` rather than
  59:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * generating some LDR or LDRB instructions (similar for stores).
  60:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  61:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * This is architecture dependent: x86-64 seems fine even with old gcc; 32-bit Arm
  62:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * is affected. To keep it simple, we enable for all architectures.
  63:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  64:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * For versions of gcc < 5.4.0 this issue always happens.
  65:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * For gcc < 6.3.0, this issue happens at -O0
  66:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * For all versions, this issue happens iff unaligned access is not supported.
  67:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  68:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * For gcc 4.x, this implementation will generate byte-by-byte loads even if unaligned access is
  69:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * supported, which is correct but not optimal.
  70:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  71:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * For performance (and code size, in some cases), we want to avoid the branch and just generate
  72:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * some inline load/store instructions since the access is small and constant-size.
  73:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  74:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * The manual states:
  75:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * "The packed attribute specifies that a variable or structure field should have the smallest
  76:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *  possible alignment—one byte for a variable"
  77:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * https://gcc.gnu.org/onlinedocs/gcc-4.5.4/gcc/Variable-Attributes.html
  78:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  79:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * Previous implementations used __attribute__((__aligned__(1)), but had issues with a gcc bug:
  80:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * https://gcc.gnu.org/bugzilla/show_bug.cgi?id=94662
  81:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  82:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * Tested with several versions of GCC from 4.5.0 up to 13.2.0
  83:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * We don't enable for older than 4.5.0 as this has not been tested.
  84:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  */
  85:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  #define UINT_UNALIGNED_STRUCT
  86:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** typedef struct {
  87:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****     uint16_t x;
  88:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** } __attribute__((packed)) mbedtls_uint16_unaligned_t;
  89:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** typedef struct {
GAS LISTING /tmp/ccXTgbQV.s 			page 28


  90:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****     uint32_t x;
  91:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** } __attribute__((packed)) mbedtls_uint32_unaligned_t;
  92:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** typedef struct {
  93:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****     uint64_t x;
  94:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** } __attribute__((packed)) mbedtls_uint64_unaligned_t;
  95:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  #endif
  96:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** 
  97:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** /*
  98:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * We try to force mbedtls_(get|put)_unaligned_uintXX to be always inline, because this results
  99:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * in code that is both smaller and faster. IAR and gcc both benefit from this when optimising
