 100:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c **** #if (INT_MAX < INT32_MAX)
 101:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****     /* We don't support int smaller than 32-bits, but if someone tried to build
 102:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****      * with this configuration, there is a risk that, for differing data, the
 103:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****      * only bits set in diff are in the top 16-bits, and would be lost by a
 104:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****      * simple cast from uint32 to int.
 105:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****      * This would have significant security implications, so protect against it. */
 106:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c **** #error "mbedtls_ct_memcmp() requires minimum 32-bit ints"
 107:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c **** #else
 108:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****     /* The bit-twiddling ensures that when we cast uint32_t to int, we are casting
 109:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****      * a value that is in the range 0..INT_MAX - a value larger than this would
 110:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****      * result in implementation defined behaviour.
 111:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****      *
 112:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****      * This ensures that the value returned by the function is non-zero iff
 113:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****      * diff is non-zero.
 114:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****      */
 115:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****     return (int) ((diff & 0xffff) | (diff >> 16));
  70              		.loc 1 115 5 is_stmt 1 view .LVU22
 116:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c **** #endif
