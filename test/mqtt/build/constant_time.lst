 114:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** #endif
 115:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** static inline uint16_t mbedtls_get_unaligned_uint16(const void *p)
 116:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** {
