  50:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c **** {
  51:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****     /* This is UB, even where it's safe:
  52:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****      *    return *((volatile uint32_t*)p);
