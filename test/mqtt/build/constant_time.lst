 119:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****     mbedtls_uint16_unaligned_t *p16 = (mbedtls_uint16_unaligned_t *) p;
 120:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****     r = *p16;
 121:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** #elif defined(UINT_UNALIGNED_STRUCT)
