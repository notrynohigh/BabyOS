  18:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** /*
  19:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * Define MBEDTLS_EFFICIENT_UNALIGNED_ACCESS for architectures where unaligned memory
  20:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * accesses are known to be efficient.
  21:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
  22:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * All functions defined here will behave correctly regardless, but might be less
  23:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * efficient when this is not defined.
  24:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  */
  25:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** #if defined(__ARM_FEATURE_UNALIGNED) \
  26:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****     || defined(MBEDTLS_ARCH_IS_X86) || defined(MBEDTLS_ARCH_IS_X64) \
  27:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****     || defined(MBEDTLS_PLATFORM_IS_WINDOWS_ON_ARM64)
  28:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** /*
  29:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * __ARM_FEATURE_UNALIGNED is defined where appropriate by armcc, gcc 7, clang 9
  30:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * (and later versions) for Arm v7 and later; all x86 platforms should have
  31:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * efficient unaligned access.
  32:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
GAS LISTING /tmp/ccXTgbQV.s 			page 27


  33:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * https://learn.microsoft.com/en-us/cpp/build/arm64-windows-abi-conventions?view=msvc-170#alignmen
  34:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * specifies that on Windows-on-Arm64, unaligned access is safe (except for uncached
  35:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * device memory).
  36:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  */
  37:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** #define MBEDTLS_EFFICIENT_UNALIGNED_ACCESS
  38:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** #endif
