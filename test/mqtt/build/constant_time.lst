  42:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****  */
  43:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c **** #if defined(MBEDTLS_EFFICIENT_UNALIGNED_ACCESS) && \
  44:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****     ((defined(MBEDTLS_CT_ARM_ASM) && (UINTPTR_MAX == 0xfffffffful)) || \
  45:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time.c ****     defined(MBEDTLS_CT_AARCH64_ASM))
