 406:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** static inline unsigned char mbedtls_ct_uchar_in_range_if(unsigned char low,
 407:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                                                          unsigned char high,
 408:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                                                          unsigned char c,
 409:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                                                          unsigned char t)
 410:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** {
 411:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     const unsigned char co = (unsigned char) mbedtls_ct_compiler_opaque(c);
 412:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     const unsigned char to = (unsigned char) mbedtls_ct_compiler_opaque(t);
 413:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
 414:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     /* low_mask is: 0 if low <= c, 0x...ff if low > c */
 415:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     unsigned low_mask = ((unsigned) co - low) >> 8;
 416:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     /* high_mask is: 0 if c <= high, 0x...ff if c > high */
 417:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     unsigned high_mask = ((unsigned) high - co) >> 8;
 418:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
 419:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     return (unsigned char) (~(low_mask | high_mask)) & to;
 420:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** }
