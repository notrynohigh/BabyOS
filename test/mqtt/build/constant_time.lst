 382:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****      * bigger. (That is if y has MSB of 1, then x<y is true and it is false if
 383:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****      * the MSB of y is 0.)
 384:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****      */
 385:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
 386:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     // Select either y, or x - y
 387:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     mbedtls_ct_uint_t ret = mbedtls_ct_if(cond, yo, (mbedtls_ct_uint_t) (xo - yo));
 388:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
 389:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     // Extract only the MSB of ret
 390:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     ret = ret >> (MBEDTLS_CT_SIZE - 1);
 391:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
 392:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     // Convert to a condition (i.e., all bits set iff non-zero)
 393:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     return mbedtls_ct_bool(ret);
 394:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #endif
 395:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** }
 396:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
 397:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** static inline mbedtls_ct_condition_t mbedtls_ct_uint_ne(mbedtls_ct_uint_t x, mbedtls_ct_uint_t y)
 398:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** {
 399:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     /* diff = 0 if x == y, non-zero otherwise */
 400:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     const mbedtls_ct_uint_t diff = mbedtls_ct_compiler_opaque(x) ^ mbedtls_ct_compiler_opaque(y);
 401:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
 402:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     /* all ones if x != y, 0 otherwise */
 403:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     return mbedtls_ct_bool(diff);
 404:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** }
