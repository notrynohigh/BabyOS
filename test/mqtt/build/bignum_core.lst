 648:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c **** 
 649:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****     /*
 650:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * When min == 0, each try has at worst a probability 1/2 of failing
 651:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * (the msb has a probability 1/2 of being 0, and then the result will
 652:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * be < N), so after 30 tries failure probability is a most 2**(-30).
 653:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      *
 654:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * When N is just below a power of 2, as is the case when generating
 655:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * a random scalar on most elliptic curves, 1 try is enough with
 656:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * overwhelming probability. When N is just above a power of 2,
 657:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * as when generating a random scalar on secp224k1, each try has
 658:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * a probability of failing that is almost 1/2.
 659:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      *
 660:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * The probabilities are almost the same if min is nonzero but negligible
 661:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * compared to N. This is always the case when N is crypto-sized, but
 662:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * it's convenient to support small N for testing purposes. When N
 663:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * is small, use a higher repeat count, otherwise the probability of
 664:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * failure is macroscopic.
 665:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      */
 666:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****     int count = (n_bytes > 4 ? 30 : 250);
