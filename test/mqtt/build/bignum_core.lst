 749:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c **** /* Exponentiation: X := A^E mod N.
 750:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****  *
 751:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****  * A must already be in Montgomery form.
 752:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****  *
 753:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****  * As in other bignum functions, assume that AN_limbs and E_limbs are nonzero.
 754:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****  *
 755:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****  * RR must contain 2^{2*biL} mod N.
 756:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****  *
 757:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****  * The algorithm is a variant of Left-to-right k-ary exponentiation: HAC 14.82
 758:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****  * (The difference is that the body in our loop processes a single bit instead
 759:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****  * of a full window.)
 760:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****  */
