 561:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****     /*
 562:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * Using R as the Montgomery radix (auxiliary modulus) i.e. 2^(biL*AN_limbs):
 563:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      *
 564:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * T can be in one of 3 ranges:
 565:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      *
 566:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * 1) T < N      : (carry, borrow) = (0, 1): we want T
 567:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * 2) N <= T < R : (carry, borrow) = (0, 0): we want X
 568:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * 3) T >= R     : (carry, borrow) = (1, 1): we want X
 569:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      *
 570:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * and (carry, borrow) = (1, 0) can't happen.
 571:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      *
 572:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * So the correct return value is already in X if (carry ^ borrow) = 0,
 573:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      * but is in (the lower AN_limbs limbs of) T if (carry ^ borrow) = 1.
 574:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****      */
 575:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.c ****     mbedtls_ct_memcpy_if(mbedtls_ct_bool(carry ^ borrow),
