 413:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
 414:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     /* low_mask is: 0 if low <= c, 0x...ff if low > c */
 415:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     unsigned low_mask = ((unsigned) co - low) >> 8;
 416:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     /* high_mask is: 0 if c <= high, 0x...ff if c > high */
 417:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     unsigned high_mask = ((unsigned) high - co) >> 8;
