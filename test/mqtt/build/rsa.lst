  28:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * This appears to behave as if the declaration-without-definition was not present
  29:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * (except for warnings if gcc -Wredundant-decls or similar is used).
  30:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
