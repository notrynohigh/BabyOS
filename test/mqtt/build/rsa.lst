 551:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** /** Generate a random number uniformly in a range.
 552:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 553:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * This function generates a random number between \p min inclusive and
 554:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \p N exclusive.
 555:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 556:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * The procedure complies with RFC 6979 §3.3 (deterministic ECDSA)
 557:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * when the RNG is a suitably parametrized instance of HMAC_DRBG
 558:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * and \p min is \c 1.
 559:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 560:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \note           There are `N - min` possible outputs. The lower bound
 561:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 \p min can be reached, but the upper bound \p N cannot.
 562:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 563:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param X        The destination MPI, with \p limbs limbs.
 564:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 It must not be aliased with \p N or otherwise overlap it.
 565:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param min      The minimum value to return.
 566:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param N        The upper bound of the range, exclusive, with \p limbs limbs.
 567:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 In other words, this is one plus the maximum value to return.
 568:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 \p N must be strictly larger than \p min.
 569:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param limbs    The number of limbs of \p N and \p X.
 570:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 This must not be 0.
 571:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param f_rng    The RNG function to use. This must not be \c NULL.
 572:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param p_rng    The RNG parameter to be passed to \p f_rng.
 573:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 574:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \return         \c 0 if successful.
 575:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \return         #MBEDTLS_ERR_MPI_NOT_ACCEPTABLE if the implementation was
 576:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 unable to find a suitable value within a limited number
 577:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 of attempts. This has a negligible probability if \p N
 578:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 is significantly larger than \p min, which is the case
 579:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 for all usual cryptographic applications.
 580:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  */
 581:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** int mbedtls_mpi_core_random(mbedtls_mpi_uint *X,
 582:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                             mbedtls_mpi_uint min,
 583:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                             const mbedtls_mpi_uint *N,
 584:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                             size_t limbs,
 585:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                             int (*f_rng)(void *, unsigned char *, size_t),
 586:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                             void *p_rng);
 587:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** 
 588:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** /**
 589:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \brief          Returns the number of limbs of working memory required for
 590:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 a call to `mbedtls_mpi_core_exp_mod()`.
 591:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 592:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \note           This will always be at least
 593:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 `mbedtls_mpi_core_montmul_working_limbs(AN_limbs)`,
 594:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 i.e. sufficient for a call to `mbedtls_mpi_core_montmul()`.
 595:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 596:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param AN_limbs The number of limbs in the input `A` and the modulus `N`
 597:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 (they must be the same size) that will be given to
 598:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 `mbedtls_mpi_core_exp_mod()`.
 599:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param E_limbs  The number of limbs in the exponent `E` that will be given
 600:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 to `mbedtls_mpi_core_exp_mod()`.
GAS LISTING /tmp/ccpAd290.s 			page 264


 601:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 602:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \return         The number of limbs of working memory required by
 603:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 `mbedtls_mpi_core_exp_mod()`.
 604:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  */
 605:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** size_t mbedtls_mpi_core_exp_mod_working_limbs(size_t AN_limbs, size_t E_limbs);
 606:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** 
 607:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** /**
 608:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \brief            Perform a modular exponentiation with secret exponent:
 609:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                   X = A^E mod N, where \p A is already in Montgomery form.
 610:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 611:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \p X may be aliased to \p A, but not to \p RR or \p E, even if \p E_limbs ==
 612:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \p AN_limbs.
 613:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 614:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[out] X     The destination MPI, as a little endian array of length
 615:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                   \p AN_limbs.
 616:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in] A      The base MPI, as a little endian array of length \p AN_limbs.
 617:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                   Must be in Montgomery form.
 618:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in] N      The modulus, as a little endian array of length \p AN_limbs.
 619:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param AN_limbs   The number of limbs in \p X, \p A, \p N, \p RR.
 620:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in] E      The exponent, as a little endian array of length \p E_limbs.
 621:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param E_limbs    The number of limbs in \p E.
 622:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in] RR     The precomputed residue of 2^{2*biL} modulo N, as a little
 623:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                   endian array of length \p AN_limbs.
 624:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in,out] T  Temporary storage of at least the number of limbs returned
 625:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                   by `mbedtls_mpi_core_exp_mod_working_limbs()`.
 626:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                   Its initial content is unused and its final content is
 627:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                   indeterminate.
 628:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                   It must not alias or otherwise overlap any of the other
 629:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                   parameters.
 630:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                   It is up to the caller to zeroize \p T when it is no
 631:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                   longer needed, and before freeing it if it was dynamically
 632:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                   allocated.
 633:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  */
 634:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** void mbedtls_mpi_core_exp_mod(mbedtls_mpi_uint *X,
 635:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                               const mbedtls_mpi_uint *A,
 636:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                               const mbedtls_mpi_uint *N, size_t AN_limbs,
 637:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                               const mbedtls_mpi_uint *E, size_t E_limbs,
 638:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                               const mbedtls_mpi_uint *RR,
 639:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                               mbedtls_mpi_uint *T);
 640:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** 
 641:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** /**
 642:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \brief Subtract unsigned integer from known-size large unsigned integers.
 643:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *        Return the borrow.
 644:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 645:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[out] X    The result of the subtraction.
 646:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in] A     The left operand.
 647:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param b         The unsigned scalar to subtract.
