1037:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** /*
1038:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * Generate an RSA keypair
1039:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *
1040:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * This generation method follows the RSA key pair generation procedure of
1041:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * FIPS 186-4 if 2^16 < exponent < 2^256 and nbits = 2048 or nbits = 3072.
1042:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  */
1043:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** int mbedtls_rsa_gen_key(mbedtls_rsa_context *ctx,
1044:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****                         int (*f_rng)(void *, unsigned char *, size_t),
1045:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****                         void *p_rng,
1046:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****                         unsigned int nbits, int exponent)
1047:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** {
1048:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
1049:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     mbedtls_mpi H, G, L;
1050:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     int prime_quality = 0;
1051:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
1052:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     /*
1053:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * If the modulus is 1024 bit long or shorter, then the security strength of
1054:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * the RSA algorithm is less than or equal to 80 bits and therefore an error
1055:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * rate of 2^-80 is sufficient.
1056:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      */
1057:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     if (nbits > 1024) {
1058:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         prime_quality = MBEDTLS_MPI_GEN_PRIME_FLAG_LOW_ERR;
1059:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     }
1060:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
1061:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     mbedtls_mpi_init(&H);
1062:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     mbedtls_mpi_init(&G);
1063:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     mbedtls_mpi_init(&L);
1064:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
1065:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     if (exponent < 3 || nbits % 2 != 0) {
1066:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         ret = MBEDTLS_ERR_RSA_BAD_INPUT_DATA;
1067:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         goto cleanup;
1068:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     }
1069:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
1070:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     if (nbits < MBEDTLS_RSA_GEN_KEY_MIN_BITS) {
1071:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         ret = MBEDTLS_ERR_RSA_BAD_INPUT_DATA;
1072:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         goto cleanup;
1073:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     }
1074:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
GAS LISTING /tmp/ccpAd290.s 			page 20


1075:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     /*
1076:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * find primes P and Q with Q < P so that:
1077:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * 1.  |P-Q| > 2^( nbits / 2 - 100 )
1078:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * 2.  GCD( E, (P-1)*(Q-1) ) == 1
1079:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * 3.  E^-1 mod LCM(P-1, Q-1) > 2^( nbits / 2 )
1080:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      */
1081:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_lset(&ctx->E, exponent));
1082:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
1083:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     do {
1084:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_gen_prime(&ctx->P, nbits >> 1,
1085:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****                                               prime_quality, f_rng, p_rng));
1086:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
1087:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_gen_prime(&ctx->Q, nbits >> 1,
1088:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****                                               prime_quality, f_rng, p_rng));
1089:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
1090:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         /* make sure the difference between p and q is not too small (FIPS 186-4 §B.3.3 step 5.4) 
1091:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_sub_mpi(&H, &ctx->P, &ctx->Q));
1092:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         if (mbedtls_mpi_bitlen(&H) <= ((nbits >= 200) ? ((nbits >> 1) - 99) : 0)) {
1093:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****             continue;
1094:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         }
1095:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
1096:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         /* not required by any standards, but some users rely on the fact that P > Q */
1097:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         if (H.s < 0) {
1098:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****             mbedtls_mpi_swap(&ctx->P, &ctx->Q);
1099:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         }
1100:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
1101:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         /* Temporarily replace P,Q by P-1, Q-1 */
1102:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&ctx->P, &ctx->P, 1));
1103:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&ctx->Q, &ctx->Q, 1));
1104:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&H, &ctx->P, &ctx->Q));
1105:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
1106:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         /* check GCD( E, (P-1)*(Q-1) ) == 1 (FIPS 186-4 §B.3.1 criterion 2(a)) */
1107:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_gcd(&G, &ctx->E, &H));
1108:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         if (mbedtls_mpi_cmp_int(&G, 1) != 0) {
