 334:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** /**
 335:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \brief Conditional addition of two fixed-size large unsigned integers,
 336:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *        returning the carry.
 337:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 338:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * Functionally equivalent to
