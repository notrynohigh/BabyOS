 448:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** /**
 449:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \brief Montgomery multiplication: X = A * B * R^-1 mod N (HAC 14.36)
 450:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 451:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \p A and \p B must be in canonical form. That is, < \p N.
 452:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 453:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \p X may be aliased to \p A or \p N, or even \p B (if \p AN_limbs ==
 454:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \p B_limbs) but may not overlap any parameters otherwise.
 455:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 456:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \p A and \p B may alias each other, if \p AN_limbs == \p B_limbs. They may
 457:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * not alias \p N (since they must be in canonical form, they cannot == \p N).
 458:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 459:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[out]    X         The destination MPI, as a little-endian array of
 460:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          length \p AN_limbs.
 461:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          On successful completion, X contains the result of
 462:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          the multiplication `A * B * R^-1` mod N where
 463:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          `R = 2^(biL*AN_limbs)`.
 464:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in]     A         Little-endian presentation of first operand.
 465:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          Must have the same number of limbs as \p N.
 466:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in]     B         Little-endian presentation of second operand.
 467:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in]     B_limbs   The number of limbs in \p B.
 468:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          Must be <= \p AN_limbs.
 469:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in]     N         Little-endian presentation of the modulus.
 470:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          This must be odd, and have exactly the same number
 471:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          of limbs as \p A.
 472:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          It may alias \p X, but must not alias or otherwise
 473:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          overlap any of the other parameters.
 474:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in]     AN_limbs  The number of limbs in \p X, \p A and \p N.
 475:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param         mm        The Montgomery constant for \p N: -N^-1 mod 2^biL.
 476:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          This can be calculated by `mbedtls_mpi_core_montmul_init()`.
 477:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in,out] T         Temporary storage of size at least 2*AN_limbs+1 limbs.
 478:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          Its initial content is unused and
 479:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          its final content is indeterminate.
 480:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          It must not alias or otherwise overlap any of the
 481:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          other parameters.
 482:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  */
 483:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** void mbedtls_mpi_core_montmul(mbedtls_mpi_uint *X,
 484:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                               const mbedtls_mpi_uint *A,
 485:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                               const mbedtls_mpi_uint *B, size_t B_limbs,
 486:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                               const mbedtls_mpi_uint *N, size_t AN_limbs,
GAS LISTING /tmp/ccpAd290.s 			page 262


 487:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                               mbedtls_mpi_uint mm, mbedtls_mpi_uint *T);
