 343:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * return carry;
 344:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * ```
 345:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 346:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * This function operates modulo `2^(biL*limbs)`.
 347:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 348:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in,out] X  The pointer to the (little-endian) array
