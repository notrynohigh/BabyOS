 654:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                                           const mbedtls_mpi_uint *A,
 655:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                                           mbedtls_mpi_uint b,
 656:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                                           size_t limbs);
