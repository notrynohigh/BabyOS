  66:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  */
  67:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** 
  68:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #ifndef MBEDTLS_BIGNUM_CORE_H
  69:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #define MBEDTLS_BIGNUM_CORE_H
  70:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** 
  71:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #include "common.h"
  72:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** 
  73:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #if defined(MBEDTLS_BIGNUM_C)
  74:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #include "thirdparty/mbedtls/bos_mbedtls/mbedtls/bignum.h"
  75:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #endif
  76:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** 
  77:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #include "constant_time_internal.h"
  78:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** 
  79:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #define ciL    (sizeof(mbedtls_mpi_uint))     /** chars in limb  */
  80:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #define biL    (ciL << 3)                     /** bits  in limb  */
  81:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #define biH    (ciL << 2)                     /** half limb size */
  82:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** 
  83:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** /*
  84:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * Convert between bits/chars and number of limbs
  85:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * Divide first in order to avoid potential overflows
  86:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  */
  87:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #define BITS_TO_LIMBS(i)  ((i) / biL + ((i) % biL != 0))
GAS LISTING /tmp/ccpAd290.s 			page 255


  88:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #define CHARS_TO_LIMBS(i) ((i) / ciL + ((i) % ciL != 0))
  89:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** /* Get a specific byte, without range checks. */
  90:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** #define GET_BYTE(X, i)                                \
  91:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****     (((X)[(i) / ciL] >> (((i) % ciL) * 8)) & 0xff)
  92:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** 
  93:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** /** Count leading zero bits in a given integer.
  94:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
  95:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \warning     The result is undefined if \p a == 0
  96:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
  97:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param a     Integer to count leading zero bits.
  98:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
  99:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \return      The number of leading zero bits in \p a, if \p a != 0.
 100:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *              If \p a == 0, the result is undefined.
 101:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  */
 102:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** size_t mbedtls_mpi_core_clz(mbedtls_mpi_uint a);
 103:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** 
 104:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** /** Return the minimum number of bits required to represent the value held
 105:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * in the MPI.
 106:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 107:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \note This function returns 0 if all the limbs of \p A are 0.
 108:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
