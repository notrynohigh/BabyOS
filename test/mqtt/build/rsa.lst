  39:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \warning   MD5 and SHA-1 are considered weak message digests and
  40:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *            their use constitutes a security risk. We recommend considering
  41:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *            stronger message digests instead.
  42:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *
  43:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  */
  44:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** /* Note: these are aligned with the definitions of PSA_ALG_ macros for hashes,
  45:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * in order to enable an efficient implementation of conversion functions.
  46:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * This is tested by md_to_from_psa() in test_suite_md. */
  47:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** typedef enum {
  48:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****     MBEDTLS_MD_NONE=0,    /**< None. */
  49:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****     MBEDTLS_MD_MD5=0x03,       /**< The MD5 message digest. */
  50:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****     MBEDTLS_MD_RIPEMD160=0x04, /**< The RIPEMD-160 message digest. */
  51:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****     MBEDTLS_MD_SHA1=0x05,      /**< The SHA-1 message digest. */
  52:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****     MBEDTLS_MD_SHA224=0x08,    /**< The SHA-224 message digest. */
  53:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****     MBEDTLS_MD_SHA256=0x09,    /**< The SHA-256 message digest. */
  54:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****     MBEDTLS_MD_SHA384=0x0a,    /**< The SHA-384 message digest. */
  55:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****     MBEDTLS_MD_SHA512=0x0b,    /**< The SHA-512 message digest. */
  56:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****     MBEDTLS_MD_SHA3_224=0x10,  /**< The SHA3-224 message digest. */
  57:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****     MBEDTLS_MD_SHA3_256=0x11,  /**< The SHA3-256 message digest. */
  58:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****     MBEDTLS_MD_SHA3_384=0x12,  /**< The SHA3-384 message digest. */
  59:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****     MBEDTLS_MD_SHA3_512=0x13,  /**< The SHA3-512 message digest. */
  60:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** } mbedtls_md_type_t;
