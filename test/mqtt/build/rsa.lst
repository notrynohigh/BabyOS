  62:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** /* Note: this should always be >= PSA_HASH_MAX_SIZE
  63:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * in all builds with both CRYPTO_C and MD_LIGHT.
  64:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *
  65:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * This is to make things easier for modules such as TLS that may define a
  66:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * buffer size using MD_MAX_SIZE in a part of the code that's common to PSA
  67:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * and legacy, then assume the buffer's size is PSA_HASH_MAX_SIZE in another
  68:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * part of the code based on PSA.
  69:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  */
  70:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #if defined(MBEDTLS_MD_CAN_SHA512) || defined(MBEDTLS_MD_CAN_SHA3_512)
  71:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #define MBEDTLS_MD_MAX_SIZE         64  /* longest known is SHA512 */
  72:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #elif defined(MBEDTLS_MD_CAN_SHA384) || defined(MBEDTLS_MD_CAN_SHA3_384)
  73:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #define MBEDTLS_MD_MAX_SIZE         48  /* longest known is SHA384 */
  74:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #elif defined(MBEDTLS_MD_CAN_SHA256) || defined(MBEDTLS_MD_CAN_SHA3_256)
  75:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #define MBEDTLS_MD_MAX_SIZE         32  /* longest known is SHA256 */
  76:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #elif defined(MBEDTLS_MD_CAN_SHA224) || defined(MBEDTLS_MD_CAN_SHA3_224)
  77:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #define MBEDTLS_MD_MAX_SIZE         28  /* longest known is SHA224 */
  78:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #else
  79:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #define MBEDTLS_MD_MAX_SIZE         20  /* longest known is SHA1 or RIPE MD-160
  80:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****                                            or smaller (MD5 and earlier) */
  81:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #endif
  82:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** 
  83:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #if defined(MBEDTLS_MD_CAN_SHA3_224)
  84:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #define MBEDTLS_MD_MAX_BLOCK_SIZE         144 /* the longest known is SHA3-224 */
  85:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #elif defined(MBEDTLS_MD_CAN_SHA3_256)
  86:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #define MBEDTLS_MD_MAX_BLOCK_SIZE         136
  87:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #elif defined(MBEDTLS_MD_CAN_SHA512) || defined(MBEDTLS_MD_CAN_SHA384)
  88:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #define MBEDTLS_MD_MAX_BLOCK_SIZE         128
  89:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #elif defined(MBEDTLS_MD_CAN_SHA3_384)
  90:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #define MBEDTLS_MD_MAX_BLOCK_SIZE         104
  91:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #elif defined(MBEDTLS_MD_CAN_SHA3_512)
  92:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #define MBEDTLS_MD_MAX_BLOCK_SIZE         72
  93:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #else
  94:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #define MBEDTLS_MD_MAX_BLOCK_SIZE         64
  95:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** #endif
