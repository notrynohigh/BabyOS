  20:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * To improve readability of constant_time_internal.h, the static inline
  21:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * definitions are here, and constant_time_internal.h has only the declarations.
  22:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
  23:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * This results in duplicate declarations of the form:
  24:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *     static inline void f();         // from constant_time_internal.h
