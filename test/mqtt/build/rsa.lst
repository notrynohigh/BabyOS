 517:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param index             The (secret) table index to look up. This must be in the
 518:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                          range `0 .. count-1`.
 519:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  */
