 742:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     /*
 743:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * Check whether provided parameters are enough
 744:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * to deduce all others. The following incomplete
 745:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * parameter sets for private keys are supported:
 746:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      *
 747:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * (1) P, Q missing.
 748:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * (2) D and potentially N missing.
 749:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      *
 750:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      */
 751:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
 752:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     n_missing  =              have_P &&  have_Q &&  have_D && have_E;
 753:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     pq_missing =   have_N && !have_P && !have_Q &&  have_D && have_E;
 754:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     d_missing  =              have_P &&  have_Q && !have_D && have_E;
 755:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     is_pub     =   have_N && !have_P && !have_Q && !have_D && have_E;
 756:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
 757:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     /* These three alternatives are mutually exclusive */
 758:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     is_priv = n_missing || pq_missing || d_missing;
