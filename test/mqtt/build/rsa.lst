 489:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** /**
 490:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \brief Calculate the square of the Montgomery constant. (Needed
 491:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *        for conversion and operations in Montgomery form.)
 492:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 493:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[out] X  A pointer to the result of the calculation of
 494:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                the square of the Montgomery constant:
 495:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                2^{2*n*biL} mod N.
 496:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param[in]  N  Little-endian presentation of the modulus, which must be odd.
 497:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 498:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \return        0 if successful.
 499:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \return        #MBEDTLS_ERR_MPI_ALLOC_FAILED if there is not enough space
 500:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                to store the value of Montgomery constant squared.
 501:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \return        #MBEDTLS_ERR_MPI_DIVISION_BY_ZERO if \p N modulus is zero.
 502:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \return        #MBEDTLS_ERR_MPI_NEGATIVE_VALUE if \p N modulus is negative.
 503:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  */
 504:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** int mbedtls_mpi_core_get_mont_r2_unsafe(mbedtls_mpi *X,
 505:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                                         const mbedtls_mpi *N);
