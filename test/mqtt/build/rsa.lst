 416:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** /** This function performs the unpadding part of a PKCS#1 v1.5 decryption
 417:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *  operation (EME-PKCS1-v1_5 decoding).
 418:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *
 419:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * \note The return value from this function is a sensitive value
 420:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *       (this is unusual). #MBEDTLS_ERR_RSA_OUTPUT_TOO_LARGE shouldn't happen
 421:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *       in a well-written application, but 0 vs #MBEDTLS_ERR_RSA_INVALID_PADDING
 422:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *       is often a situation that an attacker can provoke and leaking which
 423:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *       one is the result is precisely the information the attacker wants.
 424:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *
 425:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * \param input          The input buffer which is the payload inside PKCS#1v1.5
 426:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *                       encryption padding, called the "encoded message EM"
 427:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *                       by the terminology.
 428:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * \param ilen           The length of the payload in the \p input buffer.
 429:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * \param output         The buffer for the payload, called "message M" by the
 430:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *                       PKCS#1 terminology. This must be a writable buffer of
 431:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *                       length \p output_max_len bytes.
 432:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * \param olen           The address at which to store the length of
 433:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *                       the payload. This must not be \c NULL.
 434:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * \param output_max_len The length in bytes of the output buffer \p output.
 435:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *
 436:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * \return      \c 0 on success.
 437:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * \return      #MBEDTLS_ERR_RSA_OUTPUT_TOO_LARGE
 438:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *              The output buffer is too small for the unpadded payload.
 439:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * \return      #MBEDTLS_ERR_RSA_INVALID_PADDING
 440:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *              The input doesn't contain properly formatted padding.
 441:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  */
