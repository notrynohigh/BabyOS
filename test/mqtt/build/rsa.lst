 177:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** /**
 178:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \brief           This function selects the message digest algorithm to use,
 179:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  and allocates internal structures.
 180:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *
 181:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  It should be called after mbedtls_md_init() or
 182:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  mbedtls_md_free(). Makes it necessary to call
 183:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  mbedtls_md_free() later.
 184:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *
 185:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \param ctx       The context to set up.
 186:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \param md_info   The information structure of the message-digest algorithm
 187:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  to use.
 188:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \param hmac      Defines if HMAC is used. 0: HMAC is not used (saves some memory),
 189:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  or non-zero: HMAC is used with this context.
 190:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *
 191:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \return          \c 0 on success.
 192:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \return          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification
 193:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  failure.
 194:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \return          #MBEDTLS_ERR_MD_ALLOC_FAILED on memory-allocation failure.
 195:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  */
 196:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** MBEDTLS_CHECK_RETURN_TYPICAL
 197:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** int mbedtls_md_setup(mbedtls_md_context_t *ctx, const mbedtls_md_info_t *md_info, int hmac);
 198:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** 
 199:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** /**
 200:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \brief           This function clones the state of a message-digest
 201:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  context.
 202:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *
 203:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \note            You must call mbedtls_md_setup() on \c dst before calling
 204:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  this function.
 205:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *
 206:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \note            The two contexts must have the same type,
 207:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  for example, both are SHA-256.
 208:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *
 209:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \warning         This function clones the message-digest state, not the
 210:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  HMAC state.
 211:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *
 212:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \param dst       The destination context.
 213:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \param src       The context to be cloned.
 214:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *
 215:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \return          \c 0 on success.
 216:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \return          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification failure.
 217:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \return          #MBEDTLS_ERR_MD_FEATURE_UNAVAILABLE if both contexts are
 218:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  not using the same engine. This can be avoided by moving
 219:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  the call to psa_crypto_init() before the first call to
 220:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  mbedtls_md_setup().
 221:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  */
 222:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** MBEDTLS_CHECK_RETURN_TYPICAL
 223:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h **** int mbedtls_md_clone(mbedtls_md_context_t *dst,
 224:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****                      const mbedtls_md_context_t *src);
