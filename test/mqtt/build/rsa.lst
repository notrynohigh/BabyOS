  75:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
  76:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** /* Ensure that the compiler cannot know the value of x (i.e., cannot optimise
  77:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * based on its value) after this function is called.
  78:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
  79:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * If we are not using assembly, this will be fairly inefficient, so its use
  80:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * should be minimised.
  81:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  */
  82:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
  83:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #if !defined(MBEDTLS_CT_ASM)
  84:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** extern volatile mbedtls_ct_uint_t mbedtls_ct_zero;
  85:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #endif
  86:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
  87:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** /**
  88:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * \brief   Ensure that a value cannot be known at compile time.
  89:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
  90:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * \param x        The value to hide from the compiler.
  91:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * \return         The same value that was passed in, such that the compiler
  92:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *                 cannot prove its value (even for calls of the form
  93:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *                 x = mbedtls_ct_compiler_opaque(1), x will be unknown).
  94:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
  95:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * \note           This is mainly used in constructing mbedtls_ct_condition_t
  96:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *                 values and performing operations over them, to ensure that
  97:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *                 there is no way for the compiler to ever know anything about
  98:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *                 the value of an mbedtls_ct_condition_t.
  99:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  */
 100:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** static inline mbedtls_ct_uint_t mbedtls_ct_compiler_opaque(mbedtls_ct_uint_t x)
 101:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** {
 102:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #if defined(MBEDTLS_CT_ASM)
 103:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     asm volatile ("" : [x] "+r" (x) :);
 104:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     return x;
 105:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #else
 106:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     return x ^ mbedtls_ct_zero;
 107:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #endif
 108:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** }
 109:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
 110:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** /*
 111:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * Selecting unified syntax is needed for gcc, and harmless on clang.
 112:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
 113:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * This is needed because on Thumb 1, condition flags are always set, so
 114:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * e.g. "negs" is supported but "neg" is not (on Thumb 2, both exist).
 115:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
 116:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * Under Thumb 1 unified syntax, only the "negs" form is accepted, and
 117:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * under divided syntax, only the "neg" form is accepted. clang only
 118:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * supports unified syntax.
 119:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
 120:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * On Thumb 2 and Arm, both compilers are happy with the "s" suffix,
 121:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * although we don't actually care about setting the flags.
 122:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
 123:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * For old versions of gcc (see #8516 for details), restore divided
 124:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * syntax afterwards - otherwise old versions of gcc seem to apply
 125:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * unified syntax globally, which breaks other asm code.
 126:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  */
 127:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #if defined(MBEDTLS_COMPILER_IS_GCC) && defined(__thumb__) && !defined(__thumb2__) && \
 128:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     (__GNUC__ < 11) && !defined(__ARM_ARCH_2__)
 129:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #define RESTORE_ASM_SYNTAX  ".syntax divided                      \n\t"
 130:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #else
 131:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #define RESTORE_ASM_SYNTAX
