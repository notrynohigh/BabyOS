  50:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** /*
  51:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * Wrapper around mbedtls_asn1_get_mpi() that rejects zero.
  52:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *
  53:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * The value zero is:
  54:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * - never a valid value for an RSA parameter
  55:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * - interpreted as "omitted, please reconstruct" by mbedtls_rsa_complete().
  56:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  *
  57:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * Since values can't be omitted in PKCS#1, passing a zero value to
  58:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  * rsa_complete() would be incorrect, so reject zero values early.
  59:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****  */
  60:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** static int asn1_get_nonzero_mpi(unsigned char **p,
  61:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****                                 const unsigned char *end,
  62:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****                                 mbedtls_mpi *X)
  63:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** {
  64:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     int ret;
  65:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
  66:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     ret = mbedtls_asn1_get_mpi(p, end, X);
  67:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     if (ret != 0) {
  68:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         return ret;
  69:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     }
  70:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
  71:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     if (mbedtls_mpi_cmp_int(X, 0) == 0) {
  72:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;
  73:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     }
  74:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
  75:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     return 0;
  76:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** }
