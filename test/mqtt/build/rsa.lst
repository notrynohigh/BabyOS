 159:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     /*
 160:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * The RSA CRT parameters DP, DQ and QP are nominally redundant, in
 161:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * that they can be easily recomputed from D, P and Q. However by
 162:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * parsing them from the PKCS1 structure it is possible to avoid
GAS LISTING /tmp/ccpAd290.s 			page 4


 163:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * recalculating them which both reduces the overhead of loading
 164:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * RSA private keys into memory and also avoids side channels which
 165:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * can arise when computing those values, since all of D, P, and Q
 166:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * are secret. See https://eprint.iacr.org/2020/055 for a
 167:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      * description of one such attack.
 168:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****      */
 169:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c **** 
 170:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     /* Import DP */
 171:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     if ((ret = asn1_get_nonzero_mpi(&p, end, &T)) != 0 ||
 172:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         (ret = mbedtls_mpi_copy(&rsa->DP, &T)) != 0) {
 173:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****         goto cleanup;
 174:../../bos/thirdparty/mbedtls/bos_mbedtls/rsa.c ****     }
