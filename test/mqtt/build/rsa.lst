 527:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** /**
 528:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \brief          Fill an integer with a number of random bytes.
 529:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 530:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param X        The destination MPI.
 531:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param X_limbs  The number of limbs of \p X.
 532:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param bytes    The number of random bytes to generate.
 533:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param f_rng    The RNG function to use. This must not be \c NULL.
 534:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \param p_rng    The RNG parameter to be passed to \p f_rng. This may be
 535:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 \c NULL if \p f_rng doesn't need a context argument.
 536:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 537:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \return         \c 0 if successful.
 538:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \return         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \p X does not have
 539:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 enough room for \p bytes bytes.
 540:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \return         A negative error code on RNG failure.
 541:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *
 542:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  * \note           The bytes obtained from the RNG are interpreted
 543:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 as a big-endian representation of an MPI; this can
GAS LISTING /tmp/ccpAd290.s 			page 263


 544:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  *                 be relevant in applications like deterministic ECDSA.
 545:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****  */
 546:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h **** int mbedtls_mpi_core_fill_random(mbedtls_mpi_uint *X, size_t X_limbs,
 547:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                                  size_t bytes,
 548:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                                  int (*f_rng)(void *, unsigned char *, size_t),
 549:../../bos/thirdparty/mbedtls/bos_mbedtls/bignum_core.h ****                                  void *p_rng);
