  59:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c ****  * GCC < 8 won't work at all (lacks the sha512 instructions)
  60:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c ****  * GCC >= 8 uses intrinsics, sets __ARM_FEATURE_SHA512
  61:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c ****  *
  62:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c ****  * Clang < 7 won't work at all (lacks the sha512 instructions)
  63:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c ****  * Clang 7-12 don't have intrinsics (but we work around that with inline
  64:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c ****  *            assembler) or __ARM_FEATURE_SHA512
  65:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c ****  * Clang == 13.0.0 same as clang 12 (only seen on macOS)
  66:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c ****  * Clang >= 13.0.1 has __ARM_FEATURE_SHA512 and intrinsics
  67:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c ****  */
  68:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c **** #    if !defined(__ARM_FEATURE_SHA512) || defined(MBEDTLS_ENABLE_ARM_SHA3_EXTENSIONS_COMPILER_FLAG)
  69:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c ****        /* Test Clang first, as it defines __GNUC__ */
  70:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c **** #      if defined(__ARMCOMPILER_VERSION)
  71:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c **** #        if __ARMCOMPILER_VERSION < 6090000
