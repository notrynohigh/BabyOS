  73:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c **** #        elif __ARMCOMPILER_VERSION == 6090000
  74:../../bos/thirdparty/mbedtls/bos_mbedtls/sha512.c **** #          error "Must use minimum -march=armv8.2-a+sha3 for MBEDTLS_SHA512_USE_A64_CRYPTO_*"
