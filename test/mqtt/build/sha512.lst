 103:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h **** /**
 104:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * Read the unsigned 16 bits integer from the given address, which need not
 105:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * be aligned.
 106:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  *
 107:../../bos/thirdparty/mbedtls/bos_mbedtls/alignment.h ****  * \param   p pointer to 2 bytes of data
