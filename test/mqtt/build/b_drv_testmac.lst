 134:../../bos/drivers/b_drv_testmac.c **** // 设置socket为非阻塞模式
 135:../../bos/drivers/b_drv_testmac.c **** static int _bSockSetNonblocking(int sockfd)
 136:../../bos/drivers/b_drv_testmac.c **** {
 137:../../bos/drivers/b_drv_testmac.c ****     int flags = fcntl(sockfd, F_GETFL, 0);
 138:../../bos/drivers/b_drv_testmac.c ****     if (flags == -1)
 139:../../bos/drivers/b_drv_testmac.c ****     {
 140:../../bos/drivers/b_drv_testmac.c ****         perror("fcntl F_GETFL failed");
 141:../../bos/drivers/b_drv_testmac.c ****         return -1;
 142:../../bos/drivers/b_drv_testmac.c ****     }
 143:../../bos/drivers/b_drv_testmac.c ****     if (fcntl(sockfd, F_SETFL, flags | O_NONBLOCK) == -1)
 144:../../bos/drivers/b_drv_testmac.c ****     {
 145:../../bos/drivers/b_drv_testmac.c ****         perror("fcntl F_SETFL failed");
GAS LISTING /tmp/ccRtkei6.s 			page 5


 146:../../bos/drivers/b_drv_testmac.c ****         return -1;
 147:../../bos/drivers/b_drv_testmac.c ****     }
 148:../../bos/drivers/b_drv_testmac.c ****     return 0;
 149:../../bos/drivers/b_drv_testmac.c **** }
 150:../../bos/drivers/b_drv_testmac.c **** 
 151:../../bos/drivers/b_drv_testmac.c **** // 检查socket是否可读
 152:../../bos/drivers/b_drv_testmac.c **** static uint8_t _bTestMacIsReadable(void *sockfd)
 153:../../bos/drivers/b_drv_testmac.c **** {
 154:../../bos/drivers/b_drv_testmac.c ****     int            sock = (int)sockfd;
 155:../../bos/drivers/b_drv_testmac.c ****     fd_set         read_fds;
 156:../../bos/drivers/b_drv_testmac.c ****     struct timeval timeout;
 157:../../bos/drivers/b_drv_testmac.c **** 
 158:../../bos/drivers/b_drv_testmac.c ****     FD_ZERO(&read_fds);
 159:../../bos/drivers/b_drv_testmac.c ****     FD_SET(sock, &read_fds);
 160:../../bos/drivers/b_drv_testmac.c **** 
 161:../../bos/drivers/b_drv_testmac.c ****     // 设置超时时间
 162:../../bos/drivers/b_drv_testmac.c ****     timeout.tv_sec  = 0;
 163:../../bos/drivers/b_drv_testmac.c ****     timeout.tv_usec = 0;
 164:../../bos/drivers/b_drv_testmac.c **** 
 165:../../bos/drivers/b_drv_testmac.c ****     // 使用select检查可读性
 166:../../bos/drivers/b_drv_testmac.c ****     int ret = select(sock + 1, &read_fds, NULL, NULL, &timeout);
 167:../../bos/drivers/b_drv_testmac.c ****     if (ret == -1)
 168:../../bos/drivers/b_drv_testmac.c ****     {
 169:../../bos/drivers/b_drv_testmac.c ****         return 0;
 170:../../bos/drivers/b_drv_testmac.c ****     }
 171:../../bos/drivers/b_drv_testmac.c ****     else if (ret == 0)
 172:../../bos/drivers/b_drv_testmac.c ****     {
 173:../../bos/drivers/b_drv_testmac.c ****         return 0;  // 超时，不可读
 174:../../bos/drivers/b_drv_testmac.c ****     }
 175:../../bos/drivers/b_drv_testmac.c ****     return 1;  // 可读
 176:../../bos/drivers/b_drv_testmac.c **** }
 177:../../bos/drivers/b_drv_testmac.c **** 
 178:../../bos/drivers/b_drv_testmac.c **** // 检查socket是否可写
 179:../../bos/drivers/b_drv_testmac.c **** static uint8_t _bTestMacIsWriteable(void *sockfd)
 180:../../bos/drivers/b_drv_testmac.c **** {
 181:../../bos/drivers/b_drv_testmac.c ****     int            sock = (int)sockfd;
 182:../../bos/drivers/b_drv_testmac.c ****     fd_set         write_fds;
 183:../../bos/drivers/b_drv_testmac.c ****     struct timeval timeout;
 184:../../bos/drivers/b_drv_testmac.c **** 
 185:../../bos/drivers/b_drv_testmac.c ****     FD_ZERO(&write_fds);
 186:../../bos/drivers/b_drv_testmac.c ****     FD_SET(sock, &write_fds);
 187:../../bos/drivers/b_drv_testmac.c **** 
 188:../../bos/drivers/b_drv_testmac.c ****     // 设置超时时间
 189:../../bos/drivers/b_drv_testmac.c ****     timeout.tv_sec  = 0;
 190:../../bos/drivers/b_drv_testmac.c ****     timeout.tv_usec = 0;
 191:../../bos/drivers/b_drv_testmac.c **** 
 192:../../bos/drivers/b_drv_testmac.c ****     // 使用select检查可写性
 193:../../bos/drivers/b_drv_testmac.c ****     b_log("check wr select\r\n");
 194:../../bos/drivers/b_drv_testmac.c ****     int ret = select(sock + 1, NULL, &write_fds, NULL, &timeout);
 195:../../bos/drivers/b_drv_testmac.c ****     b_log("wr select:%d\r\n", ret);
 196:../../bos/drivers/b_drv_testmac.c ****     if (ret == -1)
 197:../../bos/drivers/b_drv_testmac.c ****     {
 198:../../bos/drivers/b_drv_testmac.c ****         return 0;
 199:../../bos/drivers/b_drv_testmac.c ****     }
 200:../../bos/drivers/b_drv_testmac.c ****     else if (ret == 0)
 201:../../bos/drivers/b_drv_testmac.c ****     {
 202:../../bos/drivers/b_drv_testmac.c ****         return 0;  // 超时，不可写
GAS LISTING /tmp/ccRtkei6.s 			page 6


 203:../../bos/drivers/b_drv_testmac.c ****     }
 204:../../bos/drivers/b_drv_testmac.c ****     return 1;  // 可写
 205:../../bos/drivers/b_drv_testmac.c **** }
