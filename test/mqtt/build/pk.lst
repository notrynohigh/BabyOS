 450:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #if defined(MBEDTLS_USE_PSA_CRYPTO)
 451:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 452:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Tell if context can do the operation given by PSA algorithm
 453:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 454:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param ctx       The context to query. It must have been initialized.
 455:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param alg       PSA algorithm to check against, the following are allowed:
 456:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_ALG_RSA_PKCS1V15_SIGN(hash),
 457:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_ALG_RSA_PSS(hash),
 458:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_ALG_RSA_PKCS1V15_CRYPT,
 459:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_ALG_ECDSA(hash),
 460:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_ALG_ECDH, where hash is a specific hash.
 461:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param usage     PSA usage flag to check against, must be composed of:
 462:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_KEY_USAGE_SIGN_HASH
 463:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_KEY_USAGE_DECRYPT
 464:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_KEY_USAGE_DERIVE.
 465:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  Context key must match all passed usage flags.
 466:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 467:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \warning         Since the set of allowed algorithms and usage flags may be
 468:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  expanded in the future, the return value \c 0 should not
 469:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  be taken in account for non-allowed algorithms and usage
 470:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  flags.
 471:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 472:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          1 if the context can do operations on the given type.
 473:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 if the context cannot do the operations on the given
 474:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  type, for non-allowed algorithms and usage flags, or
 475:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  for a context that has been initialized but not set up
 476:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  or that has been cleared with mbedtls_pk_free().
 477:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 478:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** int mbedtls_pk_can_do_ext(const mbedtls_pk_context *ctx, psa_algorithm_t alg,
 479:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                           psa_key_usage_t usage);
 480:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #endif /* MBEDTLS_USE_PSA_CRYPTO */
 481:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** 
 482:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #if defined(MBEDTLS_PSA_CRYPTO_CLIENT)
GAS LISTING /tmp/ccbaEuC6.s 			page 61


 483:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 484:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Determine valid PSA attributes that can be used to
 485:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  import a key into PSA.
 486:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 487:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * The attributes determined by this function are suitable
 488:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * for calling mbedtls_pk_import_into_psa() to create
 489:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * a PSA key with the same key material.
 490:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 491:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * The typical flow of operations involving this function is
 492:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * ```
 493:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
 494:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * int ret = mbedtls_pk_get_psa_attributes(pk, &attributes);
 495:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * if (ret != 0) ...; // error handling omitted
 496:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * // Tweak attributes if desired
 497:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * psa_key_id_t key_id = 0;
 498:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * ret = mbedtls_pk_import_into_psa(pk, &attributes, &key_id);
 499:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * if (ret != 0) ...; // error handling omitted
 500:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * ```
 501:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 502:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            This function does not support RSA-alt contexts
 503:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  (set up with mbedtls_pk_setup_rsa_alt()).
 504:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 505:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param[in] pk    The PK context to use. It must have been set up.
 506:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  It can either contain a key pair or just a public key.
 507:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param usage     A single `PSA_KEY_USAGE_xxx` flag among the following:
 508:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #PSA_KEY_USAGE_DECRYPT: \p pk must contain a
 509:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    key pair. The output \p attributes will contain a
 510:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    key pair type, and the usage policy will allow
 511:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    #PSA_KEY_USAGE_ENCRYPT as well as
 512:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    #PSA_KEY_USAGE_DECRYPT.
 513:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #PSA_KEY_USAGE_DERIVE: \p pk must contain a
 514:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    key pair. The output \p attributes will contain a
 515:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    key pair type.
 516:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #PSA_KEY_USAGE_ENCRYPT: The output
 517:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    \p attributes will contain a public key type.
 518:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #PSA_KEY_USAGE_SIGN_HASH: \p pk must contain a
 519:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    key pair. The output \p attributes will contain a
 520:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    key pair type, and the usage policy will allow
 521:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    #PSA_KEY_USAGE_VERIFY_HASH as well as
 522:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    #PSA_KEY_USAGE_SIGN_HASH.
 523:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #PSA_KEY_USAGE_SIGN_MESSAGE: \p pk must contain a
 524:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    key pair. The output \p attributes will contain a
 525:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    key pair type, and the usage policy will allow
 526:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    #PSA_KEY_USAGE_VERIFY_MESSAGE as well as
 527:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    #PSA_KEY_USAGE_SIGN_MESSAGE.
 528:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #PSA_KEY_USAGE_VERIFY_HASH: The output
 529:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    \p attributes will contain a public key type.
 530:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #PSA_KEY_USAGE_VERIFY_MESSAGE: The output
 531:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    \p attributes will contain a public key type.
 532:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param[out] attributes
 533:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  On success, valid attributes to import the key into PSA.
 534:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - The lifetime and key identifier are unchanged. If the
 535:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    attribute structure was initialized or reset before
 536:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    calling this function, this will result in a volatile
 537:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    key. Call psa_set_key_identifier() before or after this
 538:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    function if you wish to create a persistent key. Call
 539:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    psa_set_key_lifetime() before or after this function if
GAS LISTING /tmp/ccbaEuC6.s 			page 62


 540:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    you wish to import the key in a secure element.
 541:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - The key type and bit-size are determined by the contents
 542:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    of the PK context. If the PK context contains a key
 543:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    pair, the key type can be either a key pair type or
 544:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    the corresponding public key type, depending on
 545:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    \p usage. If the PK context contains a public key,
 546:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    the key type is a public key type.
 547:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - The key's policy is determined by the key type and
 548:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    the \p usage parameter. The usage always allows
 549:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    \p usage, exporting and copying the key, and
 550:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    possibly other permissions as documented for the
 551:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    \p usage parameter.
 552:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    The permitted algorithm policy is determined as follows
 553:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    based on the #mbedtls_pk_type_t type of \p pk,
 554:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    the chosen \p usage and other factors:
 555:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                      - #MBEDTLS_PK_RSA whose underlying
 556:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        #mbedtls_rsa_context has the padding mode
 557:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        #MBEDTLS_RSA_PKCS_V15:
 558:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        #PSA_ALG_RSA_PKCS1V15_SIGN(#PSA_ALG_ANY_HASH)
 559:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        if \p usage is SIGN/VERIFY, and
 560:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        #PSA_ALG_RSA_PKCS1V15_CRYPT
 561:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        if \p usage is ENCRYPT/DECRYPT.
 562:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                      - #MBEDTLS_PK_RSA whose underlying
 563:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        #mbedtls_rsa_context has the padding mode
 564:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        #MBEDTLS_RSA_PKCS_V21 and the digest type
 565:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        corresponding to the PSA algorithm \c hash:
 566:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        #PSA_ALG_RSA_PSS_ANY_SALT(#PSA_ALG_ANY_HASH)
 567:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        if \p usage is SIGN/VERIFY, and
 568:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        #PSA_ALG_RSA_OAEP(\c hash)
 569:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        if \p usage is ENCRYPT/DECRYPT.
 570:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                      - #MBEDTLS_PK_RSA_ALT: not supported.
 571:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                      - #MBEDTLS_PK_ECDSA or #MBEDTLS_PK_ECKEY
 572:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        if \p usage is SIGN/VERIFY:
 573:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        #PSA_ALG_DETERMINISTIC_ECDSA(#PSA_ALG_ANY_HASH)
 574:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        if #MBEDTLS_ECDSA_DETERMINISTIC is enabled,
 575:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        otherwise #PSA_ALG_ECDSA(#PSA_ALG_ANY_HASH).
 576:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                      - #MBEDTLS_PK_ECKEY_DH or #MBEDTLS_PK_ECKEY
 577:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        if \p usage is DERIVE:
 578:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        #PSA_ALG_ECDH.
 579:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                      - #MBEDTLS_PK_OPAQUE: same as the primary algorithm
 580:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        set for the underlying PSA key, except that
 581:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        sign/decrypt flags are removed if the type is
 582:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        set to a public key type.
 583:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        The underlying key must allow \p usage.
 584:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        Note that the enrollment algorithm set with
 585:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                        psa_set_key_enrollment_algorithm() is not copied.
 586:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 587:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 on success.
 588:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  #MBEDTLS_ERR_PK_TYPE_MISMATCH if \p pk does not contain
 589:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  a key of the type identified in \p attributes.
 590:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  Another error code on other failures.
 591:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 592:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** int mbedtls_pk_get_psa_attributes(const mbedtls_pk_context *pk,
 593:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                                   psa_key_usage_t usage,
 594:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                                   psa_key_attributes_t *attributes);
 595:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** 
 596:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
GAS LISTING /tmp/ccbaEuC6.s 			page 63


 597:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Import a key into the PSA key store.
 598:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 599:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * This function is equivalent to calling psa_import_key()
 600:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * with the key material from \p pk.
 601:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 602:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * The typical way to use this function is:
 603:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * -# Call mbedtls_pk_get_psa_attributes() to obtain
 604:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *    attributes for the given key.
 605:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * -# If desired, modify the attributes, for example:
 606:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *     - To create a persistent key, call
 607:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *       psa_set_key_identifier() and optionally
 608:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *       psa_set_key_lifetime().
 609:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *     - To import only the public part of a key pair:
 610:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 611:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *           psa_set_key_type(&attributes,
 612:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                            PSA_KEY_TYPE_PUBLIC_KEY_OF_KEY_PAIR(
 613:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                                psa_get_key_type(&attributes)));
 614:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *     - Restrict the key usage if desired.
 615:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * -# Call mbedtls_pk_import_into_psa().
 616:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 617:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            This function does not support RSA-alt contexts
 618:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  (set up with mbedtls_pk_setup_rsa_alt()).
 619:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 620:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param[in] pk    The PK context to use. It must have been set up.
 621:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  It can either contain a key pair or just a public key.
 622:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param[in] attributes
 623:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  The attributes to use for the new key. They must be
 624:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  compatible with \p pk. In particular, the key type
 625:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  must match the content of \p pk.
 626:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  If \p pk contains a key pair, the key type in
 627:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  attributes can be either the key pair type or the
 628:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  corresponding public key type (to import only the
 629:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  public part).
 630:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param[out] key_id
 631:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  On success, the identifier of the newly created key.
 632:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  On error, this is #MBEDTLS_SVC_KEY_ID_INIT.
 633:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 634:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 on success.
 635:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  #MBEDTLS_ERR_PK_TYPE_MISMATCH if \p pk does not contain
 636:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  a key of the type identified in \p attributes.
 637:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  Another error code on other failures.
 638:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 639:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** int mbedtls_pk_import_into_psa(const mbedtls_pk_context *pk,
 640:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                                const psa_key_attributes_t *attributes,
 641:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                                mbedtls_svc_key_id_t *key_id);
 642:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** 
 643:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 644:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Create a PK context starting from a key stored in PSA.
 645:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  This key:
 646:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - must be exportable and
 647:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - must be an RSA or EC key pair or public key (FFDH is not supported in PK).
 648:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 649:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  The resulting PK object will be a transparent type:
 650:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #MBEDTLS_PK_RSA for RSA keys or
 651:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #MBEDTLS_PK_ECKEY for EC keys.
 652:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
