 436:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 437:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Tell if a context can do the operation given by type
 438:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 439:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param ctx       The context to query. It must have been initialized.
 440:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param type      The desired type.
 441:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 442:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          1 if the context can do operations on the given type.
 443:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 if the context cannot do the operations on the given
 444:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  type. This is always the case for a context that has
 445:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  been initialized but not set up, or that has been
 446:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  cleared with mbedtls_pk_free().
 447:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 448:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** int mbedtls_pk_can_do(const mbedtls_pk_context *ctx, mbedtls_pk_type_t type);
