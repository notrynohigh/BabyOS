 852:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param md_alg    Hash algorithm used (see notes)
 853:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash      Hash of the message to sign
 854:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash_len  Hash length
 855:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig       Place to write the signature.
 856:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  It must have enough room for the signature.
 857:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  #MBEDTLS_PK_SIGNATURE_MAX_SIZE is always enough.
 858:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  You may use a smaller buffer if it is large enough
 859:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  given the key type.
 860:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig_size  The size of the \p sig buffer in bytes.
 861:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig_len   On successful return,
 862:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  the number of bytes written to \p sig.
 863:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param f_rng     RNG function, must not be \c NULL.
 864:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param p_rng     RNG parameter
 865:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 866:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 on success, or a specific error code.
 867:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 868:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            When \p pk_type is #MBEDTLS_PK_RSASSA_PSS,
 869:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  see #PSA_ALG_RSA_PSS for a description of PSS options used.
 870:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 871:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            For RSA, md_alg may be MBEDTLS_MD_NONE if hash_len != 0.
 872:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  For ECDSA, md_alg may never be MBEDTLS_MD_NONE.
 873:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 874:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
