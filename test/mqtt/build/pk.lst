 713:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 714:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Verify signature (including padding if relevant).
 715:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 716:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param ctx       The PK context to use. It must have been set up.
 717:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param md_alg    Hash algorithm used.
 718:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  This can be #MBEDTLS_MD_NONE if the signature algorithm
 719:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  does not rely on a hash algorithm (non-deterministic
 720:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  ECDSA, RSA PKCS#1 v1.5).
 721:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  For PKCS#1 v1.5, if \p md_alg is #MBEDTLS_MD_NONE, then
 722:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  \p hash is the DigestInfo structure used by RFC 8017
 723:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  &sect;9.2 steps 3&ndash;6. If \p md_alg is a valid hash
 724:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  algorithm then \p hash is the digest itself, and this
 725:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  function calculates the DigestInfo encoding internally.
 726:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash      Hash of the message to sign
 727:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash_len  Hash length
 728:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig       Signature to verify
 729:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig_len   Signature length
 730:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 731:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            For keys of type #MBEDTLS_PK_RSA, the signature algorithm is
 732:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  either PKCS#1 v1.5 or PSS (accepting any salt length),
 733:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  depending on the padding mode in the underlying RSA context.
 734:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  For a pk object constructed by parsing, this is PKCS#1 v1.5
 735:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  by default. Use mbedtls_pk_verify_ext() to explicitly select
 736:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  a different algorithm.
 737:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 738:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 on success (signature is valid),
 739:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  #MBEDTLS_ERR_PK_SIG_LEN_MISMATCH if there is a valid
 740:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  signature in \p sig but its length is less than \p sig_len,
 741:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  or a specific error code.
 742:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
