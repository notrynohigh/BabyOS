 342:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     /*
 343:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****      * Common case: the key alg [or alg2] only allows alg.
 344:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****      * This will match PSA_ALG_RSA_PKCS1V15_CRYPT & PSA_ALG_IS_ECDH
 345:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****      * directly.
 346:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****      * This would also match ECDSA/RSA_PKCS1V15_SIGN/RSA_PSS with
 347:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****      * a fixed hash on key_alg [or key_alg2].
 348:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****      */
 349:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     if (alg == key_alg) {
 350:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         return 1;
 351:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     }
 352:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** #if defined(MBEDTLS_PSA_CRYPTO_C)
 353:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     if (alg == key_alg2) {
 354:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         return 1;
 355:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     }
 356:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** #endif /* MBEDTLS_PSA_CRYPTO_C */
 357:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
 358:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     /*
 359:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****      * If key_alg [or key_alg2] is a hash-and-sign with a wildcard for the hash,
 360:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****      * and alg is the same hash-and-sign family with any hash,
 361:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****      * then alg is compliant with this key alg
 362:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****      */
 363:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     if (PSA_ALG_IS_SIGN_HASH(alg)) {
 364:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         if (PSA_ALG_IS_SIGN_HASH(key_alg) &&
 365:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             PSA_ALG_SIGN_GET_HASH(key_alg) == PSA_ALG_ANY_HASH &&
 366:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             (alg & ~PSA_ALG_HASH_MASK) == (key_alg & ~PSA_ALG_HASH_MASK)) {
 367:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             return 1;
 368:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         }
 369:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** #if defined(MBEDTLS_PSA_CRYPTO_C)
 370:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         if (PSA_ALG_IS_SIGN_HASH(key_alg2) &&
 371:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             PSA_ALG_SIGN_GET_HASH(key_alg2) == PSA_ALG_ANY_HASH &&
 372:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             (alg & ~PSA_ALG_HASH_MASK) == (key_alg2 & ~PSA_ALG_HASH_MASK)) {
 373:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             return 1;
 374:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         }
 375:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** #endif /* MBEDTLS_PSA_CRYPTO_C */
 376:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     }
 377:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
 378:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     return 0;
 379:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** }
 380:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** #endif /* MBEDTLS_USE_PSA_CRYPTO */
