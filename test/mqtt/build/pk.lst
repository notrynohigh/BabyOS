 258:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
 259:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     /* Filter out non allowed algorithms */
 260:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     if (PSA_ALG_IS_ECDSA(alg) == 0 &&
 261:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         PSA_ALG_IS_RSA_PKCS1V15_SIGN(alg) == 0 &&
 262:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         PSA_ALG_IS_RSA_PSS(alg) == 0 &&
 263:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         alg != PSA_ALG_RSA_PKCS1V15_CRYPT &&
 264:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         PSA_ALG_IS_ECDH(alg) == 0) {
 265:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         return 0;
 266:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     }
 267:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
 268:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     /* Filter out non allowed usage flags */
 269:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     if (usage == 0 ||
 270:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         (usage & ~(PSA_KEY_USAGE_SIGN_HASH |
 271:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                    PSA_KEY_USAGE_DECRYPT |
 272:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                    PSA_KEY_USAGE_DERIVE)) != 0) {
 273:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         return 0;
 274:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     }
 275:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
 276:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     /* Wildcard hash is not allowed */
 277:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     if (PSA_ALG_IS_SIGN_HASH(alg) &&
 278:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         PSA_ALG_SIGN_GET_HASH(alg) == PSA_ALG_ANY_HASH) {
 279:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         return 0;
 280:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     }
 281:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
 282:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     if (mbedtls_pk_get_type(ctx) != MBEDTLS_PK_OPAQUE) {
