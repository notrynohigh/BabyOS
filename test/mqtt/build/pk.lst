GAS LISTING /tmp/ccbaEuC6.s 			page 58


 363:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 364:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            This function replaces mbedtls_pk_setup() for contexts
 365:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  that wrap a (possibly opaque) PSA key instead of
 366:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  storing and manipulating the key material directly.
 367:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 368:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param ctx       The context to initialize. It must be empty (type NONE).
 369:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param key       The PSA key to wrap, which must hold an ECC or RSA key
 370:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  pair (see notes below).
 371:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 372:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            The wrapped key must remain valid as long as the
 373:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  wrapping PK context is in use, that is at least between
 374:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  the point this function is called and the point
 375:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  mbedtls_pk_free() is called on this context. The wrapped
 376:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  key might then be independently used or destroyed.
 377:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 378:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            This function is currently only available for ECC or RSA
 379:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  key pairs (that is, keys containing private key material).
 380:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  Support for other key types may be added later.
 381:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 382:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          \c 0 on success.
 383:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          #MBEDTLS_ERR_PK_BAD_INPUT_DATA on invalid input
 384:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  (context already used, invalid key identifier).
 385:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          #MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE if the key is not an
 386:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  ECC key pair.
 387:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          #MBEDTLS_ERR_PK_ALLOC_FAILED on allocation failure.
 388:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 389:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** int mbedtls_pk_setup_opaque(mbedtls_pk_context *ctx,
