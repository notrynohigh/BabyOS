 220:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** typedef struct mbedtls_pk_context {
 221:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****     const mbedtls_pk_info_t *MBEDTLS_PRIVATE(pk_info);    /**< Public key information         */
 222:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****     void *MBEDTLS_PRIVATE(pk_ctx);                        /**< Underlying public key context  */
 223:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****     /* The following field is used to store the ID of a private key in the
 224:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * following cases:
 225:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * - opaque key when MBEDTLS_USE_PSA_CRYPTO is defined
 226:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * - normal key when MBEDTLS_PK_USE_PSA_EC_DATA is defined. In this case:
 227:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *    - the pk_ctx above is not not used to store the private key anymore.
 228:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *      Actually that field not populated at all in this case because also
 229:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *      the public key will be stored in raw format as explained below
 230:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *    - this ID is used for all private key operations (ex: sign, check
 231:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *      key pair, key write, etc) using PSA functions
 232:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *
 233:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * Note: this private key storing solution only affects EC keys, not the
 234:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *       other ones. The latters still use the pk_ctx to store their own
 235:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *       context. */
 236:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #if defined(MBEDTLS_USE_PSA_CRYPTO)
 237:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****     mbedtls_svc_key_id_t MBEDTLS_PRIVATE(priv_id);      /**< Key ID for opaque keys */
 238:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #endif /* MBEDTLS_USE_PSA_CRYPTO */
 239:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****     /* The following fields are meant for storing the public key in raw format
 240:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * which is handy for:
 241:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * - easily importing it into the PSA context
 242:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * - reducing the ECP module dependencies in the PK one.
 243:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *
 244:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * When MBEDTLS_PK_USE_PSA_EC_DATA is enabled:
 245:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * - the pk_ctx above is not used anymore for storing the public key
 246:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *   inside the ecp_keypair structure
 247:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * - the following fields are used for all public key operations: signature
 248:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *   verify, key pair check and key write.
GAS LISTING /tmp/ccbaEuC6.s 			page 56


 249:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * - For a key pair, priv_id contains the private key. For a public key,
 250:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *   priv_id is null.
 251:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * Of course, when MBEDTLS_PK_USE_PSA_EC_DATA is not enabled, the legacy
 252:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * ecp_keypair structure is used for storing the public key and performing
