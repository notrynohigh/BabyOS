 284:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
GAS LISTING /tmp/ccbaEuC6.s 			page 11


 285:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         if (PSA_ALG_IS_ECDSA(alg) || PSA_ALG_IS_ECDH(alg)) {
 286:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             type = MBEDTLS_PK_ECKEY;
 287:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         } else if (PSA_ALG_IS_RSA_PKCS1V15_SIGN(alg) ||
 288:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                    alg == PSA_ALG_RSA_PKCS1V15_CRYPT) {
 289:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             type = MBEDTLS_PK_RSA;
 290:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         } else if (PSA_ALG_IS_RSA_PSS(alg)) {
 291:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             type = MBEDTLS_PK_RSASSA_PSS;
 292:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         } else {
 293:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             return 0;
 294:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         }
 295:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
 296:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         if (ctx->pk_info->can_do(type) == 0) {
 297:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             return 0;
 298:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         }
 299:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
 300:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         switch (type) {
 301:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             case MBEDTLS_PK_ECKEY:
 302:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                 key_usage = PSA_KEY_USAGE_SIGN_HASH | PSA_KEY_USAGE_DERIVE;
 303:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                 break;
 304:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             case MBEDTLS_PK_RSA:
 305:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             case MBEDTLS_PK_RSASSA_PSS:
 306:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                 key_usage = PSA_KEY_USAGE_SIGN_HASH |
 307:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                             PSA_KEY_USAGE_SIGN_MESSAGE |
 308:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                             PSA_KEY_USAGE_DECRYPT;
 309:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                 break;
 310:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             default:
 311:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                 /* Should never happen */
 312:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                 return 0;
 313:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         }
