 190:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *
 191:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \return          \c 0 on success.
 192:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \return          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification
 193:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  *                  failure.
 194:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  * \return          #MBEDTLS_ERR_MD_ALLOC_FAILED on memory-allocation failure.
 195:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/md.h ****  */
