1439:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** /*
1440:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****  * Check public-private key pair
1441:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****  */
1442:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** int mbedtls_pk_check_pair(const mbedtls_pk_context *pub,
1443:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                           const mbedtls_pk_context *prv,
1444:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                           int (*f_rng)(void *, unsigned char *, size_t),
1445:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                           void *p_rng)
1446:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** {
1447:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     if (pub->pk_info == NULL ||
1448:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         prv->pk_info == NULL) {
1449:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         return MBEDTLS_ERR_PK_BAD_INPUT_DATA;
1450:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     }
1451:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
1452:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     if (f_rng == NULL) {
1453:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         return MBEDTLS_ERR_PK_BAD_INPUT_DATA;
1454:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     }
1455:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
1456:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     if (prv->pk_info->check_pair_func == NULL) {
1457:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;
1458:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     }
1459:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
1460:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     if (prv->pk_info->type == MBEDTLS_PK_RSA_ALT) {
1461:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         if (pub->pk_info->type != MBEDTLS_PK_RSA) {
1462:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             return MBEDTLS_ERR_PK_TYPE_MISMATCH;
1463:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         }
1464:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     } else {
1465:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         if ((prv->pk_info->type != MBEDTLS_PK_OPAQUE) &&
1466:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             (pub->pk_info != prv->pk_info)) {
1467:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****             return MBEDTLS_ERR_PK_TYPE_MISMATCH;
1468:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         }
1469:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     }
1470:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** 
1471:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     return prv->pk_info->check_pair_func((mbedtls_pk_context *) pub,
1472:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                                          (mbedtls_pk_context *) prv,
1473:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****                                          f_rng, p_rng);
1474:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c **** }
