 253:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****      * For backward compatibility, also accept NULL instead of a context
 254:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****      * pointer. */
 255:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****     if (ctx == NULL || ctx->pk_info == NULL) {
 256:../../bos/thirdparty/mbedtls/bos_mbedtls/pk.c ****         return 0;
