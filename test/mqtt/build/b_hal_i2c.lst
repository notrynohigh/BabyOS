  60:../../bos/hal/b_hal_i2c.c **** // 计算I2C延时微秒数值的函数
  61:../../bos/hal/b_hal_i2c.c **** static uint32_t _HalCalculateI2CDelayUs(uint32_t i2cFrequency)
  62:../../bos/hal/b_hal_i2c.c **** {
  63:../../bos/hal/b_hal_i2c.c ****     if (i2cFrequency <= 100000)
  64:../../bos/hal/b_hal_i2c.c ****     {
  65:../../bos/hal/b_hal_i2c.c ****         // Standard Mode (100kHz)
  66:../../bos/hal/b_hal_i2c.c ****         return 5;
  67:../../bos/hal/b_hal_i2c.c ****     }
  68:../../bos/hal/b_hal_i2c.c ****     else if (i2cFrequency <= 200000)
  69:../../bos/hal/b_hal_i2c.c ****     {
  70:../../bos/hal/b_hal_i2c.c ****         return 2;
  71:../../bos/hal/b_hal_i2c.c ****     }
  72:../../bos/hal/b_hal_i2c.c ****     else if (i2cFrequency <= 400000)
  73:../../bos/hal/b_hal_i2c.c ****     {
  74:../../bos/hal/b_hal_i2c.c ****         // Fast Mode (400kHz)
  75:../../bos/hal/b_hal_i2c.c ****         return 1;
  76:../../bos/hal/b_hal_i2c.c ****     }
  77:../../bos/hal/b_hal_i2c.c ****     else if (i2cFrequency <= 1000000)
  78:../../bos/hal/b_hal_i2c.c ****     {
  79:../../bos/hal/b_hal_i2c.c ****         // Fast Mode Plus (1MHz)
  80:../../bos/hal/b_hal_i2c.c ****         return 1;
  81:../../bos/hal/b_hal_i2c.c ****     }
  82:../../bos/hal/b_hal_i2c.c ****     else
  83:../../bos/hal/b_hal_i2c.c ****     {
  84:../../bos/hal/b_hal_i2c.c ****         return 1;
  85:../../bos/hal/b_hal_i2c.c ****     }
  86:../../bos/hal/b_hal_i2c.c **** }
