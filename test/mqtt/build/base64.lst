  76:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** /* Ensure that the compiler cannot know the value of x (i.e., cannot optimise
  77:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * based on its value) after this function is called.
  78:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
  79:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * If we are not using assembly, this will be fairly inefficient, so its use
  80:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * should be minimised.
  81:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  */
