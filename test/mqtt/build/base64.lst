  86:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** 
  87:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** /**
  88:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * \brief   Ensure that a value cannot be known at compile time.
  89:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
  90:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * \param x        The value to hide from the compiler.
  91:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * \return         The same value that was passed in, such that the compiler
  92:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *                 cannot prove its value (even for calls of the form
  93:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *                 x = mbedtls_ct_compiler_opaque(1), x will be unknown).
  94:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
  95:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * \note           This is mainly used in constructing mbedtls_ct_condition_t
  96:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *                 values and performing operations over them, to ensure that
  97:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *                 there is no way for the compiler to ever know anything about
  98:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *                 the value of an mbedtls_ct_condition_t.
  99:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  */
 100:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** static inline mbedtls_ct_uint_t mbedtls_ct_compiler_opaque(mbedtls_ct_uint_t x)
 101:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** {
 102:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #if defined(MBEDTLS_CT_ASM)
 103:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     asm volatile ("" : [x] "+r" (x) :);
 104:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     return x;
 105:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #else
 106:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     return x ^ mbedtls_ct_zero;
 107:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #endif
 108:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** }
