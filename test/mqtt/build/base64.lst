 110:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** /*
 111:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * Selecting unified syntax is needed for gcc, and harmless on clang.
 112:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
 113:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * This is needed because on Thumb 1, condition flags are always set, so
 114:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * e.g. "negs" is supported but "neg" is not (on Thumb 2, both exist).
 115:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
 116:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * Under Thumb 1 unified syntax, only the "negs" form is accepted, and
 117:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * under divided syntax, only the "neg" form is accepted. clang only
 118:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * supports unified syntax.
 119:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
 120:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * On Thumb 2 and Arm, both compilers are happy with the "s" suffix,
 121:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * although we don't actually care about setting the flags.
 122:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  *
 123:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * For old versions of gcc (see #8516 for details), restore divided
 124:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * syntax afterwards - otherwise old versions of gcc seem to apply
 125:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  * unified syntax globally, which breaks other asm code.
 126:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****  */
 127:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #if defined(MBEDTLS_COMPILER_IS_GCC) && defined(__thumb__) && !defined(__thumb2__) && \
 128:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     (__GNUC__ < 11) && !defined(__ARM_ARCH_2__)
 129:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #define RESTORE_ASM_SYNTAX  ".syntax divided                      \n\t"
 130:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #else
