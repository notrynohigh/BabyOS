 134:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** /* Convert a number into a condition in constant time. */
 135:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** static inline mbedtls_ct_condition_t mbedtls_ct_bool(mbedtls_ct_uint_t x)
 136:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** {
 137:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     /*
 138:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****      * Define mask-generation code that, as far as possible, will not use branches or conditional i
 139:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****      *
 140:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****      * For some platforms / type sizes, we define assembly to assure this.
 141:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****      *
 142:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****      * Otherwise, we define a plain C fallback which (in May 2023) does not get optimised into
 143:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****      * conditional instructions or branches by trunk clang, gcc, or MSVC v19.
 144:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****      */
 145:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #if defined(MBEDTLS_CT_AARCH64_ASM) && (defined(MBEDTLS_CT_SIZE_32) || defined(MBEDTLS_CT_SIZE_64))
 146:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     mbedtls_ct_uint_t s;
 147:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     asm volatile ("neg %x[s], %x[x]                               \n\t"
 148:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   "orr %x[x], %x[s], %x[x]                        \n\t"
 149:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   "asr %x[x], %x[x], 63                           \n\t"
 150:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   :
 151:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   [s] "=&r" (s),
 152:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   [x] "+&r" (x)
 153:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   :
 154:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   :
 155:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   );
 156:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     return (mbedtls_ct_condition_t) x;
 157:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h **** #elif defined(MBEDTLS_CT_ARM_ASM) && defined(MBEDTLS_CT_SIZE_32)
 158:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     uint32_t s;
 159:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****     asm volatile (".syntax unified                                \n\t"
 160:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   "negs %[s], %[x]                                \n\t"
 161:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   "orrs %[x], %[x], %[s]                          \n\t"
 162:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   "asrs %[x], %[x], #31                           \n\t"
 163:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   RESTORE_ASM_SYNTAX
 164:../../bos/thirdparty/mbedtls/bos_mbedtls/constant_time_impl.h ****                   :
