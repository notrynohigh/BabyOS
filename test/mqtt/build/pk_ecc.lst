 146:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c **** /*
 147:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  * Set the public key: fallback using ECP_LIGHT in the USE_PSA_EC_DATA case.
 148:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  *
 149:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  * Normally, when MBEDTLS_PK_USE_PSA_EC_DATA is enabled, we only use PSA
 150:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  * functions to handle keys. However, currently psa_import_key() does not
 151:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  * support compressed points. In case that support was explicitly requested,
 152:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  * this fallback uses ECP functions to get the job done. This is the reason
 153:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  * why MBEDTLS_PK_PARSE_EC_COMPRESSED auto-enables MBEDTLS_ECP_LIGHT.
 154:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  *
 155:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  * [in/out] pk: in: must have the group set, see mbedtls_pk_ecc_set_group().
 156:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  *              out: will have the public key set.
 157:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  * [in] pub, pub_len: the public key as an ECPoint,
 158:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  *                    in any format supported by ECP.
 159:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  *
 160:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  * Return:
 161:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  * - 0 on success;
 162:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  * - MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if the format is potentially valid
 163:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  *   but not supported;
 164:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  * - another error code otherwise.
 165:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c ****  */
 166:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_ecc.c **** static int pk_ecc_set_pubkey_psa_ecp_fallback(mbedtls_pk_context *pk,
