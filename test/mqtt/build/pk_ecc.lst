  61:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_internal.h **** {
  62:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_internal.h ****     switch (mbedtls_pk_get_type(&pk)) {
  63:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_internal.h ****         case MBEDTLS_PK_ECKEY:
  64:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_internal.h ****         case MBEDTLS_PK_ECKEY_DH:
  65:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_internal.h ****         case MBEDTLS_PK_ECDSA:
  66:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_internal.h ****             return (const mbedtls_ecp_keypair *) (pk).MBEDTLS_PRIVATE(pk_ctx);
  67:../../bos/thirdparty/mbedtls/bos_mbedtls/pk_internal.h ****         default:
