1003:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c **** /* VIA Padlock and our intrinsics-based implementation of AESNI require
1004:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****  * the round keys to be aligned on a 16-byte boundary. We take care of this
1005:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****  * before creating them, but the AES context may have moved (this can happen
1006:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****  * if the library is called from a language with managed memory), and in later
1007:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****  * calls it might have a different alignment with respect to 16-byte memory.
1008:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****  * So we may need to realign.
1009:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****  */
1010:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c **** MBEDTLS_MAYBE_UNUSED static void aes_maybe_realign(mbedtls_aes_context *ctx)
1011:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c **** {
1012:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****     unsigned new_offset = mbedtls_aes_rk_offset(ctx->buf);
1013:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****     if (new_offset != ctx->rk_offset) {
1014:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****         memmove(ctx->buf + new_offset,     // new address
1015:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****                 ctx->buf + ctx->rk_offset, // current address
1016:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****                 (ctx->nr + 1) * 16);       // number of round keys * bytes per rk
1017:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****         ctx->rk_offset = new_offset;
1018:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c ****     }
1019:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c **** }
1020:../../bos/thirdparty/mbedtls/bos_mbedtls/aes.c **** 
