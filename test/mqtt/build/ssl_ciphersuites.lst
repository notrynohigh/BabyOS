  25:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c **** /*
  26:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c ****  * Ordered from most preferred to least preferred in terms of security.
  27:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c ****  *
  28:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c ****  * Current rule (except weak and null which come last):
  29:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c ****  * 1. By key exchange:
  30:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c ****  *    Forward-secure non-PSK > forward-secure PSK > ECJPAKE > other non-PSK > other PSK
  31:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c ****  * 2. By key length and cipher:
  32:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c ****  *    ChaCha > AES-256 > Camellia-256 > ARIA-256 > AES-128 > Camellia-128 > ARIA-128
  33:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c ****  * 3. By cipher mode when relevant GCM > CCM > CBC > CCM_8
  34:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c ****  * 4. By hash function used when relevant
  35:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c ****  * 5. By key exchange/auth again: EC > non-EC
  36:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c ****  */
  37:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c **** static const int ciphersuite_preference[] =
  38:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c **** {
  39:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c **** #if defined(MBEDTLS_SSL_CIPHERSUITES)
  40:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c ****     MBEDTLS_SSL_CIPHERSUITES,
  41:../../bos/thirdparty/mbedtls/bos_mbedtls/ssl_ciphersuites.c **** #else
