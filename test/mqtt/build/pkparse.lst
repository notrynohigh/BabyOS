 254:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *
 255:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * Note: This new public key storing solution only works for EC keys, not
 256:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *       other ones. The latters still use pk_ctx to store their own
 257:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *       context.
 258:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      */
