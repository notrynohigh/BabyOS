 451:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 452:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Tell if context can do the operation given by PSA algorithm
 453:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 454:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param ctx       The context to query. It must have been initialized.
 455:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param alg       PSA algorithm to check against, the following are allowed:
 456:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_ALG_RSA_PKCS1V15_SIGN(hash),
 457:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_ALG_RSA_PSS(hash),
 458:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_ALG_RSA_PKCS1V15_CRYPT,
 459:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_ALG_ECDSA(hash),
 460:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_ALG_ECDH, where hash is a specific hash.
 461:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param usage     PSA usage flag to check against, must be composed of:
 462:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_KEY_USAGE_SIGN_HASH
 463:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_KEY_USAGE_DECRYPT
 464:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PSA_KEY_USAGE_DERIVE.
 465:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  Context key must match all passed usage flags.
 466:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 467:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \warning         Since the set of allowed algorithms and usage flags may be
 468:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  expanded in the future, the return value \c 0 should not
 469:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  be taken in account for non-allowed algorithms and usage
 470:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  flags.
 471:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 472:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          1 if the context can do operations on the given type.
 473:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 if the context cannot do the operations on the given
 474:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  type, for non-allowed algorithms and usage flags, or
 475:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  for a context that has been initialized but not set up
 476:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  or that has been cleared with mbedtls_pk_free().
 477:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
