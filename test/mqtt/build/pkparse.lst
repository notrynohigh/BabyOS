  49:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *      Low-level ECC parsing: optional support for SpecifiedECDomain
  50:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *
  51:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * There are two functions here that are used by the rest of the code:
  52:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * - pk_ecc_tag_is_speficied_ec_domain()
  53:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * - pk_ecc_group_id_from_specified()
  54:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *
  55:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * All the other functions are internal to this section.
  56:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *
  57:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * The two "public" functions have a dummy variant provided
  58:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * in configs without MBEDTLS_PK_PARSE_EC_EXTENDED. This acts as an
  59:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * abstraction layer for this macro, which should not appear outside
  60:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * this section.
  61:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *
  62:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  **********************************************************************/
  63:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** 
  64:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** #if !defined(MBEDTLS_PK_PARSE_EC_EXTENDED)
  65:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** /* See the "real" version for documentation */
  66:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** static int pk_ecc_tag_is_specified_ec_domain(int tag)
  67:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** {
  68:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     (void) tag;
  69:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     return 0;
  70:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** }
  71:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** 
  72:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** /* See the "real" version for documentation */
  73:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** static int pk_ecc_group_id_from_specified(const mbedtls_asn1_buf *params,
  74:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****                                           mbedtls_ecp_group_id *grp_id)
  75:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** {
  76:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     (void) params;
  77:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     (void) grp_id;
  78:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;
  79:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** }
  80:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** #else /* MBEDTLS_PK_PARSE_EC_EXTENDED */
  81:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** /*
  82:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * Tell if the passed tag might be the start of SpecifiedECDomain
  83:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * (that is, a sequence).
  84:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  */
  85:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** static int pk_ecc_tag_is_specified_ec_domain(int tag)
  86:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** {
  87:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     return tag == (MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE);
  88:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** }
  89:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** 
  90:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** /*
  91:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * Parse a SpecifiedECDomain (SEC 1 C.2) and (mostly) fill the group with it.
  92:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * WARNING: the resulting group should only be used with
  93:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * pk_ecc_group_id_from_specified(), since its base point may not be set correctly
  94:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * if it was encoded compressed.
  95:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *
  96:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *  SpecifiedECDomain ::= SEQUENCE {
  97:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *      version SpecifiedECDomainVersion(ecdpVer1 | ecdpVer2 | ecdpVer3, ...),
  98:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *      fieldID FieldID {{FieldTypes}},
  99:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *      curve Curve,
 100:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *      base ECPoint,
 101:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *      order INTEGER,
 102:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *      cofactor INTEGER OPTIONAL,
 103:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *      hash HashAlgorithm OPTIONAL,
 104:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *      ...
 105:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *  }
GAS LISTING /tmp/cciIRIE9.s 			page 3


 106:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  *
 107:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  * We only support prime-field as field type, and ignore hash and cofactor.
 108:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****  */
 109:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** static int pk_group_from_specified(const mbedtls_asn1_buf *params, mbedtls_ecp_group *grp)
 110:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** {
 111:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
 112:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     unsigned char *p = params->p;
 113:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     const unsigned char *const end = params->p + params->len;
 114:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     const unsigned char *end_field, *end_curve;
 115:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     size_t len;
 116:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     int ver;
 117:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** 
 118:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     /* SpecifiedECDomainVersion ::= INTEGER { 1, 2, 3 } */
 119:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     if ((ret = mbedtls_asn1_get_int(&p, end, &ver)) != 0) {
 120:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****         return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);
 121:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     }
 122:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** 
 123:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     if (ver < 1 || ver > 3) {
 124:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****         return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;
 125:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     }
 126:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** 
 127:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     /*
 128:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****      * FieldID { FIELD-ID:IOSet } ::= SEQUENCE { -- Finite field
 129:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****      *       fieldType FIELD-ID.&id({IOSet}),
 130:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****      *       parameters FIELD-ID.&Type({IOSet}{@fieldType})
 131:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****      * }
 132:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****      */
 133:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     if ((ret = mbedtls_asn1_get_tag(&p, end, &len,
 134:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****                                     MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {
 135:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****         return ret;
 136:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     }
 137:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** 
 138:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     end_field = p + len;
 139:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** 
 140:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     /*
 141:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****      * FIELD-ID ::= TYPE-IDENTIFIER
 142:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****      * FieldTypes FIELD-ID ::= {
 143:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****      *       { Prime-p IDENTIFIED BY prime-field } |
 144:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****      *       { Characteristic-two IDENTIFIED BY characteristic-two-field }
 145:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****      * }
 146:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****      * prime-field OBJECT IDENTIFIER ::= { id-fieldType 1 }
 147:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****      */
 148:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     if ((ret = mbedtls_asn1_get_tag(&p, end_field, &len, MBEDTLS_ASN1_OID)) != 0) {
 149:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****         return ret;
 150:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     }
 151:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** 
 152:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     if (len != MBEDTLS_OID_SIZE(MBEDTLS_OID_ANSI_X9_62_PRIME_FIELD) ||
 153:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****         memcmp(p, MBEDTLS_OID_ANSI_X9_62_PRIME_FIELD, len) != 0) {
 154:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****         return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;
 155:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     }
 156:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** 
 157:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     p += len;
 158:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c **** 
 159:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     /* Prime-p ::= INTEGER -- Field of size p. */
 160:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     if ((ret = mbedtls_asn1_get_mpi(&p, end_field, &grp->P)) != 0) {
 161:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****         return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);
 162:../../bos/thirdparty/mbedtls/bos_mbedtls/pkparse.c ****     }
