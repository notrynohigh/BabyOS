 809:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 810:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Make signature, including padding if relevant.
 811:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 812:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param ctx       The PK context to use. It must have been set up
 813:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  with a private key.
 814:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param md_alg    Hash algorithm used (see notes)
 815:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash      Hash of the message to sign
 816:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash_len  Hash length
 817:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig       Place to write the signature.
 818:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  It must have enough room for the signature.
 819:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  #MBEDTLS_PK_SIGNATURE_MAX_SIZE is always enough.
 820:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  You may use a smaller buffer if it is large enough
 821:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  given the key type.
 822:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig_size  The size of the \p sig buffer in bytes.
 823:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig_len   On successful return,
 824:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  the number of bytes written to \p sig.
 825:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param f_rng     RNG function, must not be \c NULL.
 826:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param p_rng     RNG parameter
 827:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 828:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            For keys of type #MBEDTLS_PK_RSA, the signature algorithm is
 829:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  either PKCS#1 v1.5 or PSS (using the largest possible salt
 830:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  length up to the hash length), depending on the padding mode
 831:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  in the underlying RSA context. For a pk object constructed
 832:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  by parsing, this is PKCS#1 v1.5 by default. Use
 833:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  mbedtls_pk_verify_ext() to explicitly select a different
 834:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  algorithm.
 835:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 836:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 on success, or a specific error code.
 837:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 838:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            For RSA, md_alg may be MBEDTLS_MD_NONE if hash_len != 0.
 839:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  For ECDSA, md_alg may never be MBEDTLS_MD_NONE.
 840:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
