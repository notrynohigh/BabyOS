 883:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 884:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Restartable version of \c mbedtls_pk_sign()
 885:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 886:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            Performs the same job as \c mbedtls_pk_sign(), but can
 887:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  return early and restart according to the limit set with
 888:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  \c mbedtls_ecp_set_max_ops() to reduce blocking for ECC
 889:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  operations. For RSA, same as \c mbedtls_pk_sign().
 890:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 891:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param ctx       The PK context to use. It must have been set up
 892:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  with a private key.
 893:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param md_alg    Hash algorithm used (see notes for mbedtls_pk_sign())
 894:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash      Hash of the message to sign
 895:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash_len  Hash length
 896:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig       Place to write the signature.
 897:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  It must have enough room for the signature.
 898:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  #MBEDTLS_PK_SIGNATURE_MAX_SIZE is always enough.
 899:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  You may use a smaller buffer if it is large enough
 900:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  given the key type.
