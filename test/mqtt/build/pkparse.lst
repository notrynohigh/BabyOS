 779:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param ctx       The PK context to use. It must have been set up.
 780:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param md_alg    Hash algorithm used (see notes)
 781:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash      Hash of the message to sign
 782:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash_len  Hash length or 0 (see notes)
 783:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig       Signature to verify
 784:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig_len   Signature length
 785:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 786:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 on success (signature is valid),
GAS LISTING /tmp/cciIRIE9.s 			page 59


 787:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  #MBEDTLS_ERR_PK_TYPE_MISMATCH if the PK context can't be
