 596:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 597:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Import a key into the PSA key store.
 598:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 599:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * This function is equivalent to calling psa_import_key()
 600:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * with the key material from \p pk.
 601:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 602:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * The typical way to use this function is:
 603:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * -# Call mbedtls_pk_get_psa_attributes() to obtain
 604:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *    attributes for the given key.
 605:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * -# If desired, modify the attributes, for example:
 606:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *     - To create a persistent key, call
 607:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *       psa_set_key_identifier() and optionally
 608:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *       psa_set_key_lifetime().
 609:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *     - To import only the public part of a key pair:
 610:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 611:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *           psa_set_key_type(&attributes,
 612:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                            PSA_KEY_TYPE_PUBLIC_KEY_OF_KEY_PAIR(
 613:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                                psa_get_key_type(&attributes)));
 614:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *     - Restrict the key usage if desired.
 615:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * -# Call mbedtls_pk_import_into_psa().
GAS LISTING /tmp/cciIRIE9.s 			page 56


 616:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 617:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            This function does not support RSA-alt contexts
 618:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  (set up with mbedtls_pk_setup_rsa_alt()).
 619:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 620:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param[in] pk    The PK context to use. It must have been set up.
 621:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  It can either contain a key pair or just a public key.
 622:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param[in] attributes
 623:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  The attributes to use for the new key. They must be
 624:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  compatible with \p pk. In particular, the key type
 625:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  must match the content of \p pk.
 626:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  If \p pk contains a key pair, the key type in
 627:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  attributes can be either the key pair type or the
 628:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  corresponding public key type (to import only the
 629:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  public part).
 630:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param[out] key_id
 631:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  On success, the identifier of the newly created key.
 632:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  On error, this is #MBEDTLS_SVC_KEY_ID_INIT.
 633:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 634:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 on success.
 635:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  #MBEDTLS_ERR_PK_TYPE_MISMATCH if \p pk does not contain
 636:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  a key of the type identified in \p attributes.
 637:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  Another error code on other failures.
 638:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 639:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** int mbedtls_pk_import_into_psa(const mbedtls_pk_context *pk,
 640:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                                const psa_key_attributes_t *attributes,
 641:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                                mbedtls_svc_key_id_t *key_id);
 642:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** 
 643:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 644:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Create a PK context starting from a key stored in PSA.
 645:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  This key:
 646:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - must be exportable and
 647:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - must be an RSA or EC key pair or public key (FFDH is not supported in PK).
 648:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 649:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  The resulting PK object will be a transparent type:
 650:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #MBEDTLS_PK_RSA for RSA keys or
 651:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #MBEDTLS_PK_ECKEY for EC keys.
 652:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 653:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  Once this functions returns the PK object will be completely
 654:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  independent from the original PSA key that it was generated
 655:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  from.
 656:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  Calling mbedtls_pk_sign(), mbedtls_pk_verify(),
 657:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  mbedtls_pk_encrypt(), mbedtls_pk_decrypt() on the resulting
 658:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PK context will perform the corresponding algorithm for that
 659:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PK context type.
 660:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  * For ECDSA, the choice of deterministic vs randomized will
 661:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    be based on the compile-time setting #MBEDTLS_ECDSA_DETERMINISTIC.
 662:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  * For an RSA key, the output PK context will allow both
 663:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    encrypt/decrypt and sign/verify regardless of the original
 664:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    key's policy.
 665:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    The original key's policy determines the output key's padding
 666:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    mode: PCKS1 v2.1 is set if the PSA key policy is OAEP or PSS,
 667:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                    otherwise PKCS1 v1.5 is set.
 668:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 669:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param key_id    The key identifier of the key stored in PSA.
 670:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param pk        The PK context that will be filled. It must be initialized,
 671:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  but not set up.
 672:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
GAS LISTING /tmp/cciIRIE9.s 			page 57


 673:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 on success.
 674:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          #MBEDTLS_ERR_PK_BAD_INPUT_DATA in case the provided input
 675:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  parameters are not correct.
 676:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 677:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** int mbedtls_pk_copy_from_psa(mbedtls_svc_key_id_t key_id, mbedtls_pk_context *pk);
 678:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** 
 679:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 680:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Create a PK context for the public key of a PSA key.
 681:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 682:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  The key must be an RSA or ECC key. It can be either a
 683:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  public key or a key pair, and only the public key is copied.
 684:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  The resulting PK object will be a transparent type:
 685:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #MBEDTLS_PK_RSA for RSA keys or
 686:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  - #MBEDTLS_PK_ECKEY for EC keys.
 687:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 688:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  Once this functions returns the PK object will be completely
 689:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  independent from the original PSA key that it was generated
 690:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  from.
 691:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  Calling mbedtls_pk_verify() or
 692:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  mbedtls_pk_encrypt() on the resulting
 693:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PK context will perform the corresponding algorithm for that
 694:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  PK context type.
 695:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 696:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  For an RSA key, the output PK context will allow both
 697:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  encrypt and verify regardless of the original key's policy.
 698:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  The original key's policy determines the output key's padding
 699:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  mode: PCKS1 v2.1 is set if the PSA key policy is OAEP or PSS,
 700:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  otherwise PKCS1 v1.5 is set.
 701:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 702:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param key_id    The key identifier of the key stored in PSA.
 703:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param pk        The PK context that will be filled. It must be initialized,
 704:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  but not set up.
 705:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 706:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 on success.
 707:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          MBEDTLS_ERR_PK_BAD_INPUT_DATA in case the provided input
 708:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  parameters are not correct.
 709:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 710:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** int mbedtls_pk_copy_public_from_psa(mbedtls_svc_key_id_t key_id, mbedtls_pk_context *pk);
 711:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #endif /* MBEDTLS_PSA_CRYPTO_CLIENT */
 712:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** 
 713:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 714:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Verify signature (including padding if relevant).
 715:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 716:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param ctx       The PK context to use. It must have been set up.
 717:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param md_alg    Hash algorithm used.
 718:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  This can be #MBEDTLS_MD_NONE if the signature algorithm
 719:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  does not rely on a hash algorithm (non-deterministic
 720:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  ECDSA, RSA PKCS#1 v1.5).
 721:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  For PKCS#1 v1.5, if \p md_alg is #MBEDTLS_MD_NONE, then
 722:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  \p hash is the DigestInfo structure used by RFC 8017
 723:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  &sect;9.2 steps 3&ndash;6. If \p md_alg is a valid hash
 724:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  algorithm then \p hash is the digest itself, and this
 725:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  function calculates the DigestInfo encoding internally.
 726:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash      Hash of the message to sign
 727:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash_len  Hash length
 728:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig       Signature to verify
 729:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig_len   Signature length
GAS LISTING /tmp/cciIRIE9.s 			page 58


 730:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 731:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            For keys of type #MBEDTLS_PK_RSA, the signature algorithm is
 732:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  either PKCS#1 v1.5 or PSS (accepting any salt length),
 733:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  depending on the padding mode in the underlying RSA context.
 734:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  For a pk object constructed by parsing, this is PKCS#1 v1.5
 735:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  by default. Use mbedtls_pk_verify_ext() to explicitly select
 736:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  a different algorithm.
 737:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 738:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          0 on success (signature is valid),
 739:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  #MBEDTLS_ERR_PK_SIG_LEN_MISMATCH if there is a valid
 740:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  signature in \p sig but its length is less than \p sig_len,
 741:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  or a specific error code.
 742:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 743:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** int mbedtls_pk_verify(mbedtls_pk_context *ctx, mbedtls_md_type_t md_alg,
 744:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                       const unsigned char *hash, size_t hash_len,
 745:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                       const unsigned char *sig, size_t sig_len);
 746:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** 
 747:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 748:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Restartable version of \c mbedtls_pk_verify()
 749:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 750:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            Performs the same job as \c mbedtls_pk_verify(), but can
 751:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  return early and restart according to the limit set with
 752:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  \c mbedtls_ecp_set_max_ops() to reduce blocking for ECC
 753:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  operations. For RSA, same as \c mbedtls_pk_verify().
 754:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 755:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param ctx       The PK context to use. It must have been set up.
 756:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param md_alg    Hash algorithm used (see notes)
 757:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash      Hash of the message to sign
 758:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param hash_len  Hash length or 0 (see notes)
 759:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig       Signature to verify
 760:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param sig_len   Signature length
 761:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \param rs_ctx    Restart context (NULL to disable restart)
 762:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 763:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          See \c mbedtls_pk_verify(), or
 764:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \return          #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of
 765:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  operations was reached: see \c mbedtls_ecp_set_max_ops().
 766:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 767:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** int mbedtls_pk_verify_restartable(mbedtls_pk_context *ctx,
 768:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                                   mbedtls_md_type_t md_alg,
 769:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                                   const unsigned char *hash, size_t hash_len,
 770:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                                   const unsigned char *sig, size_t sig_len,
 771:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****                                   mbedtls_pk_restart_ctx *rs_ctx);
 772:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** 
 773:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
