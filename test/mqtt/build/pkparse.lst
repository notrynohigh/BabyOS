 238:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #endif /* MBEDTLS_USE_PSA_CRYPTO */
 239:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****     /* The following fields are meant for storing the public key in raw format
 240:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * which is handy for:
 241:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * - easily importing it into the PSA context
 242:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * - reducing the ECP module dependencies in the PK one.
 243:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *
 244:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * When MBEDTLS_PK_USE_PSA_EC_DATA is enabled:
 245:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * - the pk_ctx above is not used anymore for storing the public key
 246:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *   inside the ecp_keypair structure
 247:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * - the following fields are used for all public key operations: signature
 248:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      *   verify, key pair check and key write.
 249:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****      * - For a key pair, priv_id contains the private key. For a public key,
