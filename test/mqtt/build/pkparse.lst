 110:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /**
 111:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \brief           Maximum size of a signature made by mbedtls_pk_sign().
 112:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 113:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /* We need to set MBEDTLS_PK_SIGNATURE_MAX_SIZE to the maximum signature
 114:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * size among the supported signature types. Do it by starting at 0,
 115:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * then incrementally increasing to be large enough for each supported
 116:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * signature mechanism.
 117:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 118:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * The resulting value can be 0, for example if MBEDTLS_ECDH_C is enabled
 119:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * (which allows the pk module to be included) but neither MBEDTLS_ECDSA_C
 120:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * nor MBEDTLS_RSA_C nor any opaque signature mechanism (PSA or RSA_ALT).
 121:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 122:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #define MBEDTLS_PK_SIGNATURE_MAX_SIZE 0
 123:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** 
 124:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #if (defined(MBEDTLS_RSA_C) || defined(MBEDTLS_PK_RSA_ALT_SUPPORT)) && \
 125:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****     MBEDTLS_MPI_MAX_SIZE > MBEDTLS_PK_SIGNATURE_MAX_SIZE
 126:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /* For RSA, the signature can be as large as the bignum module allows.
 127:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * For RSA_ALT, the signature size is not necessarily tied to what the
 128:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * bignum module can do, but in the absence of any specific setting,
 129:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * we use that (rsa_alt_sign_wrap in library/pk_wrap.h will check). */
 130:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #undef MBEDTLS_PK_SIGNATURE_MAX_SIZE
 131:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #define MBEDTLS_PK_SIGNATURE_MAX_SIZE MBEDTLS_MPI_MAX_SIZE
 132:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #endif
 133:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** 
 134:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #if defined(MBEDTLS_ECDSA_C) &&                                 \
 135:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****     MBEDTLS_ECDSA_MAX_LEN > MBEDTLS_PK_SIGNATURE_MAX_SIZE
 136:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /* For ECDSA, the ecdsa module exports a constant for the maximum
 137:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * signature size. */
 138:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #undef MBEDTLS_PK_SIGNATURE_MAX_SIZE
 139:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #define MBEDTLS_PK_SIGNATURE_MAX_SIZE MBEDTLS_ECDSA_MAX_LEN
 140:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #endif
 141:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** 
 142:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #if defined(MBEDTLS_USE_PSA_CRYPTO)
 143:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #if PSA_SIGNATURE_MAX_SIZE > MBEDTLS_PK_SIGNATURE_MAX_SIZE
 144:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /* PSA_SIGNATURE_MAX_SIZE is the maximum size of a signature made
 145:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * through the PSA API in the PSA representation. */
 146:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #undef MBEDTLS_PK_SIGNATURE_MAX_SIZE
 147:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #define MBEDTLS_PK_SIGNATURE_MAX_SIZE PSA_SIGNATURE_MAX_SIZE
 148:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #endif
 149:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** 
 150:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #if PSA_VENDOR_ECDSA_SIGNATURE_MAX_SIZE + 11 > MBEDTLS_PK_SIGNATURE_MAX_SIZE
 151:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /* The Mbed TLS representation is different for ECDSA signatures:
 152:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * PSA uses the raw concatenation of r and s,
 153:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * whereas Mbed TLS uses the ASN.1 representation (SEQUENCE of two INTEGERs).
 154:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * Add the overhead of ASN.1: up to (1+2) + 2 * (1+2+1) for the
 155:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * types, lengths (represented by up to 2 bytes), and potential leading
 156:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * zeros of the INTEGERs and the SEQUENCE. */
 157:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #undef MBEDTLS_PK_SIGNATURE_MAX_SIZE
 158:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #define MBEDTLS_PK_SIGNATURE_MAX_SIZE (PSA_VENDOR_ECDSA_SIGNATURE_MAX_SIZE + 11)
 159:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #endif
GAS LISTING /tmp/cciIRIE9.s 			page 48


 160:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #endif /* defined(MBEDTLS_USE_PSA_CRYPTO) */
