 263:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****     size_t MBEDTLS_PRIVATE(ec_bits);                /**< Curve's bits of pk */
 264:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #endif /* MBEDTLS_PK_USE_PSA_EC_DATA */
 265:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** } mbedtls_pk_context;
