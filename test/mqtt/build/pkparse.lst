 363:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 364:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * \note            This function replaces mbedtls_pk_setup() for contexts
 365:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *                  that wrap a (possibly opaque) PSA key instead of
