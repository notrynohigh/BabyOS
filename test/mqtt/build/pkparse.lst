 162:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** /* Internal helper to define which fields in the pk_context structure below
 163:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * should be used for EC keys: legacy ecp_keypair or the raw (PSA friendly)
 164:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * format. It should be noted that this only affects how data is stored, not
 165:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * which functions are used for various operations. The overall picture looks
 166:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * like this:
 167:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * - if USE_PSA is not defined and ECP_C is defined then use ecp_keypair data
 168:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *   structure and legacy functions
 169:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * - if USE_PSA is defined and
 170:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *     - if ECP_C then use ecp_keypair structure, convert data to a PSA friendly
 171:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *       format and use PSA functions
 172:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *     - if !ECP_C then use new raw data and PSA functions directly.
 173:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  *
 174:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * The main reason for the "intermediate" (USE_PSA + ECP_C) above is that as long
 175:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * as ECP_C is defined mbedtls_pk_ec() gives the user a read/write access to the
 176:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * ecp_keypair structure inside the pk_context so they can modify it using
 177:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  * ECP functions which are not under PK module's control.
 178:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****  */
 179:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #if defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY) && \
 180:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h ****     !defined(MBEDTLS_ECP_C)
 181:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #define MBEDTLS_PK_USE_PSA_EC_DATA
 182:../../bos/thirdparty/mbedtls/bos_mbedtls/mbedtls/pk.h **** #endif
