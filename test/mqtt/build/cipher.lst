1398:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** /*
1399:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****  * Packet-oriented encryption for AEAD modes: internal function used by
1400:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****  * mbedtls_cipher_auth_encrypt_ext().
1401:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****  */
1402:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** static int mbedtls_cipher_aead_encrypt(mbedtls_cipher_context_t *ctx,
1403:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****                                        const unsigned char *iv, size_t iv_len,
1404:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****                                        const unsigned char *ad, size_t ad_len,
1405:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****                                        const unsigned char *input, size_t ilen,
1406:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****                                        unsigned char *output, size_t *olen,
1407:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****                                        unsigned char *tag, size_t tag_len)
1408:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** {
1409:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** #if defined(MBEDTLS_USE_PSA_CRYPTO) && !defined(MBEDTLS_DEPRECATED_REMOVED)
1410:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     if (ctx->psa_enabled == 1) {
1411:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         /* As in the non-PSA case, we don't check that
1412:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****          * a key has been set. If not, the key slot will
1413:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****          * still be in its default state of 0, which is
