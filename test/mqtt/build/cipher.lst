 825:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** #if defined(MBEDTLS_CIPHER_MODE_WITH_PADDING)
 826:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** #if defined(MBEDTLS_CIPHER_PADDING_PKCS7)
 827:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** /*
 828:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****  * PKCS7 (and PKCS5) padding: fill with ll bytes, with ll = padding_len
 829:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****  */
 830:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** static void add_pkcs_padding(unsigned char *output, size_t output_len,
 831:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****                              size_t data_len)
 832:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** {
 833:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     size_t padding_len = output_len - data_len;
 834:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     unsigned char i;
 835:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 836:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     for (i = 0; i < padding_len; i++) {
 837:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         output[data_len + i] = (unsigned char) padding_len;
 838:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     }
 839:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** }
 840:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 841:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** static int get_pkcs_padding(unsigned char *input, size_t input_len,
 842:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****                             size_t *data_len)
 843:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** {
 844:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     size_t i, pad_idx;
 845:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     unsigned char padding_len;
 846:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 847:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     if (NULL == input || NULL == data_len) {
 848:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;
 849:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     }
 850:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 851:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     padding_len = input[input_len - 1];
 852:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     *data_len = input_len - padding_len;
 853:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 854:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     mbedtls_ct_condition_t bad = mbedtls_ct_uint_gt(padding_len, input_len);
 855:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     bad = mbedtls_ct_bool_or(bad, mbedtls_ct_uint_eq(padding_len, 0));
 856:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 857:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     /* The number of bytes checked must be independent of padding_len,
 858:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****      * so pick input_len, which is usually 8 or 16 (one block) */
 859:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     pad_idx = input_len - padding_len;
 860:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     for (i = 0; i < input_len; i++) {
 861:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         mbedtls_ct_condition_t in_padding = mbedtls_ct_uint_ge(i, pad_idx);
 862:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         mbedtls_ct_condition_t different  = mbedtls_ct_uint_ne(input[i], padding_len);
 863:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         bad = mbedtls_ct_bool_or(bad, mbedtls_ct_bool_and(in_padding, different));
 864:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     }
 865:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 866:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     return mbedtls_ct_error_if_else_0(bad, MBEDTLS_ERR_CIPHER_INVALID_PADDING);
 867:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** }
 868:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** #endif /* MBEDTLS_CIPHER_PADDING_PKCS7 */
