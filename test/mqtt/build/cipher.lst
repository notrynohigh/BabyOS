 871:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** /*
 872:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****  * One and zeros padding: fill with 80 00 ... 00
 873:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****  */
 874:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** static void add_one_and_zeros_padding(unsigned char *output,
 875:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****                                       size_t output_len, size_t data_len)
 876:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** {
 877:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     size_t padding_len = output_len - data_len;
 878:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     unsigned char i = 0;
 879:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 880:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     output[data_len] = 0x80;
 881:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     for (i = 1; i < padding_len; i++) {
 882:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         output[data_len + i] = 0x00;
 883:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     }
 884:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** }
 885:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 886:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** static int get_one_and_zeros_padding(unsigned char *input, size_t input_len,
 887:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****                                      size_t *data_len)
 888:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** {
 889:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     if (NULL == input || NULL == data_len) {
 890:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;
 891:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     }
 892:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 893:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     mbedtls_ct_condition_t in_padding = MBEDTLS_CT_TRUE;
 894:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     mbedtls_ct_condition_t bad = MBEDTLS_CT_TRUE;
 895:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 896:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     *data_len = 0;
 897:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 898:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     for (ptrdiff_t i = (ptrdiff_t) (input_len) - 1; i >= 0; i--) {
 899:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         mbedtls_ct_condition_t is_nonzero = mbedtls_ct_bool(input[i]);
 900:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 901:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         mbedtls_ct_condition_t hit_first_nonzero = mbedtls_ct_bool_and(is_nonzero, in_padding);
 902:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 903:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         *data_len = mbedtls_ct_size_if(hit_first_nonzero, i, *data_len);
 904:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 905:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         bad = mbedtls_ct_bool_if(hit_first_nonzero, mbedtls_ct_uint_ne(input[i], 0x80), bad);
 906:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 907:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****         in_padding = mbedtls_ct_bool_and(in_padding, mbedtls_ct_bool_not(is_nonzero));
 908:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     }
 909:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** 
 910:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c ****     return mbedtls_ct_error_if_else_0(bad, MBEDTLS_ERR_CIPHER_INVALID_PADDING);
 911:../../bos/thirdparty/mbedtls/bos_mbedtls/cipher.c **** }
