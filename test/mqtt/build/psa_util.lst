 342:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c **** /* Wrapper function allowing the classic API to use the PSA RNG.
 343:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****  *
 344:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****  * `mbedtls_psa_get_random(MBEDTLS_PSA_RANDOM_STATE, ...)` calls
 345:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****  * `psa_generate_random(...)`. The state parameter is ignored since the
 346:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****  * PSA API doesn't support passing an explicit state.
 347:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****  */
 348:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c **** int mbedtls_psa_get_random(void *p_rng,
 349:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****                            unsigned char *output,
 350:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****                            size_t output_size)
 351:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c **** {
 352:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****     /* This function takes a pointer to the RNG state because that's what
 353:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****      * classic mbedtls functions using an RNG expect. The PSA RNG manages
 354:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****      * its own state internally and doesn't let the caller access that state.
 355:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****      * So we just ignore the state parameter, and in practice we'll pass
 356:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****      * NULL. */
 357:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****     (void) p_rng;
 358:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****     psa_status_t status = psa_generate_random(output, output_size);
 359:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****     if (status == PSA_SUCCESS) {
 360:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****         return 0;
 361:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****     } else {
 362:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****         return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;
 363:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c ****     }
 364:../../bos/thirdparty/mbedtls/bos_mbedtls/psa_util.c **** }
