  52:../../bos/utils/b_util_utc.c **** #define YEAR_CHECK(yr) (((yr % 400) == 0x0) || (((yr % 4) == 0) && ((yr % 100) != 0)))
  53:../../bos/utils/b_util_utc.c **** 
  54:../../bos/utils/b_util_utc.c **** #define YEAR_DAYS(yr) (YEAR_CHECK(yr) ? 366 : 365)
  55:../../bos/utils/b_util_utc.c **** #define BEGYEAR 1970  // UTC started at 00:00:00 January 1, 2000
  56:../../bos/utils/b_util_utc.c **** #define DAY 86400UL   // 24 hours * 60 minutes * 60 seconds
  57:../../bos/utils/b_util_utc.c **** 
  58:../../bos/utils/b_util_utc.c **** #define IS_TIME_VALID(n)                                                             \
  59:../../bos/utils/b_util_utc.c ****     ((n.month > 0 && n.month <= 12) && (n.day > 0 && n.day <= 31) && n.hour <= 23 && \
  60:../../bos/utils/b_util_utc.c ****      n.minute <= 59 && n.second <= 59)
