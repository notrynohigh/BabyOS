  80:../../bos/utils/b_util_utc.c **** static uint8_t _bUTC_CalendarMonthDays(uint8_t lpyr, uint8_t month)
  81:../../bos/utils/b_util_utc.c **** {
  82:../../bos/utils/b_util_utc.c ****     uint8_t days = 31, i = 0;
  83:../../bos/utils/b_util_utc.c ****     uint8_t table[7] = {1, 3, 5, 7, 8, 10, 12};
  84:../../bos/utils/b_util_utc.c ****     if (month < 1 || month > 12)
  85:../../bos/utils/b_util_utc.c ****     {
  86:../../bos/utils/b_util_utc.c ****         return 0;
  87:../../bos/utils/b_util_utc.c ****     }
  88:../../bos/utils/b_util_utc.c ****     if (month == 2)
  89:../../bos/utils/b_util_utc.c ****     {
  90:../../bos/utils/b_util_utc.c ****         days = (28 + lpyr);
  91:../../bos/utils/b_util_utc.c ****     }
  92:../../bos/utils/b_util_utc.c ****     else
  93:../../bos/utils/b_util_utc.c ****     {
  94:../../bos/utils/b_util_utc.c ****         for (i = 0; i < 7; i++)
  95:../../bos/utils/b_util_utc.c ****         {
  96:../../bos/utils/b_util_utc.c ****             if (month == table[i])
  97:../../bos/utils/b_util_utc.c ****             {
  98:../../bos/utils/b_util_utc.c ****                 days = 31;
  99:../../bos/utils/b_util_utc.c ****                 break;
 100:../../bos/utils/b_util_utc.c ****             }
 101:../../bos/utils/b_util_utc.c ****         }
 102:../../bos/utils/b_util_utc.c ****         if (i >= 7)
 103:../../bos/utils/b_util_utc.c ****         {
 104:../../bos/utils/b_util_utc.c ****             days = 30;
GAS LISTING /tmp/ccQPlPFm.s 			page 3


 105:../../bos/utils/b_util_utc.c ****         }
 106:../../bos/utils/b_util_utc.c ****     }
 107:../../bos/utils/b_util_utc.c ****     return days;
 108:../../bos/utils/b_util_utc.c **** }
