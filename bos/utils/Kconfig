# Utils Configuration
menu "Utils Configuration"

#======================================== Debug/Log ========================================
config _DEBUG_ENABLE
    bool "Debug Enable/Disable"
    default y

if _DEBUG_ENABLE

choice
    prompt "Log level"
    default LOG_LEVEL_ALL
config LOG_LEVEL_ALL
    bool "All (debug + info + warning + error)"
config LOG_LEVEL_INFO
    bool "Info level and above"
config LOG_LEVEL_WARNING
    bool "Warning level and above"
config LOG_LEVEL_ERROR
    bool "Error level only"
config LOG_LEVEL_CUSTOMIZE
    bool "User-defined levels"
endchoice

if LOG_LEVEL_CUSTOMIZE

config _B_LOG_ENABLE
    bool "b_log (debug)"
    default y

config _B_LOG_I_ENABLE
    bool "b_log_i (info)"
    default y

config _B_LOG_W_ENABLE
    bool "b_log_w (warning)"
    default y

config _B_LOG_E_ENABLE
    bool "b_log_e (error)"
    default y

endif

config LOG_BUF_SIZE
    int "Log buffer size (bytes)"
    default 256
    range 64 1024

choice
    prompt "Log output channel"
    default _LOG_VIA_UART
config _LOG_VIA_UART
    bool "Serial port"
config _LOG_VIA_USER_SPECIFIED
    bool "User-defined"
endchoice

if _LOG_VIA_UART

config LOG_UART
    int "UART (0-7: B_HAL_UART_1-8, 8-11: B_HAL_LPUART_1-4)"
    default 0
    range 0 11

endif

endif

#======================================== Memory Pool ========================================
config _MEMP_ENABLE
    bool "Memory Pool"
    default n

if _MEMP_ENABLE

config MEMP_MAX_SIZE
    int "Maximum memory block size (bytes)"
    default 10240 if !_MBEDTLS_ENABLE
    default 40960

config _MEMP_WATERLINE_ENABLE
    bool "Waterline monitoring"
    default n

config _MEMP_MONITOR_ENABLE
    bool "Memory pool monitor"
    default n

endif

#======================================== AT Command ========================================
config _AT_ENABLE
    bool "AT Command"
    default n

if _AT_ENABLE

config _AT_DYNAMIC_ENABLE
    bool "Dynamic response data allocation"
    default n
    select _MEMP_ENABLE if _AT_DYNAMIC_ENABLE

endif

endmenu