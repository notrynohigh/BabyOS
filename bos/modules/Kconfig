#======================================== SSL/TLS ========================================
config _SSL_ENABLE
    bool "SSL/TLS"
    default n
    depends on _BOS_MODULES_ENABLE
    select _MBEDTLS_ENABLE

if _SSL_ENABLE

config _SSL_DEFAULT_CERT_ENABLE
    bool "Use default certificate"
    default y
    help
      Embed default root CA certificates (_config/b_mbedtls_config.h).
      Required to verify HTTPS server certificates.
      Always enable for HTTP client functionality.

config _SSL_SKIP_HOSTNAME_VERIFY
    bool "Skip TLS hostname verification (test only)"
    default n
    help
      WARNING: Only enable for development/testing!
      Skips CN/SAN check between URL host and certificate subject.
      Certificate chain validation (signature, expiry, etc.) still runs.
      Disable in production to prevent MITM attacks.

config _SSL_VERIFY_ENABLE
    bool "Enable server certificate verification"
    default n
    help
      Enable CA chain + expiry validation for server certificates.
      Disable for self-signed certs or development/testing.
      Hostname verification is controlled separately by _SSL_SKIP_HOSTNAME_VERIFY.

# mbedTLS细粒度配置（用于优化Flash占用）
config _MBEDTLS_DEBUG_ENABLE
    bool "mbedTLS debug output"
    default n
    help
      Enable mbedTLS debug log output. Disable in production to save ~5-10KB Flash.

config _MBEDTLS_SHA384_ENABLE
    bool "SHA-384 support"
    default n
    help
      Required for AES-256-GCM-SHA384 cipher suite.
      Enable if you need AES-256 strength; otherwise SHA-256 is sufficient.

config _MBEDTLS_PEM_PARSE_ENABLE
    bool "PEM certificate parsing"
    default y
    help
      Required for parsing PEM-formatted certificates (most common).
      Disable only if you use DER-formatted certificates exclusively.
      Saves ~3-4KB Flash when disabled.

endif

endmenu