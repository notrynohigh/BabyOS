    bool "Protocol"
    default n
    depends on _BOS_MODULES_ENABLE
    select _BOS_SERVICES_ENABLE
    select _PROTOCOL_SERVICE_ENABLE

if _PROTO_ENABLE

choice
    prompt "Protocol role"
    default PROTO_ROLE_MCU
config PROTO_ROLE_MCU
    bool "MCU (device)"
    help
        Select if protocol is used by the microcontroller.
config PROTO_ROLE_HOST
    bool "Host"
    help
        Select if protocol is used by the upper-level system.
endchoice

config PROTO_FID_SIZE
    int "Device ID field size (bytes)"
    default 4
    range 2 4

config PROTO_FLEN_SIZE
    int "Length field size (bytes)"
    default 2
    range 1 2

config _PROTO_ENCRYPT_ENABLE
    bool "Encryption"
    default n

if _PROTO_ENCRYPT_ENABLE

config SECRET_KEY1
    int "Secret key 1"
    default 1

config SECRET_KEY2
    int "Secret key 2"
    default 22

config SECRET_KEY3
    int "Secret key 3"
    default 333

config SECRET_KEY4
    int "Secret key 4"
    default 4444

endif

endif

