# HAL Configuration
menu "HAL Configuration"

config TICK_FRQ_HZ
    int "System tick frequency (Hz)"
    default 1000
    help
        System tick timer frequency for task scheduling.

config USER_TICK_ENABLE
    bool "Use user-provided tick interface"
    default n
    help
        Enable custom tick counter implementation.

config _HALIF_VARIABLE_ENABLE
    bool "HAL interface variable enable"
    default n
    help
        Enable runtime HAL interface configuration.

#======================================== Watchdog ========================================
config _WDT_ENABLE
    bool "Watchdog"
    default n

if _WDT_ENABLE

config WDT_TIMEOUT_S
    int "Watchdog timeout (seconds)"
    default 60

endif

endmenu