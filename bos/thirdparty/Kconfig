# Thirdparty Components Configuration
menu "Thirdparty Configuration"

#======================================== CmBackTrace ========================================
config _CMBACKTRACE_ENABLE
    bool "CmBackTrace (ARM crash dump)"
    default n

if _CMBACKTRACE_ENABLE

choice
    prompt "ARM Cortex-M core"
config TRACE_ARM_CORTEX_M0
    bool "Cortex-M0"
config TRACE_ARM_CORTEX_M3
    bool "Cortex-M3"
config TRACE_ARM_CORTEX_M4
    bool "Cortex-M4"
config TRACE_ARM_CORTEX_M7
    bool "Cortex-M7"
config TRACE_ARM_CORTEX_M33
    bool "Cortex-M33"
endchoice

endif

#======================================== NR Micro Shell ========================================
config _NR_MICRO_SHELL_ENABLE
    bool "NR Micro Shell"
    default n

if _NR_MICRO_SHELL_ENABLE

config NR_SHELL_USER_NAME
    string "Shell prompt username"
    default "nr@bos:"

config NR_ANSI_LINE_SIZE
    int "Command line buffer size"
    default 100

config NR_SHELL_USER_NAME_MAX_LENGTH
    int "Maximum username length"
    default 30

config NR_SHELL_CMD_NAME_MAX_LENGTH
    int "Maximum command name length"
    default 16

config NR_SHELL_CMD_PARAS_MAX_NUM
    int "Maximum parameters per command"
    default 10

config NR_SHELL_MAX_CMD_HISTORY_NUM
    int "Command history count (0-3)"
    default 1
    range 0 3

config NR_SHELL_CMD_HISTORY_BUF_LENGTH
    int "Command history buffer length"
    default 100

config NR_SHELL_END_OF_LINE
    int "Line ending (0: \n, 1: \r, 2: \r\n)"
    default 1
    range 0 2

config NR_SHLL_FULL_ANSI
    bool "Full ANSI escape codes"
    default y

config NR_SHELL_ECHO_ENABLE
    bool "Echo input characters"
    default y

endif

#======================================== Flexible Button ========================================
config _FLEXIBLEBUTTON_ENABLE
    bool "Flexible Button"
    default n

if _FLEXIBLEBUTTON_ENABLE

config FLEX_BTN_SCAN_FREQ_HZ
    int "Button scan frequency (Hz)"
    default 50

config FLEX_BTN_SHORT_XMS
    int "Short press threshold (ms)"
    default 1000

config FLEX_BTN_LONG_XMS
    int "Long press threshold (ms)"
    default 3000

config FLEX_BTN_LLONG_XMS
    int "Long-long press threshold (ms)"
    default 5000

config MULTIPLE_CLICKS_INTERVAL_XMS
    int "Multiple clicks interval (ms)"
    default 300

endif

#======================================== uGUI ========================================
config _UGUI_ENABLE
    bool "uGUI"
    default n

if _UGUI_ENABLE

choice
    prompt "Font"
config GUI_FONT_6X8
    bool "6x8"
config GUI_FONT_8X12
    bool "8x12"
config GUI_FONT_12X16
    bool "12x16"
config GUI_FONT_XBF
    bool "XBF (external)"
endchoice

if GUI_FONT_XBF

config XBF_FILE_ADDR
    hex "XBF font file address"
    default 0x0

endif

choice
    prompt "Encoding"
config ENCODING_UTF_8
    bool "UTF-8"
config ENCODING_UNICODE
    bool "UNICODE"
endchoice

endif

#======================================== cJSON ========================================
config _CJSON_ENABLE
    bool "cJSON"
    default n

if _CJSON_ENABLE

config CJSON_MEM_USE_BMALLOC
    bool "Use bMalloc/bFree"
    default y
    select _MEMP_ENABLE

endif

