# Algorithm Configuration
menu "Algorithm Configuration"

config _BOS_ALGO_ENABLE
    bool "Algorithm Enable/Disable"
    default y

#======================================== Base64 ========================================
config _ALGO_BASE64_ENABLE
    bool "Base64 Encode/Decode"
    default n
    depends on _BOS_ALGO_ENABLE

#======================================== SHA1 ========================================
config _ALGO_SHA1_ENABLE
    bool "SHA1"
    default n
    depends on _BOS_ALGO_ENABLE

