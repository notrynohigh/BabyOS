    bool "Unicode"
    default n
    depends on _BOS_ALGO_ENABLE

#======================================== MD5 ========================================
config _ALGO_MD5_ENABLE
    bool "MD5"
    default n
    depends on _BOS_ALGO_ENABLE

#======================================== CRC ========================================
config _ALGO_CRC_ENABLE
    bool "CRC Algorithms"
    default n
    depends on _BOS_ALGO_ENABLE

