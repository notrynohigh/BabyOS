# Version Configuration
menu "Version Configuration"

config HW_VERSION
    int "Hardware version"
    default 211212
    help
        Hardware version number.

config FW_VERSION
    int "Firmware version"
    default 80700
    help
        Firmware version number.

config FW_NAME
    string "Firmware name"
    default "BabyOS"
    help
        Firmware name string.

endmenu